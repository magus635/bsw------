                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>31</MAX-VALUE>
                                  <UUID>87c4aa22-17ee-4919-b715-659d6aca875f</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerPropSeg</SHORT-NAME>
                                  <DESC>Specifies propagation delay in time quantas.</DESC>
                                  <VALUE>3</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>31</MAX-VALUE>
                                  <UUID>e0c33d36-7fc5-4cd3-b5a6-30d4a28260aa</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSeg1</SHORT-NAME>
                                  <DESC>Specifies phase segment 1 in time quantas.</DESC>
                                  <VALUE>3</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>31</MAX-VALUE>
                                  <UUID>abc324df-7cdb-4590-988d-b12ecf49fd7e</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSeg2</SHORT-NAME>
                                  <DESC>Specifies phase segment 2 in time quantas.</DESC>
                                  <VALUE>1</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>15</MAX-VALUE>
                                  <UUID>2123f8bd-e37c-434c-80d2-d70a99c1321c</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSyncJumpWidth</SHORT-NAME>
                                  <DESC>Specifies the synchronization jump width for the controller in time quantas.</DESC>
