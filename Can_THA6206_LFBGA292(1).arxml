                    <CONTAINER>
                      <SHORT-NAME>CanController</SHORT-NAME>
                      <DESC>This container contains the configuration parameters of the CAN controller(s).</DESC>
                      <UUID>b0dfbd34-0c3c-445c-8569-ef205ea8bd44</UUID>
                      <PARAMETERS>
                        <PARAMETER>
                          <SHORT-NAME>CanControllerActivation</SHORT-NAME>
                          <DESC>Defines if a CAN controller is used in the configuration.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>95637b65-4d25-4d6c-913f-b9464fa7ca9c</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanControllerBaseAddress</SHORT-NAME>
                          <DESC>Specifies the CAN controller base address.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>4294967295</MAX-VALUE>
                          <UUID>47f300a0-3f5a-441f-bfd1-7c16e20d259a</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanHardwareChannel</SHORT-NAME>
                          <DESC>This parameter provides the Real Hardware controller ID which is unique in the CAN Driver</DESC>
                          <VALUE>CAN_CONTROLLER_00</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>a0b474b7-1425-46ab-b600-b31822dac0d2</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanControllerId</SHORT-NAME>
                          <DESC>This parameter provides the controller ID which is unique in a given CAN Driver. The value for this parameter starts with 0 and continue without any gaps.</DESC>
                          <VALUE>1</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>255</MAX-VALUE>
                          <UUID>20859705-be64-4146-a326-9b032d19598f</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanRxProcessing</SHORT-NAME>
                          <DESC>Enables / disables API Can_MainFunction_Read() for handling PDU reception events in polling mode.</DESC>
                          <VALUE>POLLING</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>41fa8f83-4a2d-4998-aeb2-2cd164ee1c13</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTxProcessing</SHORT-NAME>
                          <DESC>Enables / disables API Can_MainFunction_Write() for handling PDU transmission events in polling mode.</DESC>
                          <VALUE>POLLING</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>8c8cc9f7-e7aa-4fd6-960f-6416ae28e68c</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanBusoffProcessing</SHORT-NAME>
                          <DESC>Enables / disables API Can_MainFunction_BusOff() for handling busoff events in polling mode.</DESC>
                          <VALUE>POLLING</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>aad4346b-3e7b-401e-9dbe-a5ca8d13392c</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanWakeupProcessing</SHORT-NAME>
                          <DESC>Enables / disables API Can_MainFunction_Wakeup() for handling wakeup events in polling mode.</DESC>
                          <VALUE>POLLING</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>ff513d3b-42b9-4a57-9c25-6f3181f12983</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanWakeupFunctionalityAPI</SHORT-NAME>
                          <DESC>Adds / removes the service Can_CheckWakeup() from the code.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>f9843e62-bc26-4a26-bc50-7b62f7d7fdb3</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanFDSupport</SHORT-NAME>
