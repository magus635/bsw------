                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>3efd78a7-0933-488f-b132-875d4c9d9a0c</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerInitialRefOffset</SHORT-NAME>
