                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanIcomLevel</SHORT-NAME>
                              <DESC>Defines the level of Pretended Networking.</DESC>
                              <VALUE>CAN_ICOM_LEVEL_ONE</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>b90a975e-f046-4393-8c5e-9cfa65371212</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanIcomVariant</SHORT-NAME>
                              <DESC>Defines the variant, which is supported by this CanController</DESC>
                              <VALUE>CAN_ICOM_VARIANT_NONE</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>b8198c6f-13a1-45e1-83e7-89f02082951f</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                        </CONTAINER>
                        <CONTAINER>
                          <SHORT-NAME>CanMainFunctionRWPeriods</SHORT-NAME>
                          <DESC>This container contains the parameter for configuring the period for cyclic call to Can_MainFunction_Read or Can_MainFunction_Write depending on the referring item.</DESC>
                          <UUID>f3f8c76c-21c4-4001-9707-f4e9a6e3ae94</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanMainFunctionPeriod</SHORT-NAME>
                              <DESC>This parameter describes the period for cyclic call to Can_MainFunction_Read or Can_MainFunction_Write depending on the referring item. Unit is seconds. Different poll-cycles will be configurable if more than one CanMainFunctionPeriod is configured. In this case multiple Can_MainFunction_Read() or Can_MainFunction_Write() will be provided by the CAN Driver module.</DESC>
                              <VALUE>0.001</VALUE>
                              <TYPE>FLOAT</TYPE>
                              <MIN-VALUE>0.001</MIN-VALUE>
                              <MAX-VALUE>65.535</MAX-VALUE>
                              <UUID>636d9af3-044a-411a-9bde-7f48a167e863</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                        </CONTAINER>
                      </SUB-CONTAINERS>
                    </CONTAINER>
                    <CONTAINER>
                      <SHORT-NAME>CanIcomGeneral</SHORT-NAME>
                      <DESC>This container contains the general configuration parameters of the ICOM Configuration.</DESC>
                      <UUID>e6808148-58a0-4bef-916a-9e6488136f6b</UUID>
                      <PARAMETERS>
                        <PARAMETER>
                          <SHORT-NAME>CanIcomLevel</SHORT-NAME>
                          <DESC>Defines the level of Pretended Networking.</DESC>
                          <VALUE>CAN_ICOM_LEVEL_ONE</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>50789eaf-69bd-455c-ae34-3a8115bca929</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanIcomVariant</SHORT-NAME>
                          <DESC>Defines the variant, which is supported by this CanController</DESC>
                          <VALUE>CAN_ICOM_VARIANT_NONE</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>b9b757bc-96e9-468c-a4fd-3434c9d279fb</UUID>
                        </PARAMETER>
                      </PARAMETERS>
                    </CONTAINER>
                    <CONTAINER>
                      <SHORT-NAME>CanMainFunctionRWPeriods</SHORT-NAME>
                      <DESC>This container contains the parameter for configuring the period for cyclic call to Can_MainFunction_Read or Can_MainFunction_Write depending on the referring item.</DESC>
                      <UUID>1db70ced-f8dc-4409-8940-59b19db92686</UUID>
                      <PARAMETERS>
                        <PARAMETER>
                          <SHORT-NAME>CanMainFunctionPeriod</SHORT-NAME>
                          <DESC>This parameter describes the period for cyclic call to Can_MainFunction_Read or Can_MainFunction_Write depending on the referring item. Unit is seconds. Different poll-cycles will be configurable if more than one CanMainFunctionPeriod is configured. In this case multiple Can_MainFunction_Read() or Can_MainFunction_Write() will be provided by the CAN Driver module.</DESC>
                          <VALUE>0.001</VALUE>
                          <TYPE>FLOAT</TYPE>
                          <MIN-VALUE>0.001</MIN-VALUE>
                          <MAX-VALUE>65.535</MAX-VALUE>
                          <UUID>bf06cda4-ab18-4a07-acac-d68c95ba11ff</UUID>
                        </PARAMETER>
                      </PARAMETERS>
                    </CONTAINER>
                    <CONTAINER>
                      <SHORT-NAME>CommonPublishedInformation</SHORT-NAME>
                      <DESC>&lt;html&gt;
                                                       Common container, aggregated by all modules.
                                                       It contains published information about vendor and versions.
                                                  &lt;/html&gt;</DESC>
                      <UUID>80003297-9ff6-4706-bc55-658029c19238</UUID>
