                                  <TYPE>FLOAT</TYPE>
                                  <MIN-VALUE>0.0</MIN-VALUE>
                                  <MAX-VALUE>8000.0</MAX-VALUE>
                                  <UUID>50e7529c-b90e-4012-9e6c-317cf7db3d09</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerFdBaudRatePRESDIV</SHORT-NAME>
