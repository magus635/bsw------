                              <UUID>9f5d58a8-254e-4dd8-8c74-8e06e47fa2f0</UUID>
                              <PARAMETERS>
                                <PARAMETER>
                                  <SHORT-NAME>CanIcomSignalMask</SHORT-NAME>
                                  <DESC>This parameter shall be used to mask a signal in the payload of a CAN message.</DESC>
                                  <VALUE>0</VALUE>
