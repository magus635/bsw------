                    <CONTAINER>
                      <SHORT-NAME>CanGeneral</SHORT-NAME>
                      <DESC>This container contains the parameters related each CAN Driver Unit.</DESC>
                      <UUID>1a4d3c82-c4d2-4fdc-af04-adfa93e3b1ba</UUID>
                      <PARAMETERS>
                        <PARAMETER>
                          <SHORT-NAME>CanDevErrorDetect</SHORT-NAME>
                          <DESC>Switches the Default Error Tracer (Det) detection and notification ON or OFF.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>4b8f1e57-8217-49c5-a132-aee562dfd59e</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanSafetyErrorDetect</SHORT-NAME>
                          <DESC>Switches the Safety Default Error Tracer (Det) detection and notification ON or OFF.</DESC>
                          <VALUE>true</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>48cc4111-9359-44b4-a8f7-7ed2ce7a8c6e</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanSupportMultipartition</SHORT-NAME>
                          <DESC>Only used for compatibility adaptation of some BSW modules, CanDriver ability multipartition depend on Resources module.</DESC>
                          <VALUE>true</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>add5ad19-d00f-48d9-986e-355eeced6e5b</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanIndex</SHORT-NAME>
                          <DESC>Specifies the InstanceId of this module instance. If only one instance is present it shall have the Id 0.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>255</MAX-VALUE>
                          <UUID>815c23be-4fc0-495d-a369-e27fa26152f1</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanLPduReceiveCalloutFunction</SHORT-NAME>
                          <DESC>This parameter defines the existence and the name of a callout function that is called after a successful</DESC>
                          <TYPE>STRING</TYPE>
                          <UUID>ace9d591-be28-4068-8256-51cfa924be5a</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanLPduTransmitCalloutFunction</SHORT-NAME>
                          <DESC>This parameter defines the existence and the name of a callout function that is called before sending data</DESC>
                          <TYPE>STRING</TYPE>
                          <UUID>32a947d3-852f-41f1-b78e-88e6c3858020</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanMainFunctionBusoffPeriod</SHORT-NAME>
                          <DESC>This parameter describes the period for cyclic call to Can_MainFunction_Busoff. Unit is seconds.</DESC>
                          <VALUE>0.001</VALUE>
                          <TYPE>FLOAT</TYPE>
                          <MIN-VALUE>0.001</MIN-VALUE>
                          <MAX-VALUE>65.535</MAX-VALUE>
                          <UUID>3cc2bb60-4c9e-40d6-a9c0-da0a28ef205a</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanMainFunctionModePeriod</SHORT-NAME>
                          <DESC>This parameter describes the period for cyclic call to Can_MainFunction_Mode. Unit is seconds.</DESC>
                          <VALUE>0.001</VALUE>
                          <TYPE>FLOAT</TYPE>
                          <MIN-VALUE>0.001</MIN-VALUE>
                          <MAX-VALUE>65.535</MAX-VALUE>
                          <UUID>79d97c75-d135-4b8f-aa4d-36566adf12a4</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanMainFunctionWakeupPeriod</SHORT-NAME>
                          <DESC>This parameter describes the period for cyclic call to Can_MainFunction_Wakeup. Unit is seconds.</DESC>
                          <VALUE>0.001</VALUE>
                          <TYPE>FLOAT</TYPE>
                          <MIN-VALUE>0.001</MIN-VALUE>
                          <MAX-VALUE>65.535</MAX-VALUE>
                          <UUID>0cc37a6b-dd60-4623-a674-b92188206c55</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanMultiplexedTransmission</SHORT-NAME>
                          <DESC>Specifies if multiplexed transmission shall be supported.ON or OFF</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>b9133a83-1fac-4115-bf0f-304df6912f9b</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanNoAckErrSupport</SHORT-NAME>
                          <DESC>Selects support of Get ACK ERR Status features in Can driver.Only for Faw.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>7cd913ff-7b30-43b8-807e-4e4a693523e5</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanSetBaudrateApi</SHORT-NAME>
                          <DESC>The support of the Can_SetBaudrate API is optional.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>4eaacaea-14a1-4d29-a4ba-6a6155f50a54</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanPublicIcomSupport</SHORT-NAME>
                          <DESC>Selects support of Pretended Network features in Can driver.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>63ab1d67-2614-478b-937a-58b1bd0fbdf7</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanVersionInfoApi</SHORT-NAME>
                          <DESC>Switches the Can_GetVersionInfo() API ON or OFF.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>bb7d2720-3d06-4494-a29e-a0dcaf1b9b05</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanOSCounterSupport</SHORT-NAME>
                          <DESC>Selects support of OSCounter features in Can driver.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>ef7e7592-ab46-489a-8bfd-28707e1077cf</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTimeoutLoopTime</SHORT-NAME>
                          <DESC>Specifies the maximum loop time for blocking function until a timeout is detected. Unit is seconds.</DESC>
                          <VALUE>0.001</VALUE>
                          <TYPE>FLOAT</TYPE>
                          <MIN-VALUE>1e-06</MIN-VALUE>
                          <MAX-VALUE>65.535</MAX-VALUE>
                          <UUID>fa7fcea1-043b-4c1d-a654-b0131df2f9ac</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTimeoutDuration</SHORT-NAME>
                          <DESC>Specifies the maximum time for blocking function until a timeout is detected. Unit is seconds.</DESC>
                          <VALUE>1.0E-6</VALUE>
                          <TYPE>FLOAT</TYPE>
                          <MIN-VALUE>1e-06</MIN-VALUE>
                          <MAX-VALUE>65.535</MAX-VALUE>
                          <UUID>3c2f7522-92ae-4289-8782-d2a9e716e08f</UUID>
                        </PARAMETER>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
