                      </PARAMETERS>
                    </CONTAINER>
                    <CONTAINER>
                      <SHORT-NAME>CanHardwareObject</SHORT-NAME>
                      <DESC>This container contains the configurations (parameters) of CAN Hardware Objects.</DESC>
                      <UUID>47b3b770-8164-46fb-9691-0b46acecd3d9</UUID>
                      <PARAMETERS>
                        <PARAMETER>
                          <SHORT-NAME>CanFdPaddingValue</SHORT-NAME>
                          <DESC>Specifies the value which is used to pad unspecified data in CAN FD frames &gt; 8 bytes for transmission. This is necessary due to the discrete possible values of the DLC if &gt; 8 bytes.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>255</MAX-VALUE>
                          <UUID>b4468034-c75c-449c-bec8-4c30c05d33d5</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanHandleType</SHORT-NAME>
                          <DESC>Specifies the type (Full-CAN or Basic-CAN) of a hardware object.</DESC>
                          <VALUE>BASIC</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>3517ac78-6104-448d-9492-dda90826c4e7</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanHwObjectCount</SHORT-NAME>
                          <DESC>Number of hardware objects used to implement one HOH. In case of a HRH this parameter defines the number of elements in the hardware FIFO or the number of shadow buffers, in case of a HTH it defines the number of hardware objects used for multiplexed transmission or for a hardware FIFO used by a FullCAN HTH.</DESC>
                          <VALUE>1</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>1</MIN-VALUE>
                          <MAX-VALUE>64</MAX-VALUE>
                          <UUID>3926fa7b-3966-4233-a590-86b4fefc8bef</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanHwFIFOThreshold</SHORT-NAME>
                          <DESC>Number of the threshold size of Rx/TxEvent FIFO buffer to copy the data.</DESC>
                          <VALUE>1</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>1</MIN-VALUE>
                          <MAX-VALUE>64</MAX-VALUE>
                          <UUID>c7a069fe-5ddc-4e50-8ca6-744acf2b1ea2</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanIdType</SHORT-NAME>
                          <DESC>Specifies whether the IdValue is of type</DESC>
                          <VALUE>STANDARD</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>3a9cb520-d596-4159-a49a-12283e2e3727</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanObjectId</SHORT-NAME>
                          <DESC>Holds the handle ID of HRH or HTH. The value of this parameter is unique in a given CAN Driver, and it should start with 0 and continue without any gaps.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>65535</MAX-VALUE>
                          <UUID>2ad44f3b-7c83-4b63-9652-81fc9ef8d976</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanObjectType</SHORT-NAME>
                          <DESC>Specifies if the HardwareObject is used as Transmit or as Receive object</DESC>
                          <VALUE>RECEIVE</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>759258e0-1cb4-4e36-b006-b90a9b7db4ca</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTriggerTransmitEnable</SHORT-NAME>
                          <DESC>This parameter defines if or if not Can supports the trigger-transmit API for this handle.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>211672f2-2007-4622-ba46-85f7051200bd</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanHardwareObjectUsesPolling</SHORT-NAME>
                          <DESC>Enables polling of this hardware object.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>555ffd24-0526-479b-8f5d-9ad032c6ab48</UUID>
                        </PARAMETER>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
                        <CONTAINER>
                          <SHORT-NAME>CanHwFilter</SHORT-NAME>
                          <DESC>This container is only valid for HRHs and contains the configuration (parameters) of one hardware filter.</DESC>
                          <UUID>e9c20ac7-90c3-4384-8731-3da58321de9c</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanHwFilterCode</SHORT-NAME>
                              <DESC>Specifies (together with the filter mask) the identifiers range that passes the hardware filter.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>4294967295</MAX-VALUE>
                              <UUID>504b84c7-642a-4f57-9cf1-ad0c39e839dd</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanHwFilterMask</SHORT-NAME>
                              <DESC>Describes a mask for hardware-based filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with the appropriate CanFilterMaskValue. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position.</DESC>
                              <VALUE>2047</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>4294967295</MAX-VALUE>
                              <UUID>1f72975c-d2e1-42f9-9bad-41e41e957c48</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                        </CONTAINER>
                        <CONTAINER>
                          <SHORT-NAME>CanTTHardwareObjectTrigger</SHORT-NAME>
                          <DESC>CanTTHardwareObjectTrigger is specified in the SWS TTCAN and contains the configuration (parameters) of TTCAN triggers for Hardware Objects, which are additional to the configuration (parameters) of CAN Hardware Objects.</DESC>
                          <UUID>4885e458-320e-47ee-8133-959ac1fae2ba</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectBaseCycle</SHORT-NAME>
                              <DESC>Defines the cycle_offset.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>63</MAX-VALUE>
                              <UUID>94f51824-1dcc-43f7-9cbe-efcf086030f0</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectCycleRepetition</SHORT-NAME>
                              <DESC>Defines the repeat_factor.</DESC>
                              <VALUE>1</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>1</MIN-VALUE>
                              <MAX-VALUE>64</MAX-VALUE>
                              <UUID>92a19fe8-2108-4901-90bc-51d5119d379c</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectTimeMark</SHORT-NAME>
                              <DESC>Defines the point in time, when the trigger will be activated.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>65535</MAX-VALUE>
                              <UUID>de1b1007-7efd-4789-b890-ac658b3470c3</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectTriggerId</SHORT-NAME>
                              <DESC>Sequential number which allows separation of different TTCAN triggers configured for one and the same hardware object.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>63</MAX-VALUE>
                              <UUID>d5aa5d18-4f3d-4096-97e4-9a25401c1ef2</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectTriggerType</SHORT-NAME>
                              <DESC>Defines the type of the trigger associated with the hardware object. This parameter depends on plain CAN parameter CAN_OBJECT_TYPE.</DESC>
                              <VALUE>CAN_TT_RX_TRIGGER</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>7936b340-7dd8-4115-bd34-1a275b9d62ca</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                        </CONTAINER>
                      </SUB-CONTAINERS>
                    </CONTAINER>
                    <CONTAINER>
                      <SHORT-NAME>CanHwFilter</SHORT-NAME>
                      <DESC>This container is only valid for HRHs and contains the configuration (parameters) of one hardware filter.</DESC>
                      <UUID>59086400-e727-4dfd-aa92-92f2fdd98014</UUID>
                      <PARAMETERS>
                        <PARAMETER>
                          <SHORT-NAME>CanHwFilterCode</SHORT-NAME>
                          <DESC>Specifies (together with the filter mask) the identifiers range that passes the hardware filter.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>4294967295</MAX-VALUE>
                          <UUID>ad027779-9c59-44a3-8f65-aa51bff00fa3</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanHwFilterMask</SHORT-NAME>
                          <DESC>Describes a mask for hardware-based filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with the appropriate CanFilterMaskValue. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position.</DESC>
                          <VALUE>2047</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>4294967295</MAX-VALUE>
                          <UUID>af2fd990-cfba-464c-a4a8-f3955139e997</UUID>
                        </PARAMETER>
                      </PARAMETERS>
                    </CONTAINER>
                    <CONTAINER>
                      <SHORT-NAME>CanTTHardwareObjectTrigger</SHORT-NAME>
                      <DESC>CanTTHardwareObjectTrigger is specified in the SWS TTCAN and contains the configuration (parameters) of TTCAN triggers for Hardware Objects, which are additional to the configuration (parameters) of CAN Hardware Objects.</DESC>
                      <UUID>80331446-a875-402c-8daa-c93bf9bafe35</UUID>
                      <PARAMETERS>
                        <PARAMETER>
                          <SHORT-NAME>CanTTHardwareObjectBaseCycle</SHORT-NAME>
                          <DESC>Defines the cycle_offset.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>63</MAX-VALUE>
                          <UUID>55fd284c-2954-4949-98cc-75866fbc3055</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTHardwareObjectCycleRepetition</SHORT-NAME>
                          <DESC>Defines the repeat_factor.</DESC>
                          <VALUE>1</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>1</MIN-VALUE>
                          <MAX-VALUE>64</MAX-VALUE>
                          <UUID>7f174cb4-c085-4068-9ad6-1aba911b78c8</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTHardwareObjectTimeMark</SHORT-NAME>
                          <DESC>Defines the point in time, when the trigger will be activated.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>65535</MAX-VALUE>
                          <UUID>bdd5bbf0-f474-45ef-8806-0f4923d0b6e7</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTHardwareObjectTriggerId</SHORT-NAME>
                          <DESC>Sequential number which allows separation of different TTCAN triggers configured for one and the same hardware object.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>63</MAX-VALUE>
                          <UUID>6aa80b15-885c-479b-8b31-92964b58e329</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTHardwareObjectTriggerType</SHORT-NAME>
                          <DESC>Defines the type of the trigger associated with the hardware object. This parameter depends on plain CAN parameter CAN_OBJECT_TYPE.</DESC>
                          <VALUE>CAN_TT_RX_TRIGGER</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>af6b58ee-0691-46a2-8910-ff21a4ccc480</UUID>
                        </PARAMETER>
                      </PARAMETERS>
                    </CONTAINER>
                    <CONTAINER>
                      <SHORT-NAME>CanIcom</SHORT-NAME>
                      <DESC>This container contains the parameters for configuring pretended networking</DESC>
                      <UUID>3ecbafc0-ee0c-4290-9c00-668b9d53c0d9</UUID>
                      <PARAMETERS>
                        <PARAMETER>
                          <SHORT-NAME>CanIcomConfigId</SHORT-NAME>
                          <DESC>This parameter identifies the ID of the ICOM configuration.</DESC>
                          <VALUE>1</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>1</MIN-VALUE>
                          <MAX-VALUE>255</MAX-VALUE>
                          <UUID>5e875461-0440-4166-bd2e-cb496e250b94</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanIcomWakeOnBusOff</SHORT-NAME>
                          <DESC>This parameter defines that the MCU shall wake if the bus off is detected or not.</DESC>
                          <VALUE>true</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>9ef291b4-4395-4f2e-9579-9ff151fc6acc</UUID>
                        </PARAMETER>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
                        <CONTAINER>
                          <SHORT-NAME>CanIcomConfig</SHORT-NAME>
                          <DESC>This container contains the configuration parameters of the ICOM Configuration.</DESC>
                          <UUID>b5243f14-3ebc-4561-8ae2-c2ab3fe10922</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanIcomConfigId</SHORT-NAME>
                              <DESC>This parameter identifies the ID of the ICOM configuration.</DESC>
                              <VALUE>1</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>1</MIN-VALUE>
                              <MAX-VALUE>255</MAX-VALUE>
                              <UUID>34c2ff56-3a85-4051-b150-87c163298f2e</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanIcomWakeOnBusOff</SHORT-NAME>
                              <DESC>This parameter defines that the MCU shall wake if the bus off is detected or not.</DESC>
                              <VALUE>true</VALUE>
                              <TYPE>BOOLEAN</TYPE>
                              <UUID>9ec1df1d-3808-4ae9-a956-491175b67e64</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                          <SUB-CONTAINERS>
                            <CONTAINER>
                              <SHORT-NAME>CanIcomWakeupCauses</SHORT-NAME>
                              <DESC>This container contains the configuration parameters of the wakeup causes to leave the power saving mode.</DESC>
                              <UUID>2e1157d7-cfb8-4988-a488-feabfb20b5c9</UUID>
                              <PARAMETERS>
                                <PARAMETER>
                                  <SHORT-NAME>CanIcomCounterValue</SHORT-NAME>
                                  <DESC>This parameter defines that the MCU shall wake if the message with the ID is received n times on the communication channel.</DESC>
                                  <VALUE>1</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>1</MIN-VALUE>
                                  <MAX-VALUE>65536</MAX-VALUE>
                                  <UUID>c0c2edbd-7c80-4556-a141-c2794c39ebe0</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanIcomMessageId</SHORT-NAME>
                                  <DESC>This parameter defines the message ID the wakeup causes of this CanIcomRxMessage are configured for. In addition a mask (CanIcomMessageIdMask) can be defined, in that case it is possible to define a range of rx messages, which can create a wakeup condition.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>536870912</MAX-VALUE>
                                  <UUID>13bf2d13-ee84-466a-b63c-5a9b978e0f48</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanIcomMessageIdMask</SHORT-NAME>
                                  <DESC>Describes a mask for filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with this CanIcomMessageIdMask. If the masked identifier matches the masked value of CanIcomMessageId, it can create a wakeup condition for this CanIcomRxMessage. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position. The mask shall be build by filling with leading 0.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>536870912</MAX-VALUE>
                                  <UUID>b28483ab-4720-4f9c-a006-2bc6d7ffaf5e</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanIcomMissingMessageTimerValue</SHORT-NAME>
                                  <DESC>This parameter defines that the MCU shall wake if the message with the ID is not received for a specific time in s on the</DESC>
                                  <VALUE>0.0</VALUE>
                                  <TYPE>FLOAT</TYPE>
                                  <MIN-VALUE>0.0</MIN-VALUE>
                                  <MAX-VALUE>65535.0</MAX-VALUE>
                                  <UUID>3df39d8f-c816-4eb5-a625-8988fbb15c06</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanIcomPayloadLengthError</SHORT-NAME>
                                  <DESC>This parameter defines that the MCU shall wake if a payload error occurs</DESC>
                                  <VALUE>false</VALUE>
                                  <TYPE>BOOLEAN</TYPE>
