                          <MAX-VALUE>7</MAX-VALUE>
                          <UUID>6c7befe1-8dfc-470e-b0d2-bd8d5c77ab58</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerTxEnableWindowLength</SHORT-NAME>
                          <DESC>Length of the tx enable window given in CAN bit times.</DESC>
                          <VALUE>1</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>1</MIN-VALUE>
                          <MAX-VALUE>16</MAX-VALUE>
                          <UUID>254d371a-cc19-4cdc-bfa1-a1c9cd5783d5</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerWatchTriggerGapTimeMark</SHORT-NAME>
                          <DESC>watch trigger time mark after a gap</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>65535</MAX-VALUE>
                          <UUID>ed426863-fc9c-457a-a3bc-29525c8f6a82</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerWatchTriggerTimeMark</SHORT-NAME>
                          <DESC>watch trigger time mark</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>65535</MAX-VALUE>
                          <UUID>8512dfb4-54dd-4d24-8ac1-2906018382a2</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTIRQProcessing</SHORT-NAME>
                          <DESC>Enables / disables API Can_MainFunction_BusOff() for handling busoff events in polling mode.</DESC>
                          <VALUE>INTERRUPT</VALUE>
