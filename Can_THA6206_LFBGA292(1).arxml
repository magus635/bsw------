                        <PARAMETER>
                          <SHORT-NAME>ArReleaseMajorVersion</SHORT-NAME>
                          <DESC>&lt;html&gt;
                                                            Major version number of AUTOSAR specification on which the appropriate implementation is based on. &lt;p/&gt;
                                                       &lt;/html&gt;</DESC>
                          <VALUE>4</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>4</MIN-VALUE>
                          <MAX-VALUE>4</MAX-VALUE>
                          <UUID>c8fc70c2-e055-4a9d-86e1-c8ed428f9540</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>ArReleaseMinorVersion</SHORT-NAME>
                          <DESC>&lt;html&gt;
                                                            Minor version number of AUTOSAR specification on which the appropriate implementation is based on. &lt;p/&gt;
                                                       &lt;/html&gt;</DESC>
                          <VALUE>4</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>255</MAX-VALUE>
                          <UUID>f9c54e0d-ea09-4b4e-ab11-3a4987648013</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>ArReleaseRevisionVersion</SHORT-NAME>
                          <DESC>&lt;html&gt;
                                                            Revision version number of AUTOSAR specification on which the appropriate implementation is based on. &lt;p/&gt;
                                                       &lt;/html&gt;</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>255</MAX-VALUE>
                          <UUID>9ed553f5-4d1b-4c75-afab-0a639bfec2a2</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>ModuleId</SHORT-NAME>
                          <DESC>&lt;html&gt;
                                                            Module ID of this module from Module List.
                                                            Note: Implementation Specific Parameter
                                                       &lt;/html&gt;</DESC>
                          <VALUE>80</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>80</MIN-VALUE>
                          <MAX-VALUE>80</MAX-VALUE>
                          <UUID>2e56b86a-6e38-454a-8ff1-7587deb9373f</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>SwMajorVersion</SHORT-NAME>
                          <DESC>&lt;html&gt;
                                                            Major version number of the vendor specific implementation of the module. The numbering is vendor specific.
                                                            Note: Implementation Specific Parameter
                                                       &lt;/html&gt;</DESC>
                          <VALUE>1</VALUE>
