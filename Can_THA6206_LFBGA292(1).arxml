                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>c053d884-0434-484f-ad44-b05e5df082e6</UUID>
                        </PARAMETER>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
                        <CONTAINER>
                          <SHORT-NAME>CanControllerBaudrateConfig</SHORT-NAME>
                          <DESC>This container contains bit timing related configuration parameters of the CAN controller(s).</DESC>
