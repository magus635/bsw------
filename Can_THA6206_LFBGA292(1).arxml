                              <SHORT-NAME>CanTTControllerTimeMasterPriority</SHORT-NAME>
                              <DESC>Defines the time master priority.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>7</MAX-VALUE>
                              <UUID>fd1720fa-13e5-4a40-8270-58c70ac5c32e</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTControllerTxEnableWindowLength</SHORT-NAME>
                              <DESC>Length of the tx enable window given in CAN bit times.</DESC>
                              <VALUE>1</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>1</MIN-VALUE>
                              <MAX-VALUE>16</MAX-VALUE>
                              <UUID>078bfa53-5c42-4ebb-8571-6aa4ea1b64c7</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTControllerWatchTriggerGapTimeMark</SHORT-NAME>
                              <DESC>watch trigger time mark after a gap</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>65535</MAX-VALUE>
                              <UUID>96097765-4864-4e0f-9c1b-3fd1181734af</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTControllerWatchTriggerTimeMark</SHORT-NAME>
                              <DESC>watch trigger time mark</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>65535</MAX-VALUE>
                              <UUID>afac0684-69c8-47c3-9e89-56b6c8408a0d</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTIRQProcessing</SHORT-NAME>
                              <DESC>Enables / disables API Can_MainFunction_BusOff() for handling busoff events in polling mode.</DESC>
                              <VALUE>INTERRUPT</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>79e281fc-ac1c-422b-8be2-0e4c38cd71b6</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                        </CONTAINER>
                        <CONTAINER>
                          <SHORT-NAME>CanHardwareObject</SHORT-NAME>
                          <DESC>This container contains the configurations (parameters) of CAN Hardware Objects.</DESC>
                          <UUID>05495c50-a8ff-4f8e-9f57-48e7f7ec10c4</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanFdPaddingValue</SHORT-NAME>
                              <DESC>Specifies the value which is used to pad unspecified data in CAN FD frames &gt; 8 bytes for transmission. This is necessary due to the discrete possible values of the DLC if &gt; 8 bytes.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>255</MAX-VALUE>
                              <UUID>c2ff5445-c21f-4cb5-819b-318ae60bb0fc</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanHandleType</SHORT-NAME>
                              <DESC>Specifies the type (Full-CAN or Basic-CAN) of a hardware object.</DESC>
                              <VALUE>BASIC</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>98fc4054-cfbb-4def-abf0-47bafae0704b</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanHwObjectCount</SHORT-NAME>
                              <DESC>Number of hardware objects used to implement one HOH. In case of a HRH this parameter defines the number of elements in the hardware FIFO or the number of shadow buffers, in case of a HTH it defines the number of hardware objects used for multiplexed transmission or for a hardware FIFO used by a FullCAN HTH.</DESC>
                              <VALUE>1</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>1</MIN-VALUE>
                              <MAX-VALUE>64</MAX-VALUE>
                              <UUID>018a6282-bc97-4f6a-a067-4e8935b51d51</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanHwFIFOThreshold</SHORT-NAME>
                              <DESC>Number of the threshold size of Rx/TxEvent FIFO buffer to copy the data.</DESC>
                              <VALUE>1</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>1</MIN-VALUE>
                              <MAX-VALUE>64</MAX-VALUE>
                              <UUID>662a2946-f97c-4907-b703-1d52421094b9</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanIdType</SHORT-NAME>
                              <DESC>Specifies whether the IdValue is of type</DESC>
                              <VALUE>STANDARD</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>a58ae45f-e97d-4a48-a2b3-0db211995bed</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanObjectId</SHORT-NAME>
                              <DESC>Holds the handle ID of HRH or HTH. The value of this parameter is unique in a given CAN Driver, and it should start with 0 and continue without any gaps.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>65535</MAX-VALUE>
                              <UUID>698038a5-bbe9-41c7-89aa-f908fbc97afe</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanObjectType</SHORT-NAME>
                              <DESC>Specifies if the HardwareObject is used as Transmit or as Receive object</DESC>
                              <VALUE>RECEIVE</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>ac371cc9-1652-4f60-88eb-7f042dc56a67</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTriggerTransmitEnable</SHORT-NAME>
                              <DESC>This parameter defines if or if not Can supports the trigger-transmit API for this handle.</DESC>
                              <VALUE>false</VALUE>
                              <TYPE>BOOLEAN</TYPE>
                              <UUID>18f576d4-a3a5-48a6-9604-da5734dff1e1</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanHardwareObjectUsesPolling</SHORT-NAME>
                              <DESC>Enables polling of this hardware object.</DESC>
                              <VALUE>false</VALUE>
                              <TYPE>BOOLEAN</TYPE>
                              <UUID>fcd997f5-9eff-4e94-8bf4-1d7ecbd32c55</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                          <SUB-CONTAINERS>
                            <CONTAINER>
                              <SHORT-NAME>CanHwFilter</SHORT-NAME>
                              <DESC>This container is only valid for HRHs and contains the configuration (parameters) of one hardware filter.</DESC>
                              <UUID>8bc11b7a-b1f4-4fd1-8472-d90e42d3d726</UUID>
                              <PARAMETERS>
                                <PARAMETER>
                                  <SHORT-NAME>CanHwFilterCode</SHORT-NAME>
                                  <DESC>Specifies (together with the filter mask) the identifiers range that passes the hardware filter.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>4294967295</MAX-VALUE>
                                  <UUID>2d8832e2-32eb-4193-9331-1fc9dd236a62</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanHwFilterMask</SHORT-NAME>
                                  <DESC>Describes a mask for hardware-based filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with the appropriate CanFilterMaskValue. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position.</DESC>
                                  <VALUE>2047</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>4294967295</MAX-VALUE>
                                  <UUID>3b18e601-5f1e-4ce4-8cd4-5c88f307aacf</UUID>
                                </PARAMETER>
                              </PARAMETERS>
                            </CONTAINER>
                            <CONTAINER>
                              <SHORT-NAME>CanTTHardwareObjectTrigger</SHORT-NAME>
                              <DESC>CanTTHardwareObjectTrigger is specified in the SWS TTCAN and contains the configuration (parameters) of TTCAN triggers for Hardware Objects, which are additional to the configuration (parameters) of CAN Hardware Objects.</DESC>
                              <UUID>92a759c7-d29d-4727-9522-676f0424c45c</UUID>
                              <PARAMETERS>
                                <PARAMETER>
                                  <SHORT-NAME>CanTTHardwareObjectBaseCycle</SHORT-NAME>
                                  <DESC>Defines the cycle_offset.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>63</MAX-VALUE>
                                  <UUID>c1b60638-0e3d-40b7-8a98-5e23cf0ad07d</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanTTHardwareObjectCycleRepetition</SHORT-NAME>
                                  <DESC>Defines the repeat_factor.</DESC>
                                  <VALUE>1</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>1</MIN-VALUE>
                                  <MAX-VALUE>64</MAX-VALUE>
                                  <UUID>ac617ca2-d2a3-4a4d-8414-663f16c67858</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanTTHardwareObjectTimeMark</SHORT-NAME>
                                  <DESC>Defines the point in time, when the trigger will be activated.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>65535</MAX-VALUE>
                                  <UUID>64fa364e-85ea-4c2e-af29-56ffafd7979f</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanTTHardwareObjectTriggerId</SHORT-NAME>
                                  <DESC>Sequential number which allows separation of different TTCAN triggers configured for one and the same hardware object.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>63</MAX-VALUE>
                                  <UUID>b343f86c-4d72-4125-9668-2005f5489e2e</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanTTHardwareObjectTriggerType</SHORT-NAME>
                                  <DESC>Defines the type of the trigger associated with the hardware object. This parameter depends on plain CAN parameter CAN_OBJECT_TYPE.</DESC>
                                  <VALUE>CAN_TT_RX_TRIGGER</VALUE>
                                  <TYPE>ENUM</TYPE>
                                  <UUID>bb995167-901e-4669-891e-5eea876a30e7</UUID>
                                </PARAMETER>
                              </PARAMETERS>
                            </CONTAINER>
                          </SUB-CONTAINERS>
                        </CONTAINER>
                        <CONTAINER>
                          <SHORT-NAME>CanHwFilter</SHORT-NAME>
                          <DESC>This container is only valid for HRHs and contains the configuration (parameters) of one hardware filter.</DESC>
                          <UUID>eed8f628-801c-4730-81a1-ba1052b9832a</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanHwFilterCode</SHORT-NAME>
                              <DESC>Specifies (together with the filter mask) the identifiers range that passes the hardware filter.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>4294967295</MAX-VALUE>
                              <UUID>abfffc69-68fd-41dc-a104-e435ef0a2cb1</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanHwFilterMask</SHORT-NAME>
                              <DESC>Describes a mask for hardware-based filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with the appropriate CanFilterMaskValue. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position.</DESC>
                              <VALUE>2047</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>4294967295</MAX-VALUE>
                              <UUID>59cef1ea-e2bf-483c-b907-04a8a668bd42</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                        </CONTAINER>
                        <CONTAINER>
                          <SHORT-NAME>CanTTHardwareObjectTrigger</SHORT-NAME>
                          <DESC>CanTTHardwareObjectTrigger is specified in the SWS TTCAN and contains the configuration (parameters) of TTCAN triggers for Hardware Objects, which are additional to the configuration (parameters) of CAN Hardware Objects.</DESC>
                          <UUID>a82e3801-9e63-4c3a-98e7-538811ede1cc</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectBaseCycle</SHORT-NAME>
                              <DESC>Defines the cycle_offset.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>63</MAX-VALUE>
                              <UUID>9355e31d-97df-4216-b7b7-db584c386ab5</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectCycleRepetition</SHORT-NAME>
                              <DESC>Defines the repeat_factor.</DESC>
                              <VALUE>1</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>1</MIN-VALUE>
                              <MAX-VALUE>64</MAX-VALUE>
                              <UUID>693fa1cf-4b8d-4b16-8eba-316f6a661f81</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectTimeMark</SHORT-NAME>
                              <DESC>Defines the point in time, when the trigger will be activated.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>65535</MAX-VALUE>
                              <UUID>e0679529-85c3-4556-aebc-98d453ec44f8</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectTriggerId</SHORT-NAME>
                              <DESC>Sequential number which allows separation of different TTCAN triggers configured for one and the same hardware object.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>63</MAX-VALUE>
                              <UUID>6c1240cb-b07f-4fcf-a5ca-961bbcdc7791</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTTHardwareObjectTriggerType</SHORT-NAME>
                              <DESC>Defines the type of the trigger associated with the hardware object. This parameter depends on plain CAN parameter CAN_OBJECT_TYPE.</DESC>
                              <VALUE>CAN_TT_RX_TRIGGER</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>15174bfd-42fa-4768-9cfe-21373d93986f</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                        </CONTAINER>
                        <CONTAINER>
                          <SHORT-NAME>CanIcom</SHORT-NAME>
                          <DESC>This container contains the parameters for configuring pretended networking</DESC>
                          <UUID>cd83f642-27f2-46c8-9ee4-a18f60dbe659</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanIcomConfigId</SHORT-NAME>
                              <DESC>This parameter identifies the ID of the ICOM configuration.</DESC>
                              <VALUE>1</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>1</MIN-VALUE>
                              <MAX-VALUE>255</MAX-VALUE>
                              <UUID>369e8ee8-9b17-48e0-a4bb-f64881b1468d</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanIcomWakeOnBusOff</SHORT-NAME>
                              <DESC>This parameter defines that the MCU shall wake if the bus off is detected or not.</DESC>
                              <VALUE>true</VALUE>
                              <TYPE>BOOLEAN</TYPE>
                              <UUID>762589a4-c64c-4beb-9579-d882091511cc</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                          <SUB-CONTAINERS>
                            <CONTAINER>
                              <SHORT-NAME>CanIcomConfig</SHORT-NAME>
                              <DESC>This container contains the configuration parameters of the ICOM Configuration.</DESC>
                              <UUID>68aa8125-72f7-4644-af35-98d860b279ef</UUID>
                              <PARAMETERS>
                                <PARAMETER>
                                  <SHORT-NAME>CanIcomConfigId</SHORT-NAME>
                                  <DESC>This parameter identifies the ID of the ICOM configuration.</DESC>
                                  <VALUE>1</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>1</MIN-VALUE>
                                  <MAX-VALUE>255</MAX-VALUE>
                                  <UUID>d662b171-1c5b-4ca5-8310-4f63ae2efb9e</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanIcomWakeOnBusOff</SHORT-NAME>
                                  <DESC>This parameter defines that the MCU shall wake if the bus off is detected or not.</DESC>
                                  <VALUE>true</VALUE>
                                  <TYPE>BOOLEAN</TYPE>
                                  <UUID>4195bc60-ff39-436c-a47c-19172a2661f4</UUID>
                                </PARAMETER>
                              </PARAMETERS>
                              <SUB-CONTAINERS>
                                <CONTAINER>
                                  <SHORT-NAME>CanIcomWakeupCauses</SHORT-NAME>
                                  <DESC>This container contains the configuration parameters of the wakeup causes to leave the power saving mode.</DESC>
                                  <UUID>c2483615-13f6-43ee-a894-f2d43eaf37b0</UUID>
                                  <PARAMETERS>
                                    <PARAMETER>
                                      <SHORT-NAME>CanIcomCounterValue</SHORT-NAME>
                                      <DESC>This parameter defines that the MCU shall wake if the message with the ID is received n times on the communication channel.</DESC>
                                      <VALUE>1</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>1</MIN-VALUE>
                                      <MAX-VALUE>65536</MAX-VALUE>
                                      <UUID>45e6276e-6d3a-450b-a105-5168a7d79186</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanIcomMessageId</SHORT-NAME>
                                      <DESC>This parameter defines the message ID the wakeup causes of this CanIcomRxMessage are configured for. In addition a mask (CanIcomMessageIdMask) can be defined, in that case it is possible to define a range of rx messages, which can create a wakeup condition.</DESC>
                                      <VALUE>0</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>536870912</MAX-VALUE>
                                      <UUID>2b6e97dc-0ac9-4571-aa3b-fbc2a004d65c</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanIcomMessageIdMask</SHORT-NAME>
                                      <DESC>Describes a mask for filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with this CanIcomMessageIdMask. If the masked identifier matches the masked value of CanIcomMessageId, it can create a wakeup condition for this CanIcomRxMessage. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position. The mask shall be build by filling with leading 0.</DESC>
                                      <VALUE>0</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>536870912</MAX-VALUE>
                                      <UUID>2dda118a-9b87-4631-8bfe-e702762b76f7</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanIcomMissingMessageTimerValue</SHORT-NAME>
                                      <DESC>This parameter defines that the MCU shall wake if the message with the ID is not received for a specific time in s on the</DESC>
                                      <VALUE>0.0</VALUE>
                                      <TYPE>FLOAT</TYPE>
                                      <MIN-VALUE>0.0</MIN-VALUE>
                                      <MAX-VALUE>65535.0</MAX-VALUE>
                                      <UUID>b9dc9981-85e6-4a0f-8ecd-3a88be5a3464</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanIcomPayloadLengthError</SHORT-NAME>
                                      <DESC>This parameter defines that the MCU shall wake if a payload error occurs</DESC>
                                      <VALUE>false</VALUE>
                                      <TYPE>BOOLEAN</TYPE>
                                      <UUID>d1a7882e-7f50-4bca-946c-c7ab557d3d10</UUID>
                                    </PARAMETER>
                                  </PARAMETERS>
                                  <SUB-CONTAINERS>
                                    <CONTAINER>
                                      <SHORT-NAME>CanIcomRxMessage</SHORT-NAME>
                                      <DESC>This container contains the configuration parameters for the wakeup causes for matching received messages. It has to be configured as often as received messages are defined as wakeup cause.</DESC>
                                      <UUID>cb3e0e01-82fa-43ab-9bb3-5557b553c6ec</UUID>
                                      <PARAMETERS>
                                        <PARAMETER>
                                          <SHORT-NAME>CanIcomCounterValue</SHORT-NAME>
                                          <DESC>This parameter defines that the MCU shall wake if the message with the ID is received n times on the communication channel.</DESC>
                                          <VALUE>1</VALUE>
                                          <TYPE>INTEGER</TYPE>
                                          <MIN-VALUE>1</MIN-VALUE>
                                          <MAX-VALUE>65536</MAX-VALUE>
                                          <UUID>072afdee-0c31-4e38-95dc-f392149f4fe4</UUID>
                                        </PARAMETER>
                                        <PARAMETER>
                                          <SHORT-NAME>CanIcomMessageId</SHORT-NAME>
                                          <DESC>This parameter defines the message ID the wakeup causes of this CanIcomRxMessage are configured for. In addition a mask (CanIcomMessageIdMask) can be defined, in that case it is possible to define a range of rx messages, which can create a wakeup condition.</DESC>
                                          <VALUE>0</VALUE>
                                          <TYPE>INTEGER</TYPE>
                                          <MIN-VALUE>0</MIN-VALUE>
                                          <MAX-VALUE>536870912</MAX-VALUE>
                                          <UUID>6cebac56-1b62-46c6-917b-c2fcca387134</UUID>
                                        </PARAMETER>
                                        <PARAMETER>
                                          <SHORT-NAME>CanIcomMessageIdMask</SHORT-NAME>
                                          <DESC>Describes a mask for filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with this CanIcomMessageIdMask. If the masked identifier matches the masked value of CanIcomMessageId, it can create a wakeup condition for this CanIcomRxMessage. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position. The mask shall be build by filling with leading 0.</DESC>
                                          <VALUE>0</VALUE>
                                          <TYPE>INTEGER</TYPE>
                                          <MIN-VALUE>0</MIN-VALUE>
                                          <MAX-VALUE>536870912</MAX-VALUE>
                                          <UUID>09ac65a1-0397-4b98-aa4d-2a669be1cc24</UUID>
                                        </PARAMETER>
                                        <PARAMETER>
                                          <SHORT-NAME>CanIcomMissingMessageTimerValue</SHORT-NAME>
                                          <DESC>This parameter defines that the MCU shall wake if the message with the ID is not received for a specific time in s on the</DESC>
                                          <VALUE>0.0</VALUE>
                                          <TYPE>FLOAT</TYPE>
                                          <MIN-VALUE>0.0</MIN-VALUE>
                                          <MAX-VALUE>65535.0</MAX-VALUE>
                                          <UUID>93085f37-b23f-41bd-8315-8c7e0f29a80e</UUID>
                                        </PARAMETER>
                                        <PARAMETER>
                                          <SHORT-NAME>CanIcomPayloadLengthError</SHORT-NAME>
                                          <DESC>This parameter defines that the MCU shall wake if a payload error occurs</DESC>
                                          <VALUE>false</VALUE>
                                          <TYPE>BOOLEAN</TYPE>
                                          <UUID>82b88018-aa2e-4f2f-be25-b593235d2719</UUID>
                                        </PARAMETER>
                                      </PARAMETERS>
                                      <SUB-CONTAINERS>
                                        <CONTAINER>
                                          <SHORT-NAME>CanIcomRxMessageSignalConfig</SHORT-NAME>
                                          <DESC>This container contains the configuration parameters for the wakeup causes for matching signals.</DESC>
                                          <UUID>0dc98b11-94ea-4677-b297-344ac5aa4298</UUID>
                                          <PARAMETERS>
                                            <PARAMETER>
                                              <SHORT-NAME>CanIcomSignalMask</SHORT-NAME>
                                              <DESC>This parameter shall be used to mask a signal in the payload of a CAN message.</DESC>
                                              <VALUE>0</VALUE>
                                              <TYPE>INTEGER</TYPE>
                                              <MIN-VALUE>0</MIN-VALUE>
                                              <MAX-VALUE>9223372036854775807</MAX-VALUE>
                                              <UUID>f3b0e431-2bff-4a07-a658-6fe0b9505e31</UUID>
                                            </PARAMETER>
                                            <PARAMETER>
                                              <SHORT-NAME>CanIcomSignalOperation</SHORT-NAME>
                                              <DESC>This parameter defines the operation, which shall be used to verify the signal value creates a wakeup condition.</DESC>
                                              <VALUE>AND</VALUE>
                                              <TYPE>ENUM</TYPE>
                                              <UUID>6bb41071-2b93-4ad0-9e7c-a4a05fb72c26</UUID>
                                            </PARAMETER>
                                            <PARAMETER>
                                              <SHORT-NAME>CanIcomSignalValue</SHORT-NAME>
                                              <DESC>This parameter shall be used to define a signal value which shall be compared (CanIcomSignalOperation) with the masked CanIcomSignalMask value of the received signal (CanIcomSignalRef).</DESC>
                                              <VALUE>0</VALUE>
