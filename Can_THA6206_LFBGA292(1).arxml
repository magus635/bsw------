                                  <UUID>dd9cfab8-9a57-41a6-9f3e-80566523cda5</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanFDBytePayload</SHORT-NAME>
                                  <DESC>Data Length Code:&lt;br/&gt;                                                                            CAN and CAN FD: transmit frame has 0-8 data bytes.&lt;br/&gt;                                                                            CAN FD: transmit frame has 12/16/20/24/32/48/64 data bytes.</DESC>
                                  <VALUE>64</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>64</MAX-VALUE>
                                  <UUID>616269aa-f8f0-4f96-a165-5baa20bf7ab3</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerTxBitRateSwitch</SHORT-NAME>
                                  <DESC>Specifies if the bit rate switching shall be used for transmissions.</DESC>
                                  <VALUE>true</VALUE>
