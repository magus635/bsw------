                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>63</MAX-VALUE>
                          <UUID>764d2a93-4c87-43ec-808c-a59228780036</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerExpectedTxTrigger</SHORT-NAME>
                          <DESC>Number of expected_tx_trigger.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>255</MAX-VALUE>
                          <UUID>703a1739-547b-4f2f-8de0-b64d949e692a</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerExternalClockSynchronisation</SHORT-NAME>
                          <DESC>Enables/disables the external clock synchronization.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>37eb89a5-2510-4721-ac3e-4923f088a3e0</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerGlobalTimeFiltering</SHORT-NAME>
