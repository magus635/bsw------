                                  <PARAMETERS>
                                    <PARAMETER>
                                      <SHORT-NAME>CanIcomSignalMask</SHORT-NAME>
                                      <DESC>This parameter shall be used to mask a signal in the payload of a CAN message.</DESC>
                                      <VALUE>0</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>9223372036854775807</MAX-VALUE>
                                      <UUID>80aac1f8-a7ca-45a7-bae4-29cb10730375</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanIcomSignalOperation</SHORT-NAME>
                                      <DESC>This parameter defines the operation, which shall be used to verify the signal value creates a wakeup condition.</DESC>
                                      <VALUE>AND</VALUE>
                                      <TYPE>ENUM</TYPE>
                                      <UUID>cbfb0d15-ce19-4312-a96d-ae3988700060</UUID>
                                    </PARAMETER>
