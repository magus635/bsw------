                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerBaudRateConfigID</SHORT-NAME>
                              <DESC>Uniquely identifies a specific baud rate configuration. This ID is used by SetBaudrate API.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>65535</MAX-VALUE>
                              <UUID>89ddce26-ed80-41fc-83e2-8ad68158dbb6</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerBaudRate</SHORT-NAME>
                              <DESC>Specifies the baudrate of the controller in kbps.</DESC>
                              <VALUE>0.0</VALUE>
                              <TYPE>FLOAT</TYPE>
                              <MIN-VALUE>0.0</MIN-VALUE>
                              <MAX-VALUE>1000.0</MAX-VALUE>
                              <UUID>587a4565-0b08-404f-9bdd-7f7cdfd0c9e8</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerPRESDIV</SHORT-NAME>
                              <DESC>Specifies the Prescaler Division Factor.Defines the ratio between the module clock frequency and the serial clock frequency.</DESC>
                              <VALUE>2</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>511</MAX-VALUE>
                              <UUID>3270f931-5e85-4047-b776-9cdb1c945926</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerPropSeg</SHORT-NAME>
                              <DESC>Specifies propagation delay in time quantas.</DESC>
                              <VALUE>7</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>255</MAX-VALUE>
                              <UUID>9d4e290d-bee6-4e70-829b-b1879aba0f6b</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerSeg1</SHORT-NAME>
                              <DESC>Specifies phase segment 1 in time quantas.</DESC>
                              <VALUE>7</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>255</MAX-VALUE>
                              <UUID>07a9d3c8-4554-40aa-a6d8-e7cb018596a9</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerSeg2</SHORT-NAME>
                              <DESC>Specifies phase segment 2 in time quantas.</DESC>
                              <VALUE>2</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>127</MAX-VALUE>
                              <UUID>b1a65e94-4e25-4267-a17b-ceb7e7edd703</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerSyncJumpWidth</SHORT-NAME>
                              <DESC>Specifies the synchronization jump width for the controller in time quantas.</DESC>
                              <VALUE>1</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>127</MAX-VALUE>
                              <UUID>65edcdd1-1a07-4bf8-8ce5-dfe7e7ae5993</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                          <SUB-CONTAINERS>
                            <CONTAINER>
                              <SHORT-NAME>CanControllerFdBaudrateConfig</SHORT-NAME>
                              <DESC>This optional container contains bit timing related configuration parameters of the CAN controller(s) for payload and CRC of a CAN FD frame. If this container exists the controller supports CAN FD frames.</DESC>
                              <UUID>7c35433c-898b-45dd-b5b7-7ef99b28809e</UUID>
                              <PARAMETERS>
                                <PARAMETER>
