                        <CONTAINER>
                          <SHORT-NAME>CanIcomConfig</SHORT-NAME>
                          <DESC>This container contains the configuration parameters of the ICOM Configuration.</DESC>
                          <UUID>265604a5-cc92-435b-a766-84a16476d699</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanIcomConfigId</SHORT-NAME>
                              <DESC>This parameter identifies the ID of the ICOM configuration.</DESC>
                              <VALUE>1</VALUE>
