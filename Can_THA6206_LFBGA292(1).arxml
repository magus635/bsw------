                                  <DESC>This parameter defines that the MCU shall wake if a payload error occurs</DESC>
                                  <VALUE>false</VALUE>
                                  <TYPE>BOOLEAN</TYPE>
                                  <UUID>d4fb03ad-a185-48f5-ad11-cfd457e84c1a</UUID>
                                </PARAMETER>
                              </PARAMETERS>
                              <SUB-CONTAINERS>
                                <CONTAINER>
                                  <SHORT-NAME>CanIcomRxMessageSignalConfig</SHORT-NAME>
