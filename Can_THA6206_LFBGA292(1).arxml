                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>3a4528b9-2267-45c4-88d8-661109f409a6</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanWakeupSupport</SHORT-NAME>
