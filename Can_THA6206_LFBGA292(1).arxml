                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>127</MAX-VALUE>
                          <UUID>346933fb-1252-4fe2-9a7c-7c4fabf38bd1</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerInterruptEnable</SHORT-NAME>
                          <DESC>Enables/disables the respective interrupts.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>1023</MAX-VALUE>
                          <UUID>4964c8c8-1ca1-443b-ad76-79939b8dde8a</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerLevel2</SHORT-NAME>
                          <DESC>Defines whether Level 2 or Level 1 is used.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>d50013b2-d0f4-43c6-a089-9fde08638d58</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerNTUConfig</SHORT-NAME>
                          <DESC>Defines the config value for NTU (network time unit).</DESC>
                          <VALUE>0.0</VALUE>
                          <TYPE>FLOAT</TYPE>
                          <MIN-VALUE>0.0</MIN-VALUE>
                          <MAX-VALUE>100.0</MAX-VALUE>
                          <UUID>ebacbfbf-d0aa-4eb0-bf66-4dab6ddf1a41</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerOperationMode</SHORT-NAME>
                          <DESC>Defines the operation mode.</DESC>
                          <VALUE>CAN_TT_EVENT_SYNC_TIME_TRIGGERED</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>44ccf1d9-12b4-44ff-92f4-9edac32c3755</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerSyncDeviation</SHORT-NAME>
                          <DESC>Defines the maximum synchronization deviation:</DESC>
                          <VALUE>0.0</VALUE>
                          <TYPE>FLOAT</TYPE>
                          <MIN-VALUE>0.0</MIN-VALUE>
                          <MAX-VALUE>100.0</MAX-VALUE>
                          <UUID>f0475591-3cc9-4730-bc1f-f2feead22c76</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerTURRestore</SHORT-NAME>
                          <DESC>Enables/disables the TUR restore.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>49a9bf59-eb5b-45a6-a429-3a09237fb696</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTTControllerTimeMaster</SHORT-NAME>
                          <DESC>Defines whether the controller acts as a potential time master.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>35caec33-8b5a-4aa2-bb5c-1e615b62d368</UUID>
                        </PARAMETER>
                        <PARAMETER>
