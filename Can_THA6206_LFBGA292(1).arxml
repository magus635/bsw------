<?xml version='1.0' encoding='UTF-8'?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-4-0.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Configuration</SHORT-NAME>
      <ELEMENTS>
        <CONTAINER>
          <SHORT-NAME>AUTOSAR</SHORT-NAME>
          <UUID>adbe47b7-8beb-413d-86e4-c237b8e45938</UUID>
          <SUB-CONTAINERS>
            <CONTAINER>
              <SHORT-NAME>THA6_AS440_FuSa</SHORT-NAME>
              <UUID>03aaeb7e-a92d-421f-9e03-dc3c6b7a87b7</UUID>
              <SUB-CONTAINERS>
                <CONTAINER>
                  <SHORT-NAME>Can</SHORT-NAME>
                  <DESC>This container holds the configuration of a single CAN Driver.</DESC>
                  <UUID>42a0fa76-ea29-47d7-8bdf-517a214b4fa1</UUID>
                  <SUB-CONTAINERS>
                    <CONTAINER>
                      <SHORT-NAME>CanConfigSet</SHORT-NAME>
                      <DESC>This container contains the configuration parameters and sub containers of the AUTOSAR Can module.</DESC>
                      <UUID>534b6a93-2780-415f-918a-9d5e75f16dc1</UUID>
                      <PARAMETERS>
                        <PARAMETER>
                          <SHORT-NAME>CanControllerActivation</SHORT-NAME>
                          <DESC>Defines if a CAN controller is used in the configuration.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>0ac634ed-c37f-427c-8433-9a5b4e8d6094</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanControllerBaseAddress</SHORT-NAME>
                          <DESC>Specifies the CAN controller base address.</DESC>
                          <VALUE>0</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>4294967295</MAX-VALUE>
                          <UUID>8fe41244-4781-4ab2-ab97-22591f1171f1</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanHardwareChannel</SHORT-NAME>
                          <DESC>This parameter provides the Real Hardware controller ID which is unique in the CAN Driver</DESC>
                          <VALUE>CAN_CONTROLLER_00</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>04f808a6-15f4-4ea6-8c96-e683ff0a896d</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanControllerId</SHORT-NAME>
                          <DESC>This parameter provides the controller ID which is unique in a given CAN Driver. The value for this parameter starts with 0 and continue without any gaps.</DESC>
                          <VALUE>1</VALUE>
                          <TYPE>INTEGER</TYPE>
                          <MIN-VALUE>0</MIN-VALUE>
                          <MAX-VALUE>255</MAX-VALUE>
                          <UUID>aeb66391-50f5-462b-bfe0-08110c15bebc</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanRxProcessing</SHORT-NAME>
                          <DESC>Enables / disables API Can_MainFunction_Read() for handling PDU reception events in polling mode.</DESC>
                          <VALUE>POLLING</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>d8ecb590-ef9c-4649-ad18-78f9674d5867</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanTxProcessing</SHORT-NAME>
                          <DESC>Enables / disables API Can_MainFunction_Write() for handling PDU transmission events in polling mode.</DESC>
                          <VALUE>POLLING</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>891b276c-ddcf-4628-96e1-ca2199302ba8</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanBusoffProcessing</SHORT-NAME>
                          <DESC>Enables / disables API Can_MainFunction_BusOff() for handling busoff events in polling mode.</DESC>
                          <VALUE>POLLING</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>21ab64ac-fb8b-4fcd-ad8f-47090a4cc61f</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanWakeupProcessing</SHORT-NAME>
                          <DESC>Enables / disables API Can_MainFunction_Wakeup() for handling wakeup events in polling mode.</DESC>
                          <VALUE>POLLING</VALUE>
                          <TYPE>ENUM</TYPE>
                          <UUID>71a190da-cdcf-47f4-ace9-97514703ec04</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanWakeupFunctionalityAPI</SHORT-NAME>
                          <DESC>Adds / removes the service Can_CheckWakeup() from the code.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>a2fa6a09-d053-4c7d-839a-df8221c354fa</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanFDSupport</SHORT-NAME>
                          <DESC>Selects support of CanFD features in Can driver.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>ce771f09-5ee5-462d-abbf-33d980a4c198</UUID>
                        </PARAMETER>
                        <PARAMETER>
                          <SHORT-NAME>CanWakeupSupport</SHORT-NAME>
                          <DESC>CAN driver support for wakeup over CAN Bus.</DESC>
                          <VALUE>false</VALUE>
                          <TYPE>BOOLEAN</TYPE>
                          <UUID>4fbc957b-100c-4d46-a820-b7ccee656a8e</UUID>
                        </PARAMETER>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
                        <CONTAINER>
                          <SHORT-NAME>CanController</SHORT-NAME>
                          <DESC>This container contains the configuration parameters of the CAN controller(s).</DESC>
                          <UUID>9be929d0-b297-4ef4-aebf-6f84c09c6700</UUID>
                          <PARAMETERS>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerActivation</SHORT-NAME>
                              <DESC>Defines if a CAN controller is used in the configuration.</DESC>
                              <VALUE>false</VALUE>
                              <TYPE>BOOLEAN</TYPE>
                              <UUID>6f02eebf-9858-4c83-89df-c26d5aa3aece</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerBaseAddress</SHORT-NAME>
                              <DESC>Specifies the CAN controller base address.</DESC>
                              <VALUE>0</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>4294967295</MAX-VALUE>
                              <UUID>0803784f-f65d-4760-ae59-3e6cd12302f0</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanHardwareChannel</SHORT-NAME>
                              <DESC>This parameter provides the Real Hardware controller ID which is unique in the CAN Driver</DESC>
                              <VALUE>CAN_CONTROLLER_00</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>55b30030-a574-49fc-98cd-abfab47f9ee6</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanControllerId</SHORT-NAME>
                              <DESC>This parameter provides the controller ID which is unique in a given CAN Driver. The value for this parameter starts with 0 and continue without any gaps.</DESC>
                              <VALUE>1</VALUE>
                              <TYPE>INTEGER</TYPE>
                              <MIN-VALUE>0</MIN-VALUE>
                              <MAX-VALUE>255</MAX-VALUE>
                              <UUID>46de9ade-e631-4d22-9f47-8248a300ccec</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanRxProcessing</SHORT-NAME>
                              <DESC>Enables / disables API Can_MainFunction_Read() for handling PDU reception events in polling mode.</DESC>
                              <VALUE>POLLING</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>e0ba7dea-953d-4010-8418-384ea13f7ad0</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanTxProcessing</SHORT-NAME>
                              <DESC>Enables / disables API Can_MainFunction_Write() for handling PDU transmission events in polling mode.</DESC>
                              <VALUE>POLLING</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>6179e9f2-2663-44d7-8530-73173866508a</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanBusoffProcessing</SHORT-NAME>
                              <DESC>Enables / disables API Can_MainFunction_BusOff() for handling busoff events in polling mode.</DESC>
                              <VALUE>POLLING</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>0135e42d-b16c-48be-a4b5-59ed00e49b57</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanWakeupProcessing</SHORT-NAME>
                              <DESC>Enables / disables API Can_MainFunction_Wakeup() for handling wakeup events in polling mode.</DESC>
                              <VALUE>POLLING</VALUE>
                              <TYPE>ENUM</TYPE>
                              <UUID>f7814e59-7655-4aaf-93b0-67ae8cdc68ea</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanWakeupFunctionalityAPI</SHORT-NAME>
                              <DESC>Adds / removes the service Can_CheckWakeup() from the code.</DESC>
                              <VALUE>false</VALUE>
                              <TYPE>BOOLEAN</TYPE>
                              <UUID>5b175f0d-1d5e-48d7-aacd-1e1606b25cb0</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanFDSupport</SHORT-NAME>
                              <DESC>Selects support of CanFD features in Can driver.</DESC>
                              <VALUE>false</VALUE>
                              <TYPE>BOOLEAN</TYPE>
                              <UUID>6f4366ee-e054-4255-9979-116c34da83ba</UUID>
                            </PARAMETER>
                            <PARAMETER>
                              <SHORT-NAME>CanWakeupSupport</SHORT-NAME>
                              <DESC>CAN driver support for wakeup over CAN Bus.</DESC>
                              <VALUE>false</VALUE>
                              <TYPE>BOOLEAN</TYPE>
                              <UUID>2f1b33d3-9084-4b4e-8746-be00ae241dfb</UUID>
                            </PARAMETER>
                          </PARAMETERS>
                          <SUB-CONTAINERS>
                            <CONTAINER>
                              <SHORT-NAME>CanControllerBaudrateConfig</SHORT-NAME>
                              <DESC>This container contains bit timing related configuration parameters of the CAN controller(s).</DESC>
                              <UUID>8ed84d5c-905a-4056-a504-ff1676edd8cf</UUID>
                              <PARAMETERS>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerBaudRateConfigID</SHORT-NAME>
                                  <DESC>Uniquely identifies a specific baud rate configuration. This ID is used by SetBaudrate API.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>65535</MAX-VALUE>
                                  <UUID>a1bf5db5-f875-4965-b17a-4e66a3bf9f86</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerBaudRate</SHORT-NAME>
                                  <DESC>Specifies the baudrate of the controller in kbps.</DESC>
                                  <VALUE>0.0</VALUE>
                                  <TYPE>FLOAT</TYPE>
                                  <MIN-VALUE>0.0</MIN-VALUE>
                                  <MAX-VALUE>1000.0</MAX-VALUE>
                                  <UUID>968fa8ca-b448-44ea-a9fb-0e7fee625732</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerPRESDIV</SHORT-NAME>
                                  <DESC>Specifies the Prescaler Division Factor.Defines the ratio between the module clock frequency and the serial clock frequency.</DESC>
                                  <VALUE>2</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>511</MAX-VALUE>
                                  <UUID>081dedb4-65ac-4a65-8d0e-0c9f909ebe56</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerPropSeg</SHORT-NAME>
                                  <DESC>Specifies propagation delay in time quantas.</DESC>
                                  <VALUE>7</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>255</MAX-VALUE>
                                  <UUID>628cc1b1-6fcb-4441-b551-f87c6cb34eb6</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSeg1</SHORT-NAME>
                                  <DESC>Specifies phase segment 1 in time quantas.</DESC>
                                  <VALUE>7</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>255</MAX-VALUE>
                                  <UUID>035e76ef-a58c-473d-8584-9c7673ec97a4</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSeg2</SHORT-NAME>
                                  <DESC>Specifies phase segment 2 in time quantas.</DESC>
                                  <VALUE>2</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>127</MAX-VALUE>
                                  <UUID>ce08e8dd-ff32-48a7-b8db-ac08de6b75ad</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSyncJumpWidth</SHORT-NAME>
                                  <DESC>Specifies the synchronization jump width for the controller in time quantas.</DESC>
                                  <VALUE>1</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>127</MAX-VALUE>
                                  <UUID>29aea631-9c9d-4caf-bd76-010a4d16602f</UUID>
                                </PARAMETER>
                              </PARAMETERS>
                              <SUB-CONTAINERS>
                                <CONTAINER>
                                  <SHORT-NAME>CanControllerFdBaudrateConfig</SHORT-NAME>
                                  <DESC>This optional container contains bit timing related configuration parameters of the CAN controller(s) for payload and CRC of a CAN FD frame. If this container exists the controller supports CAN FD frames.</DESC>
                                  <UUID>8000f101-c4ad-4870-8399-a358a0ebad12</UUID>
                                  <PARAMETERS>
                                    <PARAMETER>
                                      <SHORT-NAME>CanControllerFdBaudRate</SHORT-NAME>
                                      <DESC>Specifies the data segment baud rate of the controller in kbps.</DESC>
                                      <VALUE>0.0</VALUE>
                                      <TYPE>FLOAT</TYPE>
                                      <MIN-VALUE>0.0</MIN-VALUE>
                                      <MAX-VALUE>8000.0</MAX-VALUE>
                                      <UUID>3a99d32b-0f46-40a1-a4b3-dc647c0f0278</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanControllerFdBaudRatePRESDIV</SHORT-NAME>
                                      <DESC>Specifies the Extended Prescaler Division Factor.</DESC>
                                      <VALUE>1</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>31</MAX-VALUE>
                                      <UUID>27310fe5-d1e4-456d-add7-befc470b0f21</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanControllerPropSeg</SHORT-NAME>
                                      <DESC>Specifies propagation delay in time quantas.</DESC>
                                      <VALUE>3</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>31</MAX-VALUE>
                                      <UUID>8a2a1a42-1af3-437c-96ce-6d10daa3cd19</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanControllerSeg1</SHORT-NAME>
                                      <DESC>Specifies phase segment 1 in time quantas.</DESC>
                                      <VALUE>3</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>31</MAX-VALUE>
                                      <UUID>40089929-2c51-4fea-ba92-e120eeaee06a</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanControllerSeg2</SHORT-NAME>
                                      <DESC>Specifies phase segment 2 in time quantas.</DESC>
                                      <VALUE>1</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>15</MAX-VALUE>
                                      <UUID>cc2d9e8e-7815-499a-8e7a-4154a24cb820</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanControllerSyncJumpWidth</SHORT-NAME>
                                      <DESC>Specifies the synchronization jump width for the controller in time quantas.</DESC>
                                      <VALUE>3</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>15</MAX-VALUE>
                                      <UUID>5579ce58-393b-4b61-be18-a26f113fed25</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanControllerSspOffset</SHORT-NAME>
                                      <DESC>Specifies the Transmitter Delay Compensation Offset in minimum time quanta.</DESC>
                                      <VALUE>0</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>127</MAX-VALUE>
                                      <UUID>8941ac9d-7447-49f2-8e95-aa52a7a3b3a9</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanFDBytePayload</SHORT-NAME>
                                      <DESC>Data Length Code:&lt;br/&gt;                                                                            CAN and CAN FD: transmit frame has 0-8 data bytes.&lt;br/&gt;                                                                            CAN FD: transmit frame has 12/16/20/24/32/48/64 data bytes.</DESC>
                                      <VALUE>64</VALUE>
                                      <TYPE>INTEGER</TYPE>
                                      <MIN-VALUE>0</MIN-VALUE>
                                      <MAX-VALUE>64</MAX-VALUE>
                                      <UUID>28613625-0228-401d-b679-0c0c0084562d</UUID>
                                    </PARAMETER>
                                    <PARAMETER>
                                      <SHORT-NAME>CanControllerTxBitRateSwitch</SHORT-NAME>
                                      <DESC>Specifies if the bit rate switching shall be used for transmissions.</DESC>
                                      <VALUE>true</VALUE>
                                      <TYPE>BOOLEAN</TYPE>
                                      <UUID>b0b73032-0d3c-40e4-9fe2-a645d105381f</UUID>
                                    </PARAMETER>
                                  </PARAMETERS>
                                </CONTAINER>
                              </SUB-CONTAINERS>
                            </CONTAINER>
                            <CONTAINER>
                              <SHORT-NAME>CanControllerFdBaudrateConfig</SHORT-NAME>
                              <DESC>This optional container contains bit timing related configuration parameters of the CAN controller(s) for payload and CRC of a CAN FD frame. If this container exists the controller supports CAN FD frames.</DESC>
                              <UUID>8814bb76-c685-46d9-9d4f-9675e4c95b41</UUID>
                              <PARAMETERS>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerFdBaudRate</SHORT-NAME>
                                  <DESC>Specifies the data segment baud rate of the controller in kbps.</DESC>
                                  <VALUE>0.0</VALUE>
                                  <TYPE>FLOAT</TYPE>
                                  <MIN-VALUE>0.0</MIN-VALUE>
                                  <MAX-VALUE>8000.0</MAX-VALUE>
                                  <UUID>6b7c4935-1514-4c71-b9c8-93a42faeae15</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerFdBaudRatePRESDIV</SHORT-NAME>
                                  <DESC>Specifies the Extended Prescaler Division Factor.</DESC>
                                  <VALUE>1</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>31</MAX-VALUE>
                                  <UUID>1653d080-65b0-4ae5-a0f0-bd59ea3cc4f2</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerPropSeg</SHORT-NAME>
                                  <DESC>Specifies propagation delay in time quantas.</DESC>
                                  <VALUE>3</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>31</MAX-VALUE>
                                  <UUID>bbb21aa5-ab9a-4c0c-a93d-e219a59fdb50</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSeg1</SHORT-NAME>
                                  <DESC>Specifies phase segment 1 in time quantas.</DESC>
                                  <VALUE>3</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>31</MAX-VALUE>
                                  <UUID>3671aec0-89ef-456f-900a-b7cc637c7693</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSeg2</SHORT-NAME>
                                  <DESC>Specifies phase segment 2 in time quantas.</DESC>
                                  <VALUE>1</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>15</MAX-VALUE>
                                  <UUID>373d5c2e-57cf-4995-8c7e-a365a26059e5</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSyncJumpWidth</SHORT-NAME>
                                  <DESC>Specifies the synchronization jump width for the controller in time quantas.</DESC>
                                  <VALUE>3</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>15</MAX-VALUE>
                                  <UUID>d4394623-c60d-4cc3-90cd-607ff4bd1962</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerSspOffset</SHORT-NAME>
                                  <DESC>Specifies the Transmitter Delay Compensation Offset in minimum time quanta.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>127</MAX-VALUE>
                                  <UUID>ae45a7b2-e06c-4bfe-93c0-2b826d64335f</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanFDBytePayload</SHORT-NAME>
                                  <DESC>Data Length Code:&lt;br/&gt;                                                                            CAN and CAN FD: transmit frame has 0-8 data bytes.&lt;br/&gt;                                                                            CAN FD: transmit frame has 12/16/20/24/32/48/64 data bytes.</DESC>
                                  <VALUE>64</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>64</MAX-VALUE>
                                  <UUID>0cd2ac8a-ca16-4e3b-9799-236365da4b9a</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanControllerTxBitRateSwitch</SHORT-NAME>
                                  <DESC>Specifies if the bit rate switching shall be used for transmissions.</DESC>
                                  <VALUE>true</VALUE>
                                  <TYPE>BOOLEAN</TYPE>
                                  <UUID>0183f1c7-db3a-4d81-9046-893367053812</UUID>
                                </PARAMETER>
                              </PARAMETERS>
                            </CONTAINER>
                            <CONTAINER>
                              <SHORT-NAME>CanTTController</SHORT-NAME>
                              <DESC>CanTTController is specified in the SWS TTCAN and contains the configuration parameters of the TTCAN controller(s) (which are needed in addition to the configuration parameters of the CAN controller(s)).</DESC>
                              <UUID>edb911fe-7010-47ca-84d2-32231e663654</UUID>
                              <PARAMETERS>
                                <PARAMETER>
                                  <SHORT-NAME>CanTTControllerApplWatchdogLimit</SHORT-NAME>
                                  <DESC>Defines the maximum time period (unit is 256 times NTU) after which the application has to serve the watchdog.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>255</MAX-VALUE>
                                  <UUID>3483426f-3c42-49e1-b549-70859ba58366</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanTTControllerCycleCountMax</SHORT-NAME>
                                  <DESC>Defines the value for cycle_count_max.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>63</MAX-VALUE>
                                  <UUID>d3e7a2ab-2000-4416-8965-88da8e376853</UUID>
                                </PARAMETER>
                                <PARAMETER>
                                  <SHORT-NAME>CanTTControllerExpectedTxTrigger</SHORT-NAME>
                                  <DESC>Number of expected_tx_trigger.</DESC>
                                  <VALUE>0</VALUE>
                                  <TYPE>INTEGER</TYPE>
                                  <MIN-VALUE>0</MIN-VALUE>
                                  <MAX-VALUE>255</MAX-VALUE>
                                  <UUID>aa4d670e-ae11-4cf0-a9a1-7f55fbaa408d</UUID>
