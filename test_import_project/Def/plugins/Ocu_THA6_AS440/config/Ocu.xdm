              <v:ctr name="OcuConfigurationOfOptionalApis" type="IDENTIFIABLE">
                <a:a name="DESC" value="EN: Configuration of optional APIs." />
                <a:a name="UUID" value="120740da-cc3e-45e0-96d2-f696be29a1c7" />
                <v:var name="OcuDeInitApi" type="BOOLEAN">
                  <a:a name="DESC"
