<?xml version='1.0'?>
<datamodel version="7.0"
  xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd"
  xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd"
  xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
  xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar"
    xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
    xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd"
    xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd"
    xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
    xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"
    xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="THA6_AS440_FuSa" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:AUTOSAR"/>
        <d:lst type="ELEMENTS">
          <d:chc name="Ocu" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC"
                value="EN: Configuration of Ocu (Output Compare Unit) module." />
              <a:a name="LOWER-MULTIPLICITY" value="0" />
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true" />
              <a:a name="RELEASE" value="asc:4.4.0" />
              <a:a name="UPPER-MULTIPLICITY" value="1" />
              <a:a name="UUID" value="e0834db4-ecd9-4fa9-b023-5ef87ead8a17" />
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                  type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="LABEL" value="Config Variant" />
                <a:a name="UUID" value="3e94b66e-58cf-4c9a-ad11-efd721dbc89a" />
                <a:da name="DEFAULT" value="VariantPostBuild" />
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                </a:da>
              </v:var>

              <v:ctr name="OcuConfigSet" type="IDENTIFIABLE">
                <a:a name="DESC"
                  value="EN: This container is the base of a Configuration Set, which contains the configured OCU channels. This way, different configuration sets can be defined for post-build process." />
                <a:a name="UUID" value="7ca1a1bd-b558-4dbd-be53-1956391178a1" />
                <v:lst name="OcuCountdirection">
                  <a:da name="MIN" value="0" />
                  <a:da name="MAX" value="1" />
                  <v:var name="OcuCountdirection" type="ENUMERATION">
                    <a:a name="DESC"
                      value="EN: This parameter indicates the count direction for the whole OCU driver." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                      type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID"
                      value="5b7bd428-d068-4612-b708-240f6b430aa5" />
                    <a:da name="DEFAULT" value="OCU_UPCOUNTING" />
                    <a:da name="RANGE">
                      <a:v>OCU_UPCOUNTING</a:v>
                    </a:da>
                    <a:da name="EDITABLE" value="false" />
                  </v:var>
                </v:lst>
                
                <v:lst name="OcuChannel" type="MAP">
                  <a:da name="MIN" value="1" />
                  <a:da name="MAX" type="XPath" expr="num:i(ecu:get('Gtm.NumberOfAtomModules')*ecu:get('Gtm.NumberOfAtomChannels'))" />
                  <v:ctr name="OcuChannel" type="IDENTIFIABLE">
                    <a:a name="DESC"
                      value="EN: Configuration of an individual OCU channel." />
                    <a:a name="UUID"
                      value="1ef2930e-da0b-4e58-b39a-ce34aef36a4e" />
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                      type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="REQUIRES-INDEX" value="true"/>
                    <v:var name="OcuAssignedHardwareChannel" type="INTEGER">
                      <a:a name="DESC"
                        value="EN: The physical hardware channel that is assigned to this logical channel." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                        type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID"
                        value="6e683993-c1e9-4444-80f4-8741dbe4dc60" />
                      <a:da name="DEFAULT" value="0" />
                      <a:da name="EDITABLE" value="false" />
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=15" />
                        <a:tst expr="&gt;=0" />
                      </a:da>
                    </v:var>
                    <v:var name="OcuChannelId" type="INTEGER">
                      <a:a name="DESC"
                        value="EN: Channel Id of the OCU channel. This value will be assigned to the symbolic name derived from the OcuChannel container short name. It defines the assignment of the channel to the physical OCU hardware channel." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                        type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="true" />
                      <a:a name="UUID"
                        value="79925be1-d13e-4ff5-9b17-2c0a7e0ecce6" />
                      <a:da name="DEFAULT" type="XPath"
                        expr="node:fallback(node:current()/../@index,'0')" />
                      <a:da name="RANGE" type="XPath">
                        <a:tst expr="(.&gt;= 0 ) and (.&lt; num:i(count(node:current()/../../*)))"
                          false="Value out of range: must be in range 0 to N-1 (N is number of configured channels)." />
                        <a:tst expr="text:uniq(../../*/OcuChannelId,.)"
                          false="Duplicated value, OcuChannelId must be unique across all channels." />
                      </a:da>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=65535" />
                        <a:tst expr="&gt;=0" />
                      </a:da>
                    </v:var>
                    <v:var name="OcuChannelTickDuration" type="INTEGER">
                      <a:a name="DESC"
                        value="EN: Specifies the tick duration of the counter of the channel. This parameter is the number of the input clock edges (rising edges or falling edges exclusively) counted each time to increase the counter by one unit.Note: This parameter is not-used,not editable and default value is set to 1" />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                        type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID"
                        value="2b717db7-ec56-497c-a445-ddcdd6ab6b48" />
                      <a:da name="DEFAULT" value="1" />
                      <a:da name="EDITABLE" value="false" />
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=32768" />
                        <a:tst expr="&gt;=1" />
                      </a:da>
                    </v:var>
                    <v:var name="OcuDefaultThreshold" type="INTEGER">
                      <a:a name="DESC"
                        value="EN: Value of comparison threshold used for Initialization." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                        type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID"
                        value="be9328ba-426f-4df6-b2f7-24a2e5a33dc5" />
                      <a:da name="DEFAULT" value="1" />
                      <a:da name="INVALID" type="XPath">
                        <a:tst
                          expr="(../GtmTimerOutputModuleConfiguration/*[1]/GtmTimerClockSelect != 'GTM_TBU_TS0') and (../GtmTimerOutputModuleConfiguration/*[1]/GtmTimerClockSelect != 'GTM_TBU_TS1') and (../GtmTimerOutputModuleConfiguration/*[1]/GtmTimerClockSelect != 'GTM_TBU_TS2') and ((. > ../OcuMaxCounterValue))"
                          true="Invalid threshold value. Threshold cannot be larger than maximum counter value." />
                        <a:tst
                          expr="(node:fallback(substring-after(substring-after(substring-after(substring-after(substring-before(../GtmTimerOutputModuleConfiguration/*[1]/GtmTimerUsed,'Channel_'),'/Gtm'),'/Gtm'),'/Gtm'),'/Gtm'),'Atom') = 'Atom') and (. > 16777215)"
                          true="Invalid threshold value. ( Channel Tick duration should be less than 0xFFFFFF for an ATOM channel)" />
                      </a:da>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=16777215" />
                        <a:tst expr="&gt;=1" />
                      </a:da>
                    </v:var>

                    <v:lst name="OcuHardwareTriggeredAdc">
                      <a:da name="MIN" value="0" />
                      <a:da name="MAX" value="1" />
                      <a:da name="EDITABLE" type="XPath"
                        expr = "contains(../GtmTimerOutputModuleConfiguration/*[1]/GtmTimerUsed,'GtmAtom')" />
                      <v:var name="OcuHardwareTriggeredAdc" type="INTEGER">
                        <a:a name="DESC"
                          value="EN: This parameter is used to allow the OCU channel to trigger an ADC channel upon compare match. &lt;br/&gt;
                                 The mapping of ADC physical channel and OCU physical channel is configurated in MCU module.  &lt;br/&gt;
                                 This parameter is just used to choose the output event of this ocu channel is to trigger adc" />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:da name="EDITABLE" value="false" />
                        <a:a name="UUID"
                          value="4feabcce-44b8-45cd-9323-7c2358db63d0" />
                        <a:da name="DEFAULT" value="0" />
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=255"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>

                    </v:lst>

                    <v:lst name="OcuHardwareTriggeredDMA">
                      <a:da name="MIN" value="0" />
                      <a:da name="MAX" value="1" />
                      <a:da name="EDITABLE" value="true" />
                      <v:var name="OcuHardwareTriggeredDMA" type="INTEGER">
                        <a:a name="DESC"
                          value="EN: This parameter is used to allow the OCU channel to trigger a DMA channel upon compare match. The value of the parameter represents the DMA physical channel to trigger." />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID"
                          value="0f7ed04d-841e-4192-b946-8dc3d39fc528" />
                        <a:da name="DEFAULT" value="0" />
                        <a:da name="EDITABLE" value="false"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=255" />
                          <a:tst expr="&gt;=0" />
                        </a:da>
                      </v:var>
                    </v:lst>

                    <v:var name="OcuMaxCounterValue" type="INTEGER">
                      <a:a name="DESC"
                        value="EN: Maximum value in ticks, the counter of the OCU channel is able to count." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                        type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID"
                        value="a61117b2-6785-490c-bb81-2bf4c051b931" />
                      <a:da name="DEFAULT" value="16777215" />
                      <a:da name="EDITABLE" value="false" />
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295"/>
                        <a:tst expr="&gt;=1"/>
                      </a:da>
                    </v:var>
                    <v:lst name="OcuNotification">
                      <a:da name="MIN" value="0" />
                      <a:da name="MAX" value="1" />
                      <a:da name="ENABLE" type="XPath">
                        <a:tst
                          expr="node:fallback(/AUTOSAR/TOP-LEVEL-PACKAGES/Ocu/ELEMENTS/Ocu/OcuConfigurationOfOptionalApis/OcuNotificationSupported, 'true') = 'true'" />
                      </a:da>
                      <v:var name="OcuNotification" type="FUNCTION-NAME">
                        <a:a name="DESC"
                          value="EN: Definition of a function pointer to a Callback function." />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID"
                          value="5270aa5a-5a06-42e8-96dd-e8e680f04a56" />
                        <a:da name="DEFAULT" type="XPath"
                          expr="concat('Ocu_Notification_',node:fallback(../../OcuChannelId,'0'))" />
                      </v:var>
                    </v:lst>

                    <v:var name="OcuOuptutPinUsed" type="BOOLEAN">
                      <a:a name="DESC"
                        value="EN: Information about the usage of an output pin on this channel." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                        type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID"
                        value="c257b3fa-f118-4d0d-90ae-a4b011e06a1f" />
                      <a:da name="DEFAULT" value="false" />
                    </v:var>

                    <v:lst name="GtmTimerOutputModuleConfiguration" type="MAP">
                      <a:da name="MIN" value="1" />
                      <a:da name="MAX" value="1" />

                      <v:ctr name="GtmTimerOutputModuleConfiguration" type="IDENTIFIABLE">
                        <a:a name="DESC"
                          value="EN: Choose GTM-ATOM channel which will be used by this OCU Channel.
                                   Referred timer channel in MCU should have TomChannelUsage/ AtomChannelUsage as USED_BY_OCU_DRIVER" />
                        <a:a name="UUID"
                          value="ECUC:c2253a76-e1d8-4a8f-b303-ce80ffc0e870" />
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false" />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>

                        <v:ref name="GtmTimerUsed" type="CHOICE-REFERENCE">
                          <a:a name="DESC"
                            value="EN: This parameter lists all the GTM timer channels (ATOM)." />
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                          <a:a name="ORIGIN" value="ChipowerTech" />
                          <a:a name="SCOPE" value="ECU" />
                          <a:a name="UUID"
                            value="ECUC:c945dd5e-1l5b-4bcc-a8ab-0a4d19ec3585" />
                          <a:da name="REF">
                            <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Mcu/GtmConfiguration/GtmResourceAllocationConf/GtmAtom/GtmAtomChannel</a:v>
                          </a:da>
                          <a:da name="INVALID" type="XPath">
                            <a:tst expr="node:refvalid(.)"
                              false="The configured node does not exist or may not be referenced." />
                            <a:tst
                              expr="text:uniq(../../../../../OcuChannel/*/GtmTimerOutputModuleConfiguration/*/GtmTimerUsed,.)"
                              false="The configured node is used by multiple OCU channels." />
                        <a:tst
                          expr="node:exists(node:ref(../GtmTimerUsed)/GtmAtomChannel) and 
                                (node:ref(.)/GtmAtomChannel != 'GTM_ATOM_CHANNEL_NOT_USED') and 
                                (node:ref(.)/GtmAtomChannel != 'GTM_ATOM_CHANNEL_USED_BY_OCU')"
                          true="The configured ATOM channel is not allocted for Ocu driver" />
                          </a:da>
                        </v:ref>
                        <v:var name="GtmTimerClockSelect" type="ENUMERATION">
                          <a:a name="DESC"
                            value="EN: This parameter decides the compare object of GTM-ATOM timer." />
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                          <a:a name="ORIGIN" value="ChipowerTech" />
                          <a:a name="SCOPE" value="LOCAL" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID"
                            value="ECUC:31505abb-3296-4c09-bdb7-d0909f1440f2" />
                          <a:da name="DEFAULT" value="GTM_TBU_TS0" />
                          <a:da name="RANGE">
                            <a:v>GTM_TBU_TS0</a:v>
                            <a:v>GTM_TBU_TS1</a:v>
                            <a:v>GTM_TBU_TS2</a:v>
                          </a:da>
                        </v:var>
                      </v:ctr>
                    </v:lst>

                    <v:lst name="OcuOutputPinDefaultState">
                      <a:da name="MIN" value="0" />
                      <a:da name="MAX" value="1" />
                      <a:da name="EDITABLE" type="XPath">
                        <a:tst expr="(../OcuOuptutPinUsed = 'true')" />
                      </a:da>
                      <a:da name="INVALID" type="XPath"
                            expr="../OcuOuptutPinUsed = 'true' and count(./*) = 0"
                            true="When the channel match event is a trigger pin, the default state of the pin must be configured"/>
                      <v:var name="OcuOutputPinDefaultState" type="ENUMERATION">
                        <a:a name="DESC"
                          value="EN: The parameter OcuOutputPinDefaultState represents the state that a pin associated with a channel shall be set to after initialisation." />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID"
                          value="214f8510-63d5-40a4-84e2-6e69d6b9fdf2" />
                        <a:da name="DEFAULT" value="OCU_LOW" />
                        <a:da name="RANGE">
                          <a:v>OCU_HIGH</a:v>
                          <a:v>OCU_LOW</a:v>
                        </a:da>
                      </v:var>
                    </v:lst>

                    <v:lst name="OcuChannelEcucPartitionRef">
                      <v:ref name="OcuChannelEcucPartitionRef" 
                              type="REFERENCE">
                        <a:a name="DESC">
                          <a:v>EN: Maps an OCU channel to zero or multiple ECUC partitions to limit the access to this channel. The ECUC partitions referenced are a subset of the ECUC partitions where the OCU driver is mapped to.</a:v>
                          <a:v>EN: Tags: atp.Status=draft</a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" 
                              value="true"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:da name="EDITABLE" value="false"/> 
                        <a:a name="UUID" 
                              value="ECUC:14986ac3-28d4-452c-86bf-bfc130df8ab2"/>    
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                      </v:ref>
                    </v:lst>

                  </v:ctr>
                </v:lst>

                <v:lst name="OcuHWSpecificSettings" type="MAP">
                  <a:da name="MIN" value="0" />
                  <a:da name="MAX" value="1" />
                  <a:da name="EDITABLE" value="false" />
                  <v:ctr name="OcuHWSpecificSettings" type="IDENTIFIABLE">
                    <a:a name="DESC"
                      value="EN: This container contains Ocu-specific parameters for selecting the clock source and setting optional prescalers if supported by hardware." />

                    <a:a name="UUID"
                      value="bbe28f5d-4d01-4e38-a151-9894052da4eb" />
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                      type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <v:lst name="OcuClockSource">
                      <a:da name="MIN" value="0" />
                      <a:da name="MAX" value="1" />
                      <v:var name="OcuClockSource" type="ENUMERATION">
                        <a:a name="DESC"
                          value="EN: The OCU driver specific clock input for the unit can statically be configured to select different clock sources if provided by hardware. Enumeration literals are defined vendor specific." />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                          type="IMPLEMENTATIONCONFIGCLASS">
