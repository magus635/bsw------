                    <a:a name="SCOPE" value="ECU"/>
                    <a:da name="EDITABLE" value="false"/>
                    <a:a name="UUID" 
                          value="ECUC:04ffb3b6-0333-4ed2-864e-d3710423c86f"/>
                    <a:da name="REF" 
                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                  </v:ref>
                </v:lst>

                <v:lst name="OcuKernelEcucPartitionRef">
                  <a:da name="MAX" value="1"/>
                  <v:ref name="OcuKernelEcucPartitionRef" type="REFERENCE">
                    <a:a name="DESC">
                      <a:v>EN: Maps the OCU kernel to zero or one ECUC partitions to assign the driver kernel to a certain core. The ECUC partition referenced is a subset of the ECUC partitions where the OCU driver is mapped to.</a:v>
                      <a:v>EN: Tags: atp.Status=draft</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
