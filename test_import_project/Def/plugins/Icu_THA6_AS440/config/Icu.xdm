<?xml version="1.0"?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" 
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="THA6_AS440_FuSa" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:AUTOSAR"/>
        <d:lst type="ELEMENTS">
          <d:chc name="Icu" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC" 
                   value="EN: Configuration of the Icu (Input Capture Unit) module."/>
              <a:a name="LOWER-MULTIPLICITY" value="0"/>
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
              <a:a name="RELEASE" value="asc:4.4.0"/>
              <a:a name="UPPER-MULTIPLICITY" value="1" />
              <a:a name="UUID" value="df6e06ac-4758-4a74-82aa-6d47ae652651"/>
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                     type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="LABEL" value="Config Variant"/>
                <a:a name="UUID" value="00b3b9a3-c2da-47b9-9005-6c6f98d79d1d"/>
                <a:da name="DEFAULT" value="VariantPostBuild"/>
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                </a:da>
              </v:var>
              <v:ctr name="IcuConfigSet" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: This container contains the configuration parameters and sub containers of the AUTOSAR Icu module."/>
                <a:a name="UUID" value="f55a5785-acc5-44cc-bd60-c8b933aef576"/>
                    <v:var name="IcuMaxChannel" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: This parameter contains the number of Channels configured. It will be gathered by tools during the configuration stage.
                            calculation Formula = Number of configured Icu Channels Implementation Type: Icu_ChannelType. 
                            This parameter doesn't have any influence on the generated
                            code file"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>

                    <a:a name="UUID" value="e9de36d6-afcc-4f63-b467-4457f6ab4196"/>
                    <a:da name="DEFAULT" type="XPath">
                    <a:tst expr="num:i(count(node:fallback(../IcuChannel/*,0)))"/>
                    </a:da>
            
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=65535"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>

                    </v:var>
                <v:lst name="IcuChannel" type="MAP">
                  <a:da name="MIN" value="1"/>
                  <v:ctr name="IcuChannel" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                         value="EN: Configuration of an individual ICU channel."/>
                    <a:a name="UUID" 
                         value="cfe9ad1a-a41a-4db5-af41-eb9aa7f23423"/>
               
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                    type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="REQUIRES-INDEX" value="true"/>
                    
                    <v:var name="IcuChannelId" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: Channel Id of the ICU channel. This value will be assigned to the symbolic name derived of the IcuChannel container short name."/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>

                          </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                      <a:a name="UUID" 
                           value="ECUC:3e518578-f29a-463d-b183-d4b4d1c28766"/>
                        <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index,'0')"/>
                            <a:da name="RANGE" type="XPath">
                              <a:tst expr="(.&gt;= 0 ) and (.&lt; num:i(count(node:current()/../../*)))"
                               false="Value out of range: must be in range 0 to N-1 (N is number of configured channels)."/>
                              <a:tst expr="text:uniq(../../*/IcuChannelId,.)"  false="Duplicated value, IcuChannelId must be unique across all channels."/>
                            </a:da>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=65535"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                    </v:var>

                    <v:ref name="IcuChannelInputSelection" type="CHOICE-REFERENCE">
                         <a:a name="DESC"
                         value="EN: This parameter contains the selection of ICU channel." />

                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                         <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                         <a:a name="ORIGIN" value="ChipowerTech" />
                         <a:a name="SCOPE" value="ECU" />
                         <a:a name="UUID"
                         value="ECUC:c945dd5e-1l5b-4bcc-a8ab-01ef527157ba" />
                         <a:da name="REF">
                         <a:v>
                         ASPathDataOfSchema:/THA6_AS440_FuSa/Mcu/GtmConfiguration/GtmResourceAllocationConf/GtmTim/GtmTimChannel</a:v>
                         </a:da>
                         <a:da name="INVALID" type="XPath">
                          <a:tst
                            expr="node:exists(node:ref(../IcuChannelInputSelection)/GtmTimChannel) and 
                                  (node:ref(.)/GtmTimChannel != 'GTM_TIM_CHANNEL_NOT_USED') and 
                                  (node:ref(.)/GtmTimChannel != 'GTM_TIM_CHANNEL_USED_BY_ICU')"
                            true="The configured TIM channel is not allocted for Icu driver" />
                            <a:tst
                              expr="text:uniq(../../*/IcuChannelInputSelection,.)"
                              false="Hardware channel should be unique. Enter different Tim channel" />
                         </a:da>
                    </v:ref>





                    <v:var name="IcuDefaultStartEdge" type="ENUMERATION">
                      <a:a name="DESC" 
                           value="EN: Configures the default-activation-edge which shall be used for this channel if there was no activation-edge configured by the call of service Icu_SetActivationCondition()."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="a9d96bf3-199d-4152-b63d-3bad79fef3da"/>
                      <a:da name="DEFAULT" value="ICU_FALLING_EDGE"/>
                      <a:da name="RANGE">
                        <a:v>ICU_BOTH_EDGES</a:v>
                        <a:v>ICU_FALLING_EDGE</a:v>
                        <a:v>ICU_RISING_EDGE</a:v>
                      </a:da>
                    </v:var>
                    <v:var name="IcuMeasurementMode" type="ENUMERATION">
                      <a:a name="DESC" 
                           value="EN: Configures the measurement mode of this channel."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="c8b41c8c-b546-4d07-a087-3eb4ab8bc04d"/>
                      <a:da name="DEFAULT" value="ICU_MODE_EDGE_COUNTER"/>
                      <a:da name="RANGE">
                        <a:v>ICU_MODE_EDGE_COUNTER</a:v>
                        <a:v>ICU_MODE_SIGNAL_EDGE_DETECT</a:v>
                        <a:v>ICU_MODE_SIGNAL_MEASUREMENT</a:v>
                        <a:v>ICU_MODE_TIMESTAMP</a:v>
                      </a:da>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="(. = 'ICU_MODE_EDGE_COUNTER') and (../../../../IcuOptionalApis/IcuEdgeCountApi = 'false')"
                              true="IcuOptionalApis is disable." />
                         <a:tst expr="(. = 'ICU_MODE_SIGNAL_MEASUREMENT') and (../../../../IcuOptionalApis/IcuSignalMeasurementApi = 'false')"
                              true="IcuSignalMeasurementApi is disable." />
                         <a:tst expr="(. = 'ICU_MODE_SIGNAL_EDGE_DETECT') and (../../../../IcuOptionalApis/IcuEdgeDetectApi = 'false')"
                              true="IcuEdgeDetectApi   is disable." />
                         <a:tst expr="(. = 'ICU_MODE_TIMESTAMP') and (../../../../IcuOptionalApis/IcuTimestampApi = 'false')"
                              true=" IcuTimestampApi   is disable." />
                    </a:da>

                    </v:var>
                    <v:var name="IcuWakeupCapability" type="BOOLEAN">
                      <a:a name="DESC" 
                           value="EN: Information about the wakeup-capability of this channel."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="c225e7bb-c929-4295-8846-a93a8b17b195"/>
                      <a:da name="DEFAULT" value="false"/>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr=". = 'true' and ../IcuMeasurementMode != 'ICU_MODE_SIGNAL_EDGE_DETECT'" true="Wake-up supported only for Edge Detect mode."/>
                      </a:da>

                    </v:var>
                    <v:lst name="IcuChannelEcucPartitionRef">
                      <v:ref name="IcuChannelEcucPartitionRef" 
                             type="REFERENCE">
                        <a:a name="DESC">
                          <a:v>EN: Maps an ICU channel to zero or multiple ECUC partitions to limit the access to this channel. The ECUC partitions referenced are a subset of the ECUC partitions where the ICU driver is mapped to.</a:v>
                          <a:v>EN: Tags: atp.Status=draft</a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" 
                             value="true"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="EDITABLE" value="false"/>
                        <a:a name="UUID" 
                             value="ECUC:9b06fcbd-ce60-43e0-dfgh-4ce3e151298b"/>
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                      </v:ref>
                    </v:lst>

                    <v:var name="TimChannelInputSelect"
                         type="ENUMERATION">
                    <a:a name="DESC">
                         <a:v>EN: This decides the Input for the channel&lt;br/&gt;
                         INPUT_OF_CURRENT_TIM_CHANNEL: Input to the current TIM Channel will be the input assigned to this channel.&lt;br/&gt;
                         INPUT_OF_PREVIOUS_TIM_CHANNEL: Input to the current TIM channel will be the input assigned to the previous channel. Please note, the Port and Pin number applicable in this case is
                         the configuration for the previous channel and not the Port and Pin configured for this channel.&lt;br/&gt;
                         INPUT_OF_AUX_IN: Input to the current TIM channel will be ATOM or TOM signal.
                         </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                           
                    </a:a>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID"
                         value="44b6b528-6240-4ba6-85c5-9cb69b213850"/>

                    <a:da name="ENABLE" type="XPath">
                         <a:tst expr="node:fallback(&quot;->node:exists(node:ref(../IcuChannelInputSelection)/GtmTimChannel)&quot;, 'true')" />
                         </a:da>

     
                    <a:da name="DEFAULT"
                         value="INPUT_OF_CURRENT_TIM_CHANNEL"/>
                    <a:da name="RANGE">
                         <a:v>INPUT_OF_CURRENT_TIM_CHANNEL</a:v>
                         <a:v>INPUT_OF_PREVIOUS_TIM_CHANNEL</a:v>
                         <a:v>INPUT_OF_AUX_IN</a:v>
                    </a:da>
                    </v:var>

                    <v:var name="AuxInSource" 
                         type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: This decides the input Source of the Icu channel when TimChannelInputSelect is INPUT_OF_AUX_IN. There are two groups of channels to choose from, all TOM channels are selected from the same group. Group1:{TimXChY choose TomXChY (Y less than 8)}. group2 {TimXchY choose TomXchY (Y from 0 to 7)  or  choose  Tom(X-1)ChY (X bigger than 0 , Y from 0 to 15) }"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="e48606de-7745-414d-8cc2-cb606e877ec0"/>

                    <a:da name="ENABLE" type="XPath">
                         <a:tst expr="node:fallback(&quot;->(node:exists(node:ref(../IcuChannelInputSelection)/GtmTimChannel)) and (../TimChannelInputSelect = 'INPUT_OF_AUX_IN')&quot;, 'true')" />
                         </a:da>                    
                    
                    <a:da name="DEFAULT" type="XPath">
                         <a:tst expr="text:split(ecu:get(concat( 'Gtm.Tim',
                         node:fallback('->node:value((node:ref(../IcuChannelInputSelection)/ModuleId))','B'),
                         'Ch',
                         node:fallback('->node:value((node:ref(../IcuChannelInputSelection)/ChannelId))','MD'),
                         'AuxIn'
                         )), ', ')[position()-1 = 0]"/>

                         </a:da>
                         <a:da name="RANGE" type="XPath" expr="ecu:list(concat('Gtm.Tim',node:fallback( '->node:value( (node:ref(../IcuChannelInputSelection)/ModuleId) )'  ,'B'),'Ch',node:fallback('->node:value((node:ref(../IcuChannelInputSelection)/ChannelId) )','MD'),'AuxIn'))"/>
                    </v:var>


                                        
                    <v:var name="IcuGtmSmuClkSrc" type="ENUMERATION">
                      <a:a name="DESC" 
                           value="EN: This parameter is used to select the clock source for timer TIM SMU sub module"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="9a020458-4911-4b82-b683-0fcd6dfe04e2"/>
                      <a:da name="DEFAULT" value="CMU_CLK0"/>
                      <a:da name="RANGE">
                        <a:v>CMU_CLK0</a:v>
                        <a:v>CMU_CLK1</a:v>
                        <a:v>CMU_CLK2</a:v>
                        <a:v>CMU_CLK3</a:v>
                        <a:v>CMU_CLK4</a:v>
                        <a:v>CMU_CLK5</a:v>
                        <a:v>CMU_CLK6</a:v>
                        <a:v>CMU_CLK7</a:v>
                      </a:da>
                    </v:var>   

                    <v:ctr name="TimChannelFilterConfig"
                              type="IDENTIFIABLE">
                         <a:a name="DESC"
                              value="EN: This holds the filter specific configurations for the channels."/>
                         <a:a name="UUID"
                              value="216ef17c-7539-4d9d-845b-a170143c9466"/>
          
                         <v:var name="TimChannelFilterEnable"
                              type="BOOLEAN">
                         <a:a name="DESC"
                              value="EN: Enables Filter for the Channel. This sets FLT_EN for the channel"/>


                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                    
                         <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                         <a:a name="ORIGIN" value="ChipowerTech"/>
                         <a:a name="SCOPE" value="LOCAL"/>
                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                         <a:da name="EDITABLE" type="XPath" expr="node:exists(node:ref(../../IcuChannelInputSelection)/GtmTimChannel)"/>
                         <a:a name="UUID"
                              value="202f45ca-cad5-4170-a515-56eb752ea787"/>
                         <a:da name="DEFAULT" value="false"/>
                         <a:da name="INVALID" type="XPath">
                              <a:tst expr="(. = 'true') and (node:exists(node:ref(../../IcuChannelInputSelection)/GtmTioChannel))"
                                   true="Filtering is only effective for TIM channels." />
                         </a:da>


                         </v:var>
                    
                         <v:var name="TimChFilterCounterFreqSelect"
                              type="ENUMERATION">
                         <a:a name="DESC"
                              value="EN: This decides the Filter Counter frequency for the TIM Channel. This modifies the FLT_CNT_FRQ for the channel"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                         <a:a name="ORIGIN" value="ChipowerTech"/>
                         <a:a name="SCOPE" value="LOCAL"/>
                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                         <a:a name="UUID"
                              value="a4b65ef9-e5b3-4c4e-8001-b73efdfdd8ca"/>
                         <a:da name="DEFAULT"
                              value="CMU_TIM_FILTER_CLK_0"/>
                         <a:da name="RANGE">
                              <a:v>CMU_TIM_FILTER_CLK_0</a:v>
                              <a:v>CMU_TIM_FILTER_CLK_1</a:v>
                              <a:v>CMU_TIM_FILTER_CLK_6</a:v>
                              <a:v>CMU_TIM_FILTER_CLK_7</a:v>
                         </a:da>
                         </v:var>
                         
                         <v:var name="TimChFilterModeForRisingEdge"
                              type="ENUMERATION">
                         <a:a name="DESC"
                              value="EN: This decides the Filter Mode for Rising Edge of the TIM Channel Input"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                         <a:a name="ORIGIN" value="ChipowerTech"/>
                         <a:a name="SCOPE" value="LOCAL"/>
                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                         <a:a name="UUID"
                              value="e6287088-6c79-45db-a7fb-06d1898fa79b"/>
                         <a:da name="DEFAULT"
                              value="TIM_FLTMODE_IMMEDIATE"/>
                         <a:da name="RANGE">
                              <a:v>TIM_FLTMODE_IMMEDIATE</a:v>
                              <a:v>TIM_FLTMODE_DEGLITCHTIMEUPDOWN</a:v>
                              <a:v>TIM_FLTMODE_DEGLITCHTIMEHOLD</a:v>
                         </a:da>
                         </v:var>
                         
                         <v:var name="TimChFilterModeForFallingEdge"
                              type="ENUMERATION">
                         <a:a name="DESC"
                              value="EN: This decides the Filter Mode for Falling Edge of the TIM Channel Input"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                         <a:a name="ORIGIN" value="ChipowerTech"/>
                         <a:a name="SCOPE" value="LOCAL"/>
                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                         <a:a name="UUID"
                              value="89102148-5155-4a8a-ae12-7862c001ded2"/>
                         <a:da name="DEFAULT"
                              value="TIM_FLTMODE_IMMEDIATE"/>
                         <a:da name="RANGE">
                              <a:v>TIM_FLTMODE_IMMEDIATE</a:v>
                              <a:v>TIM_FLTMODE_DEGLITCHTIMEUPDOWN</a:v>
                              <a:v>TIM_FLTMODE_DEGLITCHTIMEHOLD</a:v>
                         </a:da>
                         </v:var>
                         
                         <v:var name="TimChFilterTimeForRisingEdge"
                              type="INTEGER">
                         <a:a name="DESC"
                              value="EN: This parameter specifies the Filter Time for Rising Edge of the TIM Channel Input"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS"
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                         <a:a name="ORIGIN" value="ChipowerTech"/>
                         <a:a name="SCOPE" value="LOCAL"/>
                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                         <a:a name="UUID"
                              value="0a65f41c-4dc1-4a76-a655-00015d757948"/>
                         <a:da name="DEFAULT" value="0"/>
                         <a:da name="INVALID" type="Multi">
                         <mt:range>
                         <mt:tst expr="&gt;=0" true="valid range is 0 to 16777215"/>
                         <mt:tst expr="&lt;=16777215" true="valid range is 0 to 16777215"/>
                         </mt:range>
                         </a:da> 
                         </v:var>
                         
