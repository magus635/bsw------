                      <SHORT-NAME>IcuChannelInputSelection</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter contains the selection of ICU channel.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>ECU</SCOPE>
                      <ORIGIN>ChipowerTech</ORIGIN>
