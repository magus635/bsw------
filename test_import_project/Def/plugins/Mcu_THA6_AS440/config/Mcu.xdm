                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" 
                        value="019448c4-d54a-708c-8424-f9625733eefb"/>
                  <a:da name="DEFAULT" 
                        value="FALLING"/>
                  <a:da name="RANGE">
                    <a:v>RISING</a:v>
                    <a:v>FALLING</a:v>
                    <a:v>RISINGFALLING</a:v>
                  </a:da>
                </v:var>


              <v:var name="P34_02" type="BOOLEAN">
                <a:a name="DESC" 
                    value="EN: P34_02 as wake-up source for standby mode."/>
                <a:a name="EDITABLE" type="XPath" expr="node:fallback(../../../McuMode, '1') = '1'" />    
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                    type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                <a:a name="ORIGIN" value="ChipowerTech"/>
                <a:a name="SCOPE" value="LOCAL"/>
                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                <a:a name="UUID" value="019448c5-bdd3-752d-93e2-ba6b0b939103"/>
                <a:da name="DEFAULT" value="false"/>
              </v:var>
                <v:var name="P34_02Edge" type="ENUMERATION">
                <a:a name="DESC" 
                      value="EN: Define PWRC Standby Domain wake-up pin edge for standby mode"/>
                <a:a name="EDITABLE" type="XPath" expr="node:fallback(../../../McuMode, '1') = '1'" />    

                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                      type="IMPLEMENTATIONCONFIGCLASS">
                  
                  <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" 
                        value="019448c6-1ae8-7254-a825-498d1b6f4fde"/>
                  <a:da name="DEFAULT" 
                        value="FALLING"/>
                  <a:da name="RANGE">
                    <a:v>RISING</a:v>
                    <a:v>FALLING</a:v>
                    <a:v>RISINGFALLING</a:v>
                  </a:da>
                </v:var>



              <v:var name="P34_03" type="BOOLEAN">
                <a:a name="DESC" 
                    value="EN: P34_03 as wake-up source for standby mode."/>
                <a:a name="EDITABLE" type="XPath" expr="node:fallback(../../../McuMode, '1') = '1'" />    
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                    type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                <a:a name="ORIGIN" value="ChipowerTech"/>
                <a:a name="SCOPE" value="LOCAL"/>
                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                <a:a name="UUID" value="019448c6-3f2c-7309-89d4-6eabdea8535b"/>
                <a:da name="DEFAULT" value="false"/>
              </v:var>
                <v:var name="P34_03Edge" type="ENUMERATION">
                <a:a name="DESC" 
                      value="EN: Define PWRC Standby Domain wake-up pin edge for standby mode"/>
                <a:a name="EDITABLE" type="XPath" expr="node:fallback(../../../McuMode, '1') = '1'" />    

                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                      type="IMPLEMENTATIONCONFIGCLASS">
                  
                  <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" 
                        value="019448c6-709c-716f-a6b8-347355dd5013"/>
                  <a:da name="DEFAULT" 
                        value="FALLING"/>
                  <a:da name="RANGE">
                    <a:v>RISING</a:v>
                    <a:v>FALLING</a:v>
                    <a:v>RISINGFALLING</a:v>
                  </a:da>
                </v:var>



              <v:var name="P34_04" type="BOOLEAN">
                <a:a name="DESC" 
                    value="EN: P34_04 as wake-up source for standby mode."/>
                <a:a name="EDITABLE" type="XPath" expr="node:fallback(../../../McuMode, '1') = '1'" />    
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                    type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                <a:a name="ORIGIN" value="ChipowerTech"/>
                <a:a name="SCOPE" value="LOCAL"/>
                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                <a:a name="UUID" value="019448c6-adbf-7709-b26e-a941e6063b88"/>
                <a:da name="DEFAULT" value="false"/>
              </v:var>
                <v:var name="P34_04Edge" type="ENUMERATION">
                <a:a name="DESC" 
                      value="EN: Define PWRC Standby Domain wake-up pin edge for standby mode"/>
                <a:a name="EDITABLE" type="XPath" expr="node:fallback(../../../McuMode, '1') = '1'" />    

                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                      type="IMPLEMENTATIONCONFIGCLASS">
                  
                  <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" 
                        value="019448c6-cb6b-73f8-a393-1234be30f752"/>
                  <a:da name="DEFAULT" 
                        value="FALLING"/>
                  <a:da name="RANGE">
                    <a:v>RISING</a:v>
                    <a:v>FALLING</a:v>
                    <a:v>RISINGFALLING</a:v>
                  </a:da>
                </v:var>



              <v:var name="P34_05" type="BOOLEAN">
                <a:a name="DESC" 
                    value="EN: P34_05 as wake-up source for standby mode."/>
                <a:a name="EDITABLE" type="XPath" expr="node:fallback(../../../McuMode, '1') = '1'" />    
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                    type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                <a:a name="ORIGIN" value="ChipowerTech"/>
                <a:a name="SCOPE" value="LOCAL"/>
                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                <a:a name="UUID" value="019448c7-0d8a-76e8-9f94-78ed5af49f98"/>
                <a:da name="DEFAULT" value="false"/>
              </v:var>
                <v:var name="P34_05Edge" type="ENUMERATION">
                <a:a name="DESC" 
                      value="EN: Define PWRC Standby Domain wake-up pin edge for standby mode"/>
                <a:a name="EDITABLE" type="XPath" expr="node:fallback(../../../McuMode, '1') = '1'" />    

                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                      type="IMPLEMENTATIONCONFIGCLASS">
                  
                  <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" 
                        value="019448c7-5b86-705a-94e4-228b68f9c87d"/>
                  <a:da name="DEFAULT" 
                        value="FALLING"/>
                  <a:da name="RANGE">
                    <a:v>RISING</a:v>
                    <a:v>FALLING</a:v>
                    <a:v>RISINGFALLING</a:v>
                  </a:da>
                </v:var>




                      </v:ctr>

                    </v:ctr>

                  </v:ctr>
                </v:lst>

                <v:lst name="McuRamSectorSettingConf" type="MAP">
                  <v:ctr name="McuRamSectorSettingConf" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                         value="EN: This container contains the configuration (parameters) for the RAM Sector setting. Please see MCU030 for more information on RAM sec-tor settings."/>
                    <a:a name="UUID" 
                         value="25b82c7a-4395-4ccc-b1e7-ece9178e07e1"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          </a:a>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                        <v:var name="McuRamDefaultValue" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: This parameter shall represent the Data pre-setting to be initialized"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="a70109b2-2317-4d30-bd5f-2cea76f54b64"/>
                      <a:da name="DEFAULT" value="0"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=255"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>
                    <v:var name="McuRamSectionBaseAddress" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: This parameter shall represent the MCU RAM section base address. This address requires 16 byte alignment"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="37860253-8178-43d7-b22e-051cd12d8cda"/>
                      <a:da name="DEFAULT" value="2097152"/>
                    <a:da name="INVALID" type="XPath">
                        <a:tst expr="(. mod 16 != 0)" true="This address requires 16 byte alignment" />
                    </a:da>                                
                    <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295" />
                        <a:tst expr="&gt;=0" />
                    </a:da>                      
                      
                    </v:var>
                    <v:var name="McuRamSectionSize" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: This parameter represents the MCU RAM Section size in bytes."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="c55973f2-e153-411e-9e7f-a431dcce6fcd"/>
                      <a:da name="DEFAULT" value="8192"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295"/>
                        <a:tst expr="&gt;=4"/>
                      </a:da>
                    <a:da name="INVALID" type="XPath">
                      <a:tst expr=". mod 16 != 0" true="This size requires 16 byte alignment" />
                    </a:da>                       
                      
                    </v:var>

                    <v:var name="McuRamSectionWriteSize" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: This parameter shall define the size in bytes of data which can be written into RAM at once."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="c55973f2-e153-411e-9e7f-a431dSF36fcd"/>
                      <a:da name="DEFAULT" value="8"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="
                              (
                                  ( num:i(node:fallback(., 8)) != 1 ) and
                                  ( num:i(node:fallback(., 8)) != 2 ) and
                                  ( num:i(node:fallback(., 8)) != 4 ) and
                                  ( num:i(node:fallback(., 8)) != 8 )
                              )"
                                  true="The ram write size is restricted to {1, 2, 4, 8} bytes."/>
                      </a:da>                   
                      
                    </v:var>



                    
                  </v:ctr>
                </v:lst>
              </v:ctr>

              <v:ctr name="McuPublishedInformation" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: Container holding all MCU specific published information parameters"/>
                <a:a name="UUID" value="973c3abc-e4ab-4bcc-822b-b4d82d2d7eb8"/>
                <v:lst name="McuResetReasonConf" type="MAP">
                  <a:da name="MIN" value="14"/>
                  <a:da name="MAX" value="14"/>
                  <v:ctr name="McuResetReasonConf" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                         value="EN: This container contains the configuration for the different type of reset reason that can be retrieved from Mcu_GetResetReason Api."/>
                    <a:a name="REQUIRES-INDEX" value="true"/>
                    <a:a name="UUID" 
                         value="1ed42d1f-7876-47d7-ba5a-22b4d1acc267"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>

                    <v:var name="McuResetReason" type="INTEGER_LABEL">
                      <a:a name="DESC" 
                           value="EN: The parameter represents the different type of reset that a Micro supports. This parameter is referenced by the parameter EcuMResetReason in the ECU State manager module."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>

                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                      <a:a name="UUID" 
                           value="1d9cf98c-3d98-430b-b372-8a949936a999"/>
                      <a:da name="READONLY" value="FALSE"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->string(text:split('0 1 2 3 4 7 8 16 17 18 19 23 24 25 0')[var:set('idx',position()) and normalize-space(text:split('MCU_RSTREASON_ESR0 MCU_RSTREASON_ESR1 MCU_RSTREASON_SAC MCU_SW_RESET MCU_WATCHDOG_RESET MCU_RSTREASON_CPU0WARMRST MCU_RSTREASON_CPU1WARMRST MCU_RSTREASON_PORSTPIN MCU_RSTREASON_IST MCU_RSTREASON_HSMAPP MCU_RSTREASON_HSMSYS MCU_POWER_ON_RESET MCU_RSTREASON_MUTITYPE MCU_RESET_UNDEFINED')[position() = $idx]) = name(node:fallback(node:current()/..,''))])&quot;,'0')"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=255"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>
                  </v:ctr>
                </v:lst>
              </v:ctr>
              <!-- This Coutainer is used for GTM Setting  -->>
              <v:lst name="GtmConfiguration" type="MAP">
                <a:da name="MIN" value="1"/>
                <v:ctr name="GtmConfiguration" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: This container contains the configuration parameters of the GTM driver."/>
                  <a:a name="UUID" value="64cb95ed-196c-4b39-8165-22585f1133fe"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        
                  
                  <v:ctr name="GtmGeneral" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                         value="EN: This container contains the General Configuration for GTM"/>
                    <a:a name="UUID" 
                         value="8d57a7cd-f92b-4635-a37f-6e0bad136d74"/>
                    <v:var name="CMUGlobalClkDivNumerator" type="INTEGER">
                      <a:a name="DESC">
                        <a:v>EN: This parameter specifies the Numerator value for the CMU Global Clock Divider.
                                 This modifies GTM_CMU_GCLK_NUM [GCLK_NUM].
                                 Global Clock = System Clock *
                                 ( CMUGlobalClkDivDenominator/ CMUGlobalClkDivNumerator).</a:v>
                      </a:a>
                       <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            
                          </a:a>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="8f883293-79c9-410a-9bde-90ce47513eb3"/>
                      <a:da name="DEFAULT" value="1"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=16777215"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>
                    <v:var name="CMUGlobalClkDivDenominator" type="INTEGER">
                      <a:a name="DESC">
                        <a:v>EN: This parameter specifies the Denominator value for the CMU Global Clock Divider.
                                Global Clock = System Clock *
                                ( CMUGlobalClkDivDenominator/ CMUGlobalClkDivNumerator).
                                This value should be configured lesser than Numerator value.</a:v>
                      </a:a>
                       <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            
                          </a:a><a:a name="ORIGIN" value="ChipowerTech"/>
                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                     <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="575bcd81-b912-43b2-8ea0-3bf6a35081b4c"/>
                      <a:da name="DEFAULT" value="1"/>
                          <a:da name="INVALID" type="Multi">
                                <mt:xpath expr=".&gt; node:fallback(../CMUGlobalClkDivNumerator,0)" true="Invalid Value: CMUGlobalClkDivDenominator cannot be greater than CMUGlobalClkDivNumerator"/>
                                <mt:range>
                                <mt:tst expr="&lt;=16777215" true="valid range is 0 to 16777215"/>
                                <mt:tst expr="&gt;=0" true="valid range is 0 to 16777215"/>
                                 </mt:range>
                          </a:da>
                    </v:var>
                    <v:var name="CMUClusterClockCfg" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: This parameter (enable \ disable \ enabled with clock divider 2) the cluster clock.."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            
                          </a:a>
                          <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="575bcd81-b912-43b2-8ea0-3bf6a23508b4c"/>
                      <a:da name="DEFAULT" type="XPath" expr="num:i(ecu:get('Gtm.IntVauleOfGTM_CLS_CLK_CFG'))"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=16777215"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>
                    <v:var name="GTM_TBU_Support" type="BOOLEAN">
                      <a:a name="DESC" 
                           value="EN: This parameter specifies the TBU module used or not."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                         <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="9d237c59-cf14-4b81-8b56-907da787657f"/>
                      <a:da name="DEFAULT" value="false"/>
                    </v:var>
                  </v:ctr>
                  <v:lst name="Cmu" type="MAP">
                    <a:da name="MIN" value="1"/>          
                    <a:da name="MAX" value="1"/>
                    <v:ctr name="Cmu" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains the Clock Configuration for GTM"/>
                      <a:a name="UUID" 
                           value="cac6b90a-6b91-4b88-b6ca-276372ee461c"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        
                      <v:ctr name="CmuConfigurableClock" type="IDENTIFIABLE">
                        <a:a name="DESC" 
                             value="EN: This container contains the Configurable Clock Configuration for GTM"/>
                        <a:a name="UUID" 
                             value="1a739227-6503-45bd-9d07-891f554b21ed"/>



                        <v:var name="CmuEnableConfigurableClk0" type="BOOLEAN">
                          <a:a name="DESC" 
                               value="EN: Enables/Disables the Configurable Clock 0 of GTM. This modifies GTM_CMU_CLK_EN[EN_CLK0]"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                          <a:a name="ORIGIN" value="ChipowerTech"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="b93a21ba-d205-4091-9227-a5ce30a3f9b3"/>
                          <a:da name="DEFAULT" value="false"/>
                        </v:var>



                        <v:var name="CmuConfigurableClk0Div" type="INTEGER">
                          <a:a name="DESC">
                            <a:v>EN: This parameter specifies the Divider value for the configurable Clock 0.
                                        This modifies GTM_CMU_CLK_0_CTRL[CLK_CNT].
                                        Hence the final clock frequency will be,
                                        Gtm frequency (after Global prescaler) /(Divider value configured here + 1)</a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
