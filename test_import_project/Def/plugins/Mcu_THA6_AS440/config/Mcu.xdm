                      <v:ctr name="CmuFixedClock" type="IDENTIFIABLE">
                        <a:a name="DESC" 
                             value="EN: This container contains the Fixed Clock Configuration for GTM"/>
                        <a:a name="UUID" 
                             value="2e3ade72-f4f5-436f-b8ea-d3bedf4e91d2"/>
                        <v:var name="CmuEnableAllFixedClocks" type="BOOLEAN">
                          <a:a name="DESC" 
                               value="EN: Enables/Disables the Fixed Clocks of GTM. This modifies GTM_CMU_CLK_EN[EN_FXCLK].                                           CMU provides 5 Fixed Clocks with the following Prescale values respectively; 1, 16, 256, 4096, 65536. Hence the final clock frequency will be,                                           Gtm frequency (after Global prescaler) /Fixed Clock Prescale value"/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                          <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                         <a:a name="ORIGIN" value="ChipowerTech"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="1dbb295d-c6ee-438e-bee4-d23e8d527b28"/>
                          <a:da name="DEFAULT" value="false"/>
                        </v:var>
                        <v:var name="CmuFxdClkSourceSelect" type="ENUMERATION">
                          <a:a name="DESC">
                            <a:v>EN: Clock Source select for Fixed Clock. This modifies CMU_CLK_EN [FXCLK_SEL]&lt;br/&gt;
                                        GTM_CMU_GCLK_EN: Use Global Clock as input for Fixed Clock.&lt;br/&gt;
                                        GTM_CMU_CLK0: Use Clock 0 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK1: Use Clock 1 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK2: Use Clock 2 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK3: Use Clock 3 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK4: Use Clock 4 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK5: Use Clock 5 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK6: Use Clock 6 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK7: Use Clock 7 as the clock source for Fixed Clock&lt;br/&gt;
                                        Default: GTM_CMU_GCLK_EN</a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                          <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                          <a:a name="ORIGIN" value="ChipowerTech"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="2c3e1a08-f2a1-4397-abc8-851382e2eb45"/>
                          <a:da name="DEFAULT" value="GTM_CMU_GCLK_EN"/>
                          <a:da name="RANGE">
                            <a:v>GTM_CMU_GCLK_EN</a:v>
                            <a:v>GTM_CMU_CLK0</a:v>
                            <a:v>GTM_CMU_CLK1</a:v>
                            <a:v>GTM_CMU_CLK2</a:v>
                            <a:v>GTM_CMU_CLK3</a:v>
                            <a:v>GTM_CMU_CLK4</a:v>
                            <a:v>GTM_CMU_CLK5</a:v>
                            <a:v>GTM_CMU_CLK6</a:v>
                            <a:v>GTM_CMU_CLK7</a:v>
                          </a:da>
                        </v:var>
                        <v:var name="CmuFxdClkFrequency" type="FLOAT">
                          <a:a name="DESC" 
                               value="EN: The Cmu Fixed clock frequency."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="ChipowerTech"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="d0cc3f95-d80e-4db9-ac7e-5830123407f3"/>
                                <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(
                                node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_GCLK_EN',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
                                node:value(../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../GtmGeneral/CMUGlobalClkDivNumerator)    ,0)+
                                node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_CLK0',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
                                node:value(../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../CmuConfigurableClock/CmuConfigurableClk0Div)+1)    ,0)+
                                node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_CLK1',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
                                node:value(../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../CmuConfigurableClock/CmuConfigurableClk1Div)+1)    ,0)+
                                node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_CLK2',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
                                node:value(../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../CmuConfigurableClock/CmuConfigurableClk2Div)+1)    ,0)+node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_CLK3',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
                                node:value(../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../CmuConfigurableClock/CmuConfigurableClk3Div)+1)    ,0)+node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_CLK4',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
                                node:value(../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../CmuConfigurableClock/CmuConfigurableClk4Div)+1)    ,0)+node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_CLK5',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
                                node:value(../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../CmuConfigurableClock/CmuConfigurableClk5Div)+1)    ,0)+node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_CLK6',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
                                node:value(../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../CmuConfigurableClock/CmuConfigurableClk6Div)+1)    ,0)+node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_CLK7',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
                                node:value(../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../CmuConfigurableClock/CmuConfigurableClk7Div)+1),0))*
                                node:when(bit:and(node:value(../../../../GtmGeneral/CMUClusterClockCfg),3)= 1,1,node:when( bit:and(node:value(../../../../GtmGeneral/CMUClusterClockCfg),3)= 2 , 0.5 , 0))&quot;,'0')"/>

