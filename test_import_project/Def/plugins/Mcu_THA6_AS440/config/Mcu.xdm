<?xml version='1.0'?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="THA6_AS440_FuSa" type="AR-PACKAGE">
      <a:a name="UUID" value="ECUC:AUTOSAR"/>
        <d:lst type="ELEMENTS">

          <d:chc name="Mcu" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC" 
                   value="EN: Configuration of the Mcu (Microcontroller Unit) module."/>
              <a:a name="LOWER-MULTIPLICITY" value="0" />
              <a:a name="UPPER-MULTIPLICITY" value="1" />
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
              <a:a name="RELEASE" value="asc:4.4.0"/>
              <a:a name="UUID" value="c68c7843-a836-4119-b45b-e2b78ad84bdf"/>
              <d:ref type="REFINED_MODULE_DEF" 
                     value="ASPath:/AUTOSAR/EcucDefs/Mcu"/>
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                     type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                  
                </a:a>
                <a:a name="LABEL" value="Config Variant"/>
                <a:da name="DEFAULT" value="VariantPostBuild"/>
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                </a:da>
              </v:var>
              <v:ctr name="McuGeneralConfiguration" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: This container contains the configuration (parameters) of the MCU driver."/>
                <a:a name="UUID" value="6b3cde6a-6bf7-4c9f-afe3-3348af3c044d"/>
                <v:var name="McuDevErrorDetect" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Switches the Default Error Tracer (Det) detection and notification ON or OFF."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ebc1fc38-97a9-4b4a-993a-6f35c90b30db"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
               <v:var name="McuSafetyErrorDetect" type="BOOLEAN">
                    <a:a name="DESC" value="EN: Switches the Safety Error detection ON or OFF." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="019666e3-8a8f-77f1-a107-20484462f1ac" />
                    <a:da name="DEFAULT" value="true" />
               </v:var>


                <v:var name="McuGetRamStateApi" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Pre-processor switch to enable/disable the API Mcu_GetRamState."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="af2b992a-10f7-4c41-8f16-6573d4def8b5"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>

                <v:var name="McuClearColdResetStatusApi" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Pre-processor switch to enable/disable the API Mcu_ClearColdResetStatus.."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="Chipower"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="af2b992a-10f7-4c41-8f16-6573d4def332"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>

                <v:var name="McuInitClock" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: If this parameter is set to FALSE, the clock initialization has to be disabled from the MCU driver. This concept applies when there are some write once clock registers and a bootloader is present. If this parameter is set to TRUE, the MCU driver is responsible of the clock initialization."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ce5a7a88-4d8b-480c-9b98-b9bf182bfa6c"/>
                  <a:da name="DEFAULT" value="true"/>
                </v:var>
                <v:var name="McuNoPll" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: This parameter shall be set True, if the H/W does not have a PLL or the PLL circuitry is enabled after the power on without S/W intervention. In this case MCU_DistributePllClock has to be disabled and  MCU_GetPllStatus has to return MCU_PLL_STATUS_UNDEFINED. Otherwise this parameters has to be set False"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="3423b9d5-90d8-4756-9913-c1bec3e2f3f6"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:da name="EDITABLE" value="false"/>
                  <a:da name="INVALID" type="XPath">
                        <a:tst expr="(. = 'true')"
                            true="do not support McuNoPll." />
                  </a:da>

                </v:var>
                <v:var name="McuPerformResetApi" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Pre-processor switch to enable / disable the use of the function Mcu_PerformReset()"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="19bbab54-727c-4e34-90e1-618d19854d5d"/>
                  <a:da name="DEFAULT" value="false"/>               
                </v:var>
                <v:var name="McuVersionInfoApi" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Pre-processor switch to enable / disable the API to read out the modules version information."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="81fb3a09-899c-4084-8444-239fb2ab42a7"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>

                <v:lst name="McuEcucPartitionRef">
                  <v:ref name="McuEcucPartitionRef" type="REFERENCE">
                    <a:a name="DESC">
                      <a:v>EN: Maps the MCU driver to zero or multiple ECUC partition to make the driver API available in this partition.</a:v>
                      <a:v>EN: Tags: atp.Status=draft</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                          type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:da name="EDITABLE" value="false"/>
                    <a:a name="UUID" 
                          value="ECUC:1f5846e1-1734-4157-a80e-80de5db43895"/>
                    <a:da name="REF" 
                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                  </v:ref>
                </v:lst>


              </v:ctr>
              <v:ctr name="McuModuleConfiguration" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: This container contains the configuration (parameters) of the MCU driver"/>
                <a:a name="UUID" value="92179346-cf65-4b98-be40-2c553af0033c"/>

                <v:var name="McuClockSrcFailureNotification" type="ENUMERATION">
                  <a:a name="DESC" 
                       value="EN: Enables/Disables clock failure notification. In case this feature is not supported by HW the setting should be disabled."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="20c74c4c-fdc2-4ecb-8b5b-367a3643e986"/>
                  <a:da name="DEFAULT" value="DISABLED"/>
                  <a:da name="EDITABLE" value="false"/>
                  <a:da name="RANGE">
                    <a:v>DISABLED</a:v>
                    <a:v>ENABLED</a:v>
                  </a:da>
                  <a:da name="INVALID" type="XPath">
                        <a:tst expr="(. = 'ENABLED')"
                            true="do not support enable McuClockSrcFailureNotification ." />
                  </a:da>

                </v:var>
                <v:var name="McuNumberOfMcuModes" type="INTEGER">
                  <a:a name="DESC" 
                       value="EN: This parameter shall represent the number of Modes available for the MCU."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="cd384d29-4dfa-4a54-8a46-25c3c0ec7096"/>
                  <a:da name="DEFAULT" type="XPath">
                          <a:tst expr="num:i( count( node:fallback( ../McuModeSettingConf/*, num:i(1) ) ) )"/>
                  </a:da>
                  <a:da name="INVALID" type="XPath">
                      <a:tst expr="node:fallback( ., num:i(1)) = num:i( count( node:fallback( ../McuModeSettingConf/*, num:i(1))) )"
                          false="The value for the McuNumberOfMcuModes must match with the McuModeSettingConf. For calculating the correct value use the CALCULATE button"/>
                  </a:da>                  
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=255"/>
                    <a:tst expr="&gt;=1"/>
                  </a:da>
                </v:var>
                <v:var name="McuRamSectors" type="INTEGER">
                  <a:a name="DESC" 
                       value="EN: This parameter shall represent the number of Ram available for the MCU. This parameter is disabled and is included here for completeness. calculation Formula = Number of configured McuRamSectorSettingConf."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="0fa1cf57-ec4f-4687-83a0-b92ae5f617b4"/>
                  <a:da name="DEFAULT" value="0"/>
                  <a:da name="EDITABLE" value="false"/>

                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=4294967295"/>
                    <a:tst expr="&gt;=0"/>
                  </a:da>
                </v:var>

                <v:lst name="McuResetSetting">
                    <a:da name="MAX" value="1"/>
                    <v:var name="McuResetSetting" type="INTEGER">
                    <a:a name="DESC"
                         value="This parameter relates to the MCU specific reset configuration. This applies to the function Mcu_PerformReset, which performs a microcontroller reset using the hardware feature of the microcontroller. This parameter is disabled and is included here for completeness."/>
                     <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID"
                         value="ECUC:8182a6cf-4a0f-418c-bb8c-277225bae6da"/>
                    <a:da name="EDITABLE" value="false"/>
                    <a:da name="DEFAULT" value="1"/>
                    <a:da name="INVALID" type="Range">
                         <a:tst expr="&lt;=255"/>
                         <a:tst expr="&gt;=1"/>
                    </a:da>
                    </v:var>
               </v:lst>
                <v:ctr name="McuResetConfig" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="FOR-ALL: This container contains the configuration (parameters) of the reset settings"/>

                  <a:a name="UUID" 
                       value="ECUC:885e5693-b8f4-4142-98ae-050bd6d9c6ae"/>
                  <v:var name="McuSWResetConf" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>FOR-ALL: This parameter defines the response of SW reset request.&lt;br/&gt;
                             RCC_RSTTYPE_NONE : No reset request is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_SYS : System reset is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_APP: Application reset request is triggered.</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="c6db7200-33w1-4ac5-b89d-4276cfd0a185"/>
                    <a:da name="DEFAULT" value="RCC_RSTTYPE_APP"/>
                    <a:da name="RANGE">
                      <a:v>RCC_RSTTYPE_NONE</a:v>
                      <a:v>RCC_RSTTYPE_SYS</a:v>
                      <a:v>RCC_RSTTYPE_APP</a:v>
                    </a:da>
                    <!-- <a:da name="INVALID" type="XPath"> -->
                        <!-- <a:tst expr="(. = 'RCC_RSTTYPE_NONE') and (../../../McuGeneralConfiguration/McuPerformResetApi = 'true')"
                              true="McuPerformResetAPI needs to configure SW reset type not to be None." /> -->
                    <!-- </a:da> -->

                  </v:var>
                  <v:var name="McuESR0ResetConf" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>FOR-ALL: This parameter defines the response of ESR0 reset request.&lt;br/&gt;
                             RCC_RSTTYPE_NONE : No reset request is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_SYS : System reset is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_APP: Application reset request is triggered.</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="c6db7200-3391-4ac5-b89d-4276cfd0a185"/>
                    <a:da name="DEFAULT" value="RCC_RSTTYPE_APP"/>
                    <a:da name="RANGE">
                      <a:v>RCC_RSTTYPE_NONE</a:v>
                      <a:v>RCC_RSTTYPE_SYS</a:v>
                      <a:v>RCC_RSTTYPE_APP</a:v>
                    </a:da>
                  </v:var>
                  <v:var name="McuESR1ResetConf" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>FOR-ALL: This parameter defines the response of ESR1 reset request.&lt;br/&gt;
                             RCC_RSTTYPE_NONE : No reset request is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_SYS : System reset is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_APP: Application reset request is triggered.</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="c6db7200-3391-4ac5-b89d-x276cfd0a185"/>
                    <a:da name="DEFAULT" value="RCC_RSTTYPE_NONE"/>
                    <a:da name="RANGE">
                      <a:v>RCC_RSTTYPE_NONE</a:v>
                      <a:v>RCC_RSTTYPE_APP</a:v>
                    </a:da>
                  </v:var>
                  <v:var name="McuSACResetConf" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>FOR-ALL: This parameter defines the response of SAC reset request.&lt;br/&gt;
                             RCC_RSTTYPE_NONE : No reset request is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_SYS : System reset is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_APP: Application reset request is triggered.</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="c6db7200-3391-4ac5-b89d-4276cfd0af85"/>
                    <a:da name="DEFAULT" value="RCC_RSTTYPE_NONE"/>
                    <a:da name="RANGE">
                      <a:v>RCC_RSTTYPE_NONE</a:v>
                      <a:v>RCC_RSTTYPE_SYS</a:v>
                      <a:v>RCC_RSTTYPE_APP</a:v>
                    </a:da>
                  </v:var>
                  <v:var name="McuIWDGResetConf" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>FOR-ALL: This parameter defines the response of IWDG reset request.&lt;br/&gt;
                             RCC_RSTTYPE_NONE : No reset request is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_SYS : System reset is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_APP: Application reset request is triggered.</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="c6db7200-3391-4ac5-b89d-4276cfd0ag85"/>
                    <a:da name="DEFAULT" value="RCC_RSTTYPE_NONE"/>
                    <a:da name="RANGE">
                      <a:v>RCC_RSTTYPE_NONE</a:v>
                      <a:v>RCC_RSTTYPE_SYS</a:v>
                      <a:v>RCC_RSTTYPE_APP</a:v>
                    </a:da>
                  </v:var>
                  <v:var name="McuCPU0REQResetConf" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>FOR-ALL: This parameter defines the response of CPU0REQ reset request.&lt;br/&gt;
                             RCC_RSTTYPE_NONE : No reset request is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_SYS : System reset is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_APP: Application reset request is triggered.</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="c6db72h0-3391-4ac5-b89d-4276cfd0a185"/>
                    <a:da name="DEFAULT" value="RCC_RSTTYPE_NONE"/>
                    <a:da name="RANGE">
                      <a:v>RCC_RSTTYPE_NONE</a:v>
                      <a:v>RCC_RSTTYPE_SYS</a:v>
                      <a:v>RCC_RSTTYPE_APP</a:v>
                    </a:da>
                  </v:var>
                  <v:var name="McuCPU1REQResetConf" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>FOR-ALL: This parameter defines the response of CPU1REQ reset request.&lt;br/&gt;
                             RCC_RSTTYPE_NONE : No reset request is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_SYS : System reset is triggered.&lt;br/&gt;
                             RCC_RSTTYPE_APP: Application reset request is triggered.</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="c6db7200-3391-4ac5-b89d-4276cfd0j185"/>
                    <a:da name="DEFAULT" value="RCC_RSTTYPE_NONE"/>
                    <a:da name="RANGE">
                      <a:v>RCC_RSTTYPE_NONE</a:v>
                      <a:v>RCC_RSTTYPE_SYS</a:v>
                      <a:v>RCC_RSTTYPE_APP</a:v>
                    </a:da>
                  </v:var>
                  <v:var name="McuResetTimeoutCnt" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>EN: This parameter is the Counter delay of Reset setting. Set the Timeout counter value, the default value is 0x190, and the time length 
is 100us.Note: The counter clock is 4Mhz and the configuration range is 1 to 0x1000</a:v>
                    </a:a>
                     <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          </a:a>

                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                    <a:a name="OPTIONAL" value="true"/>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="2b912d28-cc62-409a-a661-24ed6ff2e31d"/>
                    <a:da name="DEFAULT" value="400"/>
                    <a:da name="ENABLE" value="false"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4096"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                  </v:var>
                </v:ctr>
                <v:lst name="McuClockSettingConfig" type="MAP">
                  <a:da name="MIN" value="1"/>

                        <v:ctr name="McuClockSettingConfig" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                         value="EN: This container contains the configuration (parameters) for the Clock settings of the MCU.  Please see MCU031 for more information on the MCU clock settings."/>
                    <a:a name="UUID" 
                         value="bbea3fa2-67e0-4b45-8f60-a6443e1671db"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          </a:a>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                    <v:var name="McuClockSettingId" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: The Id of this McuClockSettingConfig to be used as argument for the API call &quot;Mcu_InitClock&quot;."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="d0cc3f95-d80e-4db9-ac7e-58305b3b07f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index,'0')"/>
                      <a:da name="RANGE" type="XPath">
                        <a:tst expr="(.&gt;= 0 ) and (.&lt; num:i(count(node:current()/../../*)))"
                          false="Value out of range: must be in range 0 to N-1 (N is number of configured channels)."/>
                        <a:tst expr="text:uniq(../../*/McuClockSettingId,.)"  false="Duplicated value, McuClockSettingId must be unique."/>
                      </a:da>                      
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=255"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>
                    <v:ctr name="McuSysPllClk_Configuration" 
                           type="IDENTIFIABLE">
                      <a:a name="UUID" 
                             value="20c74c4c-fdc2-4ecb-8b5b-s67s3632e986"/>
                       <a:a name="DESC" 
                             value="EN: McuSysPllClk_Configuration"/>
                         <v:var name="McuSysPllSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Choose the source of SysPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:da name="EDITABLE" value="true"/>                      
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="20c74c4c-fdc2-4ecb-8b5b-s67a3632e986"/>
                        <a:da name="DEFAULT" value="RCC_PLLCLOCKSOURCE_HSE"/>
                        <a:da name="RANGE">
                          <a:v>RCC_PLLCLOCKSOURCE_HSE</a:v>
                          <a:v>RCC_PLLCLOCKSOURCE_HSI</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="McuHSIClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The item is indicate that Mcu basic frequency which is from HSI.Then the clock is set to FREF if it is used."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                      <a:da name="EDITABLE" type="XPath" expr= "node:value(../McuSysPllSource) = 'RCC_PLLCLOCKSOURCE_HSI'"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5831123407f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="round(ecu:get('Mcu.HSIClkFrequency'))"/>
                     <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=200000000"/>
                        <a:tst expr="&gt;=1000"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuHSEClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The item is indicate that Mcu basic frequency which is from HSE.Then the clock is set to FREF if it is used."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                      <a:da name="EDITABLE" type="XPath" expr= "node:value(../McuSysPllSource) = 'RCC_PLLCLOCKSOURCE_HSE'"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4d39-ac7e-5830123407f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="round(ecu:get('Mcu.HSEClkFrequency'))"/>
                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.HSEClkMaxFrequency')"/>
                        <a:tst expr="&gt;=ecu:get('Mcu.HSEClkMinFrequency')"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuSysPllMode" type="ENUMERATION">
                        <a:a name="DESC" value="EN: Choose the mode of SysPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:da name="EDITABLE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="20c74c4c-fdc2-4ecb-a75b-3t7a3632e986"/>
                        <a:da name="DEFAULT" value="RCC_PLLMODE_INTEGER"/>
                        <a:da name="RANGE">
                          <a:v>RCC_PLLMODE_INTEGER</a:v>
                          <a:v>RCC_PLLMODE_DECIMAL</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="McuSysPllRefDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the RefDiv coefficient of SysPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5831574407f3"/>
                        <a:da name="DEFAULT" value="2"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.RefMaxDiv')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.RefMinDiv')"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuSysPllPostDiv1" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the PostDiv1 coefficient of SysPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5834123407f3"/>
                        <a:da name="DEFAULT" value="1"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.SysPllPostDiv1MaxDiv')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.SysPllPostDiv1MinDiv')"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuSysPllPostDiv2" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the PostDiv2 coefficient of SysPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5530123407f3"/>
                        <a:da name="DEFAULT" value="1"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.SysPllPostDiv2MaxDiv')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.SysPllPostDiv2MinDiv')"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuSysPllFBDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the FBDiv coefficient of SysPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc7f95-d80e-4db9-ac7e-5830123407f3"/>
                        <a:da name="DEFAULT" type="XPath" expr="ecu:get('Mcu.McuSysPllFBDivDefault')" />

                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.McuSysPllFBDivMaxDiv')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.McuSysPllFBDivMinDiv')"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuSysPllFRAC" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the FRAC coefficient of SysPll. it is used in DECIMAL Mode."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5830127407f3"/>
                        <a:da name="DEFAULT" value="0"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.McuSysPllFRACMax')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.McuSysPllFRACMin')"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuSysPllFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The System Pll mode clock frequency. SysPllClk =(FREF/REFDIV)*(FBDIV/(POSTDIV1*POSTDIV2*2))"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-a87e-5830123407f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:when(node:value(../McuSysPllMode) = 'RCC_PLLMODE_INTEGER',(node:when(node:value(../McuSysPllSource) = 'RCC_PLLCLOCKSOURCE_HSE',node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency)) div node:value(../../McuSysPllClk_Configuration/McuSysPllRefDiv))*(node:value(../../McuSysPllClk_Configuration/McuSysPllFBDiv) div (node:value(../../McuSysPllClk_Configuration/McuSysPllPostDiv1) * 2 * node:value(../../McuSysPllClk_Configuration/McuSysPllPostDiv2))),(node:when(node:value(../McuSysPllSource) = 'RCC_PLLCLOCKSOURCE_HSE', node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency)) div node:value(../../McuSysPllClk_Configuration/McuSysPllRefDiv))*((node:value(../../McuSysPllClk_Configuration/McuSysPllFBDiv) + (node:value(../../McuSysPllClk_Configuration/McuSysPllFRAC) div num:i(16777216))) div (node:value(../../McuSysPllClk_Configuration/McuSysPllPostDiv1) * 2 * node:value(../../McuSysPllClk_Configuration/McuSysPllPostDiv2)))))&quot;,ecu:get('Mcu.SysPllClkMaxFrequency'))"/>
                      
                    <a:a name="INVALID" type="XPath">
                    <a:tst expr="( 
                                   node:fallback(., ecu:get('Mcu.SysPllClkMaxFrequency')) !=
                                   (  node:fallback(&quot;->round(node:when(node:value(../McuSysPllMode) = 'RCC_PLLMODE_INTEGER',(node:when(node:value(../McuSysPllSource) = 'RCC_PLLCLOCKSOURCE_HSE',node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency)) div node:value(../../McuSysPllClk_Configuration/McuSysPllRefDiv))*(node:value(../../McuSysPllClk_Configuration/McuSysPllFBDiv) div (node:value(../../McuSysPllClk_Configuration/McuSysPllPostDiv1) * 2 * node:value(../../McuSysPllClk_Configuration/McuSysPllPostDiv2))),(node:when(node:value(../McuSysPllSource) = 'RCC_PLLCLOCKSOURCE_HSE', node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency)) div node:value(../../McuSysPllClk_Configuration/McuSysPllRefDiv))*((node:value(../../McuSysPllClk_Configuration/McuSysPllFBDiv) + (node:value(../../McuSysPllClk_Configuration/McuSysPllFRAC) div num:i(16777216))) div (node:value(../../McuSysPllClk_Configuration/McuSysPllPostDiv1) * 2 * node:value(../../McuSysPllClk_Configuration/McuSysPllPostDiv2)))))&quot;,ecu:get('Mcu.SysPllClkMaxFrequency')))
                                   
                                 )"
                    true="Please press the button to calculate the value automatically."/>
                    </a:a>
                    <a:a name="INVALID" type="Range">
                         <a:tst expr="&lt;=ecu:get('Mcu.SysPllClkMaxFrequency')"/>
                         <a:tst expr="&gt;=1000"/>
                    </a:a>

                      </v:var>
                    </v:ctr>
                    <v:ctr name="McuPerPllClk_Configuration" 
                           type="IDENTIFIABLE">
                    <a:a name="UUID" 
                             value="20c74c4c-fdk2-4ecb-8b5b-367a3632e986"/>
                       <a:a name="DESC" 
                             value="EN: McuPerPllClk_Configuration"/>
                         <v:var name="McuPerPllSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Choose the source of PerPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="20c74c4c-fdc2-4ecb-8b5b-367a3632e986"/>
                        <a:da name="DEFAULT" value="RCC_PLLCLOCKSOURCE_HSE"/>
                        <a:da name="RANGE">
                          <a:v>RCC_PLLCLOCKSOURCE_HSE</a:v>
                          <a:v>RCC_PLLCLOCKSOURCE_HSI</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="McuPerPllMode" type="ENUMERATION">
                        <a:a name="DESC" value="EN: Choose the mode of PerPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="20c74c4c-fdc2-4ecb-a75b-367a3y32e986"/>
                        <a:da name="DEFAULT" value="RCC_PLLMODE_INTEGER"/>
                        <a:da name="RANGE">
                          <a:v>RCC_PLLMODE_INTEGER</a:v>
                          <a:v>RCC_PLLMODE_DECIMAL</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="McuPerPllRefDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the RefDiv coefficient of PerPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5830574407f3"/>
                        <a:da name="DEFAULT" value="2"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.RefMaxDiv')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.RefMinDiv')"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuPerPllPostDiv1" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the PostDiv1 coefficient of PerPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5830123497f3"/>
                        <a:da name="DEFAULT" type="XPath" expr="ecu:get('Mcu.PerPllPostDiv1Default')" />
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.PerPllPostDiv1MaxDiv')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.PerPllPostDiv1MinDiv')"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuPerPllPostDiv2" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the PostDiv2 coefficient of PerPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-583q123407f3"/>
                        <a:da name="DEFAULT" value="1"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.PerPllPostDiv2MaxDiv')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.PerPllPostDiv2MinDiv')"/>                          
                        </a:da>
                      </v:var>

                      
                      <v:var name="McuPerPllFBDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the FBDiv coefficient of SysPll."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-58301w3407f3"/>
                        <a:da name="DEFAULT" value="80"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.PerPllFBDivMaxDiv')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.PerPllFBDivMinDiv')"/>       
                        </a:da>
                      </v:var>
                      <v:var name="McuPerPllFRAC" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the FRAC coefficient of PerPll. it is used in DECIMAL Mode"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-58e0123407f3"/>
                        <a:da name="DEFAULT" value="0"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.McuPerPllFRACMax')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.McuPerPllFRACMin')"/>      
                        </a:da>
                      </v:var>
                      <v:var name="McuPerPllFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The Peripheral Pll mode clock frequency. PerPllClk =(FREF/REFDIV)*(FBDIV/(POSTDIV1*POSTDIV2*2))"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-58301r3407f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:when(node:value(../McuPerPllMode) = 'RCC_PLLMODE_INTEGER',(node:when(node:value(../McuPerPllSource) = 'RCC_PLLCLOCKSOURCE_HSE',node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency)) div node:value(../McuPerPllRefDiv))*(node:value(../McuPerPllFBDiv) div (node:value(../McuPerPllPostDiv1) * 2 * node:value(../McuPerPllPostDiv2))),(node:when(node:value(../McuPerPllSource) = 'RCC_PLLCLOCKSOURCE_HSE', node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency)) div node:value(../McuPerPllRefDiv))*((node:value(../McuPerPllFBDiv) + (node:value(../McuPerPllFRAC) div num:i(16777216))) div (node:value(../McuPerPllPostDiv1) * 2 * node:value(../McuPerPllPostDiv2)))))&quot;,ecu:get('Mcu.PerPllClkMaxFrequency'))"/>
                        
                    
                    <a:da name="INVALID" type="Range">
                         <a:tst expr="&lt;=ecu:get('Mcu.PerPllClkMaxFrequency')"/>
                         <a:tst expr="&gt;=1000"/>
                    </a:da>

                   <a:a name="INVALID" type="XPath">
                    <a:tst expr="( 
                                   node:fallback(., ecu:get('Mcu.PerPllClkMaxFrequency')) !=
                                   ( num:i( node:fallback(&quot;->round(node:when(node:value(../McuPerPllMode) = 'RCC_PLLMODE_INTEGER',(node:when(node:value(../McuPerPllSource) = 'RCC_PLLCLOCKSOURCE_HSE',node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency)) div node:value(../McuPerPllRefDiv))*(node:value(../McuPerPllFBDiv) div (node:value(../McuPerPllPostDiv1) * 2 * node:value(../McuPerPllPostDiv2))),(node:when(node:value(../McuPerPllSource) = 'RCC_PLLCLOCKSOURCE_HSE', node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency)) div node:value(../McuPerPllRefDiv))*((node:value(../McuPerPllFBDiv) + (node:value(../McuPerPllFRAC) div num:i(16777216))) div (node:value(../McuPerPllPostDiv1) * 2 * node:value(../McuPerPllPostDiv2)))))&quot;,ecu:get('Mcu.PerPllClkMaxFrequency')))
                                   )
                                 )"
                    true="Please press the button to calculate the value automatically."/>
                    </a:a>


                      </v:var>
                    </v:ctr>
                    <v:ctr name="McuSysClkDiv_Configuration" 
                           type="IDENTIFIABLE">
                     <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5830643407fa"/>
                      <a:a name="DESC" 
                             value="EN: McuSysClkDiv_Configuration"/>
                         <v:var name="McuSysClockSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Choose the source of SysClock. ()"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="20c74c4c-fdc2-4ecb-a75b-36743632e986"/>
                        <a:da name="DEFAULT" value="RCC_CPUCLOCKSOURCE_SYSPLL"/>
                        <a:da name="RANGE">
                          <a:v>RCC_CPUCLOCKSOURCE_SYSPLL</a:v>
                          <a:v>RCC_CPUCLOCKSOURCE_HSE</a:v>
                          <a:v>RCC_CPUCLOCKSOURCE_HSI</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="CpuClkDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set division paramater of CpuClk"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5830643407f3"/>
                        <a:da name="DEFAULT" value="0"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.CpuClkMaxDiv')"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuCpuClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The Cpu clock frequency. The expression is CpuClk=McuSysClockSource/(CpuClkDiv+1)."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-583012t407f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:when(node:value(../McuSysClockSource) = 'RCC_CPUCLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency),node:when(node:value(../McuSysClockSource) = 'RCC_CPUCLOCKSOURCE_HSE',node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuSysPllFrequency) div (node:value(../CpuClkDiv) + 1))))&quot;,ecu:get('Mcu.CpuClkMaxFrequency'))"/>
                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.CpuClkMaxFrequency')"/>
                          <a:tst expr="&gt;=1000"/>
                        </a:da>
                         <a:a name="INVALID" type="XPath">
                         <a:tst expr="( 
                                        node:fallback(., ecu:get('Mcu.CpuClkMaxFrequency')) !=
                                        ( num:i( node:fallback(&quot;->round(node:when(node:value(../McuSysClockSource) = 'RCC_CPUCLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency),node:when(node:value(../McuSysClockSource) = 'RCC_CPUCLOCKSOURCE_HSE',node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency),node:value(../../McuSysPllClk_Configuration/McuSysPllFrequency) div (node:value(../CpuClkDiv) + 1))))&quot;,ecu:get('Mcu.CpuClkMaxFrequency')))                                   )
                                   )"
                         true="Please press the button to calculate the value automatically."/>
                         </a:a>


                      </v:var>
                      <v:var name="SysClkDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the SysClkDiv coefficient of Clock.()"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
