                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cs3f95-d80e-4db9-ac7e-58i0l23407f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:value(../McuCpuClkFrequency) div (node:value(../AhbDiv) + 1))&quot;,ecu:get('Mcu.AHBClkMaxFrequency'))"/>
                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.AHBClkMaxFrequency')"/>
                        <a:tst expr="&gt;=0"/>
                        </a:da>
                         <a:a name="INVALID" type="XPath">
                         <a:tst expr="( 
                                        node:fallback(., ecu:get('Mcu.AHBClkMaxFrequency')) !=
                                        ( num:i( node:fallback(&quot;->round(node:value(../McuCpuClkFrequency) div (node:value(../AhbDiv) + 1))&quot;,ecu:get('Mcu.AHBClkMaxFrequency')))                                       )
                                   )"
                         true="Please press the button to calculate the value automatically."/>
                         </a:a>


                      </v:var>
                    </v:ctr>
                    <v:ctr name="McuGTMClk_Configuration" type="IDENTIFIABLE">
                      <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-58i0123407f3"/>
                      <a:a name="DESC" 
                             value="EN:McuGTMClk Configuration "/>
                         <v:var name="GTMClockSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Choose the clock source of GTM.(HSI,HSE,PerPllClk/2.)"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="20c74c4c-fdc2-41cb-a75b-367a36acf986"/>
                        <a:da name="DEFAULT" 
                              value="RCC_MODULECLOCKSOURCE_PERPLL"/>
                        <a:da name="RANGE">
                          <a:v>RCC_MODULECLOCKSOURCE_HSI</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_PERPLL</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_HSE</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="GTMClockDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the GTMClockDiv coefficient of Clock. ()"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d32e-4db9-ac7e-5830abaeddd724323"/>
                        <a:da name="DEFAULT" type="XPath" expr="ecu:get('Mcu.GTMClockDivDefault')" />
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.Div5BitMax')"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuGTMClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The GTM clock frequency. The expression is GtmClk=GTMClockSource/(GTMClockDiv+1)."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-58301o3407f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:when(node:value(../GTMClockSource) = 'RCC_MODULECLOCKSOURCE_PERPLL',(node:value(../../McuPerPllClk_Configuration/McuPerPllFrequency) div ecu:get('Mcu.PerPllClkDivValue')) div (node:value(../GTMClockDiv ) + 1),node:when(node:value(../GTMClockSource) = 'RCC_MODULECLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency) div (node:value(../GTMClockDiv ) + 1),node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency) div (node:value(../GTMClockDiv ) + 1))))&quot;,ecu:get('Mcu.GTMMaxFrequency'))"/>
                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.GTMMaxFrequency')"/>
                          <a:tst expr="&gt;=0.0"/>
                        </a:da>
                         <a:a name="INVALID" type="XPath">
                         <a:tst expr="( 
                                        node:fallback(., ecu:get('Mcu.GTMMaxFrequency')) !=
                                        ( num:i(node:fallback(&quot;->round(node:when(node:value(../GTMClockSource) = 'RCC_MODULECLOCKSOURCE_PERPLL',(node:value(../../McuPerPllClk_Configuration/McuPerPllFrequency) div ecu:get('Mcu.PerPllClkDivValue')) div (node:value(../GTMClockDiv ) + 1),node:when(node:value(../GTMClockSource) = 'RCC_MODULECLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency) div (node:value(../GTMClockDiv ) + 1),node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency) div (node:value(../GTMClockDiv ) + 1))))&quot;,ecu:get('Mcu.GTMMaxFrequency')))                                       )
                                   )"
                         true="Please press the button to calculate the value automatically."/>
                         </a:a>


                      </v:var>
                    </v:ctr>
                    <v:ctr name="McuMSCClk_Configuration" type="IDENTIFIABLE">
                      <a:a name="UUID" 
                             value="d0cckf95-d80e-4db9-ac7e-58301o3407f3"/>
                      <a:a name="DESC" 
                             value="EN: McuMSCClk Configuration"/>
                         <v:var name="MSCClockSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Choose the clock source of MSC(HSI,HSE,PerPllClk/2.)"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="20c74c4c-fdc2-4ecb-a75b-367a11986"/>
                        <a:da name="DEFAULT" 
                              value="RCC_MODULECLOCKSOURCE_PERPLL"/>
                        <a:da name="RANGE">
                          <a:v>RCC_MODULECLOCKSOURCE_HSI</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_PERPLL</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_HSE</a:v>
                        </a:da>
                      </v:var>
                    </v:ctr>
                    <v:ctr name="McuESPIClk_Configuration" type="IDENTIFIABLE">
                      <a:a name="UUID" 
                             value="20c74c4c-fkc2-4ecb-a75b-367a11986"/>
                         <a:a name="DESC" 
                             value="EN: McuESPIClk Configuration"/>
                         <v:var name="ESPIClockSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Choose the clock source of ESPI.(HSI,HSE,PerPllClk/2.)"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="20c74c4c-fdc2-4ecb-a75b-367bcaf986"/>
                        <a:da name="DEFAULT" 
                              value="RCC_MODULECLOCKSOURCE_PERPLL"/>
                        <a:da name="RANGE">
                          <a:v>RCC_MODULECLOCKSOURCE_HSI</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_PERPLL</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_HSE</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="ESPIClockDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the ESPIClockDiv coefficient of Clock.( )"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d32e-4db9-ac7e-5830ab9aeddd724323"/>
                        <a:da name="DEFAULT" value="0"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.Div5BitMax')"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuESPIClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The ESPI clock frequency. The expression is EspiClk=ESPIClockSource/(ESPIClockDiv+1)."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-58301234a7f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:when(node:value(../ESPIClockSource) = 'RCC_MODULECLOCKSOURCE_PERPLL',(node:value(../../McuPerPllClk_Configuration/McuPerPllFrequency) div ecu:get('Mcu.PerPllClkDivValue')) div (node:value(../ESPIClockDiv ) + 1),node:when(node:value(../ESPIClockSource) = 'RCC_MODULECLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency) div (node:value(../ESPIClockDiv ) + 1),node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency) div (node:value(../ESPIClockDiv ) + 1))))&quot;,ecu:get('Mcu.ESPIMaxFrequency'))"/>
                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.ESPIMaxFrequency')"/>
                          <a:tst expr="&gt;=0.0"/>
                        </a:da>
                         <a:a name="INVALID" type="XPath">
                         <a:tst expr="( 
                                        node:fallback(., ecu:get('Mcu.ESPIMaxFrequency')) !=
                                        ( num:i( node:fallback(&quot;->round(node:when(node:value(../ESPIClockSource) = 'RCC_MODULECLOCKSOURCE_PERPLL',(node:value(../../McuPerPllClk_Configuration/McuPerPllFrequency) div ecu:get('Mcu.PerPllClkDivValue')) div (node:value(../ESPIClockDiv ) + 1),node:when(node:value(../ESPIClockSource) = 'RCC_MODULECLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency) div (node:value(../ESPIClockDiv ) + 1),node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency) div (node:value(../ESPIClockDiv ) + 1))))&quot;,ecu:get('Mcu.ESPIMaxFrequency')))                                       )
                                   )"
                         true="Please press the button to calculate the value automatically."/>
                         </a:a>



                      </v:var>
                    </v:ctr>
                    <v:ctr name="McuWDTClk_Configuration" type="IDENTIFIABLE">
                      <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-58301234akf3"/>
