                        <v:var name="CmuClk6SourceSelect" type="ENUMERATION">
                          <a:a name="DESC">
                            <a:v>EN: Clock Source select for CMU Clock6. This modifies GTM_CMU_CLK_6_CTRL[CLK6_SEL]&lt;br/&gt;
                                         CMU_CLK_6_DIVIDER: Use Global Clock prescaled using Clock 6 Divider as CMU Clock 6&lt;br/&gt;
                                         CMU_SUB_INC2_SIGNAL: Use Sub_Inc2 as the CMU Clock 6</a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
