                      <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                      <a:a name="UUID" 
                           value="63af14f6-ef41-4810-bcd3-9c94a124d3e0"/>
                      <a:da name="DEFAULT" value="0"/>
                          <a:da name="INVALID" type="Multi">
                            <mt:xpath expr="text:uniq(../../*/McuMode,.)"  false="MCU - Duplicated value, McuMode must be unique and contiguous across all configurations."/>
                            <mt:range>
                              <mt:tst expr="&lt;=1"/>
                              <mt:tst expr="&gt;=0"/>
                            </mt:range>
                          </a:da>
                    </v:var>

