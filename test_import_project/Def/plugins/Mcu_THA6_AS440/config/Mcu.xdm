                         <a:a name="ORIGIN" value="ChipowerTech"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="715682cb-8f94-4f63-8dab-19371b64fe10"/>
                          <a:da name="DEFAULT" value="false"/>
                        </v:var>
                        <v:var name="CmuExternalClk2Numerator" type="INTEGER">
