                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.Div9BitMax')"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuAHBClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The Ahb and Apb clock frequency. The expression is AhbClk=McuCpuClkFrequency/ (AhbDiv+1)."/>
