                                (node:value(../../CmuConfigurableClock/CmuConfigurableClk2Div)+1)    ,0)+node:when(node:value(../CmuFxdClkSourceSelect) = 'GTM_CMU_CLK3',node:value(../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*
