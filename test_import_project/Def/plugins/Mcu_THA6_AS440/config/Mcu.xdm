                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-58306ab24323"/>
                        <a:da name="DEFAULT" type="XPath" expr="ecu:get('Mcu.SysClkDivDefault')" />
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.Div3BitMax')"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuSysClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The SysClk clock frequency. The expression is SysClk= McuCpuClkFrequency/(SysClkDiv +1)."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5y30123407f3"/>
                        <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:value(../McuCpuClkFrequency) div (node:value(../SysClkDiv) + 1))&quot;,ecu:get('Mcu.SysClkMaxFrequency'))"/>

              
                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.SysClkMaxFrequency')"/>
                        <a:tst expr="&gt;=ecu:get('Mcu.SysClkMinFrequency')"/>
                        </a:da>
                         <a:a name="INVALID" type="XPath">
                         <a:tst expr="( 
                                        node:fallback(., ecu:get('Mcu.SysClkMaxFrequency')) !=
                                        ( num:i( node:fallback(&quot;->round(node:value(../McuCpuClkFrequency) div (node:value(../SysClkDiv) + 1))&quot;,ecu:get('Mcu.SysClkMaxFrequency')))                                       )
                                   )"
                         true="Please press the button to calculate the value automatically."/>
                         </a:a>


                      </v:var>
                      <v:var name="AxiDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the AxiDiv coefficient of Clock.()"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5830ab9724323"/>
                        <a:da name="DEFAULT" value="1"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.Div6BitMax')"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuAXIClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The AXI clock frequency( AxiClk and Geth CLOCK). The expression is AxiClk=McuCpuClkFrequency/ (AxiDiv+1)."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-58301234u7f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:value(../McuCpuClkFrequency) div (node:value(../AxiDiv) + 1))&quot;,ecu:get('Mcu.AXIClkMaxFrequency'))"/>
                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.AXIClkMaxFrequency')"/>
                        <a:tst expr="&gt;=0"/>
                        </a:da>
                         <a:a name="INVALID" type="XPath">
                         <a:tst expr="( 
                                        node:fallback(., ecu:get('Mcu.AXIClkMaxFrequency')) !=
                                        ( num:i(node:fallback(&quot;->round(node:value(../McuCpuClkFrequency) div (node:value(../AxiDiv) + 1))&quot;,ecu:get('Mcu.AXIClkMaxFrequency')))                                       )
                                   )"
                         true="Please press the button to calculate the value automatically."/>
                         </a:a>



                      </v:var>
                      <v:var name="AhbDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the AhbDiv coefficient of Clock.()"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
