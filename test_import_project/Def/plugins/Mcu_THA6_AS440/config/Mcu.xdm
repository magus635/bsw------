                             value="d0cc3f95-d32e-4db9-ac7e-5830ab9ae22d7bb3"/>
                        <a:da name="DEFAULT" value="4"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.Div6BitMax')"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuCAN_PEClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The CAN_PE clock frequency. The expression is CAN_PE_CLK=CANClockSource/(CANClockDiv+1)."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-d830123407f3"/>
                        <!--  fix perpll clock as 80000000 by changing postdiv3 in pbcfg.c  -->
                        <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:when(node:value(../CANClockSource) = 'RCC_MODULECLOCKSOURCE_PERPLL',node:when( node:containsValue(as:modconf('Resource')/ResourceGeneral/ResourceSubderivative, 'THA610X_LFBGA180'),(80000000) div (node:value(../CANClockDiv   ) + 1),node:value(../../McuPerPllClk_Configuration/McuPerPllFrequency) div (node:value(../CANClockDiv   ) + 1) ),node:when(node:value(../CANClockSource) = 'RCC_MODULECLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency) div (node:value(../CANClockDiv ) + 1),node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency) div (node:value(../CANClockDiv ) + 1))))&quot;,ecu:get('Mcu.RDC_DSADC_CAN_FCMaxFrequency'))"/>                        
                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.RDC_DSADC_CAN_FCMaxFrequency')"/>
                        <a:tst expr="&gt;=0"/>

                        </a:da>
                         <a:a name="INVALID" type="XPath">
                         <a:tst expr="( 
                                        node:fallback(., ecu:get('Mcu.RDC_DSADC_CAN_FCMaxFrequency')) !=
                                        ( num:i(node:fallback(&quot;->round(node:when(node:value(../CANClockSource) = 'RCC_MODULECLOCKSOURCE_PERPLL',node:when( node:containsValue(as:modconf('Resource')/ResourceGeneral/ResourceSubderivative, 'THA610X_LFBGA180'),(80000000) div (node:value(../CANClockDiv   ) + 1),node:value(../../McuPerPllClk_Configuration/McuPerPllFrequency) div (node:value(../CANClockDiv   ) + 1) ),node:when(node:value(../CANClockSource) = 'RCC_MODULECLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency) div (node:value(../CANClockDiv ) + 1),node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency) div (node:value(../CANClockDiv ) + 1))))&quot;,ecu:get('Mcu.RDC_DSADC_CAN_FCMaxFrequency')))                                      )
                                        )"
                         true="Please press the button to calculate the value automatically."/>
                         </a:a>

                      </v:var>
                    </v:ctr>
                    <v:ctr name="McuDMAClk_Configuration" type="IDENTIFIABLE">
                      <a:a name="UUID" 
                             value="d0cc3f95-d80e-40b9-ac7e-d830123407f3"/>
                      <a:a name="DESC" 
                             value="EN: McuDMAClk Configuration"/>
                        <v:var name="DMA0_CLKEN" type="BOOLEAN">
