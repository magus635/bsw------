                      <v:ctr name="CmuExternalClock" type="IDENTIFIABLE">
                        <a:a name="DESC" 
                             value="EN: This container contains the External Clock Configuration for GTM"/>
                        <a:a name="UUID" 
                             value="51f800fe-bb3c-4e91-b352-777358775d1d"/>
                        <v:var name="CmuEnableExternalClk0" type="BOOLEAN">
                          <a:a name="DESC" 
                               value="EN: Enables/Disables the External Clock 0 of GTM. This sets GTM_CMU_CLK_EN[EN_ECLK0]."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                          <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                         <a:a name="ORIGIN" value="ChipowerTech"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="64a373ef-363b-4f79-8b7b-1c510f371cfb"/>
                          <a:da name="DEFAULT" value="false"/>
                        </v:var>
                        <v:var name="CmuExternalClk0Numerator" type="INTEGER">
                          <a:a name="DESC">
                            <a:v>EN: This parameter specifies the Numerator value for the External Clock Divider0. This modifies GTM_CMU_ECLK_0_NUM [ECLK_NUM].
                                         Final Clock value = System clock Frequency/(2 *( CmuExternalClk0Numerator/ CmuExternalClk0Denominator))</a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
