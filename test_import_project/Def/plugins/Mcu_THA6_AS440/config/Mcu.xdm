                               value="025116c3-e3e8-4241-a746-00d1f44451f4"/>
                          <a:da name="DEFAULT" value="1"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=16777215"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                        </v:var>
                        <v:var name="CmuExternalClk0Denominator" type="INTEGER">
                          <a:a name="DESC">
                            <a:v>EN: This parameter specifies the Denominator value for the External Clock Divider0. This modifies GTM_CMU_ECLK_0_DEN[ECLK_DEN].
                                         Final Clock value = System clock Frequency/(2 *( CmuExternalClk0Numerator/ CmuExternalClk0Denominator))</a:v>
