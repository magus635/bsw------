                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                 value="4b85a236-9425-46d3-b46d-67cca14aa94a"/>
                            <a:da name="DEFAULT" value="CMU_CLK0"/>
                            <a:da name="RANGE">
                              <a:v>CMU_CLK0</a:v>
                              <a:v>CMU_CLK1</a:v>
                              <a:v>CMU_CLK2</a:v>
                              <a:v>CMU_CLK3</a:v>
                              <a:v>CMU_CLK4</a:v>
                              <a:v>CMU_CLK5</a:v>
                              <a:v>CMU_CLK6</a:v>
                              <a:v>CMU_CLK7</a:v>
                              <a:v>CMU_ECLK0</a:v>
                              <a:v>CMU_ECLK1</a:v>
                              <a:v>CMU_ECLK2</a:v>
                              <a:v>CMU_FXCLK</a:v>
                            </a:da>
                          </v:var>
                          <v:var name="CmuClockReferencePointFrequency" 
                                 type="FLOAT">
                            <a:a name="DESC" 
                                 value="EN: This is the frequency for the specific instance of the McuClockReferencePoint container. It shall be given in Hz."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                 value="35d76470-e8cf-4856-beae-96397a5e596a"/>
            
                            <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK0',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk0Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK1',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk1Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK2',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk2Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK3',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk3Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK4',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk4Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK5',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk5Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK6',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk6Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK7',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk7Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_ECLK0',                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../CmuExternalClock/CmuExternalClk0Denominator ) div node:value(../../../CmuExternalClock/CmuExternalClk0Numerator  )div
                                2,
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_ECLK1',                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../CmuExternalClock/CmuExternalClk1Denominator ) div node:value(../../../CmuExternalClock/CmuExternalClk1Numerator  )div
                                2,
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_ECLK2',                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../CmuExternalClock/CmuExternalClk2Denominator ) div node:value(../../../CmuExternalClock/CmuExternalClk2Numerator  )div
                                2,
                                0)
                                )*
                                node:when(bit:and(node:value(../../../../../GtmGeneral/CMUClusterClockCfg),3)= 1,1,node:when( bit:and(node:value(../../../../../GtmGeneral/CMUClusterClockCfg),3)= 2 , 0.5 , 0))
                                +
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_FXCLK',    node:value(../../../CmuFixedClock/CmuFxdClkFrequency ),0)&quot;,'0')"/>        
                        
                            <a:da name="INVALID" type="Range">
                                  <a:tst expr="&lt;=ecu:get('Mcu.GTMMaxFrequency')"/>
                              <a:tst expr="&gt;=0.0"/>
                            </a:da>
                              <a:a name="INVALID" type="XPath">
                              <a:tst expr="( 
                                             node:fallback(., ecu:get('Mcu.GTMMaxFrequency')) !=
                                             ( num:i( node:fallback(&quot;->round(
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK0',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk0Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK1',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk1Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK2',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk2Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK3',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk3Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK4',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk4Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK5',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk5Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK6',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk6Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_CLK7',
                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../../../GtmGeneral/CMUGlobalClkDivDenominator) div node:value(../../../../../GtmGeneral/CMUGlobalClkDivNumerator)div
                                (node:value(../../../CmuConfigurableClock/CmuConfigurableClk7Div)+1),
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_ECLK0',                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../CmuExternalClock/CmuExternalClk0Denominator ) div node:value(../../../CmuExternalClock/CmuExternalClk0Numerator  )div
                                2,
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_ECLK1',                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../CmuExternalClock/CmuExternalClk1Denominator ) div node:value(../../../CmuExternalClock/CmuExternalClk1Numerator  )div
                                2,
                                0)+
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_ECLK2',                                node:value(../../../../../../../McuModuleConfiguration/McuClockSettingConfig/*[1]/McuGTMClk_Configuration/McuGTMClkFrequency)*node:value(../../../CmuExternalClock/CmuExternalClk2Denominator ) div node:value(../../../CmuExternalClock/CmuExternalClk2Numerator  )div
                                2,
                                0)
                                )*
                                node:when(bit:and(node:value(../../../../../GtmGeneral/CMUClusterClockCfg),3)= 1,1,node:when( bit:and(node:value(../../../../../GtmGeneral/CMUClusterClockCfg),3)= 2 , 0.5 , 0))
                                +
                                node:when(node:value(../McuClockReferenceSelect) = 'CMU_FXCLK',    node:value(../../../CmuFixedClock/CmuFxdClkFrequency ),0)&quot;,'0'))                                            )
                                        )"
                              true="Please press the button to calculate the value automatically."/>
                              </a:a>

                          </v:var>
                        </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
                  <v:lst name="Tbu" type="MAP">
                        <a:da name="MAX" value="1"/>
                        <a:da name="MIN" value="1"/>
                    <a:da name="EDITABLE" type="XPath" expr="../GtmGeneral/GTM_TBU_Support = 'true'"/>                           
                    <v:ctr name="Tbu" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container provides the TBU configuration."/>
                      <a:a name="UUID" 
                           value="aebfab08-5b5c-4a43-bd50-cc3d505c7e7e"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <v:lst name="TbuChannel" type="MAP">
                            <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfTbuModules')"/>
                            <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfTbuModules')"/>
                        <v:ctr name="TbuChannel" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: This container provides the TBU Channel configuration."/>
                          <a:a name="REQUIRES-INDEX" value="true"/>
                          <a:a name="UUID" 
                               value="26ec9dd3-0304-4f0f-b8db-7cde8e77ef8c"/>
                          <v:var name="TbuChannelID" type="INTEGER">
                            <a:a name="DESC" 
                                 value="EN: This parameter provides the channel ID which is unique in a given TBU Driver. The value for this parameter starts with 0 and continue without any gaps."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                            <a:a name="UUID" 
                                 value="badb922c-fc6c-4da1-bcd6-3c423d586ebe"/>
                                <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(0))"/>
                                <a:da name="RANGE" type="XPath">
                                    <a:tst expr="(node:fallback(.,1) &gt;= 0) and (node:fallback(.,1) &lt; num:i(count(node:fallback(node:current()/../../*, 1 ))))" false="Value out of range: must be in range 0 to N-1 (N is number of configured channels). Use the Calc button to calculate correct default value."/>
                                    <a:tst expr="text:uniq(node:fallback(../../*/TbuChannelID, text:split('1 2 3')), node:fallback(.,1) )" false="Duplicated value, Id must be unique across all TBU channel. Use the Calc button to calculate correct default value."/>                                                 
                                </a:da>
                            <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;=255"/>
                              <a:tst expr="&gt;=0"/>
                            </a:da>
                          </v:var>
                          <v:var name="TbuEnableChannel" type="BOOLEAN">
                            <a:a name="DESC" 
                                 value="EN: Enables the TBU Channel."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         <a:a name="POSTBUILDVARIANTVALUE" value="true" />

                         <a:a name="ORIGIN" value="ChipowerTech"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                 value="dcfde6b2-d061-4579-827b-1374a8506cc0"/>
                            <a:da name="DEFAULT" value="false"/>
                          </v:var>
                          <v:var name="TbuChannelModeSelect" type="ENUMERATION">
                            <a:a name="DESC">
                              <a:v>EN: This decides the Mode for the TBU Channel. This is only applicable for TBU Channel 1 and 2&lt;br/&gt;
                              FOR-ALL: GTM_TBU_MODE_FREERUNNING: Free Running Mode chosen&lt;br/&gt;
                              FOR-ALL: GTM_TBU_MODE_FORWARDBACKWARD: Forward Backward Counter mode chosen</a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                 value="b51eb5b9-82e9-45f8-b316-483952e37f16"/>
                            <a:da name="DEFAULT" 
                                  value="GTM_TBU_MODE_FREERUNNING"/>
                            <a:da name="RANGE">
                              <a:v>GTM_TBU_MODE_FREERUNNING</a:v>
                              <a:v>GTM_TBU_MODE_FORWARDBACKWARD</a:v>
                            </a:da>
                            <a:da name="EDITABLE" type="XPath">
                              <a:tst expr="(../TbuChannelID != '0')"/>
                            </a:da>
                          </v:var>
                          <v:var name="TbuChannelClockSource" 
                                 type="ENUMERATION">
                            <a:a name="DESC">
                              <a:v>FOR-ALL: value=&quot;EN: This decides the Clock Source for the TBU Channel&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_0: Configurable Clock0 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_1: Configurable Clock1 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_2: Configurable Clock2 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_3: Configurable Clock3 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_4: Configurable Clock4 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_5: Configurable Clock5 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_6: Configurable Clock6 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_7: Configurable Clock7 is chosen</a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            
                          </a:a>
                          
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                 value="7eb44dbc-47b1-497a-a14b-f61dfed6ffb9"/>
                            <a:da name="DEFAULT" value="GTM_CMU_CLK_0"/>
                            <a:da name="RANGE">
                              <a:v>GTM_CMU_CLK_0</a:v>
                              <a:v>GTM_CMU_CLK_1</a:v>
                              <a:v>GTM_CMU_CLK_2</a:v>
                              <a:v>GTM_CMU_CLK_3</a:v>
                              <a:v>GTM_CMU_CLK_4</a:v>
                              <a:v>GTM_CMU_CLK_5</a:v>
                              <a:v>GTM_CMU_CLK_6</a:v>
                              <a:v>GTM_CMU_CLK_7</a:v>
                            </a:da>
                          </v:var>
                          <v:var name="TbuChannelResolution" type="ENUMERATION">
                            <a:a name="DESC">
                              <a:v>EN: This decides the resolution for the TBU Channel. This is only applicable for TBU Channel 0&lt;br/&gt;
                                        GTM_TBU_TS0_BIT_LOWER: Choose Lower 24 Bits of TBU&lt;br/&gt;
                                        GTM_TBU_TS0_BIT_UPPER: Choose Higher 24 Bits of TBU</a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                 value="b820f4c2-e880-47fb-a7a8-2582326f4111"/>
                            <a:da name="DEFAULT" value="GTM_TBU_TS0_BIT_LOWER"/>
                            <a:da name="RANGE">
                              <a:v>GTM_TBU_TS0_BIT_LOWER</a:v>
                              <a:v>GTM_TBU_TS0_BIT_UPPER</a:v>
                            </a:da>
                            <a:da name="EDITABLE" type="XPath">
                              <a:tst expr="(../TbuChannelID = '0')"/>
                            </a:da>
                          </v:var>
                          <v:var name="TbuTimebaseValue" type="INTEGER">
                            <a:a name="DESC" 
                                 value="EN: This parameter specifies the Timebase value for the TBU Channel"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                 value="d6230b5f-8bab-4ec1-a04e-4bcbe435c5ee"/>
                            <a:da name="DEFAULT" value="0"/>
                            <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;=16777215"/>
                              <a:tst expr="&gt;=0"/>
                            </a:da>
                          </v:var>
                        </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
                  <v:lst name="Tom" type="MAP">
                      <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfTomModules')"/>
                      <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfTomModules')"/>
                    <v:ctr name="Tom" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains the TOM Configuration for GTM"/>
                      <a:a name="REQUIRES-INDEX" value="true"/>
                      <a:a name="UUID" 
                           value="b25dc518-7825-484f-b6eb-c6d46e174989"/>
                      <v:lst name="TomChannel" type="MAP">
                        <a:da name="MAX" value="16"/>
                        <a:da name="MIN" value="16"/>
                        <v:ctr name="TomChannel" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: This container contains the TOM Channel configuration"/>
                          <a:a name="REQUIRES-INDEX" value="true"/>
                          <a:a name="UUID" 
                               value="d61bf4d2-8efd-4432-a67f-3263aa8a9f49"/>
                          <v:ctr name="TomChannelOutput" type="IDENTIFIABLE">
                            <a:a name="DESC" 
                                 value="EN: This container contains the TOM Channel Output configuration"/>
                            <a:a name="UUID" 
                                 value="79b8b4af-65d0-40ab-aadd-3822d7e43146"/>
                            <v:var name="GTM_Tom_Negative_Support" 
                                   type="BOOLEAN">
                              <a:a name="DESC" 
                                   value="EN: This parameter specifies the Tom negative module used or not."/>
                                  <a:da name="EDITABLE" type="XPath" expr="(num:i(../../@index) &lt; 16)"/>    
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                                   value="9d237c59-cff4-4b81-8b56-907da7y7657f"/>
                              <a:da name="DEFAULT" value="false"/>
                            </v:var>

                              <v:var name="TomId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the TOM Cluster."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="91d2144e-864c-416f-b733-7bffca116e75"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../../../../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.NumberOfTomModules'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              </v:var>

                              <v:var name="ChannelId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the TOM channel."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="9322144e-864c-416f-b733-7bffca116e75"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.NumberOfTomChannels'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>

                            <a:da name="RANGE" type="XPath">
                              <a:tst expr="text:uniq(../../../*/TomChannelOutput/ChannelId,.)"  false="Duplicated value, Id must be unique. Use the Calc button to calculate correct default value."/>
                            </a:da>

                              </v:var>

                            <v:var name="TomChannelNegativePortPinSelect" 
                                   type="ENUMERATION">
                                  <a:da name="EDITABLE" type="XPath" expr="((../GTM_Tom_Negative_Support = 'true') and (num:i(../../@index) &lt; 16))"/>        
                              <a:a name="DESC" 
                                   value="EN: This decides the output port and pin for the TOM Channel. This parameter is not applicable in case of configuration using bmd. While using Bmd, GtmToutConfiguration should be configured for Port assignment."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                                       value="0d28dada-8d27-4b19-8617-7d51df1d2df4"/>
                                  <a:da name="DEFAULT" type="XPath">

                                    <a:tst expr="text:split(ecu:get(concat('Gtm.Tom',node:fallback((../TomId),'F'),'Channel',node:fallback((../ChannelId),'XX'),'N')), ',')[position()-1 = 0]"/>
                                                                  
                                  </a:da>

                                  
                                   <a:da name="RANGE" type="XPath" expr="ecu:list(concat('Gtm.Tom',node:fallback((../TomId),'F'),'Channel',node:fallback((../ChannelId),'XX'),'N'))"/>
                                 <a:da name="TOOLTIP" value="To decides the output port and pin."/>
                                </v:var>
                            <v:var name="TomChannelPortPinSelect" 
                                   type="ENUMERATION">
                                  <a:da name="EDITABLE" type="XPath" expr="../GTM_Tom_Negative_Support = 'false'"/>                                           
                              <a:a name="DESC" 
                                   value="EN: This decides the output port and pin for the TOM Channel. This parameter is not applicable in case of configuration using bmd. While using Bmd, GtmToutConfiguration should be configured for Port assignment."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                                   value="0d28dada-8d27-4b19-8617-7d51dfc22df4"/>
                                  <a:da name="DEFAULT" type="XPath">                              
                                  <a:tst expr="text:split(ecu:get(concat('Gtm.Tom',node:fallback((../TomId),'F'),'Channel',node:fallback((../ChannelId),'XX'))), ',')[position()-1 = 0]"/>
    
                                 </a:da>
                                   <a:da name="RANGE" type="XPath" expr="ecu:list(concat('Gtm.Tom',node:fallback((../TomId),'F'),'Channel',node:fallback((../ChannelId),'XX')))"/>
                                 <a:da name="TOOLTIP" value="To decides the output port and pin."/>
                            </v:var>
                          </v:ctr>
                        </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
                  <v:lst name="Atom" type="MAP">
                      <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfAtomModules')"/>
                      <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfAtomModules')"/>
                    <v:ctr name="Atom" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains the ATOM Configuration for GTM"/>
                      <a:a name="REQUIRES-INDEX" value="true"/>
                      <a:a name="UUID" 
                           value="f1ee1b60-e430-4fb2-9ba9-d6eeff840c9f"/>
                      <v:lst name="AtomChannel" type="MAP">
                        <a:da name="MAX" value="8"/>
                        <a:da name="MIN" value="8"/>
                        <v:ctr name="AtomChannel" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: This container contains the ATOM AGC Channel configuration"/>
                          <a:a name="REQUIRES-INDEX" value="true"/>
                          <a:a name="UUID" 
                               value="2debfb13-6e25-4087-8df4-289d542c63f4"/>
                          <v:ctr name="AtomChannelOutput" type="IDENTIFIABLE">
                            <a:a name="DESC" 
                                 value="EN: This container contains the ATOM Channel Output configuration"/>
                            <a:a name="UUID" 
                                 value="29fc07c4-91ba-4196-b8fe-67544d2800a2"/>
                            <v:var name="GTM_Atom_Negative_Support" 
                                   type="BOOLEAN">
                              <a:a name="DESC" 
                                   value="EN: This parameter specifies the Atom negative module used or not."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         
                         <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                         </a:a>
                         
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                                   value="9d237c59-cff4-4b81-8b56-907da287657f"/>
                              <a:da name="DEFAULT" value="false"/>
                            </v:var>

                              <v:var name="AtomId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the ATOM Cluster."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bff3a116e75"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../../../../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.NumberOfAtomModules'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              </v:var>

                              <v:var name="ChannelId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the ATOM channel."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bffc1a116175"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.NumberOfAtomChannels'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              <a:da name="RANGE" type="XPath">
                                <a:tst expr="text:uniq(../../../*/AtomChannelOutput/ChannelId,.)"  false="Duplicated value, Id must be unique. Use the Calc button to calculate correct default value."/>
                              </a:da>                  
                              </v:var>

                            <v:var name="AtomChannelNegativePortPinSelect" 
                                   type="ENUMERATION">
                                  <a:da name="EDITABLE" type="XPath" expr="../GTM_Atom_Negative_Support = 'true'"/>        
                              <a:a name="DESC" 
                                   value="EN: This decides the output port and pin for the ATOM Channel. This parameter is not applicable in case of configuration using bmd. While using Bmd, GtmToutConfiguration should be configured for Port assignment."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                                   value="0d28dada-8d27-4b19-8617-7d51dfcd3df4"/>
                                  <a:da name="DEFAULT" type="XPath">                              
                                    <a:tst expr="text:split(ecu:get(concat('Gtm.Atom',node:fallback((../AtomId),'F'),'Channel',node:fallback((../ChannelId),'XX'),'N')), ',')[position()-1 = 0]"/>
                                  </a:da>
                                    <a:da name="RANGE" type="XPath" expr="ecu:list(concat('Gtm.Atom',node:fallback((../AtomId),'F'),'Channel',node:fallback((../ChannelId),'XX'),'N'))"/>
                                  <a:da name="TOOLTIP" value="To decides the output port and pin."/>
                                </v:var>
                            <v:var name="AtomChannelPortPinSelect" 
                                   type="ENUMERATION">
                                  <a:da name="EDITABLE" type="XPath" expr="../GTM_Atom_Negative_Support = 'false'"/>
                              <a:a name="DESC" 
                                   value="EN: This decides the output port and pin for the ATOM Channel. This parameter is not applicable in case of configuration using BMD. In such a case, GtmToutConfiguration should be used instead."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                                   value="86a39812-99d5-421c-b83d-54f66fbeace4"/>
                                  <a:da name="DEFAULT" type="XPath">
                                    <a:tst expr="text:split(ecu:get(concat('Gtm.Atom',node:fallback((../AtomId),'F'),'Channel',node:fallback((../ChannelId),'XX'))), ',')[position()-1 = 0]"/>
                                  </a:da>
                                    <a:da name="RANGE" type="XPath" expr="ecu:list(concat('Gtm.Atom',node:fallback((../AtomId),'F'),'Channel',node:fallback((../ChannelId),'XX')))"/>
                                  <a:da name="TOOLTIP" value="To decides the output port and pin."/>
                            </v:var>
                          </v:ctr>
                        </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
                  <v:lst name="Tim" type="MAP">
                      <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfTimModules')"/>
                      <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfTimModules')"/>
                    <v:ctr name="Tim" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains the TIM Configuration for GTM"/>
                      <a:a name="REQUIRES-INDEX" value="true"/>
                      <a:a name="UUID" 
                           value="e150fb37-a6f3-4a0f-8b78-945223f8b76f9"/>
                      <v:lst name="TimChannel" type="MAP">
                        <a:da name="MAX" value="8"/>
                        <a:da name="MIN" value="8"/>
                        <v:ctr name="TimChannel" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: This container contains the TIM Channel Configuration"/>
                          <a:a name="REQUIRES-INDEX" value="true"/>
                          <a:a name="UUID" 
                               value="953f028c-4690-41b4-92c0-e4251331046d5"/>
                               
                               
                               
                               
                          <v:ctr name="TimChannelGeneral" type="IDENTIFIABLE">
                            <a:a name="DESC" 
                                 value="EN: This container contains the TIM Channel General Configuration"/>
                            <a:a name="UUID" 
                                 value="07f27c5d-7c2e-40d3-ae46-40ba97792032"/>



                              <v:var name="TimId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the TIM Cluster."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bff4a116e75"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../../../../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.NumberOfTimModules'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              </v:var>

                              <v:var name="ChannelId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the TIM channel."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bffca1126175"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.NumberOfTimChannels'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              <a:da name="RANGE" type="XPath">
                                <a:tst expr="text:uniq(../../../*/TimChannelGeneral/ChannelId,.)"  false="Duplicated value, Id must be unique. Use the Calc button to calculate correct default value."/>
                              </a:da>     

                              </v:var>
                                   

                            <v:var name="TimChannelPortPinSelect" 
                                   type="ENUMERATION">
                              <a:a name="DESC" 
                                   value="EN: This decides the input port and pin of the TIM Channel. This value is applicable for this channel only if TimChannelInputSelect is configured as &apos;INPUT_OF_CURRENT_TIM_CHANNEL&apos;"/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                                   value="e48606de-7745-414d-8cc2-cb606e877ec0"/>
                                  <a:da name="DEFAULT" type="XPath">
                                  <a:tst expr="text:split(ecu:get(concat('Gtm.Tim',node:fallback((../TimId),'B'),'Channel',node:fallback((../ChannelId),'MD'))), ', ')[position()-1 = 0]"/>
                                  </a:da>
                                  <a:da name="RANGE" type="XPath" expr="ecu:list(concat('Gtm.Tim',node:fallback((../TimId),'B'),'Channel',node:fallback((../ChannelId),'MD')))"/>
                                  <a:da name="TOOLTIP" value="To decide the input port and pin of the TIM Channel"/>
                                </v:var>
                          </v:ctr>
                        </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>


                  <v:lst name="GtmToPeripheral" type="MAP">
                        <a:da name="MIN" value="1"/>
                        <a:da name="MAX" value="1"/>
                        <a:da name="EDITABLE" value="true"/>
                    <v:ctr name="GtmToPeripheral" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container defines the Connections between GTM and Peripheral Modules"/>
                      <a:a name="UUID" 
                           value="7eb2873a-3f03-4450-943a-8659ca2sa68d7"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>

                          <v:lst name="SaradcSent" type="MAP">
                            <a:da name="MAX" type="XPath" expr="num:i(4*ecu:get('Gtm.NumberOfTriggerChannel'))"/>
                            <a:da name="MIN" type="XPath" expr="num:i(4*ecu:get('Gtm.NumberOfTriggerChannel'))"/>
                            <v:ctr name="SaradcSent" type="IDENTIFIABLE">
                              <a:a name="DESC" 
                                   value="EN: This Specifies the TOM/ATOM channels that can be used as ADC/SENT Triggers"/>
                              <a:a name="REQUIRES-INDEX" value="true"/>
                              <a:a name="UUID" 
                                   value="93252045-2689-470a-b302-a6fe4ba0bd51d"/>



                              <v:var name="ChannelId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the Gtm to ADC or SENT Module ID, Only TRIXCHY_* (X:0 , Y:0~11) is used by Sent.&lt;br/&gt;
                                     &lt;h1&gt;THA6206:&lt;/h1&gt;
                                     channelId0:Sent/SarAdc0&lt;br/&gt;
                                     channelId1:Sent/SarAdc1&lt;br/&gt;
                                     channelId2:Sent/SarAdc2&lt;br/&gt;
                                     channelId3:Sent/SarAdc3&lt;br/&gt;
                                     channelId4:Sent&lt;br/&gt;
                                     channelId5:Sent&lt;br/&gt;
                                     channelId6:Sent&lt;br/&gt;
                                     channelId7:Sent&lt;br/&gt;
                                     channelId8:Sent/SarAdc8&lt;br/&gt;
                                     channelId9:Sent/SarAdc9&lt;br/&gt;
                                     channelId10:Sent&lt;br/&gt;
                                     channelId11:Sent&lt;br/&gt;
                                     &lt;h1&gt;THA6412:&lt;/h1&gt;
                                     channelId0:Sent/SarAdc0&lt;br/&gt;
                                     channelId1:Sent/SarAdc1&lt;br/&gt;
                                     channelId2:Sent/SarAdc2&lt;br/&gt;
                                     channelId3:Sent/SarAdc3&lt;br/&gt;
                                     channelId4:Sent/SarAdc4&lt;br/&gt;
                                     channelId5:Sent/SarAdc5&lt;br/&gt;
                                     channelId6:Sent/SarAdc6&lt;br/&gt;
                                     channelId7:Sent/SarAdc7&lt;br/&gt;
                                     channelId8:Sent/SarAdc8&lt;br/&gt;
                                     channelId9:Sent/SarAdc9&lt;br/&gt;
                                     channelId10:Sent/SarAdc10&lt;br/&gt;
                                     channelId11:Sent/SarAdc11&lt;br/&gt;"/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bffc4a116175"/>
                              <a:da name="DEFAULT" type="XPath" expr="num:i(node:fallback(node:current()/../@index, num:i(0)) div 4)"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.NumberOfTriggerChannel'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              <a:da name="RANGE" type="XPath">
                                <a:tst expr="count(../../*/ChannelId [.= node:current()]) = 4" false="Each ChannelId must appear exactly 4 times."/>
                                <!-- <a:tst expr="text:uniq(../../*/ChannelId,.)"  false="Duplicated value, Id must be unique. Use the Calc button to calculate correct default value."/> -->
                              </a:da>                                 
                              </v:var>
                              <v:var name="GtmTriggerSelect" type="ENUMERATION">
                                <a:a name="DESC" 
                                     value="EN: This Specifies the TOM/ATOM channel that will be used as GTM Trigger. This configuration is to set GTM_ADCTRGxOUTy"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" 
                                     value="2fbe0df3-669a-45bc-b6fa-b02cf1514b32"/>

                                <a:da name="TOOLTIP" value="To specify the TOM/ATOM channel that will be used as ADC Trigger0"/>
                                <a:da name="DEFAULT" type="XPath">
                                <a:tst expr="text:split(ecu:get(concat('Gtm.SarAdc',node:fallback((../ChannelId),'X'),'Trigger','X','Out')), ', ')[position()-1 = 0]"/>
                                </a:da>
                                <a:da name="RANGE" type="XPath" expr="ecu:list(concat('Gtm.SarAdc',node:fallback((../ChannelId),'X'),'Trigger','X','Out'))"/>
                              </v:var>
                            </v:ctr>
                          </v:lst>


                          <v:lst name="Dsadc" type="MAP">
                            <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.DsadcNum')"/>
                            <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.DsadcNum')"/>
                            <v:ctr name="Dsadc" type="IDENTIFIABLE">
                              <a:a name="DESC" 
                                   value="EN: This Specifies the TOM/ATOM channels that can be used as DSADC Triggers"/>
                              <a:a name="REQUIRES-INDEX" value="true"/>
                              <a:a name="UUID" 
                                   value="93252045-2689-470a-b302-a6fe4ba0b1f1d"/>

                                   
                              <v:var name="ChannelId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the DSADC channel."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bffc4aEE6175"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <!--  Special handling, in case Gtm.DsadcNum is 0, not handling it will result in -1  -->
                              <a:tst expr="&lt;=num:inttohex(num:i(ecu:get('Gtm.DsadcNum')-num:i(1)),2)"/>                                    
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              <a:da name="RANGE" type="XPath">
                                <a:tst expr="text:uniq(../../*/ChannelId,.)"  false="Duplicated value, Id must be unique. Use the Calc button to calculate correct default value."/>
                              </a:da>                              
                              </v:var>
                              <v:var name="GtmTriggerSelect" type="ENUMERATION">
                                <a:a name="DESC" 
                                     value="EN: This Specifies the TOM/ATOM channel that will be used as GTM Trigger for dsadc. This configuration is to set DSADCOUTMUX*"/>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              </a:a>
                              
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" 
                                     value="2fgg0df3-669a-45bc-b6fa-b02cf1514b32"/>
                                <a:da name="TOOLTIP" value="To specify the TOM/ATOM channel that will be used as DSADC "/>
                                <a:da name="DEFAULT" type="XPath">
                                <a:tst expr="text:split(ecu:get(concat('Gtm.DsAdc',node:fallback((../ChannelId),'X'),'Trigger','X','Out')), ', ')[position()-1 = 0]"/>
                                </a:da>
                                <a:da name="RANGE" type="XPath" expr="ecu:list(concat('Gtm.DsAdc',node:fallback((../ChannelId),'X'),'Trigger','X','Out'))"/>
                              </v:var>
                              </v:ctr>
                            </v:lst>


                           <v:lst name="Msc" type="MAP">
                              <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfMsc')"/>
                              <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfMsc')"/>  

                            <v:ctr name="Msc" type="IDENTIFIABLE">
                              <a:a name="DESC" 
                                  value="EN: This container contains the General Configuration for Msc"/>
                              <a:a name="REQUIRES-INDEX" value="true"/>
                              <a:a name="UUID" 
                                  value="8d57a7cd-f92b-4635-a37f-6e0bad166der"/>


                            <v:var name="HwId" type="INTEGER">
                            <a:a name="DESC" 
                            value="EN: Id of the MSC."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                            type="IMPLEMENTATIONCONFIGCLASS">
                            
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                            value="93d2144e-864c-416f-b733-7bffca116166"/>
                            <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(0))"/>
                            <a:da name="INVALID" type="Range">
                            <!--  Special handling, in case Gtm.NumberOfMsc is 0, not handling it will result in -1  -->
                            <a:tst expr="&lt;=num:inttohex(num:i(ecu:get('Gtm.NumberOfMsc')-num:i(1)),2)"/>                            
                            <a:tst expr="&gt;=0"/>
                            </a:da>
                              <a:da name="RANGE" type="XPath">
                              <a:tst expr="text:uniq(../../*/HwId,.)"  false="Duplicated value, Id must be unique. Use the Calc button to calculate correct default value."/>
                              </a:da>                          
                            </v:var>   



                            <v:lst name="MscDataBit" type="MAP">
                                  <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfMscSel')"/>
                                  <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfMscSel')"/>
                              <v:ctr name="MscDataBit" type="IDENTIFIABLE">
                                <a:a name="DESC" 
                                    value="EN: This Specifies the Set channels that can be used as input of MSC"/>
                                <a:a name="REQUIRES-INDEX" value="true"/>
                                <a:a name="UUID" 
                                    value="93252045-2689-470a-b302-a6fe4b0sd51d"/>

                              <v:var name="BitId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the MSC level2 Set channel."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bffca116175"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <!--  Special handling, in case Gtm.NumberOfMscSel is 0, not handling it will result in -1  -->
                              <a:tst expr="&lt;=num:inttohex(num:i(ecu:get('Gtm.NumberOfMscSel')-num:i(1)),2)"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                                <a:da name="RANGE" type="XPath">
                                <a:tst expr="text:uniq(../../*/ChannelId,.)"  false="Duplicated value, Id must be unique. Use the Calc button to calculate correct default value."/>
                                </a:da>                          
                              </v:var>



                                <v:var name="MscDataBitLowConfiguration" type="ENUMERATION">
                                  <a:a name="DESC" 
                                      value="EN: This Specifies the Setx channels that can be used as input of MSC"/>
                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                                    
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                  <a:a name="UUID" 
                                      value="pfbe0df3-669a-45bc-b6fa-b02cf1514b32"/>

                                      <a:da name="TOOLTIP" value="This Specifies the Setx channels that can be used as input of MSC"/>
                                        <a:da name="DEFAULT" value="SETX_NO_USED"/>

                                      <a:da name="RANGE" type="XPath" expr="ecu:list('Gtm.MscBitx')"/>
                                    </v:var>


                                    <v:var name="MscDataBitHighConfiguration"
                                          type="ENUMERATION">
                                      <a:a name="DESC"
                                          value="EN: This Specifies the Setx channels that can be used as input of MSC"/>
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                                    
                                      
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                      <a:a name="UUID"
                                          value="afbe0df3-669a-45bc-b6fa-b02cf1514b32"/>

                                      <a:da name="TOOLTIP" value="This Specifies the Setx channels that can be used as input of MSC"/>
                                        <a:da name="DEFAULT" value="SETX_NO_USED"/>

                                      <a:da name="RANGE" type="XPath" expr="ecu:list('Gtm.MscBitx')"/>
                                    </v:var>

                              </v:ctr>
                            </v:lst>
                            </v:ctr>
                            </v:lst>



                        
                        <v:lst name="Dma" type="MAP">
                            <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.DmaRequestNum')"/>
                            <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.DmaRequestNum')"/>
                        <v:ctr name="Dma" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: This Specifies the TOM/ATOM channels that can be used as tirgger of DMA"/>
                          <a:a name="REQUIRES-INDEX" value="true"/>
                          <a:a name="UUID" 
                               value="93252045-2689-470a-b302-aafe4b0bd51d"/>

                              <v:var name="DmaRequestId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the GtmToDma Register id."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bff7a116e75"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.DmaRequestNum'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              <a:da name="RANGE" type="XPath">
                              <a:tst expr="text:uniq(../../*/DmaRequestId,.)"  false="Duplicated value, Id must be unique. Use the Calc button to calculate correct default value."/>
                              </a:da>                               
                              </v:var>

                              <v:var name="TriggerSource"
                                     type="ENUMERATION">
                                <a:a name="DESC"
                                     value="EN: This Specifies the TOM/ATOM channel that will be used as input of DmaRequest."/>
                               <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              </a:a>
                              
                                
                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                            <a:a name="ORIGIN" value="ChipowerTech"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID"
                                     value="dfbe0df3-669a-45bc-b6fa-b02cf1514b32"/>

                                <a:da name="DEFAULT" type="XPath">
                                <a:tst expr="text:split(ecu:get(concat('Gtm.DMAL2MU','X','n')), ',')[position()-1 = 0]"/>
                                </a:da>
                                <a:da name="RANGE" type="XPath" expr="ecu:list(concat('Gtm.DMAL2MU','X','n'))"/>
                              </v:var>

                            </v:ctr>
                          </v:lst>

                          <v:lst name="GtmOutput" type="MAP">
                            <a:da name="MAX" type="XPath" expr="num:i(ecu:get('Gtm.NumberOfTomModules') * ecu:get('Gtm.NumberOfTomChannels') +
                                                                ecu:get('Gtm.NumberOfAtomModules') * ecu:get('Gtm.NumberOfAtomChannels'))"/>
                            <a:da name="MIN" type="XPath" expr="num:i(0)"/>
                                <v:ctr name="GtmOutput" type="IDENTIFIABLE">
                                    <a:a name="DESC" value="EN: This container contains the configuration (parameters) in case the Trigger SIGNALS."/>
                                    <a:a name="REQUIRES-INDEX" value="true"/>
                                    <a:a name="UUID" value="9ba56c8a-f47b-4e15-beaf-c4e6a2734ea2"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>

                                    <v:ref name="GtmTimerUsed" type="CHOICE-REFERENCE">
                                      <a:a name="DESC" value="EN: This parameter lists all the GTM timer channels (TOM/ATOM)."/>
                                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                      </a:a>
                                      <a:a name="ORIGIN" value="ChipowerTech"/>
                                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                      <a:a name="SCOPE" value="ECU"/>
                                      <a:a name="UUID" value="ECUC:c98add5e-1l6b-4bdc-a8ab-0a4d19ec3595"/>
                                      <a:da name="REF">
                                          <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Mcu/GtmConfiguration/GtmResourceAllocationConf/GtmAtom/GtmAtomChannel</a:v>
                                          <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Mcu/GtmConfiguration/GtmResourceAllocationConf/GtmTom/GtmTomChannel</a:v>
                                      </a:da>
                                      <a:da name="INVALID" type="XPath">
                                          <a:tst expr="not(text:uniq(../../*/GtmTimerUsed, .))"
                                                 true="Duplicate GtmTimerUsed" />
                                          <a:tst
                                            expr="node:exists(node:ref(../GtmTimerUsed)/GtmTomChannel) and 
                                                  (node:ref(.)/GtmTomChannel != 'GTM_TOM_CHANNEL_NOT_USED') and 
                                                  (node:ref(.)/GtmTomChannel != 'GTM_TOM_CHANNEL_USED_BY_MCU')"
                                            true="The configured TOM channel is not allocted for MCU driver" />
                                          <a:tst
                                            expr="node:exists(node:ref(../GtmTimerUsed)/GtmAtomChannel) and 
                                                  (node:ref(.)/GtmAtomChannel != 'GTM_ATOM_CHANNEL_NOT_USED') and 
                                                  (node:ref(.)/GtmAtomChannel != 'GTM_ATOM_CHANNEL_USED_BY_MCU')"
                                            true="The configured ATOM channel is not allocted for MCU driver" />
                                      </a:da>
                                    </v:ref>
                                        <v:ref name="GtmMcuClockReference" type="REFERENCE">
                                        <a:a name="DESC" value="EN: This parameter defines GTM ATOM/TOM channle clock(hz) &lt;br/&gt;
                                                                This parameter is reference from MCU GTM Cmu clock, configure clock first in MCU Container"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="ChipowerTech"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SCOPE" value="LOCAL"/>
                                        <a:a name="UUID" value="d8be721b-0b4d-45a3-9e64-c89f3b04b300"/>
                                        <a:da name="EDITABLE" value="true"/>
                                        <a:da name="REF" value="ASPathDataOfSchema:/THA6_AS440_FuSa/Mcu/GtmConfiguration/Cmu/CmuClockReferencePoint" />
                                        <a:da name="INVALID" type="XPath">
                                            <a:tst expr="node:refvalid(.)" false="Invalid or empty reference." />
                                        </a:da>
                                    </v:ref>

                                    <v:var name="GtmTimerClockSelect" type="ENUMERATION">
                                    <a:a name="DESC" value="EN: This parameter decides the Clock Source for TOM/ATOM timer.For ATOM channel the available clocksrcs are&lt;br/&gt;
                                                            CMU_CLK0,CMU_CLK1,CMU_CLK2,CMU_CLK3,CMU_CLK4,CMU_CLK5,CMU_CLK6,CMU_CLK7.&lt;br/&gt;
                                                            For TOM channel the available clocksrcs are &lt;br/&gt;
                                                            CMUFXCLK0 (CMU_FXCLK)&lt;br/&gt;
                                                            CMUFXCLK1 (CMU_FXCLK/16)&lt;br/&gt;
                                                            CMUFXCLK2 (CMU_FXCLK/256)&lt;br/&gt;
                                                            CMUFXCLK3 (CMU_FXCLK/4096)&lt;br/&gt;
                                                            CMUFXCLK4 (CMU_FXCLK/65536)&lt;br/&gt;"/>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                              
                                    <a:a name="ORIGIN" value="ChipowerTech"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SCOPE" value="LOCAL"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="31514abb-3296-4c09-bdb7-d0909f1440f2"/>
                                    <a:da name="DEFAULT" value="CMUFXCLK0"/>
                                    <a:da name="EDITABLE" type="XPath" expr="not(node:exists(node:ref(../GtmTimerUsed)/GtmAtomChannel))" />
                                    <a:da name="RANGE">
                                        <a:v>CMUFXCLK0</a:v>
                                        <a:v>CMUFXCLK1</a:v>
                                        <a:v>CMUFXCLK2</a:v>
                                        <a:v>CMUFXCLK3</a:v>
                                        <a:v>CMUFXCLK4</a:v>
                                    </a:da>
                                    </v:var>
                                    <v:var name="GtmTimerTimePeriod" type="INTEGER">
                                        <a:a name="DESC"> <a:v>EN: This parameter is used for selecting the time period of the GTM timer in micro seconds.</a:v>
                                        </a:a>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="c6a84657-cf20-43cf-8e24-9cb114e0aa1c"/>
                                    <a:da name="EDITABLE" type="XPath">
                                        <a:tst expr="../GtmTimerCM0Ticks = num:i(0)" />
                                    </a:da>
                                    <a:da name="DEFAULT" value="20000"/>
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=65536000"/>
                                        <a:tst expr="&gt;=0"/>
                                    </a:da>
                                    </v:var>

                                    <v:var name="GtmTimerCM0Ticks" type="INTEGER">
                                    <a:a name="DESC"> <a:v>EN: This parameter specifies the Period Compare value (CM0) for the TOM/ATOM Channel in ticks. Only valid if GtmTimerTimePeriod is 0.</a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech"/>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                    <a:a name="UUID" value="c6a84657-cf20-43cf-8e14-9cb114e0aa1c"/>
                                    <a:da name="EDITABLE" type="XPath">
                                        <a:tst expr="../GtmTimerTimePeriod = num:i(0)" />
                                    </a:da>
                                    <a:da name="DEFAULT" value="0" />
                                    <a:da name="INVALID" type="Multi">
                                        <mt:xpath expr="node:exists(node:ref(../GtmTimerUsed)/GtmTomChannel) and (. &gt; num:i(65535))" true="EN:  - For TOM channels CM0 ticks cannot exceed 65535" />
                                        <mt:xpath expr="node:exists(node:ref(../GtmTimerUsed)/GtmAtomChannel) and (. &gt; num:i(16777215))" true="EN:  - For ATOM channels CM0 ticks cannot exceed 16777215" />
                                        <mt:xpath expr=" . =num:i(0) and ../GtmTimerTimePeriod = num:i(0)" true="EN:  - For GTM a channels, both GtmTimerCM0Ticks and GtmTimerTimePeriod cannot be 0 simultaneously" />
                                        <mt:range>
                                        <mt:tst expr="&gt;=0" />
                                        <mt:tst expr="&lt;=16777215" />
                                        </mt:range>
                                    </a:da>
                                    </v:var>

                                </v:ctr>
                            </v:lst>
                    </v:ctr>
                  </v:lst>

                  <v:lst name="GtmResourceAllocationConf" type="MAP">
                        <a:da name="MIN" value="1"/>
                        <a:da name="MAX" value="1"/>
                    <v:ctr name="GtmResourceAllocationConf" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container is used to represent the usage of GTM resources by other modules. Users can allocate GTM resources to individual modules. No error is reported when not configured."/>
                      <a:a name="UUID" 
                           value="a876af28-1479-42bc-832b-0b6bc1212fc8"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <v:lst name="GtmTim" type="MAP">
                            <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfTimModules')"/>
                            <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfTimModules')"/>   
                        <v:ctr name="GtmTim" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="FOR-ALL: This container contains the TIM Configuration for GTM"/>
                          <a:a name="REQUIRES-INDEX" value="true"/>
                          <a:a name="UUID" 
                               value="5f97ac83-7875-40ff-9995-286438baa0d6"/>
                          <v:lst name="GtmTimChannel" type="MAP">
                                <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfTimChannels')"/>
                                <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfTimChannels')"/>
                            <v:ctr name="GtmTimChannel" type="IDENTIFIABLE">
                              <a:a name="DESC" 
                                   value="FOR-ALL: This container contains the TIM Channel Configuration"/>
                              <a:a name="REQUIRES-INDEX" value="true"/>
                              <a:a name="UUID" 
                                   value="fa7ac16a-2e36-417b-8542-c79600fefeb0"/>



                              <v:var name="ModuleId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the TIM Cluster."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bffca186e75"/>
                              <a:da name="DEFAULT" type="XPath" expr="num:i(node:fallback(node:current()/../../../@index, num:i(0)))"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.NumberOfTimModules'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              </v:var>

                              <v:var name="ChannelId" type="INTEGER">
                              <a:a name="DESC" 
                              value="EN: Id of the TIM channel."/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="ChipowerTech"/>
                              <a:a name="SCOPE" value="ECU"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                              value="93d2144e-864c-416f-b733-7bffc9116e75"/>
                              <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(0))"/>
                              <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;num:i(ecu:get('Gtm.NumberOfTimChannels'))"/>
                              <a:tst expr="&gt;=0"/>
                              </a:da>
                              <a:da name="RANGE" type="XPath">
                              <a:tst expr="text:uniq(../../*/ChannelId,.)"  false="Duplicated value, Id must be unique. Use the Calc button to calculate correct default value."/>
                              </a:da>                              
                              </v:var>


                              <v:var name="GtmTimChannel" type="ENUMERATION">
                                <a:a name="DESC">
                                  <a:v>FOR-ALL: This decides as to if this Channel is used for ICU or not be used.&lt;br/&gt;
                                     GTM_TIM_CHANNEL_NOT_USED: Specifies that this Channel is not configured by any module (unused).&lt;br/&gt;
                                     GTM_TIM_CHANNEL_USED_BY_ICU: Specifies that this Channel is configured by ICU module.</a:v>
                                </a:a>
                                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              </a:a>
                                <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                <a:a name="ORIGIN" value="ChipowerTech"/>
                                <a:a name="SCOPE" value="LOCAL"/>
                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                <a:a name="UUID" 
                                     value="b1fb3065-c8c2-4b45-af5f-d22b0bc11149"/>
                                <a:da name="DEFAULT" 
                                      value="GTM_TIM_CHANNEL_NOT_USED"/>
                                <a:da name="RANGE">
                                  <a:v>GTM_TIM_CHANNEL_NOT_USED</a:v>
                                  <a:v>GTM_TIM_CHANNEL_USED_BY_ICU</a:v>
                                </a:da>
                              </v:var>
                            </v:ctr>
                          </v:lst>
                        </v:ctr>
                      </v:lst>
                      <v:lst name="GtmTom" type="MAP">
                            <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfTomModules')"/>
                            <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfTomModules')"/>
                        <v:ctr name="GtmTom" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="FOR-ALL: This container contains the TOM Configuration for GTM"/>
                          <a:a name="REQUIRES-INDEX" value="true"/>
                          <a:a name="UUID" 
                               value="3cee5c9f-223e-4c6e-989f-e7b4e214fe3d"/>
                          <v:lst name="GtmTomChannel" type="MAP">
                                <a:da name="MIN" type="XPath" expr="ecu:get('Gtm.NumberOfTomChannels')"/>
                                <a:da name="MAX" type="XPath" expr="ecu:get('Gtm.NumberOfTomChannels')"/>
                            <v:ctr name="GtmTomChannel" type="IDENTIFIABLE">
                              <a:a name="DESC" 
                                   value="FOR-ALL: This container contains the TOM Channel Configuration"/>
                              <a:a name="REQUIRES-INDEX" value="true"/>
                              <a:a name="UUID" 
