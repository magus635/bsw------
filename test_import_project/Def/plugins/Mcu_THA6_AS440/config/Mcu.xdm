                             value="20c74c4c-f122-4ecb-a75b-367bc5536"/>
                        <a:da name="DEFAULT" 
                              value="RCC_MODULECLOCKSOURCE_PERPLL"/>
                        <a:da name="RANGE">
                          <a:v>RCC_MODULECLOCKSOURCE_HSI</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_PERPLL</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_HSE</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="CANClockDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the CANClockDiv coefficient of Clock.()Note: ."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
