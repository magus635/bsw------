                    <v:ctr name="McuBaseTimerClk_Configuration" type="IDENTIFIABLE">
                      <a:a name="UUID" 
                             value="20474c4c-fdc2-4ecb-a75b-367a36acf986"/>
                      <a:a name="DESC" 
                             value="EN: McuBaseTimer Configration"/>       
                        <v:var name="BaseTimer0ClockSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Choose the clock source of BaseTimer .(HSI,HSE,PerPllClk/2.)"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="w0c74c4c-fdc2-4ecb-a75b-367bc5536"/>
                        <a:da name="DEFAULT" 
                              value="RCC_MODULECLOCKSOURCE_PERPLL"/>
                        <a:da name="RANGE">
                          <a:v>RCC_MODULECLOCKSOURCE_HSI</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_PERPLL</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_HSE</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="BaseTimer0ClockDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the ClockDiv coefficient of BaseTimer Clock.(BaceTimerXCLK=BaseTimerXClockSource/(BaseTimerXClockDiv+1))"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d32e-4db9-ac7e-5830ab9aed1d72a3"/>
                        <a:da name="DEFAULT" value="3"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.Div16BitMax')"/>
                          <a:tst expr="&gt;=ecu:get('Mcu.BasetimerMinDiv')"/>

                        </a:da>
                      </v:var>
                      <v:var name="BaseTimer0Frequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The BaseTimer clock frequency. The expression is BaceTimerCLK=BaseTimerClockSource/(BaseTimerClockDiv+1)."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-5830123f07f3"/>
