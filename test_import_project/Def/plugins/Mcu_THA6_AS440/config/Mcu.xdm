                              value="RCC_MODULECLOCKSOURCE_PERPLL"/>
                        <a:da name="RANGE">
                          <a:v>RCC_MODULECLOCKSOURCE_HSI</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_PERPLL</a:v>
                          <a:v>RCC_MODULECLOCKSOURCE_HSE</a:v>
                        </a:da>
                      </v:var>
                      <v:var name="CpuWDTClockDiv" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: Set the CpuWDTClockDiv coefficient of Clock.()"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d32e-4db9-ac7e-5830ab9aeddd72a3"/>
                        <a:da name="DEFAULT" value="3"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=ecu:get('Mcu.Div5BitMax')"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
                      <v:var name="McuCPU_WDTClkFrequency" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: The CPU_WDT clock frequency. The expression is WdtClk =CpuWDTClockSource/(CpuWDTClockDiv+1)."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-583012s407f3"/>
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->round(node:when(node:value(../CpuWDTClockSource) = 'RCC_MODULECLOCKSOURCE_PERPLL',(node:value(../../McuPerPllClk_Configuration/McuPerPllFrequency) div ecu:get('Mcu.PerPllClkDivValue')) div (node:value(../CpuWDTClockDiv ) + 1),node:when(node:value(../CpuWDTClockSource) = 'RCC_MODULECLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency) div (node:value(../CpuWDTClockDiv ) + 1),node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency) div (node:value(../CpuWDTClockDiv ) + 1))))&quot;,ecu:get('Mcu.WDGClkMaxFrequency'))"/>
                        <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=ecu:get('Mcu.WDGClkMaxFrequency')"/>
                          <a:tst expr="&gt;=0.0"/>
                        </a:da>
                         <a:a name="INVALID" type="XPath">
                         <a:tst expr="( 
                                        node:fallback(., ecu:get('Mcu.WDGClkMaxFrequency')) !=
                                        ( num:i( node:fallback(&quot;->round(node:when(node:value(../CpuWDTClockSource) = 'RCC_MODULECLOCKSOURCE_PERPLL',(node:value(../../McuPerPllClk_Configuration/McuPerPllFrequency) div ecu:get('Mcu.PerPllClkDivValue')) div (node:value(../CpuWDTClockDiv ) + 1),node:when(node:value(../CpuWDTClockSource) = 'RCC_MODULECLOCKSOURCE_HSI',node:value(../../McuSysPllClk_Configuration/McuHSIClkFrequency) div (node:value(../CpuWDTClockDiv ) + 1),node:value(../../McuSysPllClk_Configuration/McuHSEClkFrequency) div (node:value(../CpuWDTClockDiv ) + 1))))&quot;,ecu:get('Mcu.WDGClkMaxFrequency')))                                       )
                                   )"
                         true="Please press the button to calculate the value automatically."/>
                         </a:a>

                      </v:var>
                    </v:ctr>
                    <v:ctr name="McuCanClk_Configuration" type="IDENTIFIABLE">
                      <a:a name="UUID" 
                             value="d0cc3f95-d80e-4db9-ac7e-583012k407f3"/>
                      <a:a name="DESC" 
                             value="EN: McuCanClk Configuration"/>
                         <v:var name="CANClockSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Choose the clock source of CAN.((HSI,HSE,PerPllClk))"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
