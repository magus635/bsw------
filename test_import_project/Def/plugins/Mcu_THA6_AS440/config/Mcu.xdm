                             value="EN: McuWDTClk Configuration"/>
                         <v:var name="CpuWDTClockSource" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Choose the clock source of WDT internal CPU.(HSI,HSE,PerPllClk/2.)"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech"/>
