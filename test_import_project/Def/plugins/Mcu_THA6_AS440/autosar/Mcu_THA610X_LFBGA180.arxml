                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="26ec9dd3-0304-4f0f-b8db-7cde8e77ef8c">
                      <SHORT-NAME>TbuChannel</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container provides the TBU Channel configuration.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>3</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>3</UPPER-MULTIPLICITY>
                      <REQUIRES-INDEX>true</REQUIRES-INDEX>
                      <PARAMETERS>
                        <ECUC-INTEGER-PARAM-DEF UUID="badb922c-fc6c-4da1-bcd6-3c423d586ebe">
                          <SHORT-NAME>TbuChannelID</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter provides the channel ID which is unique in a given TBU Driver. The value for this parameter starts with 0 and continue without any gaps.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="dcfde6b2-d061-4579-827b-1374a8506cc0">
                          <SHORT-NAME>TbuEnableChannel</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables the TBU Channel.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="b51eb5b9-82e9-45f8-b316-483952e37f16">
                          <SHORT-NAME>TbuChannelModeSelect</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This decides the Mode for the TBU Channel. This is only applicable for TBU Channel 1 and 2&lt;br/&gt;
                              FOR-ALL: GTM_TBU_MODE_FREERUNNING: Free Running Mode chosen&lt;br/&gt;
                              FOR-ALL: GTM_TBU_MODE_FORWARDBACKWARD: Forward Backward Counter mode chosen</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>GTM_TBU_MODE_FREERUNNING</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TBU_MODE_FREERUNNING</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TBU_MODE_FORWARDBACKWARD</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="7eb44dbc-47b1-497a-a14b-f61dfed6ffb9">
                          <SHORT-NAME>TbuChannelClockSource</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL">value=&quot;EN: This decides the Clock Source for the TBU Channel&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_0: Configurable Clock0 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_1: Configurable Clock1 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_2: Configurable Clock2 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_3: Configurable Clock3 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_4: Configurable Clock4 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_5: Configurable Clock5 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_6: Configurable Clock6 is chosen&lt;br/&gt;
                              FOR-ALL: GTM_CMU_CLK_7: Configurable Clock7 is chosen</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>GTM_CMU_CLK_0</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_CMU_CLK_0</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_CMU_CLK_1</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_CMU_CLK_2</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_CMU_CLK_3</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_CMU_CLK_4</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_CMU_CLK_5</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_CMU_CLK_6</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_CMU_CLK_7</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="b820f4c2-e880-47fb-a7a8-2582326f4111">
                          <SHORT-NAME>TbuChannelResolution</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This decides the resolution for the TBU Channel. This is only applicable for TBU Channel 0&lt;br/&gt;
                                        GTM_TBU_TS0_BIT_LOWER: Choose Lower 24 Bits of TBU&lt;br/&gt;
                                        GTM_TBU_TS0_BIT_UPPER: Choose Higher 24 Bits of TBU</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>GTM_TBU_TS0_BIT_LOWER</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TBU_TS0_BIT_LOWER</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>GTM_TBU_TS0_BIT_UPPER</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="d6230b5f-8bab-4ec1-a04e-4bcbe435c5ee">
                          <SHORT-NAME>TbuTimebaseValue</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter specifies the Timebase value for the TBU Channel</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
