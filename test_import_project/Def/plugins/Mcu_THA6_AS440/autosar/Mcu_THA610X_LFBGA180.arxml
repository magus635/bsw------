              <SUB-CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="8d57a7cd-f92b-4635-a37f-6e0bad136d74">
                  <SHORT-NAME>GtmGeneral</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">This container contains the General Configuration for GTM</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF UUID="8f883293-79c9-410a-9bde-90ce47513eb3">
                      <SHORT-NAME>CMUGlobalClkDivNumerator</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter specifies the Numerator value for the CMU Global Clock Divider.
                                 This modifies GTM_CMU_GCLK_NUM [GCLK_NUM].
                                 Global Clock = System Clock *
                                 ( CMUGlobalClkDivDenominator/ CMUGlobalClkDivNumerator).</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>ChipowerTech</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>1</DEFAULT-VALUE>
                      <MAX>16777215</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="575bcd81-b912-43b2-8ea0-3bf6a35081b4c">
                      <SHORT-NAME>CMUGlobalClkDivDenominator</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter specifies the Denominator value for the CMU Global Clock Divider.
                                Global Clock = System Clock *
                                ( CMUGlobalClkDivDenominator/ CMUGlobalClkDivNumerator).
                                This value should be configured lesser than Numerator value.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>ChipowerTech</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>1</DEFAULT-VALUE>
                      <MAX>16777215</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
