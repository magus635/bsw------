                        <ECUC-INTEGER-PARAM-DEF UUID="025116c3-e3e8-4241-a746-00d1f44451f4">
                          <SHORT-NAME>CmuExternalClk0Numerator</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter specifies the Numerator value for the External Clock Divider0. This modifies GTM_CMU_ECLK_0_NUM [ECLK_NUM].
                                         Final Clock value = System clock Frequency/(2 *( CmuExternalClk0Numerator/ CmuExternalClk0Denominator))</L-2>
                          </DESC>
