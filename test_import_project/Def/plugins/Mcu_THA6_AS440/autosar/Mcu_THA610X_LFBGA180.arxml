                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="7eb2873a-3f03-4450-943a-8659ca2sa68d7">
                  <SHORT-NAME>GtmToPeripheral</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">This container defines the Connections between GTM and Peripheral Modules</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <MULTIPLICITY-CONFIG-CLASSES>
                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  </MULTIPLICITY-CONFIG-CLASSES>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="93252045-2689-470a-b302-a6fe4ba0bd51d">
                      <SHORT-NAME>SaradcSent</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This Specifies the TOM/ATOM channels that can be used as ADC/SENT Triggers</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>48</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>48</UPPER-MULTIPLICITY>
                      <REQUIRES-INDEX>true</REQUIRES-INDEX>
                      <PARAMETERS>
                        <ECUC-INTEGER-PARAM-DEF UUID="93d2144e-864c-416f-b733-7bffc4a116175">
                          <SHORT-NAME>ChannelId</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Id of the Gtm to ADC or SENT Module ID, Only TRIXCHY_* (X:0 , Y:0~11) is used by Sent.&lt;br/&gt;                                      &lt;h1&gt;THA6206:&lt;/h1&gt;                                      channelId0:Sent/SarAdc0&lt;br/&gt;                                      channelId1:Sent/SarAdc1&lt;br/&gt;                                      channelId2:Sent/SarAdc2&lt;br/&gt;                                      channelId3:Sent/SarAdc3&lt;br/&gt;                                      channelId4:Sent&lt;br/&gt;                                      channelId5:Sent&lt;br/&gt;                                      channelId6:Sent&lt;br/&gt;                                      channelId7:Sent&lt;br/&gt;                                      channelId8:Sent/SarAdc8&lt;br/&gt;                                      channelId9:Sent/SarAdc9&lt;br/&gt;                                      channelId10:Sent&lt;br/&gt;                                      channelId11:Sent&lt;br/&gt;                                      &lt;h1&gt;THA6412:&lt;/h1&gt;                                      channelId0:Sent/SarAdc0&lt;br/&gt;                                      channelId1:Sent/SarAdc1&lt;br/&gt;                                      channelId2:Sent/SarAdc2&lt;br/&gt;                                      channelId3:Sent/SarAdc3&lt;br/&gt;                                      channelId4:Sent/SarAdc4&lt;br/&gt;                                      channelId5:Sent/SarAdc5&lt;br/&gt;                                      channelId6:Sent/SarAdc6&lt;br/&gt;                                      channelId7:Sent/SarAdc7&lt;br/&gt;                                      channelId8:Sent/SarAdc8&lt;br/&gt;                                      channelId9:Sent/SarAdc9&lt;br/&gt;                                      channelId10:Sent/SarAdc10&lt;br/&gt;                                      channelId11:Sent/SarAdc11&lt;br/&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>11</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="2fbe0df3-669a-45bc-b6fa-b02cf1514b32">
                          <SHORT-NAME>GtmTriggerSelect</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This Specifies the TOM/ATOM channel that will be used as GTM Trigger. This configuration is to set GTM_ADCTRGxOUTy</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>ChipowerTech</ORIGIN>
