                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="9ba56c8a-f47b-4e15-beaf-c4e6a2734ea2">
                      <SHORT-NAME>GtmOutput</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container contains the configuration (parameters) in case the Trigger SIGNALS.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0.0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>40</UPPER-MULTIPLICITY>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                      <REQUIRES-INDEX>true</REQUIRES-INDEX>
                      <PARAMETERS>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="31514abb-3296-4c09-bdb7-d0909f1440f2">
                          <SHORT-NAME>GtmTimerClockSelect</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter decides the Clock Source for TOM/ATOM timer.For ATOM channel the available clocksrcs are&lt;br/&gt;                                                             CMU_CLK0,CMU_CLK1,CMU_CLK2,CMU_CLK3,CMU_CLK4,CMU_CLK5,CMU_CLK6,CMU_CLK7.&lt;br/&gt;                                                             For TOM channel the available clocksrcs are &lt;br/&gt;                                                             CMUFXCLK0 (CMU_FXCLK)&lt;br/&gt;                                                             CMUFXCLK1 (CMU_FXCLK/16)&lt;br/&gt;                                                             CMUFXCLK2 (CMU_FXCLK/256)&lt;br/&gt;                                                             CMUFXCLK3 (CMU_FXCLK/4096)&lt;br/&gt;                                                             CMUFXCLK4 (CMU_FXCLK/65536)&lt;br/&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>CMUFXCLK0</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CMUFXCLK0</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CMUFXCLK1</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CMUFXCLK2</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CMUFXCLK3</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CMUFXCLK4</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="c6a84657-cf20-43cf-8e24-9cb114e0aa1c">
                          <SHORT-NAME>GtmTimerTimePeriod</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter is used for selecting the time period of the GTM timer in micro seconds.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
