                              <SHORT-NAME>CMU_CLK3</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CMU_CLK4</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CMU_CLK5</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>CMU_CLK6</SHORT-NAME>
                              <ORIGIN>ChipowerTech</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
