                    <ECUC-INTEGER-PARAM-DEF UUID="2b912d28-cc62-409a-a661-24ed6ff2e31d">
                      <SHORT-NAME>McuResetTimeoutCnt</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter is the Counter delay of Reset setting. Set the Timeout counter value, the default value is 0x190, and the time length 
is 100us.Note: The counter clock is 4Mhz and the configuration range is 1 to 0x1000</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
