                          <SHORT-NAME>CmuFxdClkFrequency</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The Cmu Fixed clock frequency.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
