                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="2e3ade72-f4f5-436f-b8ea-d3bedf4e91d2">
                      <SHORT-NAME>CmuFixedClock</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container contains the Fixed Clock Configuration for GTM</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="1dbb295d-c6ee-438e-bee4-d23e8d527b28">
                          <SHORT-NAME>CmuEnableAllFixedClocks</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables/Disables the Fixed Clocks of GTM. This modifies GTM_CMU_CLK_EN[EN_FXCLK].                                           CMU provides 5 Fixed Clocks with the following Prescale values respectively; 1, 16, 256, 4096, 65536. Hence the final clock frequency will be,                                           Gtm frequency (after Global prescaler) /Fixed Clock Prescale value</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="2c3e1a08-f2a1-4397-abc8-851382e2eb45">
                          <SHORT-NAME>CmuFxdClkSourceSelect</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Clock Source select for Fixed Clock. This modifies CMU_CLK_EN [FXCLK_SEL]&lt;br/&gt;
                                        GTM_CMU_GCLK_EN: Use Global Clock as input for Fixed Clock.&lt;br/&gt;
                                        GTM_CMU_CLK0: Use Clock 0 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK1: Use Clock 1 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK2: Use Clock 2 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK3: Use Clock 3 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK4: Use Clock 4 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK5: Use Clock 5 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK6: Use Clock 6 as the clock source for Fixed Clock&lt;br/&gt;
                                        GTM_CMU_CLK7: Use Clock 7 as the clock source for Fixed Clock&lt;br/&gt;
                                        Default: GTM_CMU_GCLK_EN</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>GTM_CMU_GCLK_EN</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
