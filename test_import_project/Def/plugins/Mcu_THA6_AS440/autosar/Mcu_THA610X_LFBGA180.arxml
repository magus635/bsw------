                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="93252045-2689-470a-b302-a6fe4ba0b1f1d">
                      <SHORT-NAME>Dsadc</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This Specifies the TOM/ATOM channels that can be used as DSADC Triggers</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>0</UPPER-MULTIPLICITY>
                      <REQUIRES-INDEX>true</REQUIRES-INDEX>
                      <PARAMETERS>
                        <ECUC-INTEGER-PARAM-DEF UUID="93d2144e-864c-416f-b733-7bffc4aEE6175">
                          <SHORT-NAME>ChannelId</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Id of the DSADC channel.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="2fgg0df3-669a-45bc-b6fa-b02cf1514b32">
                          <SHORT-NAME>GtmTriggerSelect</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This Specifies the TOM/ATOM channel that will be used as GTM Trigger for dsadc. This configuration is to set DSADCOUTMUX*</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
