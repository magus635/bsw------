                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="51f800fe-bb3c-4e91-b352-777358775d1d">
                      <SHORT-NAME>CmuExternalClock</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container contains the External Clock Configuration for GTM</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="64a373ef-363b-4f79-8b7b-1c510f371cfb">
                          <SHORT-NAME>CmuEnableExternalClk0</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables/Disables the External Clock 0 of GTM. This sets GTM_CMU_CLK_EN[EN_ECLK0].</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
