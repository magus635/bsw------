                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="bf9f46b0-6c98-11ee-abb2-f889d2d2ec8e">
                      <SHORT-NAME>DmaChLinkedListItemConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container contains the configuration parameters of the linked list information.&lt;br/&gt;                                                     &lt;h1&gt;Note&lt;/h1&gt;                                                     - This container is available only if the parameter DmaChannelLinkedListEnable for this channel is set to true.&lt;br/&gt;                                                     - The number of linked list elements must be greater than 2.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>254</UPPER-MULTIPLICITY>
                      <MULTIPLICITY-CONFIG-CLASSES>
