                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1</DEFAULT-VALUE>
                          <MAX>254</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="8a180a98-6cc3-11ee-9e96-f889d2d2ec8e">
                          <SHORT-NAME>DmaChShadowLinkedListEnable</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables / Disables the linked list for this shadowing operation in this channel.&lt;br/&gt;                                                         &lt;h1&gt;Note&lt;/h1&gt;                                                         This parameter is only valid when &quot;DmaChannelLinkedListEnable&quot; is true.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
