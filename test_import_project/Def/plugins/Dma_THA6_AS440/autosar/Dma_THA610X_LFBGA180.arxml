                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="fafe5ee4-6cbb-11ee-9f07-f889d2d2ec8e">
                      <SHORT-NAME>DmaChShadowConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container contains the configuration parameters of the shadowing operation information.&lt;br/&gt;                                                     &lt;h1&gt;Note&lt;/h1&gt;                                                     - This container is available only if the parameter DmaChannelShadowOperationEnable for this channel is set to true.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>254</UPPER-MULTIPLICITY>
                      <MULTIPLICITY-CONFIG-CLASSES>
