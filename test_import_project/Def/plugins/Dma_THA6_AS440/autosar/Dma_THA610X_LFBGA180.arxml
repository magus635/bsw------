                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>DMA_REQUEST13_GLOBAL_REQUEST</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>DMA_REQUEST14_GLOBAL_REQUEST</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>DMA_REQUEST15_GLOBAL_REQUEST</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>DMA_REQUEST16_GLOBAL_REQUEST</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>DMA_REQUEST17_GLOBAL_REQUEST</SHORT-NAME>
