                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/THA6_AS440_FuSa/Dma/DmaConfigSet/DmaChannel/DmaChTransferConfig</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                      </REFERENCES>
