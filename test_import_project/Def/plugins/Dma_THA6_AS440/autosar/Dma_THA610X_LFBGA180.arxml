                        <ECUC-INTEGER-PARAM-DEF UUID="fdd37518-6cbb-11ee-8e83-f889d2d2ec8e">
                          <SHORT-NAME>DmaChShadowId</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Logical identifiers of each shadowing in the current channel.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
