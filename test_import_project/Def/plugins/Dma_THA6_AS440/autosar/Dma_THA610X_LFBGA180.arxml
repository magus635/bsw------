                          <DEFAULT-VALUE>1</DEFAULT-VALUE>
                          <MAX>4095</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="cea56bd3-b778-4f11-ee3b-ba494c221343">
                          <SHORT-NAME>DmaTransferRemainingCountThr</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Configure the remaining count threshold for this transfer, used to trigger the Remaining Count Reached Interrupt when transfer size is less than this parameter.&lt;br/&gt;                                                         &lt;h1&gt;Note&lt;/h1&gt;                                                         1. The remaining count must less than transfer size of the channel.&lt;br/&gt;                                                         2. If this parameter is set to 0 then it indicates that it is not used.&lt;br/&gt;                                                         3. This parameter is available only when the parameter DmaChannelRemainCountInterruptEnable is set to true.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>ChipowerTech</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <MAX>4095</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="506850b6-659f-11ee-a324-f889d2d2ec8e">
                          <SHORT-NAME>DmaTransferLinkedListEnable</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables / Disables the linked list for this transfer.&lt;br/&gt;                                                         Set this parameter to true if this transfer is the head of the linked list.                                                         &lt;h1&gt;Note&lt;/h1&gt;                                                         This parameter is available only if the parameter DmaChannelLinkedListEnable is set to true.</L-2>
                          </DESC>
