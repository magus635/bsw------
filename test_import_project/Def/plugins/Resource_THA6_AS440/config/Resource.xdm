<?xml version='1.0'?>
<datamodel version="7.0"
    xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd"
    xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd"
    xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
    xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
    <d:ctr type="AUTOSAR" factory="autosar"
        xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
        xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd"
        xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd"
        xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
        xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"
        xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
        <d:lst type="TOP-LEVEL-PACKAGES">
            <d:ctr name="THA6_AS440_FuSa" type="AR-PACKAGE">
                <a:a name="UUID" value="AUTOSAR"/>
                <d:lst type="ELEMENTS">
                    <d:chc name="Resource" type="AR-ELEMENT" value="MODULE-DEF">
                        <v:ctr type="MODULE-DEF">
                            <a:a name="RELEASE" value="asc:4.4.0" />
                            <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                                <ad:ADMIN-DATA>
                                    <ad:DOC-REVISIONS>
                                        <ad:DOC-REVISION>
                                            <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                                            <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                          </ad:DOC-REVISION>
                                    </ad:DOC-REVISIONS>
                                </ad:ADMIN-DATA>
                            </a:a>
                            <a:a name="DESC" value="EN: Configuration of Resource module." />
                            <a:a name="LOWER-MULTIPLICITY" value="0" />
                            <a:a name="UPPER-MULTIPLICITY" value="*" />
                            <a:a name="UUID" value="0c7f745f-a8c5-4f5c-96b9-05d8ef586e8c" />

                            <!--  @implements ResourceGeneral_Object  -->
                            <v:ctr name="ResourceGeneral" type="IDENTIFIABLE">
                                <a:a name="UUID" value="c7e376ac-6680-461a-84d8-be9d0c1d4f78" />
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[ EN:<html>
                                     Resource General config. container.
                                   </html>]]>
                                    </a:v>
                                </a:a>
                                <!--  @implements ResourceSubderivative_Object  -->
                                <v:var name="ResourceSubderivative" type="ENUMERATION">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[ EN:<html>
                                     Sub-derivative selector for the current platform.
                                   </html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="0aa5bac4-de79-4565-8120-830dc23e3679" />
                                    <a:da name="DEFAULT" value="THA6206_LFBGA292" />
                                    <a:da name="RANGE">
                                        <a:v>THA610X_LFBGA180</a:v>
                                        <a:v>THA6206_LFBGA292</a:v>
                                        <a:v>THA6412_BGA516</a:v>
                                    </a:da>
                                </v:var>
                            </v:ctr>

                            <v:ctr name="ResourceCoreConfigSet" type="IDENTIFIABLE">
                                <a:a name="DESC" value="EN: This container contains the configuration parameters and sub containers of the AUTOSAR Resource module." />
                                <a:a name="UUID" value="c206ec80-6212-4b59-99c8-26a1b7268691" />
                                <!-- Master core: core 0 default -->
                                <v:var name="ResourceMasterCore" type="ENUMERATION">
                                    <a:a name="DESC" value="EN: Master core is default core0. &lt;br/&gt;
                                           If a configured MCAL resource is not allocated to a core, it will default to master core. &lt;br/&gt;
                                           &lt;h1&gt;Note&lt;/h1&gt;
                                           The master core is the safety core and also the boot core(which needs to be configured by the user in the UCB).&lt;br/&gt;
                                           Users should configure the master core to be the same as the safety core (as well as the boot core)." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="2e4a3462-0bfe-11ed-8779-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" type="XPath" expr="ecu:list('Resource.MasterCore')[1]" />
                                    <a:da name="EDITABLE" value="true" />
                                    <a:da name="RANGE" type="XPath" expr="ecu:list('Resource.MasterCore')" />
                                    <a:da name="INVALID" type="XPath" expr="ecu:list('Resource.MasterCore')" false="Master core error, only Core0 can be the master core" />
                                </v:var>

                                <!-- Multicore Distribution -->
                                <v:lst name="ResourceCoreConfig" type="MAP">
                                    <a:da name="MIN" value="1" />
                                    <a:da name="MAX" type="XPath" expr="ecu:get('Resource.NumOfCores')" />
                                    <v:ctr name="ResourceCoreConfig" type="IDENTIFIABLE">
                                        <a:a name="UUID" value="6bef5c0a-0bff-11ed-8b70-f889d2d2ec8e" />
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="DESC" value="EN: General container to allocate Mcal resources to cores" />
                                        <a:a name="REQUIRES-INDEX" value="true"/>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false" />

                                        <v:var name="ResourceCoreId" type="ENUMERATION">
                                            <a:a name="DESC" value="EN: Select the core to allocation the mudule resource." />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID" value="31505abb-2290-4c00-bdb7-d0909f0440f2" />
                                            <a:da name="DEFAULT" type="XPath" expr="ecu:list('Resource.AvailableCores')[position()-1=node:fallback(node:current()/../@index,0)]" />
                                            <a:da name="RANGE" type="XPath" expr="ecu:list('Resource.AvailableCores')" />
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="text:uniq(../../*/ResourceCoreId, .)" false="Cores must be unique across all resource allocations." />
                                            </a:da>
                                        </v:var>

                                        <v:var name="ResourceCoreEnable" type="BOOLEAN">
                                            <a:a name="DESC" value="EN: Enable/Disable the core mapping resource allocation.&lt;br/&gt;
                                                false - disable&lt;br/&gt;
                                                true - enable" />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID" value="31505abb-2290-4c00-bdb7-d0909f0440f1" />
                                            <a:da name="DEFAULT" value="true" />
                                        </v:var>

                                        <v:lst name="ResourceAllocation" type="MAP">
                                            <v:ctr name="ResourceAllocation" type="IDENTIFIABLE">
                                                <a:a name="UUID" value="57911a62-0c00-11ed-b2e6-f889d2d2ec8e" />
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                                </a:a>
                                                <a:a name="DESC" value="EN: Container to allocate module resources to this core." />
                                                <a:a name="REQUIRES-INDEX" value="true"/>
                                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false" />

                                                <v:var name="ResourceModule" type="ENUMERATION">
                                                    <a:a name="DESC" value="EN: The module that need to be allocated to this core." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID" value="5b51e564-0c00-11ed-af0b-f889d2d2ec8e" />
                                                    <a:da name="DEFAULT" value="SPI" />
                                                    <a:da name="RANGE" type="XPath" expr="ecu:list('Resource.MultiCoreModules')" />
                                                    <a:da name="INVALID" type="XPath">
                                                        <!-- One core can only allocated to one Iom -->
                                                        <a:tst expr="(. = 'IOM') and not(text:uniq(../../../../*/ResourceAllocation/*/ResourceModule, .))" true="Iom can only be allocate to one core." />
                                                    </a:da>
                                                    <a:da name="WARNING" type="XPath">
                                                        <a:tst expr="node:exists(as:modconf(concat(text:replace(., '\B.*', ''), text:replace(text:tolower(.), '\b\w', ''))))" false="Selected module is not enabled." />
                                                    </a:da>
                                                </v:var>

                                                <v:ref name="ResourceModuleRef" type="CHOICE-REFERENCE">
                                                    <a:a name="DESC" value="EN: This parameter contains reference to resource. &lt;br/&gt;
                                                      Only one Iom HW unit in the MCU, so not need to allocate resource." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                                    </a:a>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                                    <a:a name="SCOPE" value="ECU" />
                                                    <a:a name="UUID" value="e199f562-0c00-11ed-b80b-f889d2d2ec8e" />
                                                    <a:da name="REF">
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Gpt/GptChannelConfigSet/GptChannelConfiguration</a:v>
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Pwm/PwmChannelConfigSet/PwmChannel</a:v>
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Icu/IcuConfigSet/IcuChannel</a:v>
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Can/CanConfigSet/CanController</a:v>
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Adc/AdcConfigSet/AdcHwUnit</a:v>
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Ocu/OcuConfigSet/OcuChannel</a:v>
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Eth/EthConfigSet/EthCtrlConfig</a:v>
                                                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Lin/LinGlobalConfig/LinChannel</a:v>
                                                        <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Spi/SpiDriver/SpiHwUnitConfig</a:v>
                                                        <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Uart/UartGlobalConfig/UartChannel</a:v>
                                                        <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Msc/MscConfigSet/MscModuleConfiguration</a:v>
                                                        <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Dma/DmaConfigSet/DmaChannel</a:v>
                                                        <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Dsadc/DsadcConfigSet/DsadcChannel</a:v>
                                                        <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Sent/SentConfigSet/SentChannelConfigSet</a:v>
                                                        <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/I2c/I2cGlobalConfig/I2cChannel</a:v>
                                                        <a:v>ASPathDataOfSchema:/THA6_AS440_FuSa/Iom</a:v>
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath">
                                                        <!-- One a resource can only be allocated to one core -->
                                                        <a:tst expr="not(text:uniq(../../../../*/ResourceAllocation/*/ResourceModuleRef,.))" true="ResourceModuleRef should be unique. A resource can only be allocated to one core." />
                                                        <!-- Judge if resource mapping is correct -->
                                                        <a:tst expr="not(contains(text:toupper(.), concat('/', ../ResourceModule, '/')))" true="ResourceModule and ResourceModuleRef are not compatible." />
                                                        <!-- Invalid references -->
                                                        <a:tst expr="node:exists(as:modconf(../ResourceModule)) and not(node:refvalid(.))" true="The configured node does not exist or may not be referenced." />
                                                    </a:da>
                                                </v:ref>
                                            </v:ctr>
                                        </v:lst>
                                    </v:ctr>
                                </v:lst>
                            </v:ctr>

                            <!--  @implements CommonPublishedInformation_Object  -->
                            <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:
                                            <html><p>Common container, aggregated by all modules. It contains published information about vendor and versions.</p></html>
                                        ]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="f69875a9-25e7-4b86-8228-6d24dce50d2d" />

                                <v:var name="ArReleaseMajorVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="AUTOSAR Major Version" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN: 
                                                <html><p>Major version number of AUTOSAR specification on which the appropriate implementation is based on.</p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="49485ae8-ffb4-4263-b543-2c38bb5965ac" />
                                    <a:da name="DEFAULT" value="4" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=4" />
                                        <a:tst expr="&lt;=4" />
                                    </a:da>
                                </v:var>

                                <v:var name="ArReleaseMinorVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="AUTOSAR Minor Version" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN: 
                                                <html><p>Minor version number of AUTOSAR specification on which the appropriate implementation is based on.</p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="b841b2b5-f8bd-475a-a6ba-1e2b0ffe3af1" />
                                    <a:da name="DEFAULT" value="4" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0" />
                                        <a:tst expr="&lt;=255" />
                                    </a:da>
                                </v:var>

                                <v:var name="ArReleaseRevisionVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="AUTOSAR Release Revision Version" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN: 
                                                <html><p>Revision version number of AUTOSAR specification on which the appropriate implementation is based on.</p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="30f1d5f3-70bf-4124-9285-52f2a146f071" />
                                    <a:da name="DEFAULT" value="0" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0" />
                                        <a:tst expr="&lt;=255" />
                                    </a:da>
                                </v:var>

                                <v:var name="ModuleId" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="Module Id" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN: 
                                                <html><p>Module ID of this module from Module List.</p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="c18a199c-a953-47f7-8782-fa834356b71c" />
                                    <a:da name="DEFAULT" value="255" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0" />
                                        <a:tst expr="&lt;=255" />
                                    </a:da>
                                </v:var>

                                <v:var name="SwMajorVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="Software Major Version" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN: 
                                                <html><p>Major version number of the vendor specific implementation of the module. The numbering is vendor specific.</p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="47e9fd65-38e0-459a-b6f8-7e1b99b3b623" />
                                    <a:da name="DEFAULT" value="1" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0" />
                                        <a:tst expr="&lt;=255" />
                                    </a:da>
                                </v:var>

                                <v:var name="SwMinorVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="Software Minor Version" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN: 
                                                <html><p>Minor version number of the vendor specific implementation of the module. The numbering is vendor specific.</p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="7f28af1d-46d4-4d2e-bccb-cb9d90eb56a3" />
                                    <a:da name="DEFAULT" value="2" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0" />
                                        <a:tst expr="&lt;=255" />
                                    </a:da>
                                </v:var>

                                <v:var name="SwPatchVersion" type="INTEGER_LABEL">
                                    <a:a name="LABEL" value="Software Patch Version" />
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN: 
                                                <html><p>Patch level version number of the vendor specific implementation of the module. The numbering is vendor specific.</p></html>
                                            ]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="c49f80cf-0d97-4d4d-a394-05e248e884a3" />
                                    <a:da name="DEFAULT" value="0" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&gt;=0" />
                                        <a:tst expr="&lt;=255" />
                                    </a:da>
                                </v:var>

                                <v:var name="VendorId" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Vendor ID of the dedicated implementation of this module according to the AUTOSAR vendor list.</html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPreCompile</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="b2856b58-d29f-11ec-a9ba-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" value="175" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255" />
                                        <a:tst expr="&gt;=0" />
                                    </a:da>
                                </v:var>

                            </v:ctr>
                        </v:ctr>
                    </d:chc>
                    <d:chc name="Resource_EcuParameterDefinition" type="AR-ELEMENT" value="ECU_PARAMETER_DEFINITION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF" value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION" />
                            <d:lst name="MODULE_REF">
                                <d:ref type="MODULE_REF" value="ASPath:/THA6_AS440_FuSa/Resource" />
                            </d:lst>
                            <a:a name="UUID" value="99d536b7-b4c0-42ab-be47-89175ebf6a19" />
                        </d:ctr>
                    </d:chc>
                    <d:chc name="Resource_ModuleDescription" type="AR-ELEMENT" value="BSW_MODULE_DESCRIPTION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF" value="ASPath:/AR_PACKAGE_SCHEMA/BSW_MODULE_DESCRIPTION" />
                            <d:var name="MODULE_ID" type="INTEGER">
                                <a:a name="EDITABLE" value="false" />
                                <a:a name="IMPORTER_INFO" value="@DEF" />
                            </d:var>
                            <d:ref type="RECOMMENDED_CONFIGURATION">
                                <a:a name="EDITABLE" value="false" />
