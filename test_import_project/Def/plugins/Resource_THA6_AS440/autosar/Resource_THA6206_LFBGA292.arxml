            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="c206ec80-6212-4b59-99c8-26a1b7268691">
              <SHORT-NAME>ResourceCoreConfigSet</SHORT-NAME>
              <DESC>
                <L-2 L="EN">This container contains the configuration parameters and sub containers of the AUTOSAR Resource module.</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-ENUMERATION-PARAM-DEF UUID="2e4a3462-0bfe-11ed-8779-f889d2d2ec8e">
                  <SHORT-NAME>ResourceMasterCore</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Master core is default core0. &lt;br/&gt;                                            If a configured MCAL resource is not allocated to a core, it will default to master core. &lt;br/&gt;                                            &lt;h1&gt;Note&lt;/h1&gt;                                            The master core is the safety core and also the boot core(which needs to be configured by the user in the UCB).&lt;br/&gt;                                            Users should configure the master core to be the same as the safety core (as well as the boot core).</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>ChipowerTech</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                  <VALUE-CONFIG-CLASSES>
