                  <DEFAULT-VALUE>16000.0</DEFAULT-VALUE>
                  <MAX>4.29496E8</MAX>
                  <MIN>0.0</MIN>
                </ECUC-FLOAT-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="336ed79c-a250-4e3c-a5a1-f978fda78670">
