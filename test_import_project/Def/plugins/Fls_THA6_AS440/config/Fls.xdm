                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="40deff1c-2f82-42a5-965f-6b1741723562"/>
                  <a:da name="DEFAULT" value="1500"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=42949600.0"/>
                    <a:tst expr="&gt;=0.0"/>
                  </a:da>
                </v:var>
              </v:ctr>
