<!-- TODO:CanTTController is specified in the SWS TTCAN and contains the configuration parameters of the TTCAN controller(s) -->
                                                  <v:ctr name="CanTTController" type="IDENTIFIABLE">
                                                       <a:a name="DESC" value="EN: CanTTController is specified in the SWS TTCAN and contains the configuration parameters of the TTCAN controller(s) (which are needed in addition to the configuration parameters of the CAN controller(s))." />
                                                       <a:a name="OPTIONAL" value="false" />
                                                       <a:a name="ENABLE" value="false" />
                                                       <!--
                                                       Supportted for features!-->
                                                       <a:a name="UUID" value="3700eb6f-ff51-4c8a-a264-0f824791156a" />
                                                       <v:var name="CanTTControllerApplWatchdogLimit" type="INTEGER">
                                                            <a:a name="DESC" value="EN: Defines the maximum time period (unit is 256 times NTU) after which the application has to serve the watchdog." />
                                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                 <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
                                                                 <icc:v vclass="PostBuild">
                                                                      VariantPostBuild</icc:v>
                                                            </a:a>
