<?xml version="1.0"?>
<datamodel version="7.0"
     xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd"
     xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd"
     xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
     xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
     <d:ctr type="AUTOSAR" factory="autosar"
          xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
          xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd"
          xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd"
          xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
          xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"
          xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
          <d:lst type="TOP-LEVEL-PACKAGES">
               <d:ctr name="THA6_AS440_FuSa" type="AR-PACKAGE">
                    <a:a name="UUID" value="ECUC:AUTOSAR" />
                    <d:lst type="ELEMENTS">
<!-- ECUC_Can_00489 :[Can] This container holds the configuration of a single CAN Driver.                  -->
                         <d:chc name="Can" type="AR-ELEMENT" value="MODULE-DEF">
                              <v:ctr type="MODULE-DEF">
                                   <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                                        <ad:ADMIN-DATA>
                                             <ad:DOC-REVISIONS>
                                                <ad:DOC-REVISION>
                                                    <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                                                    <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                                  </ad:DOC-REVISION>
                                             </ad:DOC-REVISIONS>
                                        </ad:ADMIN-DATA>
                                   </a:a>
                                   <a:a name="DESC" value="EN: This container holds the configuration of a single CAN Driver." />
                                   <a:a name="LOWER-MULTIPLICITY" value="0" />
                                   <a:a name="POSTBUILDVARIANTSUPPORT" value="true" />
                                   <a:a name="RELEASE" value="asc:4.4.0" />
                                   <a:a name="UPPER-MULTIPLICITY" value="*" />
                                   <a:a name="UUID" value="b946460f-13e5-4dec-864f-f3967fa40f83" />
                                   <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                             <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                             <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
                                        </a:a>
                                        <a:a name="LABEL" value="Config Variant" />
                                        <a:a name="UUID" value="90c15d98-3c22-4a46-88d4-8cee0d9dfaf3" />
                                        <a:da name="DEFAULT" value="VariantPostBuild" />
                                        <a:da name="RANGE">
                                             <a:v>VariantPostBuild</a:v>
                                             <!--<a:v>VariantPreCompile</a:v>!-->
                                        </a:da>
                                   </v:var>
<!-- ECUC_Can_00343 :[CanConfigSet]  This container contains the configuration parameters and sub containers of the AUTOSAR Can module.                                 -->
                                   <v:ctr name="CanConfigSet" type="IDENTIFIABLE">
                                        <a:a name="DESC" value="EN: This container contains the configuration parameters and sub containers of the AUTOSAR Can module." />
                                        <a:a name="UUID" value="93d09e19-8cbe-41d7-af63-1339b6d842f0" />
<!-- ECUC_Can_00343 :[CanConfigSet/CanController] This container contains the configuration parameters of the CAN controller(s). -->
                                        <v:lst name="CanController" type="MAP">
                                             <a:da name="MIN" value="1" />
                                             <a:da name="MAX" type="XPath" expr="num:i(ecu:get('Can.MaxModules')*ecu:get('Can.MaxNodes'))" />
                                             <v:ctr name="CanController" type="IDENTIFIABLE">
                                                  <a:a name="DESC" value="EN: This container contains the configuration parameters of the CAN controller(s)." />
                                                  <a:a name="REQUIRES-INDEX" value="true"/>
                                                  <a:a name="UUID" value="26555bf8-40c9-4dba-ab64-aad17b9fd506" />
                                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                       <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                  </a:a>
<!-- ECUC_Can_00315 :[CanControllerActivation] Defines if a CAN controller is used in the configuration. -->
                                                  <v:var name="CanControllerActivation" type="BOOLEAN">
                                                       <a:a name="DESC" value="EN: Defines if a CAN controller is used in the configuration." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="eda993fa-59fe-4368-96f2-4cb6c43566ad" />
                                                       <a:da name="DEFAULT" value="false" />
                                                  </v:var>
<!-- ECUC_Can_00382:[CanControllerBaseAddress] Specifies the CAN controller base address. -->
                                                  <v:var name="CanControllerBaseAddress" type="INTEGER">
                                                       <a:a name="DESC" value="EN: Specifies the CAN controller base address." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="EDITABLE" value="false" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="4fff0b22-d6ec-4f70-badd-dd01b0a1d6fc" />
                                                       <a:da name="DEFAULT" value="0" />
                                                       <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&lt;=4294967295" />
                                                            <a:tst expr="&gt;=0" />
                                                       </a:da>
                                                  </v:var>
<!-- Compatibility Design:[CanHardwareChannel] This parameter provides the Real Hardware controller ID which is unique in the CAN Driver -->
                                                  <v:var name="CanHardwareChannel" type="ENUMERATION">
                                                       <a:a name="DESC" value="EN: This parameter provides the Real Hardware controller ID which is unique in the CAN Driver" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
                                                            <icc:v vclass="PreCompile">
                                                                 VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="ChipowerTech" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="eaa54b9d-5bba-4b8c-93ec-8363b77eb3fe" />
                                                       <a:da name="DEFAULT" value="CAN_CONTROLLER_00" />
                                                       <a:da name="RANGE" type="XPath" expr="ecu:list('Can.HwUnitNode')" />
                                                       <a:da name="INVALID" type="XPath">
                                                            <a:tst expr="text:uniq(node:fallback(../../*/CanHardwareChannel, text:split('1 2 3')), node:fallback(.,1) )" false="Duplicated value, CanHardwareChannel must be unique across all Can Physical controllers." />
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00316 :[CanControllerId] This parameter provides the controller ID which is unique in a given CAN Driver.  -->
                                                  <v:var name="CanControllerId" type="INTEGER">
                                                       <a:a name="DESC" value="EN: This parameter provides the controller ID which is unique in a given CAN Driver. The value for this parameter starts with 0 and continue without any gaps." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="true" />
                                                       <a:a name="UUID" value="badb922c-fc6c-4da1-bcd6-3c423d586ebe" />
                                                       <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(1))" />
                                                       <a:da name="RANGE" type="XPath">
                                                            <a:tst expr="(node:fallback(.,1) &gt;= 0) and (node:fallback(.,1) &lt; num:i(count(node:fallback(node:current()/../../*, 1 ))))" false="Value out of range: must be in range 0 to N-1 (N is number of configured channels). Use the Calc button to calculate correct default value." />
                                                            <a:tst expr="text:uniq(node:fallback(../../*/CanControllerId, text:split('1 2 3')), node:fallback(.,1) )" false="Duplicated value, CanControllerId must be unique across all Can controllers. Use the Calc button to calculate correct default value." />
                                                       </a:da>
                                                       <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&lt;=255" />
                                                            <a:tst expr="&gt;=0" />
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00317 :[CanRxProcessing] Enables / disables API Can_MainFunction_Read() for handling PDU reception events in polling mode. -->
                                                  <v:var name="CanRxProcessing" type="ENUMERATION">
                                                       <a:a name="DESC" value="EN: Enables / disables API Can_MainFunction_Read() for handling PDU reception events in polling mode." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="fb89e30b-ef4f-41d5-97c3-82d1fd57dee5" />
                                                       <a:da name="DEFAULT" value="POLLING" />
                                                       <a:da name="RANGE">
                                                            <a:v>INTERRUPT</a:v>
                                                            <a:v>MIXED</a:v>
                                                            <a:v>POLLING</a:v>
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00318 :[CanTxProcessing] Enables / disables API Can_MainFunction_Write() for handling PDU transmission events in polling mode. -->
                                                  <v:var name="CanTxProcessing" type="ENUMERATION">
                                                       <a:a name="DESC" value="EN: Enables / disables API Can_MainFunction_Write() for handling PDU transmission events in polling mode." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="114905a2-6a3f-4bf5-8b5a-cc1c862aa8e8" />
                                                       <a:da name="DEFAULT" value="POLLING" />
                                                       <a:da name="RANGE">
                                                            <a:v>INTERRUPT</a:v>
                                                            <a:v>MIXED</a:v>
                                                            <a:v>POLLING</a:v>
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00314 :[CanBusoffProcessing] Enables / disables API Can_MainFunction_BusOff() for handling busoff events in polling mode. -->
                                                  <v:var name="CanBusoffProcessing" type="ENUMERATION">
                                                       <a:a name="DESC" value="EN: Enables / disables API Can_MainFunction_BusOff() for handling busoff events in polling mode." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="59775ed9-a811-4b55-80c9-186c4ef39fa2" />
                                                       <a:da name="DEFAULT" value="POLLING" />
                                                       <a:da name="RANGE">
                                                            <a:v>INTERRUPT</a:v>
                                                            <a:v>POLLING</a:v>
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00319 :[CanWakeupProcessing] Enables / disables API Can_MainFunction_Wakeup() for handling wakeup events in polling mode. -->
                                                  <v:var name="CanWakeupProcessing" type="ENUMERATION">
                                                       <a:a name="DESC" value="EN: Enables / disables API Can_MainFunction_Wakeup() for handling wakeup events in polling mode." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="b46d58ba-4462-4c51-a61c-b2fa48971091" />
                                                       <a:da name="EDITABLE" type="XPath" expr="../CanWakeupSupport = 'true'" />
                                                       <a:da name="DEFAULT" value="POLLING" />
                                                       <a:da name="RANGE">
                                                            <a:v>INTERRUPT</a:v>
                                                            <a:v>POLLING</a:v>
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00466 :[CanWakeupFunctionalityAPI] Adds / removes the service Can_CheckWakeup() from the code. -->
                                                  <v:var name="CanWakeupFunctionalityAPI" type="BOOLEAN">
                                                       <a:a name="DESC" value="EN: Adds / removes the service Can_CheckWakeup() from the code." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:da name="EDITABLE" type="XPath" expr="../CanWakeupSupport = 'true'" />
                                                       <a:a name="UUID" value="6eaa8b2e-5a67-43dc-ad20-a344363c1737" />
                                                       <a:da name="DEFAULT" value="false" />
                                                  </v:var>
<!-- Compatibility Design:[CanFDSupport] Selects support of CanFD features in Can driver. -->
                                                  <v:var name="CanFDSupport" type="BOOLEAN">
                                                       <a:a name="DESC" value="EN: Selects support of CanFD features in Can driver." />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v mclass="PreCompile">
                                                                 VariantPostBuild</icc:v>
                                                            <icc:v vclass="PreCompile">
                                                                 VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="OPTIONAL" value="true" />
                                                       <a:a name="ORIGIN" value="ChipowerTech" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="3a04f125-32da-4a29-98ed-61ccea14e781" />
                                                       <a:da name="DEFAULT" value="false" />
                                                  </v:var>
<!-- ECUC_Can_00330 :[CanWakeupSupport] CAN driver support for wakeup over CAN Bus. -->
                                                  <v:var name="CanWakeupSupport" type="BOOLEAN">
                                                       <a:a name="DESC" value="EN: CAN driver support for wakeup over CAN Bus." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="1024bb9c-35c1-4b8a-a0ff-106d8a079033" />
                                                       <a:da name="DEFAULT" value="false" />
                                                  </v:var>
<!-- ECUC_Can_00435 :[CanControllerDefaultBaudrate] Reference to baudrate configuration container configured for the Can Controller. -->
                                                  <v:ref name="CanControllerDefaultBaudrate" type="REFERENCE">
                                                       <a:a name="DESC" value="EN: Reference to baudrate configuration container configured for the Can Controller." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="UUID" value="15020ffc-51b6-4e67-afc5-8d58e5d07351" />
                                                       <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Can/CanConfigSet/CanController/CanControllerBaudrateConfig" />
                                                       <a:da name="INVALID" type="XPath" expr="(contains(node:path(node:ref(.)),node:path(../CanControllerBaudrateConfig))) and (node:refvalid(.))" false="The configured node does not exist or may not be referenced.Please select the default baudrate from CanControllerBaudrateConfig container" />
                                                  </v:ref>
<!-- ECUC_Can_00313 :[CanCpuClockRef] Reference to the CPU clock configuration, which is set in the MCU driver configuration. -->
                                                  <v:ref name="CanCpuClockRef" type="REFERENCE">
                                                       <a:a name="DESC" value="EN: Reference to the CPU clock configuration, which is set in the MCU driver configuration" />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
