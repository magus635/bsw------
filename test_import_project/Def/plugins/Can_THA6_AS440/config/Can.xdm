 <!-- ECUC_Can_00494 :[CanControllerSspOffset] Specifies the Transmitter Delay Compensation Offset in minimum time quanta -->
                                                                 <v:var name="CanControllerSspOffset" type="INTEGER">
                                                                      <a:a name="DESC" value="EN: Specifies the Transmitter Delay Compensation Offset in minimum time quanta." />
