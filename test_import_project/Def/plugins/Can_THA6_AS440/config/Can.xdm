                                                                 <a:a name="UUID" value="ebe9df6e-595b-4955-9d87-5fdc2de4041b" />
                                                                 <a:da name="DEFAULT" type="XPath" expr="node:fallback(&quot;->num:i(node:value(node:ref(../../../CanCpuClockRef)/McuClockReferencePointFrequency)div((node:value(../CanControllerPRESDIV)+1)*(node:value(../CanControllerPropSeg)+node:value(../CanControllerSeg1)+node:value(../CanControllerSeg2)+3)*1000))&quot;,'0')" />
                                                                 <a:da name="INVALID" type="Range">
