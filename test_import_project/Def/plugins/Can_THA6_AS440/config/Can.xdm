                                                                           <a:a name="UUID" value="453c6e90-b7ba-4692-9b3a-dc99433c8456" />
                                                                           <a:da name="DEFAULT" value="false" />
                                                                      </v:var>
<!-- ECUC_Can_00452 :[CanIcomRxMessageSignalConfig] This container contains the configuration parameters for the wakeup causes for matching signals.                                                                     -->
                                                                      <v:lst name="CanIcomRxMessageSignalConfig" type="MAP">
                                                                           <v:ctr name="CanIcomRxMessageSignalConfig" type="IDENTIFIABLE">
                                                                                <a:a name="DESC" value="EN: This container contains the configuration parameters for the wakeup causes for matching signals." />
                                                                                <a:a name="UUID" value="111dee59-7486-4c95-ac1f-f498cc3d96f8" />
                                                                                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                                     <icc:v mclass="PreCompile">
                                                                                          VariantPostBuild</icc:v>
                                                                                </a:a>
<!-- ECUC_Can_00487 :[CanIcomSignalMask] This parameter shall be used to mask a signal in the payload of a CAN message. -->
                                                                                <v:var name="CanIcomSignalMask" type="INTEGER">
                                                                                     <a:a name="DESC" value="EN: This parameter shall be used to mask a signal in the payload of a CAN message." />
                                                                                     <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                                                     <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
