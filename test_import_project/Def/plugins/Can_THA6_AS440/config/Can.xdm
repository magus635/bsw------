<!-- ECUC_Can_00493 :[CanTTControllerEcucPartitionRef] Maps the Time triggered CAN controller to zero or one ECUC partitions. The ECUC partition referenced is a subset of the ECUC partitions where the CAN driver is mapped to. -->
                                                        <v:lst name="CanTTControllerEcucPartitionRef">
                                                            <a:da name="MIN" value="0"/>
                                                            <a:da name="MAX" value="1"/>
                                                            <v:ref name="CanTTControllerEcucPartitionRef"
                                                                    type="REFERENCE">
                                                            <a:a name="DESC">
                                                                    <a:v>EN: Maps the Time triggered CAN controller to zero or one ECUC partitions. The ECUC partition referenced is a subset of the ECUC partitions where the CAN driver is mapped to.</a:v>
                                                                    <a:v>EN: Tags: atp.Status=draft</a:v>
                                                            </a:a>
                                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                                    type="IMPLEMENTATIONCONFIGCLASS">
                                                                    <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                            </a:a>
                                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY"
                                                                    value="true"/>
                                                            <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                            <a:a name="SCOPE" value="ECU"/>
                                                            <a:a name="UUID"
                                                                    value="ECUC:85687560-a8d9-4133-b489-4d02cddae536"/>
                                                            <a:da name="REF"
                                                                    value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                                            <a:da name="EDITABLE" value="false"/>
                                                            </v:ref>
                                                        </v:lst>
                                                  </v:ctr>
                                             </v:ctr>
                                        </v:lst>
<!-- ECUC_Can_00343 :[CanConfigSet/CanHardwareObject] This container contains the configuration (parameters) of CAN Hardware Objects.                                       -->
                                        <v:lst name="CanHardwareObject" type="MAP">
                                             <a:da name="MIN" value="1" />
                                             <v:ctr name="CanHardwareObject" type="IDENTIFIABLE">
                                                  <a:a name="DESC" value="EN: This container contains the configurations (parameters) of CAN Hardware Objects." />
                                                  <a:a name="REQUIRES-INDEX" value="true"/>
                                                  <a:a name="UUID" value="8a3dae82-2b62-430a-9649-d43d735c5495" />
                                                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                       <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                  </a:a>
<!-- ECUC_Can_00485 :[CanFdPaddingValue] Specifies the value which is used to pad unspecified data in CAN FD frames > 8 bytes for transmission.  -->
                                                  <v:var name="CanFdPaddingValue" type="INTEGER">
                                                       <a:a name="DESC" value="EN: Specifies the value which is used to pad unspecified data in CAN FD frames &gt; 8 bytes for transmission. This is necessary due to the discrete possible values of the DLC if &gt; 8 bytes." />
                                                       <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="EDITABLE" type="XPath">
                                                            <a:tst expr="(num:i(count(../../../CanController/*[CanFDSupport ='true'])) > 0) and (../CanObjectType = 'TRANSMIT')" />
                                                       </a:a>
                                                       <a:a name="OPTIONAL" value="true" />
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="4c897128-9286-4198-ae6d-6d1d271f0b55" />
                                                       <a:da name="DEFAULT" value="0" />
                                                       <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&lt;=255" />
                                                            <a:tst expr="&gt;=0" />
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00323 :[CanHandleType] Specifies the type (Full-CAN or Basic-CAN) of a hardware object. -->
                                                  <v:var name="CanHandleType" type="ENUMERATION">
                                                       <a:a name="DESC" value="EN: Specifies the type (Full-CAN or Basic-CAN) of a hardware object." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="08f7a2e8-764b-4fdb-885b-917cb6c703ae" />
                                                       <a:da name="DEFAULT" value="BASIC" />
                                                       <a:da name="RANGE">
                                                            <a:v>BASIC</a:v>
                                                            <a:v>FULL</a:v>
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00467 :[CanHwObjectCount] Number of hardware objects used to implement one HOH. -->
                                                  <v:var name="CanHwObjectCount" type="INTEGER">
                                                       <a:a name="DESC" value="EN: Number of hardware objects used to implement one HOH. In case of a HRH this parameter defines the number of elements in the hardware FIFO or the number of shadow buffers, in case of a HTH it defines the number of hardware objects used for multiplexed transmission or for a hardware FIFO used by a FullCAN HTH." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="4642a93b-cceb-4897-9218-fca0a3da3f94" />
                                                       <a:da name="DEFAULT" value="1" />
                                                       <a:a name="EDITABLE" type="XPath">
                                                            <a:tst expr="((../../../../CanGeneral/CanMultiplexedTransmission = 'true') and (../CanObjectType = 'TRANSMIT')) or (../CanObjectType  = 'RECEIVE')" />
                                                       </a:a>
                                                       <a:da name="INVALID" type="XPath">
                                                            <a:tst expr="((../../../../CanGeneral/CanMultiplexedTransmission = 'false') and (../CanObjectType = 'TRANSMIT') and (../CanHwObjectCount > 1))" true="Disable CanMultiplexedTransmission,CanHwObjectCount for 'TRANSMIT' can only be 1." />
                                                       </a:da>
                                                       <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&gt;=1" />
                                                            <a:tst expr="&lt;=64" />
                                                       </a:da>
                                                  </v:var>
<!-- Compatibility Design:[CanHwFIFOThreshold] Number of the threshold size of Rx/TxEvent FIFO buffer to copy the data. -->
                                                  <v:var name="CanHwFIFOThreshold" type="INTEGER">
                                                       <a:a name="DESC" value="EN: Number of the threshold size of Rx/TxEvent FIFO buffer to copy the data." />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
                                                            <icc:v vclass="PostBuild">
                                                                 VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="ChipowerTech" />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="94115202-4c79-47bd-9a25-65e9fe90c947" />
                                                       <a:da name="DEFAULT" value="1" />
                                                       <a:a name="EDITABLE" type="XPath">
                                                            <a:tst expr="((../CanHwObjectCount >'1') and (../CanObjectType = 'RECEIVE' or ../CanObjectType  = 'TRANSMIT'))" />
                                                       </a:a>
                                                       <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&lt;=64" />
                                                            <a:tst expr="&gt;=1" />
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00065 :[CanIdType] Specifies whether the IdValue is of type. -->
                                                  <v:var name="CanIdType" type="ENUMERATION">
                                                       <a:a name="DESC" value="EN: Specifies whether the IdValue is of type" />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="1b051a2f-3832-4ab4-b8f4-d6d012fe71b9" />
                                                       <a:da name="DEFAULT" value="STANDARD" />
                                                       <a:da name="RANGE">
                                                            <a:v>EXTENDED</a:v>
                                                            <a:v>MIXED</a:v>
                                                            <a:v>STANDARD</a:v>
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00326 :[CanObjectId] Holds the handle ID of HRH or HTH. -->
                                                  <v:var name="CanObjectId" type="INTEGER">
                                                       <a:a name="DESC" value="EN: Holds the handle ID of HRH or HTH. The value of this parameter is unique in a given CAN Driver, and it should start with 0 and continue without any gaps." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="true" />
                                                       <a:a name="UUID" value="443667c8-ac91-4a50-aa68-5a9016838686" />
                                                       <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index,'0')" />
                                                       <a:da name="RANGE" type="XPath">
                                                            <!--
                                                            <a:tst expr="node:isconsecutive(../../*/CanObjectId,0) and text:uniq(../../*/CanObjectId,.)" false="Wrong Object ID. If Multiplex transmission is OFF, Object IDs must be unique and in
                                                            order."/>
                                                            -->
                                                            <a:tst expr="(text:uniq(node:fallback(../../*/CanObjectId, text:split('1 2 3 4 5')), node:fallback(.,1)) and (node:fallback(.,1) &gt;= 0) and (node:fallback(.,1) &lt; num:i(count(node:fallback(node:current()/../../*, 1)))))
                                                                      or ((../../../../CanGeneral/CanMultiplexedTransmission='true') and (num:i(node:fallback(../CanObjectId,0)) = num:i(node:fallback(../../*/CanObjectId,0) )) and (../CanObjectType = 'TRANSMIT') )" false="Wrong Object ID. If Multiplex transmission is OFF, Object IDs must be unique and in order. If multiplex transmission is ON, different HO can have the same Object ID but these must belong to the same controller, and must be of type TRANSMIT." />

                                                            <a:tst expr="( num:i(.) = num:i(0)) or (num:i(node:fallback(../../*/CanObjectId,0) ) = num:i(node:fallback(../CanObjectId - 1,0)))" false="Wrong ObjectId. There must not be any gaps in the values of the CanObjectId of HardwareObjects." />

                                                            <!-- <a:tst expr="((node:value(../../*[node:current()/../@index + 1]/CanObjectType) = 'TRANSMIT') and (node:exists(../../*[node:current()/../@index + 2]/CanObjectType))) and (node:value(../../*[node:current()/../@index + 2]/CanObjectType) = 'RECEIVE')" true="The Hrh must be less than Hth." /> -->

                                                            <!--((node:current()/../@index
                                                            + 2) =
                                                            (num:i(count(node:fallback(node:current()/../../*,
                                                            1)))))-->
                                                       </a:da>
                                                       <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&lt;=65535" />
                                                            <a:tst expr="&gt;=0" />
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00327 :[CanObjectType] Specifies if the HardwareObject is used as Transmit or as Receive object. -->
                                                  <v:var name="CanObjectType" type="ENUMERATION">
                                                       <a:a name="DESC" value="EN: Specifies if the HardwareObject is used as Transmit or as Receive object" />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="1c9b9776-3754-428c-aaa3-79301b0f637f" />
                                                       <a:da name="DEFAULT" value="RECEIVE" />
                                                       <a:da name="RANGE">
                                                            <a:v>RECEIVE</a:v>
                                                            <a:v>TRANSMIT</a:v>
                                                       </a:da>
                                                       <a:da name="INVALID" type="XPath">
                                                            <!-- TODO:Update Error id -->
                                                            <a:tst expr=". = 'RECEIVE' and not(node:exists(../CanHwFilter))" true="[080-00-00-xx-ERROR]: CanHwFilter container is only valid for HRHs and contains the configuration (parameters) of one hardware filter."/>
                                                       </a:da>
                                                  </v:var>
<!-- ECUC_Can_00486 :[CanTriggerTransmitEnable] This parameter defines if or if not Can supports the trigger-transmit API for this handle. -->
                                                  <v:var name="CanTriggerTransmitEnable" type="BOOLEAN">
                                                       <a:a name="DESC" value="EN: This parameter defines if or if not Can supports the trigger-transmit API for this handle." />
                                                       <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                           <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                           <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="OPTIONAL" value="true" />
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="3a7f1470-b821-44d0-a461-8bd1201d8438" />
                                                       <a:da name="DEFAULT" value="false" />
                                                  </v:var>
<!-- ECUC_Can_00490 :[CanHardwareObjectUsesPolling] Enables polling of this hardware object. -->
                                                  <v:var name="CanHardwareObjectUsesPolling" type="BOOLEAN">
                                                       <a:a name="DESC" value="EN: Enables polling of this hardware object." />
                                                       <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                           <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                           <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="OPTIONAL" value="true" />
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="ECU" />
                                                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                       <a:a name="UUID" value="69b642cd-46ed-4592-a787-62589298ee94" />
                                                       <a:da name="DEFAULT" value="false" />
                                                  </v:var>
<!-- ECUC_Can_00322 :[CanControllerRef] Reference to CAN Controller to which the HOH is associated to. -->
                                                  <v:ref name="CanControllerRef" type="REFERENCE">
                                                       <a:a name="DESC" value="EN: Reference to CAN Controller to which the HOH is associated to." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="UUID" value="f6af7e9c-1485-4abd-ae4e-345975b12e9c" />
                                                       <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Can/CanConfigSet/CanController" />
                                                  </v:ref>
<!-- ECUC_Can_00438 :[CanMainFunctionRWPeriodRef] Reference to CanMainFunctionPeriod. -->
                                                  <v:ref name="CanMainFunctionRWPeriodRef" type="REFERENCE">
                                                       <a:a name="DESC" value="EN: Reference to CanMainFunctionPeriod" />
                                                       <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="OPTIONAL" value="true" />
                                                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                       <a:a name="SCOPE" value="LOCAL" />
                                                       <a:a name="EDITABLE" type="XPath">
                                                            <a:tst expr="((node:ref(../CanControllerRef)/CanRxProcessing != 'INTERRUPT') and (../CanObjectType = 'RECEIVE')) or ((node:ref(../CanControllerRef)/CanTxProcessing != 'INTERRUPT') and (../CanObjectType = 'TRANSMIT'))" />
                                                       </a:a>
                                                       <a:a name="UUID" value="78f9aaf9-eb61-419c-8afe-0da247bf66c2" />
                                                       <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Can/CanGeneral/CanMainFunctionRWPeriods" />
                                                       <a:da name="INVALID" type="XPath">
                                                            <a:tst expr="(../CanObjectType = 'RECEIVE') and (node:value((node:ref(../CanControllerRef)/CanRxProcessing)) = 'POLLING') and (not(node:refvalid(.)))" true="CanMainFunctionRWPeriodRef should refer to CanMainFunctionRWPeriod container,  including a valid CanMainFunctionReadPeriod, when CanObjectType is RECEIVE and CanRxProcessing is configured as POLLING." />
                                                            <a:tst expr="(../CanObjectType = 'TRANSMIT') and (node:value((node:ref(../CanControllerRef)/CanTxProcessing)) = 'POLLING') and (not(node:refvalid(.)))" true="CanMainFunctionRWPeriodRef should refer to CanMainFunctionRWPeriod container,  including a valid CanMainFunctionWritePeriod, when CanObjectType is TRANSMIT and CanTxProcessing is configured as POLLING" />
                                                       </a:da>
                                                  </v:ref>
<!-- ECUC_Can_00468 :[CanHwFilter] This container is only valid for HRHs and contains the configuration (parameters) of one hardware filter. -->
                                                  <v:ctr name="CanHwFilter" type="IDENTIFIABLE">
                                                       <a:a name="DESC" value="EN: This container is only valid for HRHs and contains the configuration (parameters) of one hardware filter." />
                                                       <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                           <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                       </a:a>
                                                       <a:a name="OPTIONAL" value="true" />
                                                       <a:a name="UUID" value="f63b1154-3356-404c-8b85-aefb1a507a92" />
<!-- ECUC_Can_00469 :[CanHwFilterCode] Specifies (together with the filter mask) the identifiers range that passes the hardware filter.                                                        -->
                                                       <v:var name="CanHwFilterCode" type="INTEGER">
                                                            <a:a name="DESC" value="EN: Specifies (together with the filter mask) the identifiers range that passes the hardware filter." />
                                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                 <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                            </a:a>
                                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                            <a:a name="UUID" value="748d14e1-6566-42c3-8a12-fd5d31dce434" />
                                                            <a:da name="EDITABLE" value="true" />
                                                            <a:da name="DEFAULT" value="0" />
                                                            <a:da name="INVALID" type="Range">
                                                                 <a:tst expr="&lt;=4294967295" />
                                                                 <a:tst expr="&gt;=0" />
                                                            </a:da>
                                                       </v:var>
<!-- ECUC_Can_00470 :[CanHwFilterMask] Describes a mask for hardware-based filtering of CAN identifiers.  -->
                                                       <v:var name="CanHwFilterMask" type="INTEGER">
                                                            <a:a name="DESC" value="EN: Describes a mask for hardware-based filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with the appropriate CanFilterMaskValue. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position." />
                                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                 <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                            </a:a>
                                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                            <a:a name="UUID" value="80c0c2aa-082f-42d4-90aa-59895f72b9c5" />
                                                            <a:da name="EDITABLE" value="true" />
                                                            <a:da name="DEFAULT" value="2047" />
                                                            <a:da name="INVALID" type="Range">
                                                                 <a:tst expr="&lt;=4294967295" />
                                                                 <a:tst expr="&gt;=0" />
                                                            </a:da>
                                                       </v:var>
                                                  </v:ctr>
<!-- TODO:CanTTHardwareObjectTrigger is specified in the SWS TTCAN and contains the configuration (parameters) of TTCAN triggers for Hardware Objects, which are additional to the configuration (parameters) of CAN Hardware Objects. -->
                                                  <v:lst name="CanTTHardwareObjectTrigger" type="MAP">
                                                       <a:a name="ENABLE" value="false" />
                                                       <!--
                                                       Supportted for features !-->
                                                       <v:ctr name="CanTTHardwareObjectTrigger" type="IDENTIFIABLE">
                                                            <a:a name="DESC" value="EN: CanTTHardwareObjectTrigger is specified in the SWS TTCAN and contains the configuration (parameters) of TTCAN triggers for Hardware Objects, which are additional to the configuration (parameters) of CAN Hardware Objects." />
                                                            <a:a name="UUID" value="17570571-b6f6-4274-b3e0-14acb6cfdb11" />
                                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false" />
                                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                 <icc:v mclass="PreCompile">
                                                                      VariantPostBuild</icc:v>
                                                            </a:a>
                                                            <v:var name="CanTTHardwareObjectBaseCycle" type="INTEGER">
                                                                 <a:a name="DESC" value="EN: Defines the cycle_offset." />
                                                                 <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                      <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
                                                                      <icc:v vclass="PostBuild">
                                                                           VariantPostBuild</icc:v>
                                                                 </a:a>
                                                                 <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                 <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                                 <a:a name="SCOPE" value="ECU" />
                                                                 <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                 <a:a name="UUID" value="0c55a9d8-e3dc-4abe-ae1b-6204277c12e7" />
                                                                 <a:da name="DEFAULT" value="0" />
                                                                 <a:da name="INVALID" type="Range">
                                                                      <a:tst expr="&lt;=63" />
                                                                      <a:tst expr="&gt;=0" />
                                                                 </a:da>
                                                            </v:var>
                                                            <v:var name="CanTTHardwareObjectCycleRepetition" type="INTEGER">
                                                                 <a:a name="DESC" value="EN: Defines the repeat_factor." />
                                                                 <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                      <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
                                                                      <icc:v vclass="PostBuild">
                                                                           VariantPostBuild</icc:v>
                                                                 </a:a>
                                                                 <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                 <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                                 <a:a name="SCOPE" value="ECU" />
                                                                 <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                 <a:a name="UUID" value="e51fe098-3705-4a5a-a473-bf74b6e0bfdb" />
                                                                 <a:da name="DEFAULT" value="1" />
                                                                 <a:da name="INVALID" type="Range">
                                                                      <a:tst expr="&lt;=64" />
                                                                      <a:tst expr="&gt;=1" />
                                                                 </a:da>
                                                            </v:var>
                                                            <v:var name="CanTTHardwareObjectTimeMark" type="INTEGER">
                                                                 <a:a name="DESC" value="EN: Defines the point in time, when the trigger will be activated." />
                                                                 <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                      <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
                                                                      <icc:v vclass="PostBuild">
                                                                           VariantPostBuild</icc:v>
                                                                 </a:a>
                                                                 <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                 <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                                 <a:a name="SCOPE" value="LOCAL" />
                                                                 <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                 <a:a name="UUID" value="84693721-419e-428a-9c41-24440b546963" />
                                                                 <a:da name="DEFAULT" value="0" />
                                                                 <a:da name="INVALID" type="Range">
                                                                      <a:tst expr="&lt;=65535" />
                                                                      <a:tst expr="&gt;=0" />
                                                                 </a:da>
                                                            </v:var>
                                                            <v:var name="CanTTHardwareObjectTriggerId" type="INTEGER">
                                                                 <a:a name="DESC" value="EN: Sequential number which allows separation of different TTCAN triggers configured for one and the same hardware object." />
                                                                 <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                      <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
                                                                      <icc:v vclass="PreCompile">
                                                                           VariantPostBuild</icc:v>
                                                                 </a:a>
                                                                 <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                 <a:a name="SCOPE" value="LOCAL" />
                                                                 <a:a name="SYMBOLICNAMEVALUE" value="true" />
                                                                 <a:a name="UUID" value="b7daf39e-4271-46a9-ba8d-65f251976590" />
                                                                 <a:da name="DEFAULT" value="0" />
                                                                 <a:da name="INVALID" type="Range">
                                                                      <a:tst expr="&lt;=63" />
                                                                      <a:tst expr="&gt;=0" />
                                                                 </a:da>
                                                            </v:var>
                                                            <v:var name="CanTTHardwareObjectTriggerType" type="ENUMERATION">
                                                                 <a:a name="DESC" value="EN: Defines the type of the trigger associated with the hardware object. This parameter depends on plain CAN parameter CAN_OBJECT_TYPE." />
                                                                 <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                      <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
                                                                      <icc:v vclass="PostBuild">
                                                                           VariantPostBuild</icc:v>
                                                                 </a:a>
                                                                 <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                 <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                                 <a:a name="SCOPE" value="LOCAL" />
                                                                 <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                 <a:a name="UUID" value="6227d936-b089-4588-98b9-931490025b95" />
                                                                 <a:da name="DEFAULT" value="CAN_TT_RX_TRIGGER" />
                                                                 <a:da name="RANGE">
                                                                      <a:v>CAN_TT_RX_TRIGGER</a:v>
                                                                      <a:v>CAN_TT_TX_REF_TRIGGER</a:v>
                                                                      <a:v>CAN_TT_TX_REF_TRIGGER_GAP</a:v>
                                                                      <a:v>
                                                                           CAN_TT_TX_TRIGGER_EXCLUSIVE</a:v>
                                                                      <a:v>CAN_TT_TX_TRIGGER_MERGED</a:v>
                                                                      <a:v>CAN_TT_TX_TRIGGER_SINGLE</a:v>
                                                                 </a:da>
                                                            </v:var>
                                                       </v:ctr>
                                                  </v:lst>
                                             </v:ctr>
                                        </v:lst>
<!-- ECUC_Can_00440 :[CanConfigSet/CanIcom] This container contains the parameters for configuring pretended networking -->
                                        <v:ctr name="CanIcom" type="IDENTIFIABLE">
                                             <a:da name="ENABLE" value="false" />
                                             <a:a name="DESC" value="EN: This container contains the parameters for configuring pretended networking" />
                                             <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                 <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                             </a:a>
                                             <a:a name="OPTIONAL" value="true" />
                                             <a:a name="UUID" value="df10c300-a22e-45c7-8907-c6fd62232291" />
<!-- ECUC_Can_00459 :[CanIcomConfig] This container contains the configuration parameters of the ICOM Configuration. -->
                                             <v:lst name="CanIcomConfig" type="MAP">
                                                  <a:da name="ENABLE" value="false" />
                                                  <a:da name="MIN" value="1" />
                                                  <v:ctr name="CanIcomConfig" type="IDENTIFIABLE">
                                                       <a:a name="DESC" value="EN: This container contains the configuration parameters of the ICOM Configuration." />
                                                       <a:a name="UUID" value="ec78795f-0b2e-446a-b4d6-76589063c79f" />
                                                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v mclass="PreCompile">
                                                                 VariantPostBuild</icc:v>
                                                       </a:a>
<!-- ECUC_Can_00441 :[CanIcomConfigId] This parameter identifies the ID of the ICOM configuration. -->
                                                       <v:var name="CanIcomConfigId" type="INTEGER">
                                                            <a:a name="DESC" value="EN: This parameter identifies the ID of the ICOM configuration." />
                                                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                 <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                            </a:a>
                                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                            <a:a name="SCOPE" value="ECU" />
                                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                            <a:a name="UUID" value="a92767d9-0632-4e6e-86fe-0ab19e75e372" />
                                                            <a:da name="DEFAULT" value="1" />
                                                            <a:da name="INVALID" type="Range">
                                                                 <a:tst expr="&lt;=255" />
                                                                 <a:tst expr="&gt;=1" />
                                                            </a:da>
                                                       </v:var>
<!-- ECUC_Can_00442 :[CanIcomWakeOnBusOff]  This parameter defines that the MCU shall wake if the bus off is detected or not. -->
                                                       <v:var name="CanIcomWakeOnBusOff" type="BOOLEAN">
                                                            <a:a name="DESC" value="EN: This parameter defines that the MCU shall wake if the bus off is detected or not." />
                                                            <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                 <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                            </a:a>
                                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                            <a:a name="SCOPE" value="ECU" />
                                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                            <a:a name="UUID" value="f7cf2af2-27e5-414c-a647-47f65d1502c8" />
                                                            <a:da name="DEFAULT" value="true" />
                                                       </v:var>
<!-- ECUC_Can_00443 :[CanIcomWakeupCauses] This container contains the configuration parameters of the wakeup causes to leave the power saving mode. -->
                                                       <v:ctr name="CanIcomWakeupCauses" type="IDENTIFIABLE">
                                                            <a:a name="DESC" value="EN: This container contains the configuration parameters of the wakeup causes to leave the power saving mode." />
                                                            <a:a name="UUID" value="fc76bdc0-daf6-48ed-9eb1-4ef30436d109" />
                                                            <v:lst name="CanIcomRxMessage" type="MAP">
                                                                 <a:da name="MIN" value="1" />
<!-- ECUC_Can_00447 :[CanIcomRxMessage] This container contains the configuration parameters for the wakeup causes for matching received messages.  -->
                                                                 <v:ctr name="CanIcomRxMessage" type="IDENTIFIABLE">
                                                                      <a:a name="DESC" value="EN: This container contains the configuration parameters for the wakeup causes for matching received messages. It has to be configured as often as received messages are defined as wakeup cause." />
                                                                      <a:a name="UUID" value="f702d563-bc59-4140-9e40-38400fd3d219" />
                                                                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                           <icc:v mclass="PreCompile">
                                                                                VariantPostBuild</icc:v>
                                                                      </a:a>
<!-- ECUC_Can_00448 :[CanIcomCounterValue] This parameter defines that the MCU shall wake if the message with the ID is received n times on the communication channel. -->
                                                                      <v:var name="CanIcomCounterValue" type="INTEGER">
                                                                           <a:a name="DESC" value="EN: This parameter defines that the MCU shall wake if the message with the ID is received n times on the communication channel." />
                                                                           <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                                                           <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                                           <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                                <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                                           </a:a>
                                                                           <a:a name="OPTIONAL" value="true" />
                                                                           <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                           <a:a name="SCOPE" value="ECU" />
                                                                           <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                           <a:a name="UUID" value="9d41d6ed-ed88-4338-a54a-395b5b6b8cac" />
                                                                           <a:da name="DEFAULT" value="1" />
                                                                           <a:da name="INVALID" type="Range">
                                                                                <a:tst expr="&lt;=65536" />
                                                                                <a:tst expr="&gt;=1" />
                                                                           </a:da>
                                                                      </v:var>
<!-- ECUC_Can_00449 :[CanIcomMessageId] This parameter defines the message ID the wakeup causes of this CanIcomRxMessage are configured for. -->
                                                                      <v:var name="CanIcomMessageId" type="INTEGER">
                                                                           <a:a name="DESC" value="EN: This parameter defines the message ID the wakeup causes of this CanIcomRxMessage are configured for. In addition a mask (CanIcomMessageIdMask) can be defined, in that case it is possible to define a range of rx messages, which can create a wakeup condition." />
                                                                           <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                                           <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                                           </a:a>
                                                                           <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                           <a:a name="SCOPE" value="ECU" />
                                                                           <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                           <a:a name="UUID" value="a53421ed-a145-4b08-b854-d4ece43698c7" />
                                                                           <a:da name="DEFAULT" value="0" />
                                                                           <a:da name="INVALID" type="Range">
                                                                                <a:tst expr="&lt;=536870912" />
                                                                                <a:tst expr="&gt;=0" />
                                                                           </a:da>
                                                                      </v:var>
<!-- ECUC_Can_00465 :[CanIcomMessageIdMask] Describes a mask for filtering of CAN identifiers.  -->
                                                                      <v:var name="CanIcomMessageIdMask" type="INTEGER">
                                                                           <a:a name="DESC" value="EN: Describes a mask for filtering of CAN identifiers. The CAN identifiers of incoming messages are masked with this CanIcomMessageIdMask. If the masked identifier matches the masked value of CanIcomMessageId, it can create a wakeup condition for this CanIcomRxMessage. Bits holding a 0 mean don't care, i.e. do not compare the message's identifier in the respective bit position. The mask shall be build by filling with leading 0." />
                                                                           <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                                                           <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                                           <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                                <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                                           </a:a>
                                                                           <a:a name="OPTIONAL" value="true" />
                                                                           <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                           <a:a name="SCOPE" value="ECU" />
                                                                           <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                           <a:a name="UUID" value="5ded8dd0-955d-4f04-8da8-e7e64a6d5014" />
                                                                           <a:da name="DEFAULT" value="0" />
                                                                           <a:da name="INVALID" type="Range">
                                                                                <a:tst expr="&lt;=536870912" />
                                                                                <a:tst expr="&gt;=0" />
                                                                           </a:da>
                                                                      </v:var>
<!-- ECUC_Can_00450 :[CanIcomMissingMessageTimerValue] This parameter defines that the MCU shall wake if the message with the ID is not received for a specific time in s on the communication channel. -->
                                                                      <v:var name="CanIcomMissingMessageTimerValue" type="FLOAT">
                                                                           <a:a name="DESC" value="EN: This parameter defines that the MCU shall wake if the message with the ID is not received for a specific time in s on the" />
                                                                           <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                                                           <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                                           <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                                <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                                           </a:a>
                                                                           <a:a name="OPTIONAL" value="true" />
                                                                           <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                           <a:a name="SCOPE" value="ECU" />
                                                                           <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                           <a:a name="UUID" value="4a56d4fd-caf5-46be-9658-994867403e7b" />
                                                                           <a:da name="DEFAULT" value="0"/>
                                                                           <a:da name="INVALID" type="Range">
                                                                                <a:tst expr="&gt;=0"/>
                                                                                <a:tst expr="&lt;=65535"/>
                                                                           </a:da>
                                                                      </v:var>
<!-- ECUC_Can_00451 :[CanIcomPayloadLengthError] This parameter defines that the MCU shall wake if a payload error occurs. -->
                                                                      <v:var name="CanIcomPayloadLengthError" type="BOOLEAN">
                                                                           <a:a name="DESC" value="EN: This parameter defines that the MCU shall wake if a payload error occurs" />
                                                                           <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                                           <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                                           </a:a>
                                                                           <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                           <a:a name="SCOPE" value="ECU" />
