<!-- ECUC_Can_00437 :[CanMainFunctionRWPeriods] This container contains the parameter for configuring the period for cyclic call to Can_MainFunction_Read or Can_MainFunction_Write depending on the referring item. -->
                                        <v:lst name="CanMainFunctionRWPeriods" type="MAP">
                                             <a:da name="INVALID" type="XPath">
                                                  <a:tst expr="(../../../CanConfigSet/CanHardwareObject/*/CanObjectType = 'RECEIVE') and (../../../CanConfigSet/CanController/*/CanRxProcessing = 'POLLING') and 
                                                            (num:i(count(./*)) = 0)" true="There is at least one controller that has read processing to POLLING." />
                                                  <a:tst expr="(../../../CanConfigSet/CanHardwareObject/*/CanObjectType = 'TRANSMIT') and (../../../CanConfigSet/CanController/*/CanRxProcessing = 'POLLING') and  
                                                            (num:i(count(./*)) = 0)" true="There is at least one controller that has read processing to POLLING." />
                                             </a:da>
<!-- ECUC_Can_00437 :[CanMainFunctionRWPeriods] This container contains the parameter for configuring the period for cyclic call to Can_MainFunction_Read or Can_MainFunction_Write depending on the referring item. -->
