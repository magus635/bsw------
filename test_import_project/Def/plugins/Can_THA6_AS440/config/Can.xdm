                                                                                     </a:da>
                                                                                </v:var>
<!-- ECUC_Can_00462 :[CanIcomSignalOperation] This parameter defines the operation, which shall be used to verify the signal value creates a wakeup condition.                                                                                 -->
                                                                                <v:var name="CanIcomSignalOperation" type="ENUMERATION">
                                                                                     <a:a name="DESC" value="EN: This parameter defines the operation, which shall be used to verify the signal value creates a wakeup condition." />
                                                                                     <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                                                     <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                                                     </a:a>
                                                                                     <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                                     <a:a name="SCOPE" value="ECU" />
                                                                                     <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                                     <a:a name="UUID" value="875276f9-9c11-43f1-bafa-f09fc260b1ac" />
                                                                                     <a:da name="DEFAULT" value="AND" />
                                                                                     <a:da name="RANGE">
                                                                                          <a:v>AND</a:v>
                                                                                          <a:v>EQUAL</a:v>
                                                                                          <a:v>
                                                                                               GREATER</a:v>
                                                                                          <a:v>
                                                                                               SMALLER</a:v>
                                                                                          <a:v>XOR</a:v>
                                                                                     </a:da>
                                                                                </v:var>
<!-- ECUC_Can_00488 :[CanIcomSignalValue] This parameter shall be used to define a signal value which shall be compared (CanIcomSignalOperation) with the masked CanIcomSignalMask value of the received signal (CanIcomSignalRef). -->
                                                                                <v:var name="CanIcomSignalValue" type="INTEGER">
                                                                                     <a:a name="DESC" value="EN: This parameter shall be used to define a signal value which shall be compared (CanIcomSignalOperation) with the masked CanIcomSignalMask value of the received signal (CanIcomSignalRef)." />
                                                                                     <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                                                     <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                                                     </a:a>
                                                                                     <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                                                     <a:a name="SCOPE" value="LOCAL" />
                                                                                     <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                                                     <a:a name="UUID" value="44003261-537b-4781-957d-c6f18e7b86a0" />
