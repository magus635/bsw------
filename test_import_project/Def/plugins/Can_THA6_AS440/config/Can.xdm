<!-- Compatibility Design:[CanControllerPRESDIV] Specifies the Prescaler Division Factor.Defines the ratio between the module clock frequency and the serial clock frequency. -->
                                                            <v:var name="CanControllerPRESDIV" type="INTEGER">
                                                                 <a:a name="DESC" value="EN: Specifies the Prescaler Division Factor.Defines the ratio between the module clock frequency and the serial clock frequency." />
                                                                 <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                                      <!-- <icc:v vclass="PreCompile">VariantPreCompile</icc:v> -->
