                                                  <v:var name="CanMainFunctionPeriod" type="FLOAT">
                                                       <a:a name="DESC" value="EN: This parameter describes the period for cyclic call to Can_MainFunction_Read or Can_MainFunction_Write depending on the referring item. Unit is seconds. Different poll-cycles will be configurable if more than one CanMainFunctionPeriod is configured. In this case multiple Can_MainFunction_Read() or Can_MainFunction_Write() will be provided by the CAN Driver module." />
                                                       <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
