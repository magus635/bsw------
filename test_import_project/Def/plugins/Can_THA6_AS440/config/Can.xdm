                                                                 <v:var name="CanFDBytePayload" type="INTEGER">
                                                                      <a:a name="DESC" value="EN: Data Length Code:&lt;br/&gt;
                                                                           CAN and CAN FD: transmit frame has 0-8 data bytes.&lt;br/&gt;
                                                                           CAN FD: transmit frame has 12/16/20/24/32/48/64 data bytes." />
