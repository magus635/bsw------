                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="3700eb6f-ff51-4c8a-a264-0f824791156a">
                      <SHORT-NAME>CanTTController</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">CanTTController is specified in the SWS TTCAN and contains the configuration parameters of the TTCAN controller(s) (which are needed in addition to the configuration parameters of the CAN controller(s)).</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>0</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-INTEGER-PARAM-DEF UUID="6ad293d2-6fc4-46ce-b5b6-5e6581a05f20">
                          <SHORT-NAME>CanTTControllerApplWatchdogLimit</SHORT-NAME>
                          <DESC>
