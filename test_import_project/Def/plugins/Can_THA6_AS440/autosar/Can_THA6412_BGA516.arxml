                      <SHORT-NAME>CanHardwareChannel</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter provides the Real Hardware controller ID which is unique in the CAN Driver</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
