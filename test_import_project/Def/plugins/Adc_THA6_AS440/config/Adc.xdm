<?xml version="1.0"?>
<datamodel version="7.0"
    xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd"
    xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd"
    xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
    xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
    <d:ctr type="AUTOSAR" factory="autosar"
        xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
        xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd"
        xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd"
        xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
        xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"
        xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
        <d:lst type="TOP-LEVEL-PACKAGES">
            <d:ctr name="THA6_AS440_FuSa" type="AR-PACKAGE">
                <a:a name="UUID" value="ECUC:AUTOSAR" />
                <d:lst type="ELEMENTS">
                    <d:chc name="Adc" type="AR-ELEMENT" value="MODULE-DEF">
                        <v:ctr type="MODULE-DEF">
                            <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                                <ad:ADMIN-DATA>
                                    <ad:DOC-REVISIONS>
                                        <ad:DOC-REVISION>
                                            <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                                            <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                                          </ad:DOC-REVISION>
                                    </ad:DOC-REVISIONS>
                                </ad:ADMIN-DATA>
                            </a:a>
                            <a:a name="DESC"
                                value="EN: Configuration of the Adc (Analog Digital Conversion) module." />
                            <a:a name="LOWER-MULTIPLICITY" value="0" />
                            <a:a name="POSTBUILDVARIANTSUPPORT" value="true" />
                            <a:a name="RELEASE" value="asc:4.4.0" />
                            <a:a name="UPPER-MULTIPLICITY" value="1" />
                            <a:a name="UUID" value="7966e747-678e-4128-9342-351e6e5ec5be" />
                            <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                    type="IMPLEMENTATIONCONFIGCLASS">
                                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                </a:a>
                                <a:a name="LABEL" value="Config Variant" />
                                <a:a name="UUID" value="c4f99bf8-bf5f-4259-8373-346f5681a8ce" />
                                <a:da name="DEFAULT" value="VariantPostBuild" />
                                <a:da name="RANGE">
                                    <a:v>VariantPostBuild</a:v>
                                </a:da>
                            </v:var>

                            <v:ctr name="AdcConfigSet" type="IDENTIFIABLE">
                                <a:a name="DESC"
                                    value="EN: This container contains the configuration parameters and sub containers of the AUTOSAR Adc module." />
                                <a:a name="UUID" value="c206ec80-6212-4b59-99c8-26a1b7268691" />
                                <v:ref name="AdcAnalogClockSource" type="REFERENCE">
                                    <a:a name="DESC"
                                        value="EN: This parameter defines ADC module clock(hz) &lt;br/&gt;
                                            This parameter is reference from MCU ADC clock(McuClockReferencePoint), configure ADC clock first in MCU Container" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="UUID" value="d8be721b-0b4d-45a3-9e64-c89f3b04b300" />
                                    <a:da name="REF"
                                        value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig/McuClockReferencePoint" />
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst expr="node:refvalid(.)"
                                            false="Invalid or empty reference." />
                                    </a:da>
                                </v:ref>
                                <v:lst name="AdcHwUnit" type="MAP">
                                    <a:da name="MIN" value="1" />
                                    <a:da name="MAX" type="XPath"
                                        expr="num:i(count(ecu:list('Adc.HwUnitId')))" />
                                    <v:ctr name="AdcHwUnit" type="IDENTIFIABLE">
                                        <a:a name="DESC"
                                            value="EN: This container contains the Driver configuration (parameters) depending on grouping of channels" />
                                        <a:a name="REQUIRES-INDEX" value="true"/>
                                        <a:a name="UUID"
                                            value="b4a78209-04ce-4e5c-8357-3d12631fd884" />
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                            type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                        <v:var name="AdcHwUnitId" type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: Numeric ID of the HW Unit. This symbolic name allows accessing Hw Unit data. Enumeration literals are defined vendor specific.&lt;br/&gt;" />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="88a35975-d25a-4734-8158-3f3d5520e06a" />
                                            <a:da name="DEFAULT" type="XPath"
                                                expr="ecu:list('Adc.HwUnitId')[node:fallback(node:current()/../@index, '0') + 1]" />
                                            <a:da name="RANGE" type="XPath"
                                                expr="ecu:list('Adc.HwUnitId')" />
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr="text:uniq(../../*/AdcHwUnitId, .)"
                                                    false="Wrong Configuration, ADC hardware unit must be unique" />
                                            </a:da>
                                        </v:var>
                                        <v:var name="AdcClockSource" type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: The ADC module specific clock input for the conversion unit can statically be configured to select different clock sources if provided by
                                                        hardware.&lt;br/&gt;
                                                        &lt;h1&gt;Note&lt;/h1&gt;
                                                        This parameter is not used and has been replaced by AdcConfigSet/AdcAnalogClockSource." />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="OPTIONAL" value="true" />
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="3e97b621-06e2-4f73-81a1-a1da157bbac6" />
                                            <a:a name="EDITABLE" value="false" />
                                        </v:var>
                                        <v:var name="AdcPrescale" type="INTEGER">
                                            <a:a name="DESC"
                                                value="EN: Optional ADC module specific clock divider factor.&lt;br/&gt;
                                                    &lt;h1&gt;Note&lt;/h1&gt; 
                                                    f_ADC = f_input / AdcPrescale.&lt;br/&gt;
                                                    This value must be an even number." />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="OPTIONAL" value="true" />
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="0d3a8737-ff9e-4a12-8c84-3314394ec2c2" />
                                            <a:da name="DEFAULT" value="14" />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=320" />
                                                <a:tst expr="&gt;=2" />
                                            </a:da>
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst
                                                    expr="num:i(. mod 2) = num:i(1)"
                                                    true="ADC clock divider factor must be an even number" />
                                                <a:tst
                                                    expr="(node:exists(../AdcSyncConvMode) and (../AdcSyncConvMode = 'ADC_SYNC_CONV_SLAVE')) and (num:i(.) &gt; num:i(node:ref(../AdcSyncConvMasterObject)/AdcPrescale))"
                                                    true="When 'AdcSyncConvMode' = 'ADC_SYNC_CONV_SLAVE', the clock frequency of the master within a synchronous conversion group must be less than or equal to the clock frequency of the slave." />
                                            </a:da>
                                            <a:a name="EDITABLE" value="true" />
                                        </v:var>
                                        <v:var name="AdcRequestSource0Prio" type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: Priority for the Request Source 0" />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="7bef2ef1-7158-4a2f-aa11-d1494c202aaf" />
                                            <a:da name="DEFAULT" type="XPath"
                                                expr="ecu:list('Adc.RequestSrcPrio')[1]" />
                                            <a:da name="RANGE" type="XPath"
                                                expr="ecu:list('Adc.RequestSrcPrio')" />
                                        </v:var>
                                        <v:var name="AdcRequestSource1Prio" type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: Priority for the Request Source 1" />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="6ca0ff78-0af2-40d8-99be-53feb918028c" />
                                            <a:da name="DEFAULT" type="XPath"
                                                expr="ecu:list('Adc.RequestSrcPrio')[1]" />
                                            <a:da name="RANGE" type="XPath"
                                                expr="ecu:list('Adc.RequestSrcPrio')" />
                                        </v:var>
                                        <v:var name="AdcRequestSource2Prio" type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: Priority for the Request Source 2" />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="8677d1af-42b9-493c-b70e-7cc5a6cde71b" />
                                            <a:da name="DEFAULT" type="XPath"
                                                expr="ecu:list('Adc.RequestSrcPrio')[1]" />
                                            <a:da name="RANGE" type="XPath"
                                                expr="ecu:list('Adc.RequestSrcPrio')" />
                                        </v:var>
                                        <v:var name="AdcResolution" type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: ADC resolution in bits for channel conversion in the AdcHwUnit.
                                                    &lt;h1&gt;Note&lt;/h1&gt; 
                                                    BITS_8 - 8-bit conversion. &lt;br/&gt; 
                                                    BITS_10 - 10-bit conversion. &lt;br/&gt; 
                                                    BITS_12 - 12-bit conversion." />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="d3d32214-f621-44e8-93ac-bb07becd34a4" />
                                            <a:a name="VISIBLE" type="XPath"
                                                expr="ecu:get('Adc.ResolutionForChannel') = 'false'" />
                                            <a:a name="DEFAULT" type="XPath"
                                                expr="ecu:list('Adc.Resolution')[1]" />
                                            <a:a name="RANGE" type="XPath"
                                                expr="ecu:list('Adc.Resolution')" />
                                        </v:var>
                                        <v:var name="AdcKernelChSampleTime" type="INTEGER">
                                            <a:a name="DESC"
                                                value="EN: ADC sample time for channel conversion in the AdcHwUnit.
                                                    &lt;h1&gt;Note&lt;/h1&gt;
                                                        The sample time = AdcKernelChSampleTime + 1.5." />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="6e21cb43-ea22-4794-99c2-78b262097a95" />
                                            <a:a name="VISIBLE" type="XPath"
                                                expr="ecu:get('Adc.ConvTimeForChannel') = 'false'" />
                                            <a:a name="DEFAULT" value="2" />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=255" />
                                                <a:tst expr="&gt;=0" />
                                            </a:da>
                                        </v:var>
                                        <v:var name="AdcRefVoltsrcHigh" type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: Upper reference voltage source for all channels.
                                                    &lt;h1&gt;Note&lt;/h1&gt; 
                                                    REF_VOLTAGE_VAREF - Standard reference input voltage.&lt;br&gt;" />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="OPTIONAL" value="true" />
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="a970dc76-065b-11ed-b036-f889d2d2ec8e" />
                                            <a:a name="VISIBLE" type="XPath"
                                                expr="ecu:get('Adc.RefVoltForChannel') = 'false'" />
                                            <a:a name="DEFAULT" type="XPath"
                                                expr="ecu:list('Adc.RefVoltSrcHigh')[1]" />
                                            <a:a name="RANGE" type="XPath"
                                                expr="ecu:list('Adc.RefVoltSrcHigh')" />
                                        </v:var>
                                        <v:var name="AdcRefVoltsrcLow" type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: Lower reference voltage source for all channels.
                                                    &lt;h1&gt;Note&lt;/h1&gt; 
                                                    REF_VOLTAGE_GND - Lower reference voltage is GND." />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="OPTIONAL" value="true" />
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="e41589af-e5ac-ee25-ac36-3279b5b3d5fb" />
                                            <a:a name="VISIBLE" type="XPath"
                                                expr="ecu:get('Adc.RefVoltForChannel') = 'false'" />
                                            <a:a name="DEFAULT" type="XPath"
                                                expr="ecu:list('Adc.RefVoltSrcLow')[1]" />
                                            <a:a name="RANGE" type="XPath"
                                                expr="ecu:list('Adc.RefVoltSrcLow')" />
                                        </v:var>
                                        <v:var name="AdcResultHandlingImplementation"
                                            type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: Determines the conversion result handling method of this HW unit.&lt;br/&gt;
                                                    &lt;h1&gt;Note&lt;/h1&gt;
                                                    INTERRUPT_MODE: Conversion results are transferred in the ISR (AUTOSAR Mode). If used it is necessary to configure the interrupt of this HW unit in the INTC module.&lt;br/&gt;
                                                    POLLING_MODE: Conversion results are transferred using API Adc_GetGroupStatus(). If used this API needs to be called periodically.&lt;br/&gt;
                                                    DMA_MODE: Conversion results are transferred using a DMA channel.If used it is necessary to configure the DMA channel of this HW unit in the DMA module. " />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="39ca08c4-0422-3365-d008-8794c5127d9a" />
                                            <a:da name="DEFAULT" value="INTERRUPT_MODE" />
                                            <a:da name="RANGE">
                                                <a:v>INTERRUPT_MODE</a:v>
                                                <a:v>POLLING_MODE</a:v>
                                                <a:v>DMA_MODE</a:v>
                                            </a:da>
                                        </v:var>
                                        <v:var name="AdcDmaResultHandlingInterruptEnable" type="BOOLEAN">
                                            <a:a name="DESC"
                                                value="EN: Enables / Disables ADC interrupt in the DMA result handling mode.&lt;br/&gt;
                                                    &lt;h1&gt;Note&lt;/h1&gt;
                                                    If disabled, the streaming access mode for groups under this hardware unit will be prohibited, and the API Adc_GetGroupStatus cannot be called." />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="OPTIONAL" value="true" />
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID" value="bf01c53d-a689-43c4-b7c8-495db514bd05" />
                                            <a:da name="DEFAULT" value="false" />
                                            <a:da name="EDITABLE" type="XPath" expr="node:fallback(../AdcResultHandlingImplementation, 'DMA_MODE') = 'DMA_MODE'" />
                                        </v:var>
                                        <v:var name="AdcSyncConvMode"
                                            type="ENUMERATION">
                                            <a:a name="DESC"
                                                value="EN: The working mode of the synchronization group.&lt;br/&gt;
                                                    ADC_STANDALONE: This HW unit does not use synchronization conversion function.&lt;br/&gt;
                                                    ADC_SYNC_CONV_MASTER: This HW unit serves as the master for the synchronization conversion group.&lt;br/&gt;
                                                    ADC_SYNC_CONV_SLAVE: This HW unit serves as the slave for the synchronization conversion group.
                                                    &lt;h1&gt;Note&lt;/h1&gt;
                                                    This parameter is available only if the parameter AdcSyncConvEnable is set to true." />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="4172bf56-7f19-6cca-93d0-4e09939ff871" />
                                            <a:da name="OPTIONAL" value="true" />
                                            <a:da name="DEFAULT" value="ADC_STANDALONE" />
                                            <a:da name="RANGE">
                                                <a:v>ADC_STANDALONE</a:v>
                                                <a:v>ADC_SYNC_CONV_MASTER</a:v>
                                                <a:v>ADC_SYNC_CONV_SLAVE</a:v>
                                            </a:da>
                                            <a:a name="EDITABLE" type="XPath"
                                                expr="node:fallback(as:modconf('Adc')/AdcGeneral/AdcSyncConvEnable, 'true') = 'true'" />
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst
                                                    expr="not(node:exists(../AdcSyncConvMasterObject)) and (. = 'ADC_SYNC_CONV_SLAVE')"
                                                    true="Node 'AdcSyncConvMasterObject' must be enabled when sync conversion mode is ADC_SYNC_CONV_SLAVE." />
                                            </a:da>
                                        </v:var>
                                        <v:ref name="AdcSyncConvMasterObject"
                                            type="REFERENCE">
                                            <a:a name="DESC"
                                                value="EN: If the 'AdcSyncConvMode' is set to the 'ADC_SYNC_CONV_SLAVE', this parameter selects the master HW unit for this slave HW unit in synchronization group.&lt;br/&gt;
                                                    &lt;h1&gt;Note&lt;/h1&gt;
                                                    This parameter is available only is the parameter AdcSyncConvEnable is set to 'ADC_SYNC_CONV_SLAVE'." />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="ChipowerTech" />
                                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                            <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="UUID" value="05231014-429d-4ec4-3b33-adb62e4e15c7" />
                                            <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Adc/AdcConfigSet/AdcHwUnit" />
                                            <a:da name="OPTIONAL" value="true" />
                                            <a:a name="EDITABLE" type="XPath" expr="node:fallback(../AdcSyncConvMode, 'ADC_SYNC_CONV_SLAVE') = 'ADC_SYNC_CONV_SLAVE'" />
                                            <a:da name="INVALID" type="XPath">
                                                <a:tst expr=". = ''"
                                                    true="Select an ADC HW unit as the master for this slave HW unit ." />
                                                <a:tst expr="node:refvalid(.)"
                                                    false="Invalid or empty reference." />
                                                <a:tst
                                                    expr="ecu:get(concat('Adc.SyncGroup.', ../AdcHwUnitId)) != ecu:get(concat('Adc.SyncGroup.', node:ref(.)/AdcHwUnitId))"
                                                    true="Invalid master. This hardware unit and the reference master hardware unit must belong to the same hardware synchronization group." />
                                                <a:tst
                                                    expr="contains(., ../@name)"
                                                    true="Selected HW unit is the current HW unit, You must select an HW unit where 'AdcSyncConvEnable' is set to 'ADC_SYNC_CONV_MASTER'." />
                                                <a:tst
                                                    expr="node:exists(node:ref(.)/AdcSyncConvMode)"
                                                    false="Selected HW unit must be enable the AdcSyncConvMode and set the AdcSyncConvMode = ADC_SYNC_CONV_MASTER" />
                                                <a:tst
                                                    expr="node:value(node:ref(.)/AdcSyncConvMode) = 'ADC_SYNC_CONV_MASTER'"
                                                    false="Selected HW unit must be set to master AdcSyncConvMode = ADC_SYNC_CONV_MASTER" />
                                            </a:da>
                                        </v:ref>
                                        <v:lst name="AdcChannel" type="MAP">
                                            <a:da name="MIN" value="1" />
                                            <a:da name="MAX" value="255" />
                                            <v:ctr name="AdcChannel" type="IDENTIFIABLE">
                                                <a:a name="DESC"
                                                    value="EN: This container contains the channel configuration (parameters) depending on the hardware capability.
                                                        The organization of this data structure could contain dependencies to the microcontroller so this is left up to the
                                                        implementer and its location is left up to the configuration. &lt;br/&gt;
                                                        Note: Since a AdcChannel can be part of several AdcGroups, this container is not realized as a subcontainer of AdcGroup but instead as a subcontainer of AdcHwUnit." />
                                                <a:a name="REQUIRES-INDEX" value="true"/>
                                                <a:a name="UUID"
                                                    value="34de1f72-35eb-4ffd-8ee0-dc9a2a49790f" />
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                    type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                                <a:da name="INVALID" type="XPath">
                                                    <a:tst
                                                        expr="text:uniq(../../../*/AdcChannel/*/@name, @name)"
                                                        false="Duplicate AdcChannelNames, Channel Symbolic names must be unique across HWUnits." />
                                                </a:da>
                                                <v:var name="AdcChannelId" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: This parameter defines the assignment of the channel to the physical ADC  hardware channel." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="5e56c138-15ad-4e02-bead-ce8229b42333" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=255" />
                                                        <a:tst expr="&gt;=0" />
                                                    </a:da>
                                                    <a:da name="DEFAULT" type="XPath"
                                                        expr="node:fallback(node:current()/../@index, '0')" />
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst
                                                            expr="(.&gt;= 0) and (.&lt; num:i(count(node:current()/../../*)))"
                                                            false="Logical ID is out of range" />
                                                        <a:tst
                                                            expr="text:uniq(../../*/AdcChannelId,.)"
                                                            false="Duplicate logical channel ID" />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcAnChannelNum" type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Analog Input Channel Number. 8/16 analog inputs for each ADC HW Units are connected." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="716e9055-0485-44d5-99ec-1b5507063965" />
                                                    <a:da name="RANGE" type="XPath">
                                                        <a:tst
                                                            expr="ecu:list(text:concat('Adc.AdcChannels_Adc', text:split(node:fallback(../../../AdcHwUnitId, 'SARADCx'), 'SARADC')[1]))" />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcChannelConvTime" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: Configuration of conversion time, i.e. the time during which the analogue value is converted into digital representation, (in clock cycles) for each channel, if supported by hardware. &lt;/br&gt; 
                                                            &lt;h1&gt;Note&lt;/h1&gt;This parameter is not used." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="0e358560-920f-4f1e-9c9c-027f6678238b" />
                                                    <a:da name="DEFAULT" value="0" />
                                                    <a:da name="EDITABLE" value="false" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=9223372036854775807" />
                                                        <a:tst expr="&gt;=0" />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcChannelLimitCheck" type="BOOLEAN">
                                                    <a:a name="DESC"
                                                        value="EN: Enables or disables limit checking for an ADC channel.&lt;br/&gt;
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            1. This parameter is available only when the parameter AdcEnableLimitCheck is set to true;&lt;br/&gt;
                                                            2. This parameter must set to false when the parameter AdcEnableLimitCheck is set to false;&lt;br/&gt;
                                                            3. if the parameter AdcChannelLimitCheck is set to true, the parameter AdcChannelLowLimit must be configured;&lt;br/&gt;
                                                            4. if the parameter AdcChannelHighLimit is set to true, the parameter AdcChannelLowLimit must be configured;&lt;br/&gt;
                                                            5. if the parameter AdcChannelRangeSelect is set to true, the parameter AdcChannelLowLimit must be configured;&lt;br/&gt;" />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="f7be176e-1d9a-453a-9b5f-5db3fc3c10c7" />
                                                    <a:da name="DEFAULT" value="false" />
                                                    <a:da name="EDITABLE" type="XPath"
                                                        expr="(../../../../../../AdcGeneral/AdcEnableLimitCheck = 'true')" />
                                                    <a:a name="INVALID" type="XPath">
                                                        <a:tst
                                                            expr="(../../../../../../AdcGeneral/AdcEnableLimitCheck = 'false' and .='true')"
                                                            true="AdcChannelLimitCheck must be disabled when Adc/AdcGeneral/AdcEnableLimitCheck is false." />
                                                        <a:tst
                                                            expr="(../../../../../../AdcGeneral/AdcEnableLimitCheck = 'true' and .='true' and (not(node:exists(../AdcChannelLowLimit))))"
                                                            true="if Adc/AdcGeneral/AdcChannelLimitCheck is enabled, AdcChannelLowLimit must be configured." />
                                                        <a:tst
                                                            expr="(../../../../../../AdcGeneral/AdcEnableLimitCheck = 'true' and .='true' and (not(node:exists(../AdcChannelHighLimit))))"
                                                            true="if Adc/AdcGeneral/AdcChannelLimitCheck is enabled, AdcChannelHighLimit must be configured." />
                                                        <a:tst
                                                            expr="(../../../../../../AdcGeneral/AdcEnableLimitCheck = 'true' and .='true' and (not(node:exists(../AdcChannelRangeSelect))))"
                                                            true="if Adc/AdcGeneral/AdcChannelLimitCheck is enabled, AdcChannelRangeSelect must be configured." />
                                                    </a:a>
                                                </v:var>
                                                <v:var name="AdcChannelHighLimit" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: High limit - used for limit checking.&lt;br/&gt;
                                                            1. when the resolution of HW unit is 12bits: range is 0 to 4095;
                                                            2. when the resolution of HW unit is 10bits; range is 0 to 1023;
                                                            3. when the resolution of HW unit is 8bits; range is 0 to 255; 
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            This parameter is available only when the parameters AdcChannelLimitCheck and AdcEnableLimitCheck are set to true;&lt;br/&gt;" />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="83900ba4-6b65-4569-9c4a-2597e4e1794d" />
                                                    <a:da name="DEFAULT" value="4095" />
                                                    <a:da name="EDITABLE" type="XPath"
                                                        expr="node:exists(../AdcChannelLimitCheck) and (../AdcChannelLimitCheck = 'true') and (../../../../../../AdcGeneral/AdcEnableLimitCheck = 'true')" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=9223372036854775807" />
                                                        <a:tst expr="&gt;=0" />
                                                    </a:da>
                                                    <a:da name="RANGE" type="XPath">
                                                        <a:tst
                                                            expr="(node:exists(../AdcChannelLowLimit) and (. &gt;= ../AdcChannelLowLimit))"
                                                            false="Adc Channel High Limit value should be greater or equal than Adc Channel Low Limit value." />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcChannelLowLimit" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: Low limit - used for limit checking.&lt;br/&gt;
                                                            1. when the resolution of HW unit is 12bits: range is 0 to 4095;
                                                            2. when the resolution of HW unit is 10bits; range is 0 to 1023;
                                                            3. when the resolution of HW unit is 8bits; range is 0 to 255; 
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            This parameter is available only when the parameters AdcChannelLimitCheck and AdcEnableLimitCheck are set to true;&lt;br/&gt;" />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="cd5a44f4-1783-4281-9203-6aed881acf41" />
                                                    <a:da name="DEFAULT" value="0" />
                                                    <a:da name="EDITABLE" type="XPath"
                                                        expr="node:exists(../AdcChannelLimitCheck) and (../AdcChannelLimitCheck = 'true') and (../../../../../../AdcGeneral/AdcEnableLimitCheck = 'true')" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=9223372036854775807" />
                                                        <a:tst expr="&gt;=0" />
                                                    </a:da>
                                                    <a:da name="RANGE" type="XPath">
                                                        <a:tst
                                                            expr="(node:exists(../AdcChannelHighLimit) and (. &lt;= ../AdcChannelHighLimit))"
                                                            false="Adc Channel Low Limit value should be less or equal than Adc Channel High Limit value." />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcChannelRangeSelect"
                                                    type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: In case of active limit checking: defines which conversion values are taken into account related to the boarders defined with AdcChannelLowLimit and AdcChannelHighLimit.&lt;br/&gt;
                                                            ADC_RANGE_ALWAYS - Complete range - independent from channel limit settings.&lt;br/&gt;
                                                            ADC_RANGE_BETWEEN - Range between low limit and high limit - high limit value included.&lt;br/&gt;
                                                            ADC_RANGE_NOT_BETWEEN - Range above high limit or below low limit - low limit value included.&lt;br/&gt;
                                                            ADC_RANGE_NOT_OVER_HIGH - Range below high limit - high limit value included.&lt;br/&gt;
                                                            ADC_RANGE_NOT_UNDER_LOW  - Range above low limit.&lt;br/&gt;
                                                            ADC_RANGE_OVER_HIGH - Range above high limit.&lt;br/&gt;
                                                            ADC_RANGE_UNDER_LOW - Range below limit - low limit value included.&lt;br/&gt;
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            This parameter is available only when the parameters AdcChannelLimitCheck and AdcEnableLimitCheck are set to true.;&lt;br/&gt;" />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="e17194bd-8053-4ffd-bcab-11e68e9b1e1a" />
                                                    <a:da name="DEFAULT" value="ADC_RANGE_ALWAYS" />
                                                    <a:da name="EDITABLE" type="XPath"
                                                        expr="node:exists(../AdcChannelLimitCheck) and (../AdcChannelLimitCheck = 'true') and (../../../../../../AdcGeneral/AdcEnableLimitCheck = 'true')" />
                                                    <a:da name="RANGE">
                                                        <a:v>ADC_RANGE_ALWAYS</a:v>
                                                        <a:v>ADC_RANGE_BETWEEN</a:v>
                                                        <a:v>ADC_RANGE_NOT_BETWEEN</a:v>
                                                        <a:v>ADC_RANGE_NOT_OVER_HIGH</a:v>
                                                        <a:v>ADC_RANGE_NOT_UNDER_LOW</a:v>
                                                        <a:v>ADC_RANGE_OVER_HIGH</a:v>
                                                        <a:v>ADC_RANGE_UNDER_LOW</a:v>
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcChannelRefVoltsrcHigh"
                                                    type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Upper reference voltage source for each channel. 
                                                            &lt;h1&gt;Note&lt;/h1&gt;Not supported on Adc Channel and has been replaced by AdcHwUnit/AdcRefVoltHigh." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="107fe188-71dd-4a10-b263-e691a365acac" />
                                                    <a:da name="DEFAULT" value="REF_VOLTAGE_VAREF" />
                                                    <a:a name="EDITABLE" value="false" />
                                                    <a:da name="RANGE">
                                                        <a:v>REF_VOLTAGE_VAREF</a:v>
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcChannelRefVoltsrcLow"
                                                    type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Lower reference voltage source for each channel.
                                                            &lt;h1&gt;Note&lt;/h1&gt;Not supported on Adc Channel and has been replaced by AdcHwUnit/AdcRefVoltLow." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="40d84ce4-337e-42d4-902a-d26336cda1fe" />
                                                    <a:a name="EDITABLE" value="false" />
                                                </v:var>
                                                <v:var name="AdcChannelResolution" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: Channel resolution in bits.
                                                            &lt;h1&gt;Note&lt;/h1&gt;Not supported on Adc Channel and has been replaced by AdcHwUnit/AdcResolution." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="d89f1d4c-c870-4aa5-a6ba-dbceff6cda61" />
                                                    <a:da name="DEFAULT" value="1" />
                                                    <a:da name="EDITABLE" value="false" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=63" />
                                                        <a:tst expr="&gt;=1" />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcChannelSampTime" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: Configuration of sampling time, i.e. the time during which the value is sampled, (in clock cycles) for each channel, if supported by hardware.
                                                            &lt;h1&gt;Note&lt;/h1&gt;Not supported on Adc Channel and has been replaced by AdcHwUnit/AdcKernelChSampleTime." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="9da231f8-8f10-47f1-9159-f7ace1359d2a" />
                                                    <a:da name="DEFAULT" value="0" />
                                                    <a:da name="EDITABLE" value="false" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=9223372036854775807" />
                                                        <a:tst expr="&gt;=0" />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcChannelSyncConvEnable"
                                                    type="BOOLEAN">
                                                    <a:a name="DESC"
                                                        value="EN: Enables / disables the synchronous conversion functionality for this channel.&lt;br/&gt;
                                                            true: Enable the synchronous conversion for this channel.&lt;br/&gt;
                                                            false: Disable the synchronous conversion for this channel.
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            This parameter is available only when the parameter AdcSyncConvEnable is set to true and the parameter AdcSyncConvMode is set to 'ADC_SYNC_CONV_MASTER'." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                                    <a:da name="OPTIONAL" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="db59e680-8c72-144b-d815-fbc89568c0a7" />
                                                    <a:da name="DEFAULT" value="false" />
                                                    <a:da name="EDITABLE" type="XPath"
                                                        expr="(node:fallback(as:modconf('Adc')/AdcGeneral/AdcSyncConvEnable, 'true') = 'true') and 
                                                              (node:exists(../../../AdcSyncConvMode)) and
                                                              (node:fallback(../../../AdcSyncConvMode, 'ADC_SYNC_CONV_MASTER') = 'ADC_SYNC_CONV_MASTER')" />
                                                </v:var>
                                            </v:ctr>
                                        </v:lst>
                                        <v:lst name="AdcGroup" type="MAP">
                                            <a:da name="MIN" value="1" />
                                            <a:da name="MAX" value="32"/>
                                            <v:ctr name="AdcGroup" type="IDENTIFIABLE">
                                                <a:a name="DESC"
                                                    value="EN: This container contains the Group configuration (parameters)." />
                                                <a:a name="REQUIRES-INDEX" value="true"/>
                                                <a:a name="UUID"
                                                    value="d702fa4d-8c38-4181-8563-0581b202d085" />
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                    type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                                                <a:da name="INVALID" type="XPath">
                                                    <a:tst
                                                        expr="text:uniq(../../../*/AdcGroup/*/@name, @name)"
                                                        false="Duplicate AdcGroupNames, Group Symbolic names must be unique across HWUnits." />
                                                </a:da>
                                                <v:var name="AdcGroupId" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: Numeric ID of the group. This parameter is the symbolic name to be used on the API. This symbolic name allows accessing Channel Group data. This value will be assigned to the symbolic name derived of the AdcGroup container shortName." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="true" />
                                                    <a:a name="UUID"
                                                        value="dfe37531-f881-433e-8e39-db4143aa5009" />
                                                    <a:da name="DEFAULT" type="XPath"
                                                        expr="num:i(node:fallback(node:current()/../@index,'0') + (num:i(32) * text:split(node:fallback(../../../AdcHwUnitId,'SARADC0'),'SARADC')[1]))" />
                                                    <a:da name="INVALID" type="Multi">
                                                        <mt:xpath
                                                            expr="(.&gt;= (num:i(32) * text:split(../../../AdcHwUnitId,'SARADC')[1]) ) and (.&lt; num:i((num:i(32) * text:split(../../../AdcHwUnitId,'SARADC')[1]) + count(node:current()/../../*)))"
                                                            false="EN: ADC - Value out of range: Correct Range is (HwUnitId * 32) to ((HwUnitId * 32) + N-1), where N is number of configured groups). User can use AUTO-CALCULATE-VALUE for all the groups to solve AdcGroupId errors." />
                                                        <mt:xpath
                                                            expr="text:uniq(../../*/AdcGroupId,.)"
                                                            false="EN: ADC - Duplicated value, AdcGroupId must be unique across all AdcGroups. User can use AUTO-CALCULATE-VALUE for all the groups to solve AdcGroupId errors." />
                                                        <mt:range>
                                                            <mt:tst expr="&gt;=0" />
                                                            <mt:tst expr="&lt;=1023" />
                                                        </mt:range>
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcGroupAccessMode" type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Type of access mode to group conversion results.&lt;br/&gt;
                                                            ADC_ACCESS_MODE_SINGLE - Single value access mode.&lt;br/&gt;
                                                            ADC_ACCESS_MODE_STREAMING - Streaming access mode.&lt;br/&gt;
                                                            " />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID" value="d6602ab1-cde0-4322-b73b-b9371aee7973" />
                                                    <a:da name="DEFAULT" value="ADC_ACCESS_MODE_SINGLE" />
                                                    <a:da name="RANGE">
                                                        <a:v>ADC_ACCESS_MODE_SINGLE</a:v>
                                                        <a:v>ADC_ACCESS_MODE_STREAMING</a:v>
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst
                                                            expr="(../AdcGroupTriggSrc = 'ADC_TRIGG_SRC_SW') and (../AdcGroupConversionMode = 'ADC_CONV_MODE_ONESHOT') and (. = 'ADC_ACCESS_MODE_STREAMING')"
                                                            true="streaming access mode is not available for one-shot conversion mode with software trigger source" />
                                                        <a:tst
                                                            expr="(../../../AdcResultHandlingImplementation = 'DMA_MODE') and 
                                                                  ((node:exists(../../../AdcDmaResultHandlingInterruptEnable) and (../../../AdcDmaResultHandlingInterruptEnable = 'false')) or 
                                                                  (not(node:exists(../../../AdcDmaResultHandlingInterruptEnable)))) and 
                                                                  (. = 'ADC_ACCESS_MODE_STREAMING')"
                                                            true="streaming access mode is only available for AdcResultHandlingImplementation = 'DMA_MODE' and AdcDmaResultHandlingInterruptEnable = 'true'" />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcGroupConversionMode"
                                                    type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Type of conversion mode supported by the driver.&lt;br/&gt;
                                                            ADC_CONV_MODE_CONTINUOUS - Conversions of an ADC channel group are performed continuously after a software API call (start).
                                                                The conversions itself are running automatically (no additional software or hardware trigger needed). &lt;br/&gt;
                                                            ADC_CONV_MODE_ONESHOT - The conversion of an ADC channel group is performed once after a trigger.&lt;br/&gt;
                                                            " />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID" value="49bf5241-b3bb-4ad5-8b79-c8060e90d460" />
                                                    <a:da name="DEFAULT" value="ADC_CONV_MODE_ONESHOT" />
                                                    <a:da name="RANGE">
                                                        <a:v>ADC_CONV_MODE_CONTINUOUS</a:v>
                                                        <a:v>ADC_CONV_MODE_ONESHOT</a:v>
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst
                                                            expr="../AdcGroupTriggSrc = 'ADC_TRIGG_SRC_HW' and (.='ADC_CONV_MODE_CONTINUOUS')"
                                                            true="Continuous conversion mode only available for software triggered groups" />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcGroupPriority" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: Priority level of the AdcGroup.&lt;br/&gt;
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            THe lowest priority is 0.&lt;br/&gt;
                                                            This parameter is available only when the parameter AdcGroupTriggSrc is set to 'ADC_TRIGG_SRC_SW' and the parameter AdcPriorityImplementation is set to 'ADC_PRIORITY_HW_SW'." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID" value="e128981f-bf5a-4f21-87b6-c406154803cd" />
                                                    <a:da name="DEFAULT" value="0" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=255" />
                                                        <a:tst expr="&gt;=0" />
                                                    </a:da>
                                                    <a:da name="EDITABLE" type="XPath"
                                                        expr="(../AdcGroupTriggSrc = 'ADC_TRIGG_SRC_SW') and (as:modconf('Adc')[1]/AdcGeneral/AdcPriorityImplementation = 'ADC_PRIORITY_HW_SW')" />
                                                </v:var>
                                                <v:var name="AdcGroupReplacement" type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Replacement mechanism, which is used on ADC group level, if a group conversion is interrupted by a group which has a higher priority.&lt;br/&gt;
                                                            ADC_GROUP_REPL_ABORT_RESTART - Abort/Restart mechanism is used on group level, if a group is interrupted by a higher priority
                                                                group. The complete conversion round of the interrupted group (all group channels) is restarted after the higher priority group
                                                                conversion is finished. If the group is configured in streaming access mode, only the results of the interrupted conversion round
                                                                are discarded. Results of previous conversion rounds which are already written to the result buffer are not affected.&lt;br/&gt;
                                                            ADC_GROUP_REPL_SUSPEND_RESUME - Suspend/Resume mechanism is used on group level, if a group is interrupted by a higher priority
                                                                group. The converions round (conversion of all group channels) of the interrupted group is completed after the
                                                                higher priority group conversion is finished. If the group is configured in streaming access mode, only the results of the interrupted conversion round are
                                                                discarded. Results of previous conversion rounds which are already written to the result buffer are not affected.&lt;br/&gt;&lt;br/&gt;
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            Not supported for channel group" />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID" value="d11a6eff-8230-43c0-970e-198591bee410" />
                                                    <a:da name="DEFAULT" value="ADC_GROUP_REPL_ABORT_RESTART" />
                                                    <a:da
                                                        name="RANGE">
                                                        <a:v>ADC_GROUP_REPL_ABORT_RESTART</a:v>
                                                        <a:v>ADC_GROUP_REPL_SUSPEND_RESUME</a:v>
                                                    </a:da>
                                                    <a:da
                                                        name="EDITABLE" value = "false"/>
                                                </v:var>
                                                <v:var name="AdcGroupTriggSrc" type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Type of source event that starts a group conversion.&lt;br/&gt;
                                                            ADC_TRIGG_SRC_HW - Group is triggered by a hardware event.&lt;br/&gt;
                                                            ADC_TRIGG_SRC_SW - Group is triggered by a software API call." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID" value="4a73eee5-9297-4d3d-8931-22f9d8fe818f" />
                                                    <a:da name="DEFAULT" value="ADC_TRIGG_SRC_SW" />
                                                    <a:da name="RANGE">
                                                        <a:v>ADC_TRIGG_SRC_HW</a:v>
                                                        <a:v>ADC_TRIGG_SRC_SW</a:v>
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst
                                                            expr="../AdcGroupConversionMode = 'ADC_CONV_MODE_CONTINUOUS' and (.='ADC_TRIGG_SRC_HW')"
                                                            true="Continuous conversion mode is not available for hardware triggered groups" />
                                                        <a:tst
                                                            expr="as:modconf('Adc')[1]/AdcGeneral/AdcHwTriggerApi = 'false' and (.='ADC_TRIGG_SRC_HW')"
                                                            true="AdcHwTriggerApi in AdcGeneral container is switched off! Cannot configure any groups in HW triggered mode!" />
                                                        <a:tst
                                                            expr="((. = 'ADC_TRIGG_SRC_SW') and (as:modconf('Adc')[1]/AdcGeneral/AdcPriorityImplementation = 'ADC_PRIORITY_HW_SW')) and (not(node:exists(../AdcGroupPriority)))"
                                                            true="Adc Group Priority (AdcGroupPriority) value is not provided when AdcGroupTriggSrc=ADC_TRIGG_SRC_SW and AdcPriorityImplementation=ADC_PRIORITY_HW_SW" />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcGroupRequestSource"
                                                    type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Microcontroller specific request source selection.&lt;br/&gt;
                                                            REQSRC0_SEL - Request source 'AdcRequestSource0Prio'&lt;br/&gt;
                                                            REQSRC1_SEL - Request source 'AdcRequestSource1Prio'&lt;br/&gt;
                                                            REQSRC2_SEL - Request source 'AdcRequestSource2Prio'" />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID" value="897ce8a2-f9ba-463a-9ed5-c04c6570461d" />
                                                    <a:a name="DEFAULT" type="XPath" expr="ecu:list('Adc.ReqSrcClass')[1]" />
                                                    <a:a name="RANGE" type="XPath" expr="ecu:list('Adc.ReqSrcClass')" />
                                                </v:var>
                                                <v:ref name="AdcHwExtTrigSelect" type="REFERENCE">
                                                    <a:a name="DESC"
                                                        value="EN: External request pin/signal selection. Selection should depend on the configured group request source (RS) and ADC Hw Unit.&lt;br/&gt;
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            This parameter is available only when the parameter AdcGroupTriggSrc is set to 'ADC_TRIGG_SRC_HW'" />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="UUID" value="a55732a5-a10f-60c2-6374-1962e5ef42a3" />
                                                    <a:da name="ENABLE" type="XPath" expr="node:fallback(../AdcGroupTriggSrc, 'ADC_TRIGG_SRC_HW') = 'ADC_TRIGG_SRC_HW'" />
                                                    <a:da name="REF"
                                                        value="ASPathDataOfSchema:/THA6_AS440_FuSa/Mcu/GtmConfiguration/GtmToPeripheral/SaradcSent" />
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst expr="node:refvalid(.)"
                                                            false="Invalid or empty reference." />
                                                        <a:tst expr="num:isnumber(text:split(text:split(node:ref(.)/GtmTriggerSelect, 'CH')[1], 'TRI')[1])"
                                                            false="Referenced trigger source is not configured, it can not be 'TRIXCHXX_NO_TRIGGER_SELX_CH00'." />
                                                    </a:da>
                                                </v:ref>
                                                <v:var name="AdcHwTrigSignal" type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Configures on which edge of the hardware trigger signal the driver should react, i.e. start the conversion (only if supported by the ADC hardware).&lt;br/&gt;
                                                            ADC_HW_TRIG_BOTH_EDGES - React on both edges of the hardware trigger signal (only if supported by the ADC hardware).&lt;br/&gt;
                                                            ADC_HW_TRIG_FALLING_EDGE - React on the falling edge of the hardware trigger signal (only if supported by the ADC hardware).&lt;br/&gt;
                                                            ADC_HW_TRIG_RISING_EDGE - React on the rising edge of the hardware trigger signal (only if supported by the ADC hardware).&lt;br/&gt;
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            1. This parameter is available only when the parameter AdcGroupTriggSrc is set to 'ADC_TRIGG_SRC_HW'.&lt;br/&gt;
                                                            2. Default is 'ADC_HW_TRIG_RISING_EDGE' when this parameter is disabled.
                                                            " />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="311bf263-e65b-4144-abf0-4f0c5e9139fd" />
                                                    <a:da name="DEFAULT"
                                                        value="ADC_HW_TRIG_RISING_EDGE" />
                                                    <a:da name="RANGE">
                                                        <a:v>ADC_HW_TRIG_BOTH_EDGES</a:v>
                                                        <a:v>ADC_HW_TRIG_FALLING_EDGE</a:v>
                                                        <a:v>ADC_HW_TRIG_RISING_EDGE</a:v>
                                                    </a:da>
                                                    <a:da name="EDITABLE" type="XPath"
                                                        expr="../AdcGroupTriggSrc = 'ADC_TRIGG_SRC_HW'" />
                                                </v:var>

                                                <v:var name="AdcHwTrigTimer" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: Reload value of the ADC module embedded timer (only if supported by ADC hardware).&lt;br/&gt;
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            This parameter is not used." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="f5cad1a2-44ad-4cec-b861-6ad96cf8ecad" />
                                                    <a:da name="DEFAULT" value="0" />
                                                    <a:da name="EDITABLE" value="false" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=9223372036854775807" />
                                                        <a:tst expr="&gt;=0" />
                                                    </a:da>
                                                </v:var>

                                                <v:var name="AdcNotification" type="FUNCTION-NAME">
                                                    <a:a name="DESC"
                                                        value="EN: Callback function for each group.This function pointer is called everytime when the conversion of this group is completed.&lt;br/&gt;
                                                            &lt;h1&gt;Note&lt;/h1&gt;
                                                            This parameter is available only when the parameter AdcGrpNotifCapability is set to true.&lt;br/&gt;
                                                            Notification function must be no return value(type void) and no formal parameters." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="35aea0a4-4527-4770-bd1c-37d615ff47a6" />
                                                    <a:da name="DEFAULT" value="NULL_PTR" />
                                                    <a:da name="EDITABLE" type="XPath"
                                                        expr="(../../../../../../AdcGeneral/AdcGrpNotifCapability = 'true') and (../../../AdcResultHandlingImplementation != 'POLLING_MODE')" />
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst
                                                            expr="(. = '') and (../../../../../../AdcGeneral/AdcGrpNotifCapability = 'true')"
                                                            true="AdcNotification name is empty" />
                                                        <a:tst
                                                            expr="text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')"
                                                            false="Invalid name of the 'AdcNotification'. Must be valid C function name or NULL_PTR." />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcStreamingBufferMode"
                                                    type="ENUMERATION">
                                                    <a:a name="DESC"
                                                        value="EN: Configure streaming buffer as &quot;linear buffer&quot; (i.e. the ADC Driver stops the conversion as soon as the stream buffer is full) or as &quot;ring buffer&quot; (wraps around if the end of the stream buffer is reached).&lt;br/&gt;
                                                            ADC_STREAM_BUFFER_CIRCULAR - The ADC Driver continues the conversion even if the stream buffer is full (number of samples
                                                                reached) by wrapping around the stream buffer itself.&lt;br/&gt;
                                                            ADC_STREAM_BUFFER_LINEAR - The ADC Driver stops the conversion as soon as the stream buffer is full (number of samples reached)." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="138481f9-4552-4fde-9ee9-0ac613a1a6a8" />
                                                    <a:da name="DEFAULT"
                                                        value="ADC_STREAM_BUFFER_LINEAR" />
                                                    <a:da name="RANGE">
                                                        <a:v>ADC_STREAM_BUFFER_CIRCULAR</a:v>
                                                        <a:v>ADC_STREAM_BUFFER_LINEAR</a:v>
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcStreamingNumSamples" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: Number of ADC values to be acquired per channel in streaming access mode.&lt;br/&gt;
                                                            Note: in single access mode this parameter assumes value 1, since only one sample per channel is processed." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="d35fda8c-254b-452b-bb26-9d94b1dc3290" />
                                                    <a:da name="DEFAULT" value="1" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=255" />
                                                        <a:tst expr="&gt;=1" />
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst
                                                            expr="(../AdcGroupAccessMode = 'ADC_ACCESS_MODE_SINGLE') and (. != '1')"
                                                            true="When 'AdcGroupAccessMode'='ADC_ACCESS_MODE_SINGLE', the 'AdcStreamingNumSamples' must be 1." />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcResultAccumulation" type="INTEGER">
                                                    <a:a name="DESC"
                                                        value="EN: Accumulation of 2~16 conversion results of each channel in this group.&lt;br/&gt;" />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID"
                                                        value="229274c7-2e2a-4f62-83b4-6f50a035c6bc" />
                                                    <a:da name="OPTIONAL" value="true" />
                                                    <a:da name="DEFAULT" value="2" />
                                                    <a:da name="INVALID" type="Range">
                                                        <a:tst expr="&lt;=16" />
                                                        <a:tst expr="&gt;=2" />
                                                    </a:da>
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst
                                                            expr="as:modconf('Adc')[1]/AdcGeneral/AdcResultAlignment = 'ADC_ALIGN_LEFT'"
                                                            true="Conversion result accumulation does not support left alignment(see AdcGeneral/AdcResultAlignment)" />
                                                    </a:da>
                                                </v:var>
                                                <v:var name="AdcResultRegisterManual" type="BOOLEAN">
                                                    <a:a name="DESC"
                                                        value="EN: Enables / Disables manual configuration of result registers(see AdcResultRegisterDefinition).&lt;br/&gt;
                                                            true: AdcResultRegisterDefinition must be configured.&lt;br/&gt;
                                                            false: AdcResultRegisterDefinition need not be configured. The conversion result of each channel is stored in the result register matching its physical channel ID." />
                                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                    </a:a>
                                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                                    <a:a name="SCOPE" value="LOCAL" />
                                                    <a:a name="OPTIONAL" value="true" />
                                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                                    <a:a name="UUID" value="d9706445-a00b-489d-b9b5-8b9692671712" />
                                                    <a:da name="DEFAULT" value="false" />
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst expr="(../../../AdcResultHandlingImplementation != 'DMA_MODE') and (. = 'true')"
                                                               true="Manual configuration of the result register is supported only in DMA result handling mode(see AdcResultHandlingImplementation)." />
                                                        <a:tst expr="node:exists(../../../AdcDmaResultHandlingInterruptEnable) and (../../../AdcDmaResultHandlingInterruptEnable = 'true') and (. = 'true')"
                                                               true="Manual configuration of the result register is not supported for the ADC interrupt in DMA result handling mode(see AdcDmaResultHandlingInterruptEnable)." />
                                                    </a:da>
                                                </v:var>
                                                <v:lst name="AdcGroupDefinition">
                                                    <a:da name="MIN" value="1" />
                                                    <v:ref name="AdcGroupDefinition"
                                                        type="REFERENCE">
                                                        <a:a name="DESC"
                                                            value="EN: Assignment of AdcChannels to a AdcGroups." />
                                                        <a:a name="REQUIRES-INDEX" value="true"/>
                                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                            type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                        </a:a>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                        <a:a name="SCOPE" value="LOCAL" />
                                                        <a:a name="UUID" value="f8b71236-f6af-465a-9477-1c5eeceef804" />
                                                        <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Adc/AdcConfigSet/AdcHwUnit/AdcChannel" />
                                                        <a:da name="INVALID" type="XPath">
                                                            <a:tst expr=".=''"
                                                                true="Select an ADC channel for the configured group." />
                                                            <a:tst expr="node:refvalid(.)"
                                                                false="Invalid or empty reference." />
                                                            <a:tst
                                                                expr="contains(., ../../../../@name)"
                                                                false="The ADC channel must be mapped on the same Hw Unit Group." />
                                                            <a:tst
                                                                expr="count(text:grep(../../../../AdcChannel/*/@name, split(string(.), '/')[last()])) > 0"
                                                                false="The ADC channel must be defined on the Hw Unit Group." />
                                                            <a:tst
                                                                expr="text:uniq(node:fallback(../*,text:split('')),node:fallback(.,text:split('')))"
                                                                false="Duplicate AdcGroupDefinition Channel, the assignment channel must be unique." />
                                                            <a:tst
                                                                expr="(node:exists(node:ref(.)/AdcChannelLimitCheck) = 'true') and (node:value(node:ref(.)/AdcChannelLimitCheck) = 'true') and (count(../*) > num:i(1))"
                                                                true="ADC Channel Limit checking is enabled and the Group has assigned more than one Channel. A group can only assigned one channel with 'AdcChannelLimitCheck' enabled" />
                                                            <a:tst expr="text:uniq(node:fallback(node:refs(../*)/AdcAnChannelNum,text:split('')), node:fallback(node:ref(.)/AdcAnChannelNum,text:split('')))"
                                                                false="Duplicate AdcGroupDefinition physical Channel(AdcChannel/AdcAnChannelNum), the assignment physical channel must be unique." />
                                                        </a:da>
                                                    </v:ref>
                                                </v:lst>
                                                <v:lst name="AdcResultRegisterDefinition">
                                                    <a:da name="MIN" value="0" />
                                                    <a:da name="EDITABLE" type="XPath" expr="node:exists(../AdcResultRegisterManual) and (../AdcResultRegisterManual = 'true')" />
                                                    <a:da name="INVALID" type="XPath">
                                                        <a:tst expr="node:exists(../AdcResultRegisterManual) and (../AdcResultRegisterManual = 'true') and 
                                                                    (num:i(count(../AdcGroupDefinition/*)) != num:i(count(./*)))" 
                                                               true="EN: The Number of result registers configured must be equal to the number of channels present in AdcGroupDefinition."/>
                                                    </a:da>
                                                    <v:var name="AdcResultRegisterDefinition" type="INTEGER">
                                                        <a:a name="DESC"
                                                            value="EN: Assignment of result register to AdcGroupDefinition.&lt;br/&gt;
                                                                   This parameter defines the result register for storing conversion result of each channel in the corresponding AdcGroupDefinition.&lt;br/&gt;
                                                                   The value of this parameter must be configured in descending order to match the node sequence in AdcGroupDefinition." />
                                                        <a:a name="REQUIRES-INDEX" value="true"/>
                                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                            type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                                                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                        </a:a>
                                                        <a:a name="ORIGIN" value="ChipowerTech" />
                                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                                                        <a:a name="SCOPE" value="LOCAL" />
                                                        <a:a name="UUID" value="d92d2962-8dd7-4510-b2a3-8ee3ea349a5c" />
                                                        <a:da name="DEFAULT" type="XPath" expr="num:i(node:fallback(node:current()/@index,'0') + node:fallback(../../AdcResultRegisterDefinition/*[1],'0'))"/>
                                                        <a:da name="INVALID" type="Multi">
                                                            <mt:xpath expr="(num:i(./@index)) >= num:i(count(../../AdcGroupDefinition/*))" true="EN: The number of configured result registers exceeds the number of channels defined in AdcGroupDefinition."/>
                                                            <mt:range>
                                                                <mt:tst expr="&gt;=0"/>
                                                                <mt:tst expr="&lt;=15"/>
                                                            </mt:range>
                                                        </a:da>
                                                    </v:var>
                                                </v:lst>
                                                <v:lst name="AdcGroupEcucPartitionRef">
                                                    <v:ref name="AdcGroupEcucPartitionRef" 
                                                            type="REFERENCE">
                                                        <a:a name="DESC">
                                                        <a:v>EN: Maps an ADC channel group to zero or multiple ECUC partitions to limit the access to this channel group. The ECUC partitions referenced are a subset of the ECUC partitions where the ADC driver is mapped to.</a:v>
                                                        <a:v>EN: Tags: atp.Status=draft</a:v>
                                                        </a:a>
                                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                            type="IMPLEMENTATIONCONFIGCLASS">
                                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                                        </a:a>
                                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" 
                                                            value="true"/>
                                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                                        <a:a name="SCOPE" value="ECU"/>
                                                        <a:a name="UUID" value="8c5a39c1-a928-dc5f-c0dc-e63b8f5ed1b6"/>
                                                        <a:da name="REF" 
                                                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                                    </v:ref>
                                                    <a:da name="EDITABLE" value="false"/>
                                                </v:lst>
                                            </v:ctr>
                                        </v:lst>
                                    </v:ctr>
                                </v:lst>
                            </v:ctr>

                            <v:ctr name="AdcGeneral" type="IDENTIFIABLE">
                                <a:a name="DESC"
                                    value="EN: General configuration (parameters) of the ADC Driver software module.&lt;br/&gt;
                                            true: Adc_DeInit() can be used.&lt;br/&gt; 
                                            false: Adc_DeInit() can not be used." />
                                <a:a name="UUID" value="4a2db2ed-c468-4f1b-8ff2-3e86c8693b0b" />
                                <v:var name="AdcDevErrorDetect" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Switches the Default Error Tracer (Det) detection and notification ON or OFF.&lt;br/&gt;
                                            true: enabled (ON).&lt;br/&gt;
                                            false: disabled (OFF)." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="b7dadf4f-17e5-4694-9cb5-dbc978e24a8f" />
                                    <a:da name="DEFAULT" value="false" />
                                </v:var>
                                <v:var name="AdcSafetyErrorDetect" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Switches the safety error detection ON or OFF." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="0196f056-8421-754d-bac1-8b1a07da257c" />
                                    <a:a name="DEFAULT" value="true" />
                                </v:var>
                                <v:var name="AdcDeInitApi" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Adds / removes the service Adc_DeInit() from the code.&lt;br/&gt;
                                            true: Enabled.&lt;br/&gt;
                                            false: Disabled.&lt;br/&gt;" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="4af38db2-3802-4b94-a7ad-6dace67a9e2f" />
                                    <a:da name="DEFAULT" value="true" />
                                </v:var>
                                <v:var name="AdcEnableLimitCheck" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Enables or disables limit checking feature in the ADC driver.&lt;br/&gt;
                                            true: Enabled.&lt;br/&gt;
                                            false: Disabled.&lt;br/&gt;" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="4f73123e-6d6b-42fe-aa15-92cdbf136535" />
                                    <a:da name="DEFAULT" value="false" />
                                </v:var>
                                <v:var name="AdcEnableQueuing" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Determines, if the queuing mechanism is active in case of priority mechanism disabled.&lt;br/&gt;
                                            true: Enabled.&lt;br/&gt;
                                            false: Disabled.&lt;br/&gt;
                                            &lt;h1&gt;Note&lt;/h1&gt;
                                            1. If priority mechanism is enabled, queuing mechanism is always active and the parameter ADC_ENABLE_QUEUING is not evaluated.&lt;br/&gt;
                                            2. This parameter is available only when the parameter AdcPriorityImplementation is set to 'ADC_PRIORITY_NONE'.&lt;br/&gt; 
                                            3. This parameter can not be set to true when the parameter AdcEnableStartStopGroupApi is set to false. " />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="29a339fd-5113-4f30-a9a6-e730749b84a6" />
                                    <a:da name="DEFAULT" value="false" />
                                    <a:da name="EDITABLE" type="XPath"
                                        expr="../AdcPriorityImplementation = 'ADC_PRIORITY_NONE'" />
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst
                                            expr="../AdcEnableStartStopGroupApi = 'false' and .= 'true'"
                                            true="This parameter can not be set to true when 'AdcEnableStartStopGroupApi' is false" />
                                    </a:da>
                                </v:var>
                                <v:var name="AdcEnableStartStopGroupApi" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Adds / removes the services Adc_StartGroupConversion() and Adc_StopGroupConversion() from the code.&lt;br/&gt;
                                            true: Adc_StartGroupConversion() and Adc_StopGroupConversion() can be used&lt;br/&gt;
                                            false: Adc_StartGroupConversion() and Adc_StopGroupConversion() can not be used&lt;br/&gt;" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="7c474a89-9c4e-40bc-89b1-088e1220c5a9" />
                                    <a:da name="DEFAULT" value="true" />
                                </v:var>
                                <v:var name="AdcGrpNotifCapability" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Determines, if the group notification mechanism (the functions to enable and disable the notifications) is available at runtime.&lt;br/&gt;
                                            true: Enabled.&lt;br/&gt;
                                            false: Disabled." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="8ccea893-b4b7-4223-bf08-f9091468f0d8" />
                                    <a:da name="DEFAULT" value="false" />
                                </v:var>
                                <v:var name="AdcHwTriggerApi" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Adds / removes the services Adc_EnableHardwareTrigger() and Adc_DisableHardwareTrigger() from the code.&lt;br/&gt;
                                            true: Adc_EnableHardwareTrigger() and Adc_DisableHardwareTrigger() can be used.&lt;br/&gt;
                                            false: Adc_EnableHardwareTrigger() and Adc_DisableHardwareTrigger() can not be used." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="c2cfd865-9ab4-46f5-ad6b-9e15b3d5ec9f" />
                                    <a:da name="DEFAULT" value="false" />
                                </v:var>
                                <v:var name="AdcLowPowerStatesSupport" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Adds / removes all power state management related APIs (ADC_SetPowerState, ADC_GetCurrentPowerState, ADC_GetTargetPowerState, ADC_PreparePowerState, ADC_Main_PowerTransitionManager), indicating if the HW offers low power state management.&lt;br/&gt;
                                            &lt;h1&gt;Note&lt;/h1&gt;
                                            Not supported on hardware." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="OPTIONAL" value="true" />
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="f9594f5b-406a-4cd7-ac77-470b3cabf0aa" />
                                    <a:da name="DEFAULT" value="false" />
                                    <a:da name="EDITABLE" value="false" />
                                </v:var>
                                <v:var name="AdcPowerStateAsynchTransitionMode" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Enables / disables support of the ADCDriver to the asynchronous power state transition.&lt;br/&gt;
                                            &lt;h1&gt;Note&lt;/h1&gt;
                                            Not supported on hardware." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="OPTIONAL" value="true" />
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="875017e7-c518-4a9c-ae2e-4c6fc604a0e8" />
                                    <a:da name="DEFAULT" value="false" />
                                    <a:da name="EDITABLE" value="false" />
                                </v:var>
                                <v:var name="AdcStartupCalibration" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Enables / disables Adc Startup Calibration feature when call API Adc_Init()." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="ccc599f9-0309-4cb0-b627-61efe5244c20" />
                                    <a:da name="DEFAULT" value="false" />
                                    <a:da name="VISIBLE" type="XPath"
                                        expr="ecu:get('Adc.StartUpCalEn') = 'true'" />
                                </v:var>
                                <v:var name="AdcReadGroupApi" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Adds / removes the service Adc_ReadGroup() and from the code.&lt;br/&gt;
                                            true: Adc_ReadGroup() can be used.&lt;br/&gt;
                                            false: Adc_ReadGroup() can not be used." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="ea48dfc7-7aaa-4899-b5ee-0a6d974f4360" />
                                    <a:da name="DEFAULT" value="true" />
                                </v:var>
                                <v:var name="AdcSyncConvEnable" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Enables / disables hardware synchronous conversion feature.&lt;br/&gt;
                                            true: Enable the synchronous conversion.&lt;br/&gt;
                                            false: Disable the synchronous conversion." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="8843ecbc-ad9d-b0c4-abd4-f344305fe3c3" />
                                    <a:da name="DEFAULT" value="false" />
                                </v:var>
                                <v:var name="AdcPriorityImplementation" type="ENUMERATION">
                                    <a:a name="DESC"
                                        value="EN: Determines whether a priority mechanism is available for prioritization of the conversion requests and if available, the type of prioritization mechanism. 
                                            The selection applies for groups with trigger source software and trigger source hardware. 
                                            Two types of prioritization mechanism can be selected. The hardware prioritization mechanism (AdcPriorityHw) uses the ADC hardware features for prioritization of the
                                            software conversion requests and hardware trigger signals for groups with trigger source hardware. The mixed hardware and software prioritization mechanism
                                            (AdcPriorityHwSw) uses the ADC hardware features for prioritization of ADC hardware trigger for groups with trigger source hardware and a software
                                            implemented prioritization mechanism for groups with trigger source software. The group priorities for software triggered groups are typically configured with lower
                                            priority levels than the group priorities for hardware triggered groups.&lt;br/&gt;
                                            ADC_PRIORITY_HW - Hardware priority mechanism is available only&lt;br/&gt;
                                            ADC_PRIORITY_HW_SW - Both hardware and software priority mechanisms are available&lt;br/&gt;
                                            ADC_PRIORITY_NONE - priority mechanism is not available&lt;br/&gt;
                                            &lt;h1&gt;Note&lt;/h1&gt;
                                            The priority can not be 'ADC_PRIORITY_HW_SW' when 'AdcEnableStartStopGroupApi' is false" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="2be09edc-2c26-4f56-b9e0-0f82f594f3b6" />
                                    <a:da name="DEFAULT" value="ADC_PRIORITY_NONE" />
                                    <a:da name="RANGE">
                                        <a:v>ADC_PRIORITY_HW</a:v>
                                        <a:v>ADC_PRIORITY_HW_SW</a:v>
                                        <a:v>ADC_PRIORITY_NONE</a:v>
                                    </a:da>
                                    <a:da name="INVALID" type="XPath">
                                        <a:tst
                                            expr="../AdcEnableStartStopGroupApi = 'false' and .= 'ADC_PRIORITY_HW_SW'"
                                            true="The priority can not be 'ADC_PRIORITY_HW_SW' when 'AdcEnableStartStopGroupApi' is false" />
                                    </a:da>
                                </v:var>
                                <v:var name="AdcResultAlignment" type="ENUMERATION">
                                    <a:a name="DESC"
                                        value="EN: Alignment of ADC raw results in ADC result buffer.&lt;br/&gt;
                                            ADC_ALIGN_LEFT - left alignment&lt;br/&gt;
                                            ADC_ALIGN_RIGHT - right alignment" />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="a479ac0c-baaa-450b-b8af-fb9fa685ddd9" />
                                    <a:da name="DEFAULT" value="ADC_ALIGN_RIGHT" />
                                    <a:da name="RANGE">
                                        <a:v>ADC_ALIGN_LEFT</a:v>
                                        <a:v>ADC_ALIGN_RIGHT</a:v>
                                    </a:da>
                                </v:var>
                                <v:var name="AdcVersionInfoApi" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Adds / removes the service Adc_GetVersionInfo() from the code.&lt;br/&gt;
                                            true: Adc_GetVersionInfo() can be used.&lt;br/&gt;
                                            false: Adc_GetVersionInfor() can not be used." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="68bc85e0-a389-4be7-ab53-8a522ce3ebe6" />
                                    <a:da name="DEFAULT" value="false" />
                                </v:var>

                                <v:lst name="AdcEcucPartitionRef">
                                    <v:ref name="AdcEcucPartitionRef" type="REFERENCE">
                                        <a:a name="DESC">
                                            <a:v>EN: Maps the ADC driver to zero or multiple ECUC partitions to make the driver API available in the according partition.</a:v>
                                            <a:v>EN: Tags: atp.Status=draft</a:v>
                                        </a:a>
                                        <a:a name="REQUIRES-INDEX" value="true"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                            type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="UUID" value="02d3f26e-eb58-12e4-ad77-6df619533bc6"/>
                                        <a:da name="REF" 
                                                value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                    </v:ref>
                                    <a:da name="EDITABLE" value="false"/>
                                </v:lst>
                                <v:lst name="AdcKernelEcucPartitionRef">
                                    <a:da name="MAX" value="1"/>
                                    <v:ref name="AdcKernelEcucPartitionRef" type="REFERENCE">
                                        <a:a name="DESC">
                                            <a:v>EN: Maps the ADC kernel to zero or one ECUC partitions to assign the driver kernel to a certain core. The ECUC partition referenced is a subset of the ECUC partitions where the ADC driver is mapped to.</a:v>
                                            <a:v>EN: Tags: atp.Status=draft</a:v>
                                        </a:a>
                                        <a:a name="REQUIRES-INDEX" value="true"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                            type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="UUID" value="4bdd465e-780d-7ae4-7df8-bbd7ac985f32"/>
                                        <a:da name="REF" 
                                                value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                                    </v:ref>
                                    <a:da name="EDITABLE" value="false"/>
                                </v:lst>

                                <v:lst name="AdcPowerStateConfig" type="MAP">
                                    <a:da name="EDITABLE" type="XPath"
                                        expr="(../AdcPowerStateAsynchTransitionMode = 'true' )" />
                                    <v:ctr name="AdcPowerStateConfig" type="IDENTIFIABLE">
                                        <a:a name="DESC">
                                            <a:v><![CDATA[EN:<html><p>Each instance of this parameter defines a power state and the callback to be called when this power state is reached.</p></html>]]></a:v>
                                        </a:a>
                                        <a:a name="REQUIRES-INDEX" value="true"/>
                                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false" />
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                            type="IMPLEMENTATIONCONFIGCLASS">
                                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                                        </a:a>
                                        <a:a name="UUID"
                                            value="ae5b1fcc-7db0-a5c4-3724-95a75257fead" />

                                        <v:var name="AdcPowerState" type="INTEGER">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html><p>Each instance of this parameter describes a different power state 
                                               supported by the ADC HW. It should be defined by the HW supplier and 
                                               used by the ADCDriver to reference specific HW configurations which set 
                                               the ADC HW module in the referenced power state. At least the power mode
                                               corresponding to full power state shall be always configured.
                                               This parameter shall only be configured if the parameter AdcLowPowerStatesSupport is set to true.</p></html>]]>
                                          </a:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="true" />
                                            <a:a name="UUID"
                                                value="40bde7de-1dfc-f184-11ec-96e01bb9d91c" />
                                            <a:da name="DEFAULT" value="0" />
                                            <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;=18446744073709551615" />
                                                <a:tst expr="&gt;=0" />
                                            </a:da>
                                        </v:var>

                                        <v:var name="AdcPowerStateReadyCbkRef" type="FUNCTION-NAME">
                                            <a:a name="DESC">
                                                <a:v><![CDATA[EN:<html><p>Each instance of this parameter contains a reference to a power mode callback defined in a CDD or IoHwAbs component.
                                               This parameter shall only be configured if the parameter AdcLowPowerStatesSupport is set to true</p></html>]]>
                                          </a:v>
                                            </a:a>
                                            <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                                            <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                                            </a:a>
                                            <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                            <a:a name="SCOPE" value="LOCAL" />
                                            <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                            <a:a name="UUID"
                                                value="f7d3a3c6-9d9f-3091-159e-d3019bcfeb0f" />
                                            <a:da name="DEFAULT" value="NULL_PTR" />
                                        </v:var>
                                    </v:ctr>
                                </v:lst>

                            </v:ctr>
                            <v:ctr name="AdcPublishedInformation" type="IDENTIFIABLE">
                                <a:a name="DESC"
                                    value="EN: Additional published parameters not covered by &quot;Common&quot; Published Information. Note that these parameters have &quot;PUBLISHED-INFORMATION&quot; configuration class setting, since they are published information." />
                                <a:a name="UUID" value="14a10069-8a57-4676-8fdc-89cb0533005c" />
                                <v:var name="AdcChannelValueSigned" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Information whether the result value of the ADC driver has sign information (true) or not (false). If the result shall be interpreted as signed value it shall apply to C-language rules." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="8fc80f23-9ecf-44fb-88f8-a4e6a73f935c" />
                                    <a:a name="READONLY" value="true" />
                                    <a:da name="DEFAULT" value="false" />
                                </v:var>
                                <v:var name="AdcGroupFirstChannelFixed" type="BOOLEAN">
                                    <a:a name="DESC"
                                        value="EN: Information whether the first channel of an ADC Channel group can be configured (false) or is fixed (true) to a value determined by the ADC HW Unit." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="29b021fe-154c-4067-a9d7-0aa2642cb3f7" />
                                    <a:a name="READONLY" value="true" />
                                    <a:da name="DEFAULT" value="false" />
                                </v:var>
                                <v:var name="AdcMaxChannelResolution" type="INTEGER">
                                    <a:a name="DESC"
                                        value="EN: Maximum Channel resolution in bits (does not specify accuracy)." />
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="f2f88ec0-14f7-48a2-9f37-b9707e2448af" />
                                    <a:a name="READONLY" value="true" />
                                    <a:da name="DEFAULT" value="12" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=63" />
                                        <a:tst expr="&gt;=1" />
                                    </a:da>
                                </v:var>
                            </v:ctr>
                            <!-- /** @implements CommonPublishedInformation_Object */ -->
                            <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                                <a:a name="DESC">
                                    <a:v>
                                        <![CDATA[EN:<html> Common container, aggregated by all modules. It contains published information about vendor and versions.</html>]]>
                                    </a:v>
                                </a:a>
                                <a:a name="UUID" value="95914226-9b6a-11ec-a5f3-f889d2d2ec8e" />

                                <v:var name="ArReleaseMajorVersion" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Major version number of AUTOSAR specification on which the appropriate implementation is based on.</html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="91449934-9b6a-11ec-b4e6-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" value="4" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255" />
                                        <a:tst expr="&gt;=0" />
                                    </a:da>
                                </v:var>

                                <v:var name="ArReleaseMinorVersion" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Minor version number of AUTOSAR specification on which the appropriate implementation is based on.</html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="8bc83c24-9b6a-11ec-9d95-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" value="4" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255" />
                                        <a:tst expr="&gt;=0" />
                                    </a:da>
                                </v:var>

                                <v:var name="ArReleaseRevisionVersion" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Revision version number of AUTOSAR specification on which the appropriate implementation is based on.</html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="863ef02e-9b6a-11ec-8aad-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" value="0" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255" />
                                        <a:tst expr="&gt;=0" />
                                    </a:da>
                                </v:var>

                                <v:var name="ModuleId" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Module ID of this module from Module List.</html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="829b03dc-9b6a-11ec-a05c-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" value="123" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255" />
                                        <a:tst expr="&gt;=0" />
                                    </a:da>
                                </v:var>

                                <v:var name="SwMajorVersion" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Major version number of the vendor specific implementation of the module. The numbering is vendor specific.</html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="7ed85cb0-9b6a-11ec-9559-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" value="1" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255" />
                                        <a:tst expr="&gt;=0" />
                                    </a:da>
                                </v:var>

                                <v:var name="SwMinorVersion" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Minor version number of the vendor specific implementation of the module. The numbering is vendor specific.</html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="7c1809c2-9b6a-11ec-9c2f-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" value="2" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255" />
                                        <a:tst expr="&gt;=0" />
                                    </a:da>
                                </v:var>

                                <v:var name="SwPatchVersion" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Patch level version number of the vendor specific implementation of the module. The numbering is vendor specific.</html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="781c8e5e-9b6a-11ec-a1c8-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" value="0" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=255" />
                                        <a:tst expr="&gt;=0" />
                                    </a:da>
                                </v:var>
                                <v:var name="VendorId" type="INTEGER">
                                    <a:a name="DESC">
                                        <a:v>
                                            <![CDATA[EN:<html> Vendor ID of the dedicated implementation of this module according to the AUTOSAR vendor list.</html>]]>
                                        </a:v>
                                    </a:a>
                                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                        type="IMPLEMENTATIONCONFIGCLASS">
                                        <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                                    </a:a>
                                    <a:a name="ORIGIN" value="ChipowerTech" />
                                    <a:a name="SCOPE" value="LOCAL" />
                                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                    <a:a name="UUID" value="6f65e85e-9b6a-11ec-959e-f889d2d2ec8e" />
                                    <a:da name="DEFAULT" value="175" />
                                    <a:da name="INVALID" type="Range">
                                        <a:tst expr="&lt;=175" />
                                        <a:tst expr="&gt;=175" />
                                    </a:da>
                                </v:var>
                            </v:ctr>

                            <d:ref type="REFINED_MODULE_DEF" value="ASPath:/AUTOSAR/EcucDefs/Adc" />
                        </v:ctr>
                    </d:chc>
                    <d:chc name="Adc_EcuParameterDefinition" type="AR-ELEMENT"
                        value="ECU_PARAMETER_DEFINITION">
                        <d:ctr type="AR-ELEMENT">
                            <a:a name="DEF"
                                value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION" />
                            <a:a name="UUID" value="c1d07f2d-f086-4dc1-bd64-e607b8c705c8" />
                            <d:lst name="MODULE_REF">
                                <d:ref type="MODULE_REF" value="ASPath:/THA6_AS440_FuSa/Adc" />
                            </d:lst>
                        </d:ctr>
                    </d:chc>
                </d:lst>
            </d:ctr>
        </d:lst>
    </d:ctr>
</datamodel>