                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/THA6_AS440_FuSa/Mcu/GtmConfiguration/GtmToPeripheral/SaradcSent</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                        <ECUC-REFERENCE-DEF UUID="f8b71236-f6af-465a-9477-1c5eeceef804">
                          <SHORT-NAME>AdcGroupDefinition</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Assignment of AdcChannels to a AdcGroups.</L-2>
                          </DESC>
