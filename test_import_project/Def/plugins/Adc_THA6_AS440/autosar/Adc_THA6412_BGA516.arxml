                        </ECUC-REFERENCE-DEF>
                        <ECUC-REFERENCE-DEF UUID="8c5a39c1-a928-dc5f-c0dc-e63b8f5ed1b6">
                          <SHORT-NAME>AdcGroupEcucPartitionRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Maps an ADC channel group to zero or multiple ECUC partitions to limit the access to this channel group. The ECUC partitions referenced are a subset of the ECUC partitions where the ADC driver is mapped to.</L-2>
                            <L-2 L="EN">Tags: atp.Status=draft</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
