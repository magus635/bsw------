          <CONTAINERS>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="acb6432e-8312-a4b2-63a1-5b211bc7832a">
              <SHORT-NAME>IomGeneralConfiguration</SHORT-NAME>
              <DESC>
                <L-2 L="EN">This container contains configuration switches for PPU register.</L-2>
