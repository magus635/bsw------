<?xml version='1.0'?>
<datamodel version="7.0"
  xmlns="http://www.tresos.de/_projects/DataModel2/12/root.xsd" 
  xmlns:a="http://www.tresos.de/_projects/DataModel2/12/attribute.xsd" 
  xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
  xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
  <d:ctr type="AUTOSAR" factory="autosar"  
    xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
    xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
    xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
    xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
    xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="THA6_AS440_FuSa" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:AUTOSAR"/>
        <d:lst type="ELEMENTS">
          <d:chc name="Iom" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC" 
                   value="EN: Configuration of the Iom ."/>
              <a:a name="LOWER-MULTIPLICITY" value="0"/>
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
              <a:a name="RELEASE" value="asc:4.4.0"/>
              <a:a name="UPPER-MULTIPLICITY" value="*"/>
              <a:a name="UUID" value="a06bdb1c-090f-4de8-b2c8-f254772cdecf"/>
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                     type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="LABEL" value="Config Variant"/>
                <a:a name="UUID" value="2d149fdc-8507-40b6-a0ae-7db4a6a0019b"/>
                <a:da name="DEFAULT" value="VariantPostBuild"/>
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                </a:da>
              </v:var>
              <v:ctr name="IomGeneralConfiguration" type="IDENTIFIABLE">
              <a:a name="DESC" value="EN: This container contains configuration switches for PPU register."/>
              <a:a name="UUID" value="acb6432e-8312-a4b2-63a1-5b211bc7832a"/>
                <v:var name="IomVersionInfoApi" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Pre-processor switch to enable / disable the API to read out the modules version information."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS" >
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ac32b12e-ac12-a461-b561-54231bc31aca"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="IomPpuPrecalerApi" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Switches the Ppu prescaler Api(Iom_SetPpuPrecalerThreshold, Iom_GetPpuPrecalerThreshold) ON or OFF."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS" >
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="01935190-6671-746b-a437-a96dfa530999"/>
                  <!-- <a:da name="DEFAULT" value="false"/> -->
                  <a:da name="DEFAULT" type="XPath">
                        <a:tst expr="ecu:list('Iom.PPUmode') = 'RISINGEDGE_PRESCALER' or ecu:list('Iom.PPUmode') = 'FALLINGEDGE_PRESCALER'"/>
                  </a:da>
                  <a:da name="EDITABLE" type="XPath">
                      <a:tst expr="ecu:list('Iom.PPUmode') = 'RISINGEDGE_PRESCALER' or ecu:list('Iom.PPUmode') = 'FALLINGEDGE_PRESCALER'"/>
                  </a:da>
                </v:var>
                <v:var name="IomPpuFilterApi" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Switches the Ppu filter Api(Iom_SetPpuFilterTimeThreshold, Iom_GetPpuFilterTimeThreshold) ON or OFF."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="01935280-e2b0-70d8-8ecb-8858048637ed" />
                  <a:da name="DEFAULT" value="true" />
                </v:var>
                <v:var name="IomGetPpuGlitchApi" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Switches the Iom_GetPpuGlitch Api ON or OFF."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="acb6432e-8312-a4b2-63a1-5b211bc77512" />
                  <a:da name="DEFAULT" value="true" />
                </v:var>
                <v:var name="IomDevErrorDetect" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Switches the Default Error Tracer (Det) detection and notification ON or OFF."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="01965625-a705-74e8-a8bf-ffa6abadf182" />
                  <a:da name="DEFAULT" value="true" />
                </v:var>
                <v:var name="IomSafetyErrorDetect" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Switches the Safety Error detection ON or OFF." />
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="a4e70d5a-ab21-4d58-8197-04d1d2ae0990" />
                  <a:da name="DEFAULT" value="true" />
                </v:var>
                <v:var name="IomGtmExor" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Switches the GTM input Exor ON or OFF."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ac32b12e-ac12-a461-b561-54231bc32323"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:da name="INVALID" type="XPath" >
                          <a:tst expr="(node:value(.) = 'false') or (node:value(.) = 'true' and   
                                          ecu:get('Iom.GTMExorFunctionSupport') = 'true')" false="The version does not support the GTM exor function" />
                  </a:da>
                </v:var>
                <!-- <v:var name="IomSafetyEnable" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Switches the Safety Enable and notification ON or OFF."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="01965711-a3c5-7535-af9c-fdc13d6c52c7" />
                  <a:da name="DEFAULT" value="true" />
                </v:var> -->
              </v:ctr>
              <v:ctr name="IomModuleConfiguration" type="IDENTIFIABLE">
                <a:a name="DESC" value="EN: This container contains the configuration (parameters) of the IOM driver" />
                <a:a name="UUID" value="aca83c2e-4431-a323-b128-5b21134bc64a"/>
                <v:lst name="IomPPUConfiguration" type="MAP">
                  <a:da name="MAX" value="16"/>
                  <a:da name="MIN" value="1"/>
                    <v:ctr name="IomPPUConfiguration" type="IDENTIFIABLE">
                      <a:a name="DESC" value="EN: This container contains the configuration for the Filter and Prescaler Channels." />
                      <a:a name="UUID" value="a31a3c1e-4ab3-a124-512a-53121321cbca" />
                      <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="REQUIRES-INDEX" value="true"/>
                      <v:var name="IomPPUUnitNo" type="INTEGER">
                        <a:a name="DESC" value="EN: PPU register unit or PPU number" />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS" >
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech" />
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="true" />
                        <a:a name="UUID" value="12a23b1e-4a31-abc4-521b-5ab5132c91c1" />
                        <a:da name="DEFAULT" type="XPath" >
                          <a:tst expr="node:fallback(node:current()/../@index,'0')"/>
                        </a:da>
                        <a:da name="INVALID" type="Multi" >
                          <mt:xpath expr="(text:uniq(../../*/IomPPUUnitNo,.)) and 
                                          (. &lt; 16)" false="PPU Number should be unique and between 0 to 15."/>
                          <mt:range>
                            <mt:tst expr="&gt;=0"/>
                            <mt:tst expr="&lt;=15"/>
                          </mt:range>
                        </a:da>
                      </v:var>
                      <v:var name="IomPPUFilterTime" type="INTEGER">
                        <a:a name="DESC" value="EN: Filter time threshold." />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS" >
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech" />
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID" value="ab5132ac-4b53-4624-782a-5ac21b2b6bc2" />
                        <a:da name="DEFAULT" value="0" />
                        <a:da name="INVALID" type="Multi">
                          <mt:xpath expr="(../IomPPUFilterMode != 'RISINGEDGE_PRESCALER') and
                                          (../IomPPUFilterMode != 'FALLINGEDGE_PRESCALER') and
                                          (../IomPPUFilterMode != 'NO_FILTER') and
                                          (node:value(.) = '0')" true=" If the filter mode is selected, the filter time cannot be 0" />
                          <mt:range>
                            <mt:tst expr="&gt;=0" />
                            <mt:tst expr="&lt;=65535" />
                          </mt:range>
                        </a:da>
                        <a:da name="EDITABLE" type="XPath">
                            <a:tst expr="(../IomPPUFilterMode != 'RISINGEDGE_PRESCALER') and
                                         (../IomPPUFilterMode != 'FALLINGEDGE_PRESCALER') and
                                         (../IomPPUFilterMode != 'NO_FILTER')" />
                        </a:da>
                      </v:var>
                      <v:var name="IomPPUPrescalerCompareVal" type="INTEGER">
                        <a:a name="DESC" value="EN: 16 bit prescaler compare value used to compare with 16 bit timer value" />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS" >
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech" />
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID" value="ab5132ac-4b53-4624-782a-5ac21b2b6bc3" />
                        <a:da name="DEFAULT" value="0" />
                        <a:da name="INVALID" type="Range" >
                            <a:tst expr="&lt;=65535"/>
                            <a:tst expr="&gt;=0"/>
                        </a:da>
                        <a:da name="EDITABLE" type="XPath">
                            <a:tst expr="(../IomPPUFilterMode = 'RISINGEDGE_PRESCALER') or
                                         (../IomPPUFilterMode = 'FALLINGEDGE_PRESCALER')"/>
                        </a:da>
                      </v:var>
                <v:var name="IomPPUFilterMode" type="ENUMERATION">
                        <a:a name="LABEL" value="IomPPUMode"/>
                        <a:a name="DESC" value="EN: Determines operation mode selection for PPU &lt;br/&gt;
                                              Note: DD means Delay Debounce&lt;br/&gt;
                                              ID means Immediated Debounce"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS" >
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID" value="cf8fb070-6d62-4707-a73f-a16af3461234" />
                        <a:da name="DEFAULT" type="XPath" >
                          <a:tst expr="ecu:list('Iom.PPUmode')[1]" />
                        </a:da>
                        <a:da name="RANGE" type="XPath">
                            <a:tst expr="ecu:list('Iom.PPUmode')" />
                        </a:da>
                      </v:var>
                <!-- <v:var name="IomPPUFilterResetTimer" type="BOOLEAN">
                      <a:a name="DESC" value="EN: Determines whether enable timer reset function or not" />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="EF26BB62-8E22-EC21-BD9B-BF8FB4C484C8" />
                      <a:da name="DEFAULT" value="false" />
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr=". = 'false' or (. = 'true' and 
                        ((../IomPPUFilterMode = 'BOTHEDGES_DD') or (../IomPPUFilterMode = 'RISING_DD_FALLING_ID') or (../IomPPUFilterMode = 'RISING_ID_FALLING_DD')))" 
                        false="This feature is only supported by the delayed debounce filter mode" />
                      </a:da>
                    </v:var> -->
                      <v:var name="IomPPUMonInputSel" type="ENUMERATION">
                        <a:a name="DESC" value="EN: To select monitor input signal for PPU channel. " />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS" >
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="ChipowerTech" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID" value="acb6712e-4ac1-a213-ab68-5b214246232b" />
                        <a:da name="DEFAULT" type="XPath" >
                          <a:tst expr="ecu:list(concat('Iom.Mon',node:fallback(../IomPPUUnitNo, 'x')))[1]" />
                        </a:da>
                        <a:da name="RANGE" type="XPath">
                          <a:tst expr="ecu:list(concat('Iom.Mon',node:fallback(../IomPPUUnitNo, 'x')))" />
                        </a:da>
                      </v:var>
                      <v:var name="IomPPUReferInputSel" type="ENUMERATION">
                        <a:a name="DESC" value="EN: To select reference input signal "/>                                             
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>                    
                        <a:a name="ORIGIN" value="ChipowerTech"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="DCE:6621b8c0-a041-4855-8ff4-d32a34342514"/>
                        <a:da name="DEFAULT" type="XPath" >
                          <a:tst expr="ecu:list(concat('Iom.Ref',node:fallback(../IomPPUUnitNo, 'x')))[1]" />
                        </a:da>
                        <a:da name="RANGE" type="XPath">
                          <a:tst expr="ecu:list(concat('Iom.Ref',node:fallback(../IomPPUUnitNo, 'x')))" />
                        </a:da>       
                      </v:var>
                    </v:ctr>
                </v:lst>
                <v:lst name="IomLPUConfiguration" type="MAP">
                  <a:da name="MAX" value="16" />
                  <a:da name="MIN" value="1" />
                  <v:ctr name="IomLPUConfiguration" type="IDENTIFIABLE">
                    <a:a name="DESC" value="EN: This container contains configuration for LPU register." />
                    <a:a name="UUID" value="a32e341a-6a11-48c7-54b9-31acfc6c4481" />
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS" >
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="REQUIRES-INDEX" value="true"/>
                    <v:var name="IomLPUUnitNo" type="INTEGER">
                      <a:a name="DESC" value="EN: LPU register unit or LPU number" />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="true" />
                      <a:a name="UUID" value="a41e121a-6ab1-48a7-54b9-3177fc6caa81" />
                      <a:da name="DEFAULT" type="XPath" >
                        <a:tst expr="node:fallback(node:current()/../@index,'0')" />
                      </a:da>
                      <a:da name="INVALID" type="Multi" >
                        <mt:xpath expr="(text:uniq(../../*/IomLPUUnitNo,.)) and
                                        (. &lt; 16)" false="LPU Number should be unique and between 0 to 15."/>
                        <mt:range>
                          <mt:tst expr="&gt;=0"/>
                          <mt:tst expr="&lt;=15"/>
                        </mt:range>
                      </a:da>
                    </v:var>
                    <v:var name="IomLPUEventWinTime" type="INTEGER">
                      <a:a name="DESC" value="EN: The duration of the event window."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="aa4e782a-6bc1-4ac7-5789-3178fcab4421" />
                      <a:da name="DEFAULT" value="0" />
                      <a:da name="INVALID" type="Range" >
                        <a:tst expr="&lt;=16777215"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>
                    <v:var name="IomLPUInvReferSignal" type="BOOLEAN">
                      <a:a name="DESC" value="EN: Determines whether reference signal from PPU channel is inverted or not" />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="21ab64d2-5a6b-41ca-af7d-cbd6821144dd" />
                      <a:da name="DEFAULT" value="false" />
                    </v:var>
                    <v:var name="IomLPUInvMonSignal" type="BOOLEAN">
                      <a:a name="DESC" value="EN: Determines whether monitor signal from PPU channel is inverted or not" />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="a4ae3218-54c7-48b7-9a12-35129e8c321b" />
                      <a:da name="DEFAULT" value="false" />
                    </v:var>
                    <v:var name="IomLPUInvEventWin" type="BOOLEAN">
                      <a:a name="DESC" value="EN: Determines whether event window polarity is inverted or not" />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL" />
