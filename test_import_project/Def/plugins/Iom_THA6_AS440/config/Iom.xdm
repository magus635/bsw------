                        <a:v>CH13</a:v>
                        <a:v>CH14</a:v>
                        <a:v>CH15</a:v> -->
                      </a:da>
                    </v:var>
          <v:var name="IomLPUchannelInputEMUSel" type="ENUMERATION">
                      <a:a name="DESC" value="EN: Select which EMU counter is enabled for events output from the LPU." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="d4a31298-5ca7-44b7-9210-36ae93c5123c" />
                      <a:da name="DEFAULT" value="IOM_EVENTCOUNTERCHANNEL_NOCOUNTER" />
                      <a:da name="RANGE" >
                        <a:v>IOM_EVENTCOUNTERCHANNEL_0</a:v>
                        <a:v>IOM_EVENTCOUNTERCHANNEL_1</a:v>
                        <a:v>IOM_EVENTCOUNTERCHANNEL_2</a:v>
                        <a:v>IOM_EVENTCOUNTERCHANNEL_3</a:v>
                        <a:v>IOM_EVENTCOUNTERCHANNEL_NOCOUNTER</a:v>
                    </a:da>
                      <a:da name="INVALID" type="XPath" >
                          <a:tst expr="(text:uniq(../../*/IomLPUchannelInputEMUSel,.)) or  
                                          (. = 'IOM_EVENTCOUNTERCHANNEL_NOCOUNTER')" false="EMU counter should be unique or 0." />
                        </a:da>
                    </v:var>
                  </v:ctr>
                </v:lst> 
                <v:ctr name="IomGtmConfiguration" type="IDENTIFIABLE">
                  <a:a name="DESC" value="EN: This container contains configuration for GTM input reference signal.
                                          IOM_GTM_0-IOM_GTM_7 corresponds to GTM_TOUT22-GTM_TOUT29" />
