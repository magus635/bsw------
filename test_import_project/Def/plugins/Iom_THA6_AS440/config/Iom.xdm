                      <a:da name="RANGE" type="XPath">
                        <a:tst expr="text:split(ecu:get('Iom.LPUChannelID'))" />
                        <!-- <a:v>CH0</a:v>
                        <a:v>CH1</a:v>
                        <a:v>CH2</a:v>
                        <a:v>CH3</a:v>
                        <a:v>CH4</a:v>
