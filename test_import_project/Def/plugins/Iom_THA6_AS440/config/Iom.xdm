                <v:ctr name="IomEMUConfiguration" type="IDENTIFIABLE">
                  <a:a name="DESC" value="EN: This container contains configuration for Event Combiner Module configuration " />
                  <a:a name="UUID" value="baa327ee-aac0-418d-9637-1d4452112bcf" />
                  <v:ctr name="IomEventCombModCount" type="IDENTIFIABLE">
                    <a:a name="DESC" value="EN: Contains Event Combiner Modules count " />
                    <a:a name="UUID" value="babc27ee-aac2-431d-9237-1abcc6813df1" />
                    <v:var name="IomEMUThreshold0" type="ENUMERATION">
                      <a:a name="DESC" value="EN: Indicates threshold count value for the counter 0 of the EMU module.Upon counter meeting this value,
                                              the counter event output becomes high for one clock cycle. If select IOM_EMU_C0_COUNTER_OFF counter is disabled  "/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="d6e32dd1-2c6e-4d2b-bac3-2136f54b71f1" />
                      <a:da name="DEFAULT" value="IOM_EVENTCOUNTERTHRESHOLD_DISABLE" />
                      <a:da name="RANGE">
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_DISABLE</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_1</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_2</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_3</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_4</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_5</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_6</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_7</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_8</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_9</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_10</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_11</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_12</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_13</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_14</a:v>
                            <a:v>IOM_EVENTCOUNTERTHRESHOLD_15</a:v>
                      </a:da>
                    </v:var>
                    <v:var name="IomEMUThreshold1" type="ENUMERATION">
                      <a:a name="DESC" value="EN: Indicates threshold count value for the counter 1 of the EMU module.Upon counter meeting this value,
                                              the counter event output becomes high for one clock cycle. If select IOM_EMU_C1_COUNTER_OFF counter is disabled  " />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS"
                           type="IMPLEMENTATIONCONFIGCLASS" >
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
