                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="42358cb3-2237-44eb-99b4-91879fc1e642">
                      <SHORT-NAME>SpiShiftClockIdleLevel</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">ECUC_Spi_00213: This parameter defines the SPI shift clock idle level.</L-2>
                      </DESC>
