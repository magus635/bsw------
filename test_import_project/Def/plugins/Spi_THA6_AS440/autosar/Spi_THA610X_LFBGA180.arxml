                  </REFERENCES>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="1aa8b431-ec4e-45ca-9e89-6971bb18df8f">
                  <SHORT-NAME>SpiJob</SHORT-NAME>
                  <DESC>
