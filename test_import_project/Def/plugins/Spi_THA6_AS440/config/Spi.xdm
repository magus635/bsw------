                <a:a name="UUID" value="299f7b14-a651-44d2-9c6d-00c0547b1a06" />
<!-- ECUC_Spi_00236: Number of different SPI hardware microcontroller peripherals (units/busses) available and handled by this SPI Handler/Driver module -->
                <v:var name="SpiMaxHwUnit" type="INTEGER_LABEL">
                  <a:a name="DESC" value="EN: ECUC_Spi_00236: Number of different SPI hardware microcontroller peripherals (units/busses) available and handled by this SPI Handler/Driver module." />
