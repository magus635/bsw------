                        <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Spi/SpiDriver/SpiJob" />
                        <a:da name="INVALID" type="XPath">
                          <a:tst expr="node:refvalid(.)" false="[083-00-00-ERROR]: Invalid or empty reference." />
                        </a:da>
                      </v:ref>
                    </v:lst>
                  </v:ctr>
                </v:lst>
              </v:ctr>
<!-- ECUC_Spi_00235: Container holding all SPI specific published information parameters -->
              <v:ctr name="SpiPublishedInformation" type="IDENTIFIABLE">
