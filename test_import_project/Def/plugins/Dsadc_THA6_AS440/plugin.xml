         name="Dsadc_THA6_AS440_FuSa Module"
         point="dreisoft.tresos.launcher2.plugin.module">
      <module
            allowMultiple="false"
            categoryCategory="ECU Firmware"
            categoryComponent="ECUC"
            categoryLayer="MCAL"
            categoryType="Dsadc"
            copyright="Copyright 2020-2030 ChipowerTech, Inc"
            description="Dsadc MCAL module"
