         <ecuType
               derivate="THA6XXX_FuSa"
               target="ARM">
         </ecuType>
         <cluster
               name="MCAL">
         </cluster>
      </module>
   </extension>
  
   <extension
         id="Dsadc_THA6_AS440_FuSa_GeneratorID"
         name="Dsadc_THA6_AS440_FuSa"
         point="dreisoft.tresos.launcher2.plugin.generator">
      <generator
            class="dreisoft.tresos.launcher2.generator.TemplateBasedCodeGenerator"
            id="Dsadc_THA6_AS440_FuSa_GeneratorModuleID"
            moduleId="Dsadc_THA6_AS440_FuSa">
         <parameter
               name="variantAware"
               value="true">
         </parameter>
         <parameter
               mode="generate_swcd"
               name="mode_type"
               value="generate">
         </parameter>
         <parameter
               mode="verify_swcd"
               name="mode_type"
               value="verify">
         </parameter>
         <parameter
               mode="generate_swcd,verify_swcd"
               name="templates"
               value="generate_swcd">
         </parameter>
         <parameter
               mode="generate,verify"
               name="templates"
               value="generate,generate_PC,generate_PB">
         </parameter>
         <parameter
               mode="generate_PC"
               name="templates"
               value="generate_PC">
         </parameter>
         <parameter
               mode="generate_PB"
               name="templates"
               value="generate_PB">
         </parameter>
         <parameter
               mode="generate_PC"
               name="mode_type"
               value="generate">
         </parameter>
         <parameter
               mode="generate_PB"
               name="mode_type"
               value="generate">
         </parameter>
      </generator>
   </extension>
   <extension
         id="EPC_GeneratorID"
         name="EPC"
         point="dreisoft.tresos.launcher2.plugin.generator">
      <generator
            class="dreisoft.tresos.autosar2.generator.EPCFileGenerator"
            id="Dsadc_THA6_AS440_FuSa"
            moduleId="Dsadc_THA6_AS440_FuSa">
         <parameter
               name="variantAware"
               value="true">
         </parameter>
         <parameter
               name="cfgFilePath"
               value="output">
         </parameter>
         <parameter
               name="generateAllModules"
               value="false">
         </parameter>
         <parameter
               name="generateIntoOneFile"
               value="false">
         </parameter>
         <parameter
               name="contentType"
               value="asc:4.4.0">
         </parameter>
      </generator>
   </extension> <extension
         id="Dsadc_THA6_AS440_FuSa_ConfigurationID"
         name="Dsadc_THA6_AS440_FuSa Configuration"
         point="dreisoft.tresos.launcher2.plugin.configuration">
      <configuration
            moduleId="Dsadc_THA6_AS440_FuSa">
         <schema>
            <manager
                  class="dreisoft.tresos.autosar2.resourcehandling.AutosarSchemaManager">
            </manager>
            <resource
                  type="xdm"
                  value="config/Dsadc.xdm">
            </resource>
         </schema>
        
         <editor
               id="Dsadc_THA6_AS440_FuSa_EditorId"
               label="Dsadc"
               tooltip="Dsadc MCAL module">
            <class
                  class="dreisoft.tresos.launcher2.editor.GenericConfigEditor">
               <parameter
                     name="schema"
                     value="ASPath:/THA6_AS440_FuSa/Dsadc">
               </parameter>
               <parameter
                     name="title"
                     value="Dsadc">
               </parameter>
               <parameter
                     name="noTabs"
                     value="false">
               </parameter>
               <parameter
                     name="noLinks"
                     value="true">
               </parameter>
               <parameter
                     name="groupLinks"
                     value="false">
               </parameter>
               <parameter
                     name="groupContainers"
                     value="false">
               </parameter>
               <parameter
                     name="groupTables"
                     value="true">
               </parameter>
               <parameter
                     name="optionalGeneralTab"
                     value="true">
               </parameter>
            </class>
         </editor> <data>
            <schemaNode
                  path="ASPath:/THA6_AS440_FuSa/Dsadc">
            </schemaNode>
            <manager
                  class="dreisoft.tresos.autosar2.resourcehandling.AutosarConfigManager">
            </manager>
         </data>
      </configuration>
   </extension>
   
  <!-- this post-generator just calls an ant script which renames the file created by the TemplateBasedCodeGenerator defined above
       otherwise the next run of the TemplateBasedCodeGenerator for another variant would overwrite the file -->
  <extension point="dreisoft.tresos.generator.api.plugin.generator"
    id="Dsadc_THA6_AS440_FuSa_Gen_Template_MoveFile">
    <generator moduleId="Dsadc_THA6_AS440_FuSa"
               id="Dsadc_THA6_AS440_FuSa_Gen_Template_MoveFile"
               class="dreisoft.tresos.generator.ng.api.NGGenerator"
               modes="generate,Template_withPostRename"
               step="post">
      <!-- Specify the ant build script as parameter to the NGGenerator. -->
      <parameter name="buildfile"  value="template_ant/ant_generator.xml"/>

      <!-- only having this parameter set to true, a generator is called once for each variant! -->
      <parameter name="variantAware" value="true"/>
    </generator>
  </extension>

</plugin>
