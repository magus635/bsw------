            label="Dsadc"
            mandatory="false"
            relVersionMajor="4"
            relVersionMinor="4"
            relVersionPatch="0"
            relVersionPrefix="AUTOSAR"
            specVersionMajor="4"
            specVersionMinor="4"
            specVersionPatch="0"
            swVersionMajor="1"
            swVersionMinor="2"
