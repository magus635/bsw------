                  <REFERENCES>
                    <ECUC-REFERENCE-DEF UUID="b5faa4a6-b299-47c0-b646-e687a063b74b">
                      <SHORT-NAME>LinClockRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Reference to the LIN clock source configuration, which is set in the MCU driver configuration.&lt;br/&gt;                       &lt;h1&gt;Note&lt;/h1&gt;                       This parameter is not used, replaced by &apos;LinClockSet/LinSysClockRef&apos;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
