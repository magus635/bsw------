<?xml version='1.0'?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="THA6_AS440_FuSa" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:AUTOSAR"/>
        <d:lst type="ELEMENTS">
          <d:chc name="Lin" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC" value="EN: Configuration of the Lin (LIN driver) module." />
              <a:a name="LOWER-MULTIPLICITY" value="0" />
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true" />
              <a:a name="RELEASE" value="asc:4.4.0" />
              <a:a name="UPPER-MULTIPLICITY" value="*" />
              <a:a name="UUID" value="f362b702-dbfc-4195-bd8f-09f0c2e16a69" />
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="LABEL" value="Config Variant" />
                <a:a name="UUID" value="a3cbcaab-eb9d-4aee-80a5-2b7712deec93" />
                <a:da name="DEFAULT" value="VariantPostBuild" />
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                </a:da>
              </v:var>
              <!-- @implements LinDemEventParameterRefs_Object -->
              <v:ctr name="LinDemEventParameterRefs" type="IDENTIFIABLE">
                <a:a name="DESC" value="EN: Container for the references to DemEventParameter elements which shall be invoked using the API Dem_ReportErrorStatus API in case the corresponding error occurs. The EventId is taken from the referenced DemEventParameter&apos;s DemEventId value. The standardized errors are provided in the container and can be extended by vendor specific error references." />
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="OPTIONAL" value="true" />
                <a:a name="UUID" value="c2b41451-493e-4b66-b895-af5ef7392d50" />
                <a:a name="REQUIRES-INDEX" value="true"/>
                <!-- @implements LIN_E_TIMEOUT_Object -->
                <v:ref name="LIN_E_TIMEOUT" type="SYMBOLIC-NAME-REFERENCE">
                  <a:a name="DESC" value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Timeout caused by hardware error&quot; has occured." />
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                  <a:a name="OPTIONAL" value="true" />
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="UUID" value="e9c85d6d-1e9d-4838-b2a0-e1a628c76dbb" />
                  <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter" />
                  <a:da name="INVALID" type="XPath">
                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference." />
                  </a:da>
                </v:ref>
              </v:ctr>
              <v:ctr name="LinClockSet" type="IDENTIFIABLE">
                <a:a name="DESC" value="EN: This container contains All LIN hardware unit baudrate clock setting." />
                <a:a name="UUID" value="274f0ef0-ed66-11ec-9451-f889d2d2ec8e" />
                <a:a name="REQUIRES-INDEX" value="true"/>
                <v:ref name="LinSysClockRef" type="REFERENCE">
                  <a:a name="DESC" value="EN: Reference to the LIN clock source configuration, which is set in the MCU driver configuration.&lt;br/&gt;
                  &lt;h1&gt;Note&lt;/h1&gt;This is used to replace 'LinClockRef'" />
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech" />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="UUID" value="5455fca4-ed61-11ec-a25d-f889d2d2ec8f" />
                  <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig/McuClockReferencePoint" />
                  <a:da name="INVALID" type="XPath">
                    <a:tst expr="node:refvalid(.)" false="Invalid or empty reference." />
                  </a:da>
                </v:ref>
              </v:ctr>
              <v:ctr name="LinGeneral" type="IDENTIFIABLE">
                <a:a name="DESC" value="EN: This container contains the parameters related to each LIN Driver Unit." />
                <a:a name="UUID" value="812bc05d-bf2b-4633-bf91-df48229a0003" />
                <v:var name="LinIndex" type="INTEGER">
                  <a:a name="DESC" value="EN: Specifies the InstanceId of this module instance. If only one instance is present it shall have the Id 0." />
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:da name="DEFAULT" value="0" />
                  <a:a name="UUID" value="30a9d4d0-cc6c-4915-917b-a62f89d90255" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=255" />
                    <a:tst expr="&gt;=0" />
                  </a:da>
                </v:var>
                <v:var name="LinTimeoutDuration" type="INTEGER">
                  <a:a name="DESC" value="EN: Specifies the maximum number of loops for blocking function until a timeout is raised in short term wait loops" />
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:da name="DEFAULT" value="1000" />
                  <a:a name="UUID" value="652ca32d-121a-485e-934a-b519827ad302" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=65535" />
                    <a:tst expr="&gt;=0" />
                  </a:da>
                  <a:da name="WARNING" type="XPath">
                    <a:tst expr="node:value(.) &lt; 50" true="If the value of the node is lower than 50, the hardware may experience a timeout error."  />
                  </a:da>
                </v:var>
                <v:var name="LinDevErrorDetect" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Switches the Default Error Tracer (Det) detection and notification ON or OFF. &lt;br/&gt;
                    true: enabled (ON). &lt;br/&gt;
                    false: disabled (OFF)." />
                  
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                  <a:da name="TOOLTIP" value="Switch for enabling the development error detection." />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="7d07dfed-91fd-4fa2-9392-968801ee7dad" />
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <v:var name="LinVersionInfoApi" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Switches the Lin_GetVersionInfo function ON or OFF." />
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="0c5f32c2-812f-474c-acd7-0ab9a0232f9c" />
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <!-- /** @implements LinEcucPartitionRef_Object */ -->
                <v:lst name="LinEcucPartitionRef">
                  <!-- <a:da name="INVALID" type="XPath">
                    <a:tst expr="( (node:fallback(as:modconf('Lin')[1]/LinGeneral/LinMulticoreSupport, 'false') = 'false') and (num:i(count(./*)) != 0) )"
                    true="Multicore isn't supported(LinMulticoreSupport node is unchecked) so the LinEcucPartitionRef list need to be empty"/>
                    <a:tst expr="( (node:fallback(as:modconf('Lin')[1]/LinGeneral/LinMulticoreSupport, 'false') = 'true') and (num:i(count(./*)) = 0) )"
                    true="Multicore is supported(LinMulticoreSupport node is checked) so at least one partition should be referred"/>
                  </a:da> -->
                  <v:ref name="LinEcucPartitionRef" type="REFERENCE">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:<html>
                            Maps the Lin driver to zero or multiple ECUC partitions to make the modules API available in this partition.
                            The Lin driver will operate as an independent instance in each of the partitions.
                        </html>]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPostBuild</icc:v>
                      <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true" />
                    <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="UUID" value="ECUC:b016dd0a-d2c6-4fe5-b096-75f6bfac79ff"/>
                    <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                    <a:da name="INVALID" type="XPath">
                      <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                      <a:tst expr="node:containsValue(as:modconf('Os')[1]/OsApplication/*/OsAppEcucPartitionRef, node:value(.))"
                      false="The partition referred isn't used by any Os/OsApplication/*/OsAppEcucPartitionRef"/>
                      <a:tst expr="text:uniq(node:fallback(../*,''),node:fallback( ., '' ))"
                      false ="The partition must be unique in LinEcucPartitionRef list."/>
                      <a:tst expr="node:containsValue(as:modconf('Lin')/LinGlobalConfig/LinChannel/*/LinChannelEcucPartitionRef, node:value(.))"
                      false ="The partition referred in LinEcucPartitionRef is not used by any LinChannelEcucPartitionRef."/>
                    </a:da>
                  </v:ref>
                </v:lst>
                <v:var name="LinInterruptEnable" type="BOOLEAN">
                  <a:a name="DESC"
                       value="EN: Specify LIN operation in interrupt enabled or interrupt disabled mode.&lt;br/&gt;
                       true: Interrupt mode Enabled; false: Interrupt mode Disabled"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:da name="DEFAULT" value="true"/>
                  <a:a name="UUID" value="03f6c9e0-e3b7-4907-84c0-a96e099b4438"/>
                </v:var>
              </v:ctr>
              <v:ctr name="LinGlobalConfig" type="IDENTIFIABLE">
                <a:a name="DESC" value="EN: This container contains the global configuration parameter of the Lin driver." />
                <a:a name="UUID" value="5f89f9ba-fda3-4eff-b710-a1c2bca8d03b" />
                <v:lst name="LinChannel" type="MAP">
                  <a:da name="MIN" value="1" />
                  <a:da name="MAX" type="XPath" expr="ecu:get('Asi.MaxHwUnit')" />
                  <v:ctr name="LinChannel" type="IDENTIFIABLE">
                    <a:a name="DESC" value="EN: This container contains the configuration (parameters) of the LIN Controller(s)." />
                    <a:a name="UUID" value="9a196cfa-bd9f-4174-84bb-0d3296e1d92f" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                            type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                    <a:a name="REQUIRES-INDEX" value="true"/>

                    <v:var name="LinChannelId" type="INTEGER">
                      <a:a name="DESC" value="EN: Identifies the LIN channel. Replaces LIN_CHANNEL_INDEX_NAME from the LIN SWS." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="true" />
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(0))" />
                      <a:a name="UUID" value="e5b8d2b0-4d21-49ce-9519-6de8fef3acff" />
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=65535" />
                        <a:tst expr="&gt;=0" />
                      </a:da>
                      <a:da name="RANGE" type="XPath">
                        <a:tst expr="(. &gt;= 0) and (.&lt; num:i(count(node:current()/../../*)))" false="Value out of range: must be in range 0 to N-1 (N is number of configured channels). Use the Calc button to calculate correct default value" />
                        <a:tst expr="text:uniq(../../*/LinChannelId, .)" false="Duplicated value, LinChannelId must be unique across all Lin channels. Use the Calc button to calculate correct default value." />
                      </a:da>
                    </v:var>
                    <v:var name="LinHwUnit" type="ENUMERATION">
                      <a:a name="DESC" value="EN:This parameter selects the hardware unit used to tranfer lin data." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="UUID" value="1a195c06-d2a5-11ec-8ee0-f889d2d2ec8e" />
                      <a:da name="ENABLE" value="true" />
                      <a:da name="VISIBLE" value="true" />
                      <a:da name="DEFAULT" value="ASI0" />
                      <a:da name="RANGE" type="XPath">
                        <a:tst expr="ecu:list('Asi.AvailableHWUnit')"/>
                      </a:da>
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="text:uniq(node:fallback( ../../*/LinHwUnit, 0 ), node:fallback( ., 1 ))" false="Duplicate Lin hardware unit" />
                          <a:tst expr="node:containsValue(as:modconf('Uart')[1]/UartGlobalConfig/UartChannel/*/UartHwUnit, .)" true="This ASIx HwUnit channel has been used in the Uart module" />                     
                      </a:da>
                    </v:var>
                    <v:var name="LinChannelBaudRate" type="INTEGER">
                      <a:a name="DESC" value="EN: Specifies the baud rate of the LIN channel" />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:da name="DEFAULT" value="19200" />
                      <a:a name="UUID" value="1da1fa38-50e8-490e-9c19-057b74d9babc" />
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=20000" />
                        <a:tst expr="&gt;=1000" />
                      </a:da>
                    </v:var>
                    <v:var name="LinFrameBreakFieldLength" type="ENUMERATION">
                      <a:a name="DESC" value="EN:configuration Lin frame break field length." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="ORIGIN" value="ChipowerTech" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="UUID" value="1a195c06-d2a5-11ec-8ee0-f129d2d2ec85" />
                      <a:da name="ENABLE" value="true" />
                      <a:da name="VISIBLE" value="true" />
                      <a:da name="DEFAULT" value="LIN_BREAKLEN_13BIT" />
                      <a:da name="RANGE">
                        <a:v>LIN_BREAKLEN_10BIT</a:v>
                        <a:v>LIN_BREAKLEN_11BIT</a:v>
                        <a:v>LIN_BREAKLEN_12BIT</a:v>
                        <a:v>LIN_BREAKLEN_13BIT</a:v>
                        <a:v>LIN_BREAKLEN_14BIT</a:v>
                        <a:v>LIN_BREAKLEN_15BIT</a:v>
                        <a:v>LIN_BREAKLEN_16BIT</a:v>
                        <a:v>LIN_BREAKLEN_17BIT</a:v>
                        <a:v>LIN_BREAKLEN_18BIT</a:v>
                        <a:v>LIN_BREAKLEN_19BIT</a:v>
                        <a:v>LIN_BREAKLEN_20BIT</a:v>
                        <a:v>LIN_BREAKLEN_21BIT</a:v>
                        <a:v>LIN_BREAKLEN_22BIT</a:v>
                        <a:v>LIN_BREAKLEN_23BIT</a:v>
                        <a:v>LIN_BREAKLEN_36BIT</a:v>
                        <a:v>LIN_BREAKLEN_50BIT</a:v>
                      </a:da>
                    </v:var>
                    <v:var name="LinChannelWakeupSupport" type="BOOLEAN">
                      <a:a name="DESC" value="EN: Specifies if the LIN hardware channel supports wake up functionality" />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="false" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:da name="DEFAULT" value="false" />
                      <a:a name="UUID" value="3ee2b9ef-d106-41c8-8260-88dd21d4a170" />
                      <!-- <a:da name="INVALID" type="XPath">
                        <a:tst expr="( (node:fallback(.,'false') = 'true') and  not(node:exists(../LinChannelEcuMWakeupSource)) )" true=" Need to enable LinChannelEcuMWakeupSource" />
                      </a:da> -->
                    </v:var>
                    <v:var name="LinNodeType" type="ENUMERATION">
                      <a:a name="DESC" value="EN:Specifies the LIN node type of this channel." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:a name="UUID" value="E1C3A957-7316-CA82-271F-77BD81C82595" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:da name="DEFAULT" value="MASTER" />
                      <a:da name="RANGE">
                        <a:v>MASTER</a:v>
                        <a:v>SLAVE</a:v>
                      </a:da>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="(../../../../LinGeneral/LinInterruptEnable = 'false') and
                                     ((.) = 'SLAVE')" true="Slave mode must enable the interrupt." />
                      </a:da>
                    </v:var>
                    <v:ref name="LinClockRef" type="REFERENCE">
                      <a:a name="DESC" value="EN: Reference to the LIN clock source configuration, which is set in the MCU driver configuration.&lt;br/&gt;
                      &lt;h1&gt;Note&lt;/h1&gt;
                      This parameter is not used, replaced by 'LinClockSet/LinSysClockRef'" />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                      <a:a name="POSTBUILDVARIANTVALUE" value="true" />
                      <a:a name="SCOPE" value="LOCAL" />
                      <a:da name="EDITABLE" value="false"/>
                      <a:a name="UUID" value="b5faa4a6-b299-47c0-b646-e687a063b74b" />
                      <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig/McuClockReferencePoint" />
                    </v:ref>
                    <v:lst name="LinChannelEcuMWakeupSource">
                      <a:da name="MAX" value="1"/>
                      <v:ref name="LinChannelEcuMWakeupSource" type="SYMBOLIC-NAME-REFERENCE">
                        <a:a name="DESC" value="EN: This parameter contains a reference to the Wakeup Source for this controller as defined in the ECU State Manager." />
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                        <a:a name="SCOPE" value="LOCAL" />
                        <a:a name="UUID" value="dfd8450b-74db-49b2-9236-cee8e7a3a2f0" />
                        <!-- <a:a name="OPTIONAL" value="false" /> -->
                        <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuM/EcuMConfiguration/EcuMCommonConfiguration/EcuMWakeupSource" />
                        <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                        <!-- <a:da name="INVALID" type="XPath">
                          <a:tst expr="true" true="Refer to a invalid wakeup source" /> -->
                          <!-- <a:tst expr="not( (. != '') and (node:exists(node:refs(.))) )" true="Refer to a invalid wakeup source" />
                        </a:da> -->
                      </v:ref>
                    </v:lst>
                    <!-- @implements LinChannelEcucPartitionRef_Object -->
                    <v:ref name="LinChannelEcucPartitionRef" type="REFERENCE">
                      <a:a name="DESC">
                        <a:v>
                          <![CDATA[EN:<html>
                            Maps one single Lin channel to zero or one ECUC partitions.
                            The ECUC partition referenced is a subset of the ECUC partitions where the Lin driver is mapped to.
                          </html>]]>
                        </a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="OPTIONAL" value="true"/>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" value="ECUC:b016c50a-d2c6-4fe5-b096-75a9bfac22fe"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                      <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:refvalid(.)" false="Invalid or empty reference."/>
                        <a:tst expr="node:containsValue(../../../../LinGeneral/LinEcucPartitionRef/*, node:value(.))"
                            false="The ECUC partitions referenced by LinChannelEcucPartitionRef shall be a subset of the ECUC partitions referenced by LinEcucPartitionRef."/>
                      </a:da>
                    </v:ref>
                  </v:ctr>
                </v:lst>
              </v:ctr>

