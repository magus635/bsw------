                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ebd64dde-6854-4660-ba94-57fdd8d79cbf">
                  <SHORT-NAME>PwmVersionInfoApi</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Switch to indicate that the Pwm_ GetVersionInfo is supported</L-2>
