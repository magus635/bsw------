                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="9DAC3C36-DFAF-CB98-CD4B-568A37639AB6">
                          <SHORT-NAME>MscPinInjectConfiguration</SHORT-NAME>
                          <DESC>
