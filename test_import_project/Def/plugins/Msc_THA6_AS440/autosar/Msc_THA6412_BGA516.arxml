                              <PARAMETERS>
                                <ECUC-INTEGER-PARAM-DEF UUID="f9b0c166-94e6-c05b-f179-e74f94baed3e">
                                  <SHORT-NAME>MscDataBitIndex</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="FOR-ALL">This parameter identifies the data bit of the data frame using an index. This index is used for further configuration of the data bit source,emergency stop behaviour</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>ChipowerTech</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                                  <MAX>31</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-ENUMERATION-PARAM-DEF UUID="bb610f60-defc-d246-3eb0-f01aa258d8a8">
                                  <SHORT-NAME>MscDataBitSrc</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="FOR-ALL">This parameter selects the data source for the data bit indexed by MscDataBitIndex</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>ChipowerTech</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DEFAULT-VALUE>SRC_DOWNSTREAMDATA</DEFAULT-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>SRC_DOWNSTREAMDATA</SHORT-NAME>
                                      <ORIGIN>ChipowerTech</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
