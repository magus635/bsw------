                                             <a:a name="UUID"
                                                  value="4e3c335c-4eed-8a9a-6db7-675073730e07" />
                                             <a:da name="DEFAULT" value="false" />
                                        </v:var>

                                        <v:var name="Msc_GetRxDataApi" type="BOOLEAN">
                                             <a:a name="DESC"
                                                  value="This parameter decides the availability of the API Msc_GetRxData" />
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                                  <icc:v vclass="PreCompile">
                                                       VariantPostBuild</icc:v>
                                             </a:a>
                                             <a:a name="ORIGIN" value="ChipowerTech" />
                                             <a:a name="UUID"
                                                  value="316fc372-f7d7-18b7-1c62-c5496cf5d477" />
                                             <a:da name="DEFAULT" value="false" />
                                        </v:var>

                                        <v:var name="MscGetTxStatusApi" type="BOOLEAN">
                                             <a:a name="DESC"
                                                  value="This parameter decides the availability of the API Msc_GetTxStatus" />
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                                  <icc:v vclass="PreCompile">
                                                       VariantPostBuild</icc:v>
                                             </a:a>
                                             <a:a name="ORIGIN" value="ChipowerTech" />
                                             <a:a name="UUID"
                                                  value="96F8AE05-3444-E8B3-8009-A2B03B1DC859" />
                                             <a:da name="DEFAULT" value="false" />
                                        </v:var>

                                        <v:var name="MscSelectRxDeviceApi" type="BOOLEAN">
                                             <a:a name="DESC"
                                                  value="This parameter decides the availability of the API Msc_SelectRxDevice" />
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                                  <icc:v vclass="PreCompile">
                                                       VariantPostBuild</icc:v>
                                             </a:a>
                                             <a:a name="ORIGIN" value="ChipowerTech" />
                                             <a:a name="UUID"
                                                  value="3338EA0B-495D-CA19-246F-5C3C96BDBD2A" />
                                             <a:da name="DEFAULT" value="false" />
                                        </v:var>

                                        <v:var name="MscTxDataFrameApi" type="BOOLEAN">
