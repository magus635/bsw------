                                   <v:ctr name="MscDriverConfiguration" type="IDENTIFIABLE">
                                        <a:a name="UUID"
                                                  value="9cf3579e-22f5-433a-b297-5db3eb17e092" />
                                       <a:a name="DESC" value="This contains the functional feature configuration of MSC driver" />
                                        <v:var name="MscDevErrorDetect" type="BOOLEAN">
                                             <a:a name="DESC"
                                                  value="Switch to enable/disable the function of development error trace" />
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS"
