                                             <a:da name="DEFAULT" value="false" />
                                        </v:var>

                                        <v:var name="MscChangeRxStateApi" type="BOOLEAN">
                                             <a:a name="DESC"
                                                  value="This parameter decides the availability of the API Msc_ChangeRxState" />
