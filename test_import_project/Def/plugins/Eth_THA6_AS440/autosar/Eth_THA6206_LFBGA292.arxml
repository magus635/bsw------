                    </ECUC-REFERENCE-DEF>
                  </REFERENCES>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7bbd76b3-0215-4b02-8c5a-2164e4455poi">
                      <SHORT-NAME>EthCtrlConfigEgress</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                              Configuration of one Ethernet controler egress behavior.
                         &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <REFERENCES>
                        <ECUC-REFERENCE-DEF UUID="ECUC:7bbd76b3-0215-4b02-8c5a-2164e4455ghj">
                          <SHORT-NAME>EthCtrlConfigEgressLastSchedulerRef</SHORT-NAME>
                          <DESC>
