              <v:ctr name="EthGeneral" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: General configuration of Ethernet Driver module"/>
                <a:a name="UUID" value="03388bbd-c7c3-471b-b520-0d4c2347d688"/>
                <v:var name="EthDevErrorDetect" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Switches the Default Error Tracer (Det) detection and notification ON or OFF."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="UUID" value="2bbe19a1-4942-4349-b200-1b3df36a34f5"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
               <v:var name="EthSafetyErrorDetect" type="BOOLEAN">
                    <a:a name="DESC" value="EN: Switches the Safety Error detection ON or OFF." />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech" />
                    <a:a name="SCOPE" value="LOCAL" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="019666e3-8a8f-77f1-a107-20484462f0ac" />
                    <a:da name="DEFAULT" value="true" />
               </v:var>

                <v:var name="EthGetDropCountApi" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Enables / Disables Eth_GetDropCount API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="UUID" value="31464597-ec53-4089-a6f5-0d19b8c238fe"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="EthGetEtherStatsApi" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Enables / Disables Eth_GetEtherStats API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="UUID" value="7f7eb97d-ac71-46e8-a33f-d7605ca7f0fe"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>

                <v:var name="EthGetTxErrorCounterValuesApi" type="BOOLEAN">
                  <a:a name="DESC"
                       value="EN: Enables/Disables Eth_GetTxErrorCounterValues API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="UUID" value="ECUC:6aaf0d93-a6cb-481a-902c-c6586ghyee8a"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>

                <v:var name="EthGetTxStatsApi" type="BOOLEAN">
                  <a:a name="DESC"
                       value="EN: Enables / Disables Eth_GetTxStats API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:962ec9c9-decd-48f5-8969-28ec5cd1asdw"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>


                <v:var name="EthGlobalTimeSupport" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Enables/Disables the GlobalTime APIs used amongst others by Global Time Synchronization over Ethernet."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="dbdfb082-3cea-4fec-86c5-e79b344f356b"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="EthIndex" type="INTEGER">
                  <a:a name="DESC" 
                       value="EN: Specifies the InstanceId of this module instance. If only one instance is present it shall have the Id 0."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="b7664177-d13c-4568-950e-7b0c963f3b43"/>
                  <a:da name="DEFAULT" value="0"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=255"/>
                    <a:tst expr="&gt;=0"/>
                  </a:da>
                </v:var>
                <v:var name="EthMainFunctionPeriod" type="FLOAT">
                  <a:a name="DESC" 
                       value="EN: Specifies the period of main function Eth_MainFunction in seconds. Ethernet driver does not require this information but the BSW scheduler."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="cafc853f-d744-4df6-912f-668b697ad6e8"/>
                  <a:da name="DEFAULT" value="0.005"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=Infinity"/>
                    <a:tst expr="&gt;=0.0"/>
                  </a:da>
                </v:var>
                <v:var name="EthMaxCtrlsSupported" type="INTEGER">
                  <a:a name="DESC" 
                       value="EN: Limits the total number of supported controllers."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="EDITABLE" value="false"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="7d9e9f41-db10-4eee-88ec-1ec4d3b22552"/>
                  <a:da name="DEFAULT" value="1"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=1"/>
                    <a:tst expr="&gt;=1"/>
                  </a:da>
                </v:var>

                <v:var name="EthVersionInfoApi" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Enables / Disables version info API"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="a77af4f8-9044-485c-bcc6-3ccaa48a5aba"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
        

               <v:lst name="EthEcucPartitionRef">

                    <v:ref name="EthEcucPartitionRef" type="REFERENCE">
                    <a:a name="DESC">
                         <a:v>EN: Maps the Ethernet driver to zero or multiple ECUC partitions to make the modules API available in this partition. The Ethernet driver will operate as an independent instance in each of the partitions.</a:v>
                         <a:v>EN: Tags: atp.Status=draft</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                         <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="UUID"
                         value="ECUC:ec2e160d-fd07-47d6-9f75-55489128kioi"/>
                    <a:da name="EDITABLE" value="false"/>
                    <a:da name="REF"
                         value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                    </v:ref>
               </v:lst>                
                
                <v:ctr name="EthCtrlOffloading" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: Configuration of hardware offloading features."/>
                  <a:a name="UUID" value="d8fa612b-799b-4a9f-8281-39923ac7b954"/>
                  <v:var name="EthCtrlEnableOffloadChecksumICMP" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Enables  /  Disables  hardware offloading for ICMP checksums."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>                    
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="53629a18-3bad-40df-8843-62b1aeaffe8c"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="EthCtrlEnableOffloadChecksumIPv4" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Enables  /  Disables  hardware offloading for IPv4 checksums."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                      
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>                  
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="d6eb2a15-d909-4c00-a200-33fa6d0e8a5c"/>
                    <a:da name="DEFAULT" value="false"/>
