                    <ECUC-BOOLEAN-PARAM-DEF UUID="99a2bb28-8a81-46ea-9846-09fe9ecc7459">
                      <SHORT-NAME>UartTxInterruptEnable</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the transmit Interrupt function ON or OFF.</L-2>
                      </DESC>
