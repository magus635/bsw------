                    <ECUC-BOOLEAN-PARAM-DEF UUID="72252533-6e62-4ee6-bdf7-b90b34547cda">
                      <SHORT-NAME>UartRxInterruptEnable</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the receiving Interrupt function ON or OFF.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>ChipowerTech</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
