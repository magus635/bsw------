                    <ECUC-BOOLEAN-PARAM-DEF UUID="dd7b882e-86f8-4d0c-8584-3b778be5d2fe">
                      <SHORT-NAME>UartBufferLockModeEnable</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the RX buffer Lock mode ON or OFF, The receiver buffer is locked against overflow. Once the buffer is full, how the next message is handled.&lt;br /&gt;                         True: The next incoming message will be discarded.&lt;br /&gt;                         False: The next incoming message overwrites the previous one.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>ChipowerTech</ORIGIN>
