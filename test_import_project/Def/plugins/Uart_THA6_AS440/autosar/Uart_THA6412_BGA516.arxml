                      <SHORT-NAME>UartDataParityMode</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">configuration Uart data parity mode.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>ChipowerTech</ORIGIN>
