<?xml version="1.0"?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" 
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="THA6_AS440_FuSa" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:AUTOSAR"/>
        <d:lst type="ELEMENTS">
          <d:chc name="Wdg" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.4.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC" 
                   value="EN: Configuration of the Wdg (Watchdog driver) module."/>
              <a:a name="LOWER-MULTIPLICITY" value="0"/>
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
              <a:a name="RELEASE" value="asc:4.4.0"/>
              <a:a name="UPPER-MULTIPLICITY" value="*"/>
              <a:a name="UUID" value="79e23e92-c8e7-4d12-b6be-38b98c2e24fd"/>
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                     type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="LABEL" value="Config Variant"/>
                <a:a name="UUID" value="007d0d75-2d33-453a-a9e0-e2ba39612d1e"/>
                <a:da name="DEFAULT" value="VariantPostBuild"/>
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                </a:da>
              </v:var>
              <v:ctr name="WdgDemEventParameterRefs" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: Container for the references to DemEventParameter elements which shall be invoked using the API Dem_ReportErrorStatus in case the corresponding error occurs. The EventId is taken from the referenced DemEventParameter's DemEventId value."/>
                <a:a name="OPTIONAL" value="true"/>
                <a:a name="UUID" value="96324a17-d67d-4796-9b8f-535765d9851a"/>
                <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                     type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                </a:a>
                <v:ref name="WDG_E_DISABLE_REJECTED" type="SYMBOLIC-NAME-REFERENCE">
                  <a:a name="DESC" value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Initialization or mode switch failed because it would disable the watchdog&quot; has occurred."/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="OPTIONAL" value="true"/>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="UUID" value="15636b96-41f2-466f-897d-a47fe75cd8e1"/>
                  <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                </v:ref>
                <v:ref name="WDG_E_MODE_FAILED" type="SYMBOLIC-NAME-REFERENCE">
                  <a:a name="DESC" value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Setting a watchdog mode failed (during initialization or mode switch)&quot; has occurred."/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="OPTIONAL" value="true"/>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="UUID" value="c19ca190-fcb4-4f65-9378-8ff744248d63"/>
                  <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                </v:ref>
              </v:ctr>
              <v:ctr name="WdgGeneral" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: All general parameters of the watchdog driver are collected here."/>
                <a:a name="UUID" value="5d4a50a1-fb59-4cdc-8d2a-0cd9f4b76dfc"/>
                <v:var name="WdgDevErrorDetect" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Switches the Default Error Tracer (Det) detection and notification ON or OFF."/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="1f8da242-37c7-429f-af94-2972206603e6"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="WdgSafetyErrorDetect" type="BOOLEAN">
                  <a:a name="DESC"
                    value="EN: Switches the safety error detection ON or OFF." />
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                    type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="ORIGIN" value="ChipowerTech" />
                  <a:a name="SCOPE" value="LOCAL" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="0196f056-8421-754d-bac1-8b1a17da257d" />
                  <a:a name="DEFAULT" value="true" />
                </v:var>
                <v:var name="WdgDisableAllowed" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Compile switch to allow / forbid disabling the watchdog driver during runtime."/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="e477c5aa-c04e-2c70-8443-08bb1721ce9d"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="WdgVersionInfoApi" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Compile switch to enable / disable the version information API."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="64d00f03-9123-42f7-b78c-9f2affb376b2"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:ref name="WdgEcucPartitionRef" type="REFERENCE">
                  <a:a name="DESC" value="EN: Maps the Wdg driver to zero or one ECUC partitions to make the modules API available in this partition. &lt;br/&gt; Tags: atp.Status=draft."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="OPTIONAL" value="true" />
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                  <a:a name="SCOPE" value="ECU"/>
                  <a:a name="UUID" value="64123f03-9123-44f7-378c-9f2af1b376b2"/>
                  <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                </v:ref>
                <v:var name="WdgOverflowAction" type="ENUMERATION">
                  <a:a name="DESC"
                    value="EN: This parameter is used to configure the sac action when watchdog is overflow.
                     WDG_OVERFLOW_ACTION_NONE: No action.
                     WDG_OVERFLOW_ACTION_RESET: Send a reset request."/>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                    type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ccb0731b-222b-4118-8c48-f7046b8328c1"/>
                  <a:da name="DEFAULT" value="WDG_OVERFLOW_ACTION_RESET"/>
                  <a:da name="RANGE">
                    <a:v>WDG_OVERFLOW_ACTION_RESET</a:v>
                    <a:v>WDG_OVERFLOW_ACTION_NONE</a:v>
                  </a:da>
                </v:var>
                <v:var name="WdgIndex" type="INTEGER">
                  <a:a name="DESC" 
                       value="EN: Represents the watchdog driver's ID so that it can be referenced by the watchdog interface."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                  <a:a name="UUID" value="d2f4bb0e-00d3-41da-86d8-e3201eb54b00"/>
                  <a:da name="DEFAULT" value="0"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=255"/>
                    <a:tst expr="&gt;=0"/>
                  </a:da>
                </v:var>
                <v:var name="WdgInitialTimeout" type="FLOAT">
                  <a:a name="DESC" value="EN: This parameter is disabled. The initial timeout (sec) for the trigger condition to be initialized during Init function. 
                                              It shall be not larger than WdgMaxTimeout."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="0b391ac8-13c9-4b35-aa88-02555a6fc229"/>
                  <a:da name="DEFAULT" type="XPath" expr="ecu:get('Wdg.WdgDeviceInitialTimeout')"/>
                  <a:da name="EDITABLE" value="false"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=65.535"/>
                    <a:tst expr="&gt;=0.0"/>
                  </a:da>
                </v:var>
                <v:var name="WdgMaxTimeout" type="FLOAT">
                  <a:a name="DESC" value="EN: This parameter is disabled. The maximum timeout (sec) to which the watchdog trigger condition can be initialized."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="6bb994ad-000c-4631-9f37-7524ae9f782a"/>
                  <a:da name="DEFAULT" type="XPath" expr="ecu:get('Wdg.WdgMaxTimeoutDefault')"/>
                  <a:da name="EDITABLE" value="false"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=65.535"/>
                    <a:tst expr="&gt;=0.0"/>
                  </a:da>
                </v:var>
                <v:ref name="WdgClockReference" type="REFERENCE">
                  <a:a name="DESC" value="EN: Reference to a container of the type McuClockReferencePoint, to select an input clock."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="UUID" value="db1cd861-1989-42f8-8570-b6a1d16d1b16"/>
                  <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig/McuClockReferencePoint" />
                  <a:da name="INVALID" type="XPath">
                    <a:tst expr="num:i(node:ref(.)/McuClockReferencePointFrequency) > num:i(ecu:get('Wdg.WdgMaximumFrequency'))"
                           true="The wdt clock provided by MCU is greater than the maximum value" />
                  </a:da>
                </v:ref>
                <v:var name="WdgRunArea" type="ENUMERATION">
                  <a:a name="DESC" 
                       value="EN: Represents the watchdog driver execution area is either from ROM(Flash) or RAM as required with the particular microcontroller."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="2d9ace62-2f2c-42bd-97e5-4fd01bb5b5a4"/>
                  <a:da name="EDITABLE" value="false"/>
                  <a:da name="DEFAULT" value="ROM"/>
                  <a:da name="RANGE">
                    <a:v>RAM</a:v>
                    <a:v>ROM</a:v>
                  </a:da>
                </v:var>
                <v:var name="WdgTriggerLocation" type="FUNCTION-NAME">
                  <a:a name="DESC" 
                       value="EN: Location (memory address) of the watchdog trigger routine."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:da name="DEFAULT" value="NULL_PTR"/>
                  <a:a name="UUID" value="6eac391e-bcd3-418b-9d9b-32c4cd2b77d6"/>
                  <a:da name="EDITABLE" value="false"/>
                </v:var>
              </v:ctr>
              <v:lst name="WdgSettingsConfig" type="MAP">
                <a:da name="MIN" value="1"/>
                <a:da name="MAX" type="XPath" expr="ecu:get('Resource.NumOfCores')"/>
                <v:ctr name="WdgSettingsConfig" type="IDENTIFIABLE">
                  <a:a name="REQUIRES-INDEX" value="true"/>
                  <a:a name="DESC" value="EN: The parameters of different watchdog devices are collected here."/>
                  <a:a name="UUID" value="5d4a50a2-fb59-4cdc-8d2a-0cd9f4b76dfc"/>
                  <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="false"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <v:var name="WdgDeviceID" type="INTEGER">
                    <a:a name="DESC" value="EN: This parameter refers to Device ID to which the watchdog settings belong."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="1f8da242-37c7-429f-1f94-2972206603e6"/>
                    <a:da name="DEFAULT" value="0"/>
                    <a:da name="INVALID" type="XPath">
                      <a:tst expr="text:uniq(../../*/WdgDeviceID,.)"  false="EN: WDG Device ID should be unique for each configured."/>
                    </a:da>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=num:i(num:i(ecu:get('Resource.NumOfCores')) - num:i(1))"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                  </v:var>
                  <v:var name="WdgDeviceDisableAllowed" type="BOOLEAN">
                    <a:a name="DESC" value="EN: Compile switch to allow / forbid disabling the watchdog driver during runtime."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="e477c5aa-c04e-2c70-8443-08bb170fce9d"/>
                    <a:da name="EDITABLE" type="XPath">
                      <a:tst expr="../../../WdgGeneral/WdgDisableAllowed = 'true'"/>
                    </a:da>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="WdgDeviceMaxTimeout" type="FLOAT">
                    <a:a name="DESC" value="EN: The maximum timeout (sec) to which the watchdog trigger condition can be initialized for the device."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="6bb994ad-000c-4631-9f27-7524ae9f782a"/>
                    <a:da name="DEFAULT" type="XPath" expr="ecu:get('Wdg.WdgMaxTimeoutDefault')"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=65.535"/>
                      <a:tst expr="&gt;=0.0"/>
                    </a:da>
                  </v:var>
                  <v:var name="WdgDeviceInitialTimeout" type="FLOAT">
                    <a:a name="DESC" value="EN: The default timeout time for the current device. It shall be not larger than WdgDeviceMaxTimeout."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="0b391ac8-13c9-4135-aa88-02511a6fc229"/>
                    <a:da name="DEFAULT" type="XPath" expr="ecu:get('Wdg.WdgDeviceInitialTimeout')"/>
                    <a:da name="INVALID" type="XPath">
                      <a:tst expr="../WdgDeviceMaxTimeout &lt; ." true="WdgDeviceInitialTimeout shall be not larger than WdgDeviceMaxTimeout."/>
                      <a:tst expr=" . &gt; (../WdgProcessTimeBeforeReset + ../WdgSettingsSlow/WdgRefreshTime)" false="WdgDeviceInitialTimeout shall be larger than the sum of WdgProcessTimeBeforeReset plus WdgSlowRefreshTime."/>
                    </a:da>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=65.535"/>
                      <a:tst expr="&gt;=0.0"/>
                    </a:da>
                  </v:var>
                  <v:var name="WdgNotification" type="FUNCTION-NAME">
                    <a:a name="DESC" value="EN: When the watchdog count reaches the set time (Reset time - WdgProcessTimeBeforeReset), the notification function will be called. 
                    This function mapped to the notification routine provided by some upper layer module.When the notification function is not required, close the node."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                    <a:a name="OPTIONAL" value="true"/>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="1c5cde09-2343-3237-1324-c9d734358bf2"/>
                    <a:da name="DEFAULT" value="Wdg_Notification"/>
                  </v:var>
                  <v:var name="WdgProcessTimeBeforeReset" type="FLOAT">
                    <a:a name="DESC" value="EN: This node sets the time (in seconds) between the time of notification function call and the occurrence of reset. It should not be greater than WdgDeviceMaxTimeout."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="0b391ac8-13c9-4135-aa88-02555a2fc229"/>
                    <a:da name="DEFAULT" type="XPath" expr="ecu:get('Wdg.WdgSecondIntervalTimeout')"/>
                    <a:da name="INVALID" type="XPath">
                      <a:tst expr="../WdgDeviceMaxTimeout &lt; ." true="WdgProcessTimeBeforeReset shall be not larger than WdgDeviceMaxTimeout."/>
                    </a:da>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=42.949"/>
                      <a:tst expr="&gt;=0.001"/>
                    </a:da>
                  </v:var>
                  <v:var name="WdgDefaultMode" type="ENUMERATION">
                    <a:a name="DESC" value="EN: Default mode for watchdog driver initialization.ImplementationType: WdgIf_ModeType"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="7cb1b139-452f-4591-bce5-797b8081e289"/>
                    <a:da name="DEFAULT" type="XPath" expr="ecu:get('Wdg.WdgDefaultmodeDefault')"/>
                    <a:da name="RANGE" type="XPath">
                      <a:tst expr="node:when((node:fallback(../../../WdgGeneral/WdgDisableAllowed, 'false') = 'true' and
                                              node:fallback(../WdgDeviceDisableAllowed, 'false') = 'true'),
                                            text:split('WDGIF_SLOW_MODE WDGIF_FAST_MODE WDGIF_OFF_MODE'),
                                            text:split('WDGIF_SLOW_MODE WDGIF_FAST_MODE'))" />
                    </a:da>
                  </v:var>
                  <v:lst name="WdgExternalConfiguration" type="MAP">
                    <a:da name="MIN" value="0"/>
                    <a:da name="MAX" value="1"/>
                    <a:da name="EDITABLE" value="false"/>
                    <v:ctr name="WdgExternalConfiguration" type="IDENTIFIABLE">
                      <a:a name="REQUIRES-INDEX" value="true"/>
                      <a:a name="DESC" value="EN: Configuration items for an external watchdog hardware"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                        </a:a>
                      <a:a name="UUID" value="7cb12139-452f-4591-b2e5-197b8081e289"/>
                      <v:ref name="WdgExternalContainerRef" type="CHOICE-REFERENCE">
                        <a:a name="DESC" value="EN: Reference to either"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="OPTIONAL" value="true"/>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="UUID" value="2cb12139-452f-3591-b2e5-19728081e289"/>
                        <a:da name="REF">
                          <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dio/DioConfig/DioPort/DioChannelGroup</a:v>
                          <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Spi/SpiDriver/SpiSequence</a:v>
                        </a:da>
                      </v:ref>
                    </v:ctr>
                  </v:lst>
                  <v:ctr name="WdgSettingsFast" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                        value="EN: Hardware dependent settings for the watchdog driver's 'fast' mode."/>
                    <a:a name="UUID" value="65ea042e-514a-b08c-69d3-18b3981eadfc"/>
                    <v:var name="WdgRefreshTime" type="FLOAT">
                      <a:a name="DESC" 
                          value="EN: Timeout value (sec) for Refresh Timer. Wdg driver serve the watchdog hardware by refresh timer."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                          type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:da name="DEFAULT" type="XPath" expr="ecu:get('Wdg.WdgFastModeRefreshTimeDefault')"/>
                      <a:a name="UUID" value="3739001a-be95-3014-68d1-65e2d84a3ca5"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=42.949"/>
                        <a:tst expr="&gt;0.0"/>
                      </a:da>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="(. > ../../WdgSettingsSlow/WdgRefreshTime)"
                               true="WdgSettingsFast/WdgRefreshTime must be greater than WdgSettingsSlow/WdgRefreshTime." />
                      </a:da>
                    </v:var>
                  </v:ctr>
                  <v:ctr name="WdgSettingsSlow" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                        value="EN: Hardware dependent settings for the watchdog driver's 'slow' mode."/>
                    <a:a name="UUID" value="135a045e-568a-aa8c-01d3-18b04a1e122c"/>
                    <v:var name="WdgRefreshTime" type="FLOAT">
                      <a:a name="DESC" 
                          value="EN: Timeout value (sec) for Refresh Timer. Wdg driver serve the watchdog hardware by refresh timer."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                          type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="373ec01a-ba94-3ce4-6957-65e06ed15abc"/>
                      <a:da name="DEFAULT" type="XPath" expr="ecu:get('Wdg.WdgSlowModeRefreshTimeDefault')"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=42.949"/>
                        <a:tst expr="&gt;0.0"/>
                      </a:da>
                    </v:var>
                  </v:ctr>
                  <v:ctr name="WdgSettingsOff" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                        value="EN: Hardware dependent settings for the watchdog driver's 'off' mode."/>
                    <a:a name="UUID" value="65e03bce-5daa-6e8c-6103-182ea11e52d6"/>
                  </v:ctr>
                </v:ctr>
              </v:lst>
              <v:ctr name="WdgPublishedInformation" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: Container holding all Wdg specific published information parameters"/>
                <a:a name="UUID" value="0fecf12b-a689-484e-b7c8-7ddcf5176e5b"/>
                <v:var name="WdgTriggerMode" type="ENUMERATION_LABEL">
                  <a:a name="DESC" 
                       value="EN: Watchdog trigger mode (toggle/window/both)"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PublishedInformation">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="2d9ace62-2f2c-42bd-97e5-4f101bb5b5a4"/>
                  <a:da name="DEFAULT" value="WDG_TOGGLE"/>
                  <a:da name="RANGE">
                    <a:v>WDG_BOTH</a:v>
                    <a:v>WDG_TOGGLE</a:v>
                    <a:v>WDG_WINDOW</a:v>
                  </a:da>
                </v:var>
              </v:ctr>
              <v:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
