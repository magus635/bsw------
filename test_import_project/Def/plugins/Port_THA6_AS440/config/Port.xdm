                  <a:a name="UUID" value="4583c4c8-9c08-4c99-ba63-45f067fb0b59" />
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <v:var name="PortSetPinModeApi" type="BOOLEAN">
                  <a:a name="DESC" value="EN: ECUC_Port_00132: Pre-processor switch to enable / disable the use of the function Port_SetPinMode(). &lt;br/&gt;true: Enabled - Function Port_SetPinMode() is available. &lt;br/&gt;false: Disabled - Function Port_SetPinMode() is not available." />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
