                    </v:ref>
                </v:lst>
                <v:var name="PortDevErrorDetect" type="BOOLEAN">
                  <a:a name="DESC" value="EN: ECUC_Port_00123: Switches the Default Error Tracer (Det) detection and notification ON or OFF. &lt;br/&gt;true: enabled (ON). &lt;br/&gt;false: disabled (OFF)." />
