                  <a:da name="DEFAULT" value="true" />
                </v:var>
                <v:var name="PortSetPinDirectionApi" type="BOOLEAN">
                  <a:a name="DESC" value="EN: ECUC_Port_00131: Pre-processor switch to enable / disable the use of the function Port_SetPinDirection(). &lt;br/&gt;true: Enabled - Function Port_SetPinDirection() is available. &lt;br/&gt;false: Disabled - Function Port_SetPinDirection() is notavailable." />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
