                  <a:a name="UUID" value="b2595b83-abd5-413b-a1e6-b98ce51ce71c" />
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <v:var name="PortVersionInfoApi" type="BOOLEAN">
                  <a:a name="DESC" value="EN: ECUC_Port_00133: Pre-processor switch to enable / disable the API to read out the modules version information. &lt;br/&gt;true: Version info API enabled. &lt;br/&gt;false: Version info API disabled." />
                  <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
