                </v:var>
                <v:var name="PortLvdsEnable" type="BOOLEAN">
                  <a:a name="DESC" value="EN: Pre-processor switch to enable / disable the LVDS function. &lt;br/&gt;Enable it when LVDS function used. &lt;br/&gt;true: enabled LVDS function. &lt;br/&gt;false: disabled LVDS function." />
