                        <ECUC-ENUMERATION-PARAM-DEF UUID="a5e68cdc-c945-4d42-8f87-54e086e3910c">
                          <SHORT-NAME>PortPinDriverStrength</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Parameter to  Select Driver Strength</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
