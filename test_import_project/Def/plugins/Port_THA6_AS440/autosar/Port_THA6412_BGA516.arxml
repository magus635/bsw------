                      <SHORT-NAME>PortNumber</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The number of specified Ports in this PortContainer.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
