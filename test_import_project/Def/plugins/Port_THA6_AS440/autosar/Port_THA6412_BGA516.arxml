                  <DESC>
                    <L-2 L="EN">ECUC_Port_00122: Container collecting the PortPins.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>23</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>23</UPPER-MULTIPLICITY>
                  <REQUIRES-INDEX>true</REQUIRES-INDEX>
                  <PARAMETERS>
