          <SUPPORTED-CONFIG-VARIANTS>
            <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
          </SUPPORTED-CONFIG-VARIANTS>
          <CONTAINERS>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="6dfab789-0cd4-4e89-a342-959c3830feb2">
              <SHORT-NAME>PortConfigSet</SHORT-NAME>
              <DESC>
                <L-2 L="EN">ECUC_Port_00121: This container contains the configuration parameters and sub containers of the AUTOSAR Port module.</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
