<?xml version='1.0'?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00046.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE UUID="ECUC:AUTOSAR">
      <SHORT-NAME>THA6_AS440_FuSa</SHORT-NAME>
      <ELEMENTS>
        <ECUC-DEFINITION-COLLECTION UUID="01f19997-ea6e-e513-bf82-bfab416d21a0">
          <SHORT-NAME>Intc_EcuParameterDefinition</SHORT-NAME>
          <MODULE-REFS>
            <MODULE-REF DEST="ECUC-MODULE-DEF">/THA6_AS440_FuSa/Intc</MODULE-REF>
          </MODULE-REFS>
        </ECUC-DEFINITION-COLLECTION>
        <ECUC-MODULE-DEF UUID="326109f4-7397-11ec-8934-f889d2d2ec8e">
          <SHORT-NAME>Intc</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Configuration of the Intc (Interrupt controller) module.</L-2>
          </DESC>
          <ADMIN-DATA>
            <DOC-REVISIONS>
              <DOC-REVISION>
                <REVISION-LABEL>4.4.0</REVISION-LABEL>
                <ISSUED-BY>AUTOSAR</ISSUED-BY>
              </DOC-REVISION>
            </DOC-REVISIONS>
          </ADMIN-DATA>
          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
          <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
          <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
          <SUPPORTED-CONFIG-VARIANTS>
            <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
          </SUPPORTED-CONFIG-VARIANTS>
          <CONTAINERS>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ecb69da8-740c-11ec-bbe1-f889d2d2ec8e">
              <SHORT-NAME>IntcGeneral</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Module wide configuration parameters of the PORT driver.</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-BOOLEAN-PARAM-DEF UUID="df98e78c-740c-11ec-b2b3-f889d2d2ec8e">
                  <SHORT-NAME>IntcDevErrorDetect</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Switches the Default Error Tracer (Det) detection and                      notification ON or OFF.&lt;br/&gt;                     true: enabled (ON). &lt;br/&gt;                     false: disabled (OFF).</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>ChipowerTech</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                  <VALUE-CONFIG-CLASSES>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                  </VALUE-CONFIG-CLASSES>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="2ff4becc-7412-11ec-9233-f889d2d2ec8e">
                  <SHORT-NAME>IntcVersionInfoApi</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Pre-processor switch to enable / disable the API to read out                      the modules version information. &lt;br/&gt;                     true: Version info API enabled. &lt;br/&gt;                     false: Version info API disabled.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>ChipowerTech</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                  <VALUE-CONFIG-CLASSES>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                  </VALUE-CONFIG-CLASSES>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="6a20b829-0388-11ee-9fd6-f889d2d2ae74">
                  <SHORT-NAME>IntcFIQPriorityBinaryPoint</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Defines the point of FIQ at which the priority value fields split into two parts, the group priority field and the subpriority field.                                The group priority field determines FIQ interrupt preemption.&lt;br/&gt;                      - 2: [group priority range is 0~31], [subpriority is  None] &lt;br/&gt;                      - 3: [group priority range is 0~15], [subpriority range is  0~1] &lt;br/&gt;                      - 4: [group priority range is  0~7], [subpriority range is  0~3] &lt;br/&gt;                      - 5: [group priority range is  0~3], [subpriority range is  0~7] &lt;br/&gt;                      - 6: [group priority range is  0~1], [subpriority range is  0~15] &lt;br/&gt;                      - 7: [group priority range is  None], [subpriority range is  0~31]: In this case, Interrupt preemption is not supported &lt;br/&gt;                     &lt;h1&gt;Note&lt;/h1&gt;                     Detail refer to GIC register &apos;ICC_BPR0&apos; in &lt;i&gt;Arm Cortex-R52 Processor Technical Reference Manual&lt;/i&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>ChipowerTech</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                  <VALUE-CONFIG-CLASSES>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                  </VALUE-CONFIG-CLASSES>
                  <DEFAULT-VALUE>2</DEFAULT-VALUE>
                  <MAX>7</MAX>
                  <MIN>2</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="1fce3438-0401-11ee-aaf1-f889d2d2ae74">
                  <SHORT-NAME>IntcIRQPriorityBinaryPoint</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Defines the point of IRQ at which the priority value fields split into two parts, the group priority field and the subpriority field.                               The group priority field determines IRQ interrupt preemption.&lt;br/&gt;                      - 3: [group priority range is  0~31], [subpriority is  None] &lt;br/&gt;                      - 4: [group priority range is  0~15], [subpriority range is  0~1] &lt;br/&gt;                      - 5: [group priority range is  0~7], [subpriority range is  0~3] &lt;br/&gt;                      - 6: [group priority range is  0~3], [subpriority range is  0~7] &lt;br/&gt;                      - 7: [group priority range is  0~1], [subpriority range is  0~15] &lt;br/&gt;                     &lt;h1&gt;Note&lt;/h1&gt;                     Detail refer to GIC register &apos;ICC_BPR1&apos; in &lt;i&gt;Arm Cortex-R52 Processor Technical Reference Manual&lt;/i&gt;</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>ChipowerTech</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                  <VALUE-CONFIG-CLASSES>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                  </VALUE-CONFIG-CLASSES>
                  <DEFAULT-VALUE>3</DEFAULT-VALUE>
                  <MAX>7</MAX>
                  <MIN>3</MIN>
                </ECUC-INTEGER-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="2fc7a1ae-feb7-11ed-b138-f889d2d2ae74">
              <SHORT-NAME>IntcConfigSet</SHORT-NAME>
              <DESC>
                <L-2 L="EN">This container contains the configuration parameters and sub containers of the Intc module.</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <SUB-CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="2ee8f68e-feb8-11ed-9028-f889d2d2ae74">
                  <SHORT-NAME>IntcContainer</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Container collecting the interrupt srouces.                         &lt;h1&gt;Note&lt;/h1&gt;                         Interrupt details refer to chip UM &quot;TMC_THA6206_UserManua&quot; -&gt; Appendix A Interrupt Vector Table.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>30</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>30</UPPER-MULTIPLICITY>
                  <REQUIRES-INDEX>true</REQUIRES-INDEX>
                  <PARAMETERS>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="a7cf0b9c-feba-11ed-a920-f889d2d2ae75">
                      <SHORT-NAME>IntcIntSrcClass</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Interrupt source classification.&lt;br/&gt;                             &lt;h1&gt;Note&lt;/h1&gt;                             Prohibit manual modification of this value.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>ChipowerTech</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>GIC_SGI</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>GIC_SGI</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>GIC_PPI</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CPUWDT</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>SAFEWDT</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>CLUSTER</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>RCC</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>PWRC</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>INTC_SOFTINT</SHORT-NAME>
                          <ORIGIN>ChipowerTech</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF>
                          <SHORT-NAME>SAC</SHORT-NAME>
