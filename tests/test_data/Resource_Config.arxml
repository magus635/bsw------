<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ResourceConfig</SHORT-NAME>
      <ELEMENTS>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>Resource</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/Resource</DEFINITION-REF>
          <CONTAINERS>
            <!-- General Configuration -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ResourceGeneral</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Resource/ResourceGeneral</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceGeneral/NumOfCores</DEFINITION-REF>
                  <VALUE>4</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>
            <!-- Core Configuration Set -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ResourceCoreConfigSet</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet</DEFINITION-REF>
              <SUB-CONTAINERS>
                <!-- CORE0 Configuration -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>ResourceCoreConfig_0</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceCoreId</DEFINITION-REF>
                      <VALUE>CORE0</VALUE>
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceCoreEnable</DEFINITION-REF>
                      <VALUE>true</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                  <SUB-CONTAINERS>
                    <!-- CAN Controller allocation to CORE0 -->
                    <!-- Add ResourceAllocation entries here when you have CAN controllers configured -->
                    <!-- Example:
                    <ECUC-CONTAINER-VALUE>
                      <SHORT-NAME>ResourceAllocation_CAN_0</SHORT-NAME>
                      <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceAllocation</DEFINITION-REF>
                      <PARAMETER-VALUES>
                        <ECUC-TEXTUAL-PARAM-VALUE>
                          <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceAllocation/ResourceModule</DEFINITION-REF>
                          <VALUE>CAN</VALUE>
                        </ECUC-TEXTUAL-PARAM-VALUE>
                      </PARAMETER-VALUES>
                      <REFERENCE-VALUES>
                        <ECUC-REFERENCE-VALUE>
                          <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceAllocation/ResourceModuleRef</DEFINITION-REF>
                          <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/CanConfig/Can/CanConfigSet/CanController_0</VALUE-REF>
                        </ECUC-REFERENCE-VALUE>
                      </REFERENCE-VALUES>
                    </ECUC-CONTAINER-VALUE>
                    -->
                  </SUB-CONTAINERS>
                </ECUC-CONTAINER-VALUE>
                <!-- CORE1 Configuration -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>ResourceCoreConfig_1</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceCoreId</DEFINITION-REF>
                      <VALUE>CORE1</VALUE>
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceCoreEnable</DEFINITION-REF>
                      <VALUE>true</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                  <SUB-CONTAINERS>
                  </SUB-CONTAINERS>
                </ECUC-CONTAINER-VALUE>
                <!-- CORE2 Configuration -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>ResourceCoreConfig_2</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceCoreId</DEFINITION-REF>
                      <VALUE>CORE2</VALUE>
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceCoreEnable</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                  <SUB-CONTAINERS>
                  </SUB-CONTAINERS>
                </ECUC-CONTAINER-VALUE>
                <!-- CORE3 Configuration -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>ResourceCoreConfig_3</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceCoreId</DEFINITION-REF>
                      <VALUE>CORE3</VALUE>
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR/EcucDefs/Resource/ResourceCoreConfigSet/ResourceCoreConfig/ResourceCoreEnable</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                  <SUB-CONTAINERS>
                  </SUB-CONTAINERS>
                </ECUC-CONTAINER-VALUE>
              </SUB-CONTAINERS>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
