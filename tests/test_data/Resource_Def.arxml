<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>EcucDefs</SHORT-NAME>
          <ELEMENTS>
            <ECUC-MODULE-DEF>
              <SHORT-NAME>Resource</SHORT-NAME>
              <DESC><L-2 L="EN">Resource Manager Module for Multi-Core Resource Allocation</L-2></DESC>
              <CONTAINERS>
                <!-- ResourceCoreConfigSet Container -->
                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>ResourceCoreConfigSet</SHORT-NAME>
                  <DESC><L-2 L="EN">Container for core configuration set</L-2></DESC>
                  <SUB-CONTAINERS>
                    <!-- ResourceCoreConfig - one per core -->
                    <ECUC-PARAM-CONF-CONTAINER-DEF>
                      <SHORT-NAME>ResourceCoreConfig</SHORT-NAME>
                      <DESC><L-2 L="EN">Configuration for a single core</L-2></DESC>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                      <PARAMETERS>
                        <!-- ResourceCoreId -->
                        <ECUC-STRING-PARAM-DEF>
                          <SHORT-NAME>ResourceCoreId</SHORT-NAME>
                          <DESC><L-2 L="EN">Identifier of the core (e.g., CORE0, CORE1)</L-2></DESC>
                          <DEFAULT-VALUE>CORE0</DEFAULT-VALUE>
                        </ECUC-STRING-PARAM-DEF>
                        <!-- ResourceCoreEnable -->
                        <ECUC-BOOLEAN-PARAM-DEF>
                          <SHORT-NAME>ResourceCoreEnable</SHORT-NAME>
                          <DESC><L-2 L="EN">Enable or disable this core</L-2></DESC>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
                        <!-- ResourceAllocation - module to core mapping -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF>
                          <SHORT-NAME>ResourceAllocation</SHORT-NAME>
                          <DESC><L-2 L="EN">Allocation of a module resource to this core</L-2></DESC>
                          <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                          <PARAMETERS>
                            <!-- ResourceModule -->
                            <ECUC-STRING-PARAM-DEF>
                              <SHORT-NAME>ResourceModule</SHORT-NAME>
                              <DESC><L-2 L="EN">Name of the module (e.g., CAN, SPI, ADC)</L-2></DESC>
                              <DEFAULT-VALUE>CAN</DEFAULT-VALUE>
                            </ECUC-STRING-PARAM-DEF>
                          </PARAMETERS>
                          <REFERENCES>
                            <!-- ResourceModuleRef - reference to specific module instance -->
                            <ECUC-REFERENCE-DEF>
                              <SHORT-NAME>ResourceModuleRef</SHORT-NAME>
                              <DESC><L-2 L="EN">Reference to the specific module instance (e.g., CanController)</L-2></DESC>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Can/CanConfigSet/CanController</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                          </REFERENCES>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                  </SUB-CONTAINERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <!-- ResourceGeneral Container -->
                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>ResourceGeneral</SHORT-NAME>
                  <DESC><L-2 L="EN">General resource configuration</L-2></DESC>
                  <PARAMETERS>
                    <!-- NumOfCores -->
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>NumOfCores</SHORT-NAME>
                      <DESC><L-2 L="EN">Total number of cores available in the MCU</L-2></DESC>
                      <DEFAULT-VALUE>4</DEFAULT-VALUE>
                      <MIN>1</MIN>
                      <MAX>8</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </CONTAINERS>
            </ECUC-MODULE-DEF>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
