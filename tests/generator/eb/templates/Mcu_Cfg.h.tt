#define MCU_CLOCK_SETTING_COUNT     ([!"$ClockCount"!]U)

[!LOOP McuClockSettingConfig/*!]
/* Clock Setting [!"node:name(.)"!] */
#define MCU_CLOCK_[!"num:i(@index)"!]_FREQ     ([!"node:value(McuClockSettingFrequency)"!]U)
[!ENDLOOP!]
[!ELSE!]
