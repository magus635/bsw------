<?xml version="1.0" encoding="UTF-8"?>
<!--
  Arti_ParamDef.arxml: ECUC parameter definition of the AUTOSAR "Arti" module.

  Source : AUTOSAR CP R24-11, SWS ARTI (Document ID 923), chapter 10.
           Every container/parameter carries its ECUC_Arti_xxxxx id in a comment.
  Scope  : ArtiGeneric and ArtiValues only (fully specified in SWS ARTI).
  NOT included on purpose:
    - ArtiHardware, ArtiOs  : specified in SWS_OS, chapter "Containers and
                              configuration parameters for ARTI" (not in this repo).
    - ArtiRte               : filled by the RTE generator, not part of the OS delivery.
  Known gap: ArtiParameterTypeMapPairOutputRef (ECUC_Arti_00027) also allows
    ArtiOsTaskInstance, ArtiOsIsrInstance, ArtiOsContextInstance, ArtiOsStackInstance
    and OsAppMode as destinations. Those are defined in SWS_OS; add them once
    that chapter has been checked.
  Generated by scratchpad/gen_arti_def.py; edit the generator, not this file.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00046.xsd">
