<?xml version="1.0" encoding="UTF-8"?>
<!--
  Arti_ParamDef.arxml: ECUC parameter definition of the AUTOSAR "Arti" module.

  Source : AUTOSAR CP R24-11, SWS ARTI (Document ID 923), chapter 10.
           Every container/parameter carries its ECUC_Arti_xxxxx id in a comment.
  Scope  : ArtiGeneric, ArtiValues (SWS ARTI R24-11 chapter 10) and
           ArtiHardware, ArtiOs (SWS OS R21-11 section 10.4, which is where
           those two containers are specified).
  NOT included on purpose: ArtiRte (filled by the RTE generator, not part of
           the OS delivery).
  Notes  : Descriptions are shortened from the specifications.
           The path of EcucCoreDefinition (ArtiHardwareCoreInstanceEcucCoreRef)
           is not given by SWS OS; the standard EcuC module path
           /AUTOSAR/EcucDefs/EcuC/EcucHardware/EcucCoreDefinition is used.
           Multiplicities, configuration classes, post-build flags and scopes
           come from the PDF tables (tools/arti/arti_spec.json, extracted by
           tools/arti/extract_arti_spec.py); generation fails if a multiplicity
           written in the generator disagrees with them.
  Validated against doc/ARTI/AUTOSAR_00047.xsd.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00047.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>EcucDefs</SHORT-NAME>
          <ELEMENTS>
            <ECUC-MODULE-DEF>
              <SHORT-NAME>Arti</SHORT-NAME>
              <DESC>
                <L-2 L="EN">The Arti Module serves as a superordinate container collecting all information and parameters concerning ARTI.</L-2>
              </DESC>
              <!-- ECUC_Arti_00001 -->
              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>
              <SUPPORTED-CONFIG-VARIANTS>
                <SUPPORTED-CONFIG-VARIANT>VARIANT-LINK-TIME</SUPPORTED-CONFIG-VARIANT>
                <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
                <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
              </SUPPORTED-CONFIG-VARIANTS>
              <CONTAINERS>
          <ECUC-PARAM-CONF-CONTAINER-DEF>
            <SHORT-NAME>ArtiGeneric</SHORT-NAME>
            <DESC>
              <L-2 L="EN">The ArtiGeneric container contains definitions for generic objects, i.e. not belonging to a standard AUTOSAR module.</L-2>
            </DESC>
            <!-- ECUC_Arti_00042 -->
            <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
            <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
            <MULTIPLICITY-CONFIG-CLASSES>
              <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
              </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
              <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
              </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
              <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
              </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
            </MULTIPLICITY-CONFIG-CLASSES>
            <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
            <REQUIRES-INDEX>false</REQUIRES-INDEX>
            <SUB-CONTAINERS>
              <ECUC-PARAM-CONF-CONTAINER-DEF>
                <SHORT-NAME>ArtiGenericComponentClass</SHORT-NAME>
                <DESC>
                  <L-2 L="EN">The class definition describes the layout of the object (similar to a "class" definition in C++).</L-2>
                </DESC>
                <!-- ECUC_Arti_00043 -->
                <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                <MULTIPLICITY-CONFIG-CLASSES>
                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                    <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                    <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                    <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                </MULTIPLICITY-CONFIG-CLASSES>
                <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                <REQUIRES-INDEX>false</REQUIRES-INDEX>
                <PARAMETERS>
                  <ECUC-STRING-PARAM-DEF>
                    <SHORT-NAME>ArtiGenericComponentClassName</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Name of the class.</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00044 -->
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <SCOPE>ECU</SCOPE>
                    <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                    <VALUE-CONFIG-CLASSES>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                    </VALUE-CONFIG-CLASSES>
                  </ECUC-STRING-PARAM-DEF>
                </PARAMETERS>
                <SUB-CONTAINERS>
                  <ECUC-PARAM-CONF-CONTAINER-DEF>
                    <SHORT-NAME>ArtiGenericComponentClassParameter</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Parameter definition of a class.</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00045 -->
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                    <MULTIPLICITY-CONFIG-CLASSES>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    </MULTIPLICITY-CONFIG-CLASSES>
                    <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                    <REQUIRES-INDEX>false</REQUIRES-INDEX>
                    <PARAMETERS>
                      <ECUC-STRING-PARAM-DEF>
                        <SHORT-NAME>ArtiGenericComponentClassParameterName</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">Name of the parameter.</L-2>
                        </DESC>
                        <!-- ECUC_Arti_00046 -->
                        <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <SCOPE>ECU</SCOPE>
                        <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                        <VALUE-CONFIG-CLASSES>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                        </VALUE-CONFIG-CLASSES>
                      </ECUC-STRING-PARAM-DEF>
                    </PARAMETERS>
                    <REFERENCES>
                      <ECUC-REFERENCE-DEF>
                        <SHORT-NAME>ArtiGenericComponentClassParameterTypeMapRef</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">Refers to a parameter type to interpret the parameter value.</L-2>
                        </DESC>
                        <!-- ECUC_Arti_00053 -->
                        <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <SCOPE>ECU</SCOPE>
                        <MULTIPLICITY-CONFIG-CLASSES>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        </MULTIPLICITY-CONFIG-CLASSES>
                        <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                        <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                        <VALUE-CONFIG-CLASSES>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                        </VALUE-CONFIG-CLASSES>
                        <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Arti/ArtiValues/ArtiParameterTypeMap</DESTINATION-REF>
                      </ECUC-REFERENCE-DEF>
                    </REFERENCES>
                  </ECUC-PARAM-CONF-CONTAINER-DEF>
                </SUB-CONTAINERS>
              </ECUC-PARAM-CONF-CONTAINER-DEF>
              <ECUC-PARAM-CONF-CONTAINER-DEF>
                <SHORT-NAME>ArtiGenericComponentInstance</SHORT-NAME>
                <DESC>
                  <L-2 L="EN">The instance definition describes a specific instantiated object.</L-2>
                </DESC>
                <!-- ECUC_Arti_00049 -->
                <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                <MULTIPLICITY-CONFIG-CLASSES>
                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                    <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                    <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                    <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                </MULTIPLICITY-CONFIG-CLASSES>
                <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                <REQUIRES-INDEX>false</REQUIRES-INDEX>
                <PARAMETERS>
                  <ECUC-STRING-PARAM-DEF>
                    <SHORT-NAME>ArtiGenericComponentInstanceName</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Name of the instance.</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00050 -->
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <SCOPE>ECU</SCOPE>
                    <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                    <VALUE-CONFIG-CLASSES>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                    </VALUE-CONFIG-CLASSES>
                  </ECUC-STRING-PARAM-DEF>
                </PARAMETERS>
                <REFERENCES>
                  <ECUC-REFERENCE-DEF>
                    <SHORT-NAME>ArtiGenericComponentInstanceClassRef</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Refers to a ArtGenericClass of which this object is instantiated.</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00048 -->
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <SCOPE>ECU</SCOPE>
                    <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                    <VALUE-CONFIG-CLASSES>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                    </VALUE-CONFIG-CLASSES>
                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Arti/ArtiGeneric/ArtiGenericComponentClass</DESTINATION-REF>
                  </ECUC-REFERENCE-DEF>
                </REFERENCES>
                <SUB-CONTAINERS>
                  <ECUC-PARAM-CONF-CONTAINER-DEF>
                    <SHORT-NAME>ArtiGenericComponentInstanceParameter</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Parameter definition of an instance.</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00051 -->
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                    <MULTIPLICITY-CONFIG-CLASSES>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    </MULTIPLICITY-CONFIG-CLASSES>
                    <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                    <REQUIRES-INDEX>false</REQUIRES-INDEX>
                    <REFERENCES>
                      <ECUC-REFERENCE-DEF>
                        <SHORT-NAME>ArtiGenericComponentInstanceParameterClassParameterRef</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">Refers to an ArtiGenericComponentClassParameter that defines this parameter.</L-2>
                        </DESC>
                        <!-- ECUC_Arti_00047 -->
                        <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                        <SCOPE>ECU</SCOPE>
                        <MULTIPLICITY-CONFIG-CLASSES>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        </MULTIPLICITY-CONFIG-CLASSES>
                        <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                        <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                        <VALUE-CONFIG-CLASSES>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                        </VALUE-CONFIG-CLASSES>
                        <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Arti/ArtiGeneric/ArtiGenericComponentClass/ArtiGenericComponentClassParameter</DESTINATION-REF>
                      </ECUC-REFERENCE-DEF>
                      <ECUC-REFERENCE-DEF>
                        <SHORT-NAME>ArtiGenericComponentInstanceParameterConstantRef</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">Refers to an ArtiConstant that represents the value of this parameter.</L-2>
                        </DESC>
                        <!-- ECUC_Arti_00040 -->
                        <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <SCOPE>ECU</SCOPE>
                        <MULTIPLICITY-CONFIG-CLASSES>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        </MULTIPLICITY-CONFIG-CLASSES>
                        <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                        <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                        <VALUE-CONFIG-CLASSES>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                        </VALUE-CONFIG-CLASSES>
                        <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Arti/ArtiValues/ArtiConstant</DESTINATION-REF>
                      </ECUC-REFERENCE-DEF>
                      <ECUC-REFERENCE-DEF>
                        <SHORT-NAME>ArtiGenericComponentInstanceParameterExpressionRef</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">Refers to an ArtiExpression that evaluates the value of this parameter.</L-2>
                        </DESC>
                        <!-- ECUC_Arti_00041 -->
                        <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <SCOPE>ECU</SCOPE>
                        <MULTIPLICITY-CONFIG-CLASSES>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        </MULTIPLICITY-CONFIG-CLASSES>
