                <DESC>
                  <L-2 L="EN">This container contains all states of tasks, isrs... that the EcuC uses.</L-2>
                </DESC>
                <!-- ECUC_Arti_00029 -->
                <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                <MULTIPLICITY-CONFIG-CLASSES>
                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                    <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                    <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                    <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                </MULTIPLICITY-CONFIG-CLASSES>
                <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                <REQUIRES-INDEX>false</REQUIRES-INDEX>
                <PARAMETERS>
                  <ECUC-BOOLEAN-PARAM-DEF>
                    <SHORT-NAME>ArtiStatesTaskEnhanced</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Set to true, if the OS provides an "enhanced" state model with "READY" split to "Activated", "Preempted", "Released".</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00032 -->
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <SCOPE>LOCAL</SCOPE>
                    <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                    <VALUE-CONFIG-CLASSES>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                      <ECUC-VALUE-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-VALUE-CONFIGURATION-CLASS>
                    </VALUE-CONFIG-CLASSES>
                  </ECUC-BOOLEAN-PARAM-DEF>
                </PARAMETERS>
                <SUB-CONTAINERS>
                  <ECUC-PARAM-CONF-CONTAINER-DEF>
                    <SHORT-NAME>ArtiStatesScheduleTableState</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Each state used by the OsScheduleTable has to be listed as ArtiStatesScheduleTableState parameter with a choice of the states.</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00205 -->
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                    <MULTIPLICITY-CONFIG-CLASSES>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    </MULTIPLICITY-CONFIG-CLASSES>
                    <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                    <REQUIRES-INDEX>false</REQUIRES-INDEX>
                    <PARAMETERS>
                      <ECUC-ENUMERATION-PARAM-DEF>
                        <SHORT-NAME>ArtiStatesScheduleTableStateEnum</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">ArtiStatesScheduleTableState choice of the states.</L-2>
                        </DESC>
                        <!-- ECUC_Arti_00206 -->
                        <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <SCOPE>LOCAL</SCOPE>
                        <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                        <VALUE-CONFIG-CLASSES>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                        </VALUE-CONFIG-CLASSES>
                        <LITERALS>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiScheduleTableStateNext</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiScheduleTableStateRunning</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiScheduleTableStateRunningAndSynchronous</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiScheduleTableStateStopped</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiScheduleTableStateWaiting</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                        </LITERALS>
                      </ECUC-ENUMERATION-PARAM-DEF>
                    </PARAMETERS>
                  </ECUC-PARAM-CONF-CONTAINER-DEF>
                  <ECUC-PARAM-CONF-CONTAINER-DEF>
                    <SHORT-NAME>ArtiStatesSpinlockOwnerType</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Each owner type used by the OsSpinlock has to be listed as ArtiStatesSpinlockOwnerType parameter with a choice of the states.</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00207 -->
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                    <MULTIPLICITY-CONFIG-CLASSES>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    </MULTIPLICITY-CONFIG-CLASSES>
                    <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                    <REQUIRES-INDEX>false</REQUIRES-INDEX>
                    <PARAMETERS>
                      <ECUC-ENUMERATION-PARAM-DEF>
                        <SHORT-NAME>ArtiStatesSpinlockOwnerTypeEnum</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">ArtiStatesSpinlockOwnerType choice of the states.</L-2>
                        </DESC>
                        <!-- ECUC_Arti_00208 -->
                        <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <SCOPE>LOCAL</SCOPE>
                        <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                        <VALUE-CONFIG-CLASSES>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                        </VALUE-CONFIG-CLASSES>
                        <LITERALS>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiSpinlockOwnerTypeIsr2</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiSpinlockOwnerTypeTask</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                        </LITERALS>
                      </ECUC-ENUMERATION-PARAM-DEF>
                    </PARAMETERS>
                  </ECUC-PARAM-CONF-CONTAINER-DEF>
                  <ECUC-PARAM-CONF-CONTAINER-DEF>
                    <SHORT-NAME>ArtiStatesSpinlockState</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Each state used by the OsSpinlock has to be listed as ArtiStatesSpinlockState parameter with a choice of the states.</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00209 -->
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                    <MULTIPLICITY-CONFIG-CLASSES>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    </MULTIPLICITY-CONFIG-CLASSES>
                    <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                    <REQUIRES-INDEX>false</REQUIRES-INDEX>
                    <PARAMETERS>
                      <ECUC-ENUMERATION-PARAM-DEF>
                        <SHORT-NAME>ArtiStatesSpinlockStateEnum</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">ArtiStatesSpinlockState choice of the states.</L-2>
                        </DESC>
                        <!-- ECUC_Arti_00210 -->
                        <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <SCOPE>LOCAL</SCOPE>
                        <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                        <VALUE-CONFIG-CLASSES>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                        </VALUE-CONFIG-CLASSES>
                        <LITERALS>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiSpinlockStateLocked</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiSpinlockStateUnlocked</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                        </LITERALS>
                      </ECUC-ENUMERATION-PARAM-DEF>
                    </PARAMETERS>
                  </ECUC-PARAM-CONF-CONTAINER-DEF>
                  <ECUC-PARAM-CONF-CONTAINER-DEF>
                    <SHORT-NAME>ArtiStatesTaskState</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Each state used by the OS has to be listed as ArtiStatesTaskState Parameter with a choice of the states.</L-2>
                    </DESC>
                    <!-- ECUC_Arti_00030 -->
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                    <MULTIPLICITY-CONFIG-CLASSES>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                    </MULTIPLICITY-CONFIG-CLASSES>
                    <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                    <REQUIRES-INDEX>false</REQUIRES-INDEX>
                    <PARAMETERS>
                      <ECUC-ENUMERATION-PARAM-DEF>
                        <SHORT-NAME>ArtiStatesTaskStateEnum</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">ArtiStatesTaskState choice of the states.</L-2>
                        </DESC>
                        <!-- ECUC_Arti_00033 -->
                        <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <SCOPE>LOCAL</SCOPE>
                        <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                        <VALUE-CONFIG-CLASSES>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                          <ECUC-VALUE-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-VALUE-CONFIGURATION-CLASS>
                        </VALUE-CONFIG-CLASSES>
                        <LITERALS>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiTaskStateActivated</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiTaskStatePreempted</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiTaskStateReady</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiTaskStateReleased</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiTaskStateRunning</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiTaskStateSuspended</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                          <ECUC-ENUMERATION-LITERAL-DEF>
                            <SHORT-NAME>ArtiTaskStateWaiting</SHORT-NAME>
                          </ECUC-ENUMERATION-LITERAL-DEF>
                        </LITERALS>
                      </ECUC-ENUMERATION-PARAM-DEF>
                    </PARAMETERS>
                  </ECUC-PARAM-CONF-CONTAINER-DEF>
                </SUB-CONTAINERS>
              </ECUC-PARAM-CONF-CONTAINER-DEF>
            </SUB-CONTAINERS>
          </ECUC-PARAM-CONF-CONTAINER-DEF>
              </CONTAINERS>
            </ECUC-MODULE-DEF>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
