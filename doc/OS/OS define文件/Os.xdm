                              <a:tst expr="&gt;=0"/>
                         </a:da>
                    </v:var>
               
                    <v:var name="Core1StackAlign" type="ENUMERATION">
                         <a:a name="DESC" 
                              value="EN: The align of Memory block."/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:da name="ENABLE" type="XPath">
                              <a:tst expr="node:ref(../Core0MemoryRegionRef)/MemoryRegionCopy != 'ALL'"/>
                         </a:da>
                         <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                         <a:a name="SCOPE" value="LOCAL"/>
                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                         <a:a name="UUID" 
                              value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                         <a:a name="DEFAULT" value="NON"/>
                         <a:da name="RANGE">
                              <a:v>NON</a:v>
                              <a:v>128</a:v>
                              <a:v>64</a:v>
                              <a:v>32</a:v>
                              <a:v>16</a:v>
                              <a:v>8</a:v>
                         </a:da>
                    </v:var>
               
                    <v:ref name="Core1MemoryRegionRef" type="REFERENCE">
                          <a:a name="DESC" 
                               value="EN: Memory Block that reference to a specific ."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:da name="ENABLE" type="XPath">
                              <a:tst expr="node:ref(../Core0MemoryRegionRef)/MemoryRegionCopy != 'ALL'"/>
                         </a:da>
                          <a:a name="UUID" 
                              value="8f6720b9-f794-4c7e-a36a-806e0a5864ce"/>
                              <a:da name="REF" 
                                   value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/MemoryRegion"/>
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="node:ref(.)/MemoryRegionAttribute = 'FLASH' or text:contains(node:name(node:ref(.)), 'GMU')"
                                   true = "FLASH or GMU region could not be Stack"/>
                              <a:tst expr="text:contains(node:name(node:ref(.)), '0')"
                                   true = "Could not use CPU from another core"/>
                              <a:tst expr="node:ref(../Core1MemoryRegionRef)/MemoryRegionCopy = 'ALL'"
                                   true = "Could not use data copy region"/>
                         </a:da>
                    </v:ref>
                    
               </v:ctr>
           
           
          </v:ctr>
          <v:lst name="OsMemoryMap" type="MAP">
               <a:a name="UUID" 
               value="6feba224-f010-4914-8cd6-19d9c82de9d7"/>
               <a:da name="ENABLE" type="XPath" 
               expr="node:value(./../OsResourceSubderivative) = 'Os_THA6206'"
               true="true" false="false"/>
              <v:ctr name="OsMemoryMap" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: Memory Block indicate the data block in the memory Region."/>
                <a:a name="UUID" value="fc22fa0f-29d3-4d47-b793-34bbbc83ac1f"/>
               <v:ref name="MemorySectionMatch" type="REFERENCE">
                    <a:a name="DESC" 
                         value="EN: Memory Block that reference to a specific ."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" 
                         value="8f6720b9-f794-4c7e-a36a-806e0a5864ce"/>
                         <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/MemorySection"/>
               </v:ref>
              </v:ctr>
            </v:lst>
              <d:ref type="REFINED_MODULE_DEF" 
                     value="ASPath:/AUTOSAR/EcucDefs/Os"/>
            </v:ctr>
          </d:chc>
          <d:chc name="myEcuParameterDefinition" type="AR-ELEMENT" 
                 value="ECU_PARAMETER_DEFINITION">
            <d:ctr type="AR-ELEMENT">
              <a:a name="DEF" 
                   value="ASPath:/AR_PACKAGE_SCHEMA/ECU_PARAMETER_DEFINITION"/>
              <d:lst name="MODULE_REF">
                <d:ref type="MODULE_REF" value="ASPath:/OS/Os"/>
              </d:lst>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
