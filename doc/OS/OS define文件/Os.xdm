<?xml version="1.0"?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" 
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="THA6_ASR21" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:AUTOSAR"/>
        <d:lst type="ELEMENTS">
          <d:chc name="Os" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.7.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                      <ad:DATE>2014-10-31</ad:DATE>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC" 
                   value="EN: Configuration of the Os (Operating System) module."/>
              <a:a name="LOWER-MULTIPLICITY" value="1"/>
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
              <a:a name="RELEASE" value="asc:4.7.0"/>
              <a:a name="UPPER-MULTIPLICITY" value="1"/>
              <a:a name="UUID" value="7caf756e-f14d-4438-850e-8138e655161b"/>
              <v:var name="POST_BUILD_VARIANT_USED" type="BOOLEAN">
                <a:a name="DESC" 
                     value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
                <a:a name="LABEL" value="Post Build Variant Used"/>
                <a:a name="ORIGIN" value="EB"/>
                <a:a name="POSTBUILDVARIANTVALUE" value="false"/>
                <a:a name="UUID" value="959179b5-fcd2-4203-9745-86fae77d6b76"/>
                <a:da name="DEFAULT" value="false"/>
                <a:da name="READONLY" value="TRUE"/>
                <a:da name="TOOLTIP" 
                      value="Indicates whether a module implementation has or plans to have (i.e., introduced at link or post-build time) new post-build variation points."/>
              </v:var>
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="LABEL" value="Config Variant"/>
                <a:a name="UUID" value="71cac65e-98ad-4dd4-9284-b78ebdbd1062"/>
                <a:da name="DEFAULT" value="VariantPreCompile"/>
                <a:da name="RANGE" value="VariantPreCompile"/>
              </v:var>
              
               <v:var name="OsResourceSubderivative" type="ENUMERATION">
                    <a:a name="DESC">
                    <a:v><![CDATA[EN:<html> Sub-derivative selector for the current platform.</html>]]>
                    </a:v>
                    </a:a>
                    <a:a name="ORIGIN" value="ChipowerTech" />
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="0aa5bac4-de79-4565-8120-830dc23e3679" />
                    <a:da name="DEFAULT" value="Os_THA6206" />
                    <a:da name="RANGE">
                    <a:v>Os_THA6206</a:v>
                    <a:v>Os_THA6412</a:v>
                    <a:v>Os_SC300</a:v>
                    </a:da>
               </v:var>

               <v:lst name="OsCoreIdMappingConfig" type="MAP">
                  <a:da name="MIN" value="1"/>    
                  <a:da name="MAX" type="XPath" expr="ecu:get('OsResource.NumOfCores')" />    
                  <a:a name="DESC" 
                       value="EN: List the CoreId Configuration for Application to map."/>
                  <a:a name="UUID" 
                         value="9257CAE9-9D97-4FA2-8DBB-C06FF608C870"/>
                  <v:ctr name="OsCoreIdMappingConfig" type="IDENTIFIABLE">
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="UUID" 
                         value="F91D29D3-17E4-4A05-AD36-D8F521B728D0"/>
                    <v:ref name="OsCoreId" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to the Core Definition in the Ecuc Module where the CoreId is defined. This reference is used to describe to which Core the OsApplication is bound."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompInvaildile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="8f6720b9-f794-4c7e-a36a-806e0a5864ce"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucHardware/EcucCoreDefinition"/>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="(num:i(../@index) = num:i(0)) and (num:i(node:ref(.)/EcucCoreId) != num:i(0))"
                               true = "The reference to the Core Definition is not allowed start don't from 0"/>
                      </a:da>
                    </v:ref>

                    <v:ref name="OsKernelApplication" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to the OsApplication in the Ecuc Module where the OsApplication is defined. This reference is used to describe to which OsApplication the CoreId is bound."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="8f6721c9-f794-4c7e-a36a-806e0a5864ce"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:name(node:ref(node:ref(.)/OsApplicationCoreRef)) != node:name(../.)"
                               true = "Failed to reference a specific application"/>
                         <a:tst expr="text:contains(concat(text:split(node:ref(.)/OsAppTaskRef/*),''), concat('Idle_Task_Core', node:value(node:ref(../OsCoreId)/EcucCoreId)))"
                               false = "The System Application needs an idle task"/>  
                     </a:da>                        
                    </v:ref>

                    <v:var name="OsPhysicalCoreId" type="INTEGER">
                       <a:a name="DESC" value="EN: This parameter provides the Core Physical ID. The value for this parameter starts with 0 and continue without any gaps." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                       <a:da name="DEFAULT" type="XPath" expr="node:fallback(node:current()/../@index, num:i(1))" />
                       <a:da name="RANGE" type="XPath">
                            <a:tst expr="num:i(.) &gt;= num:i(ecu:get('OsResource.NumOfCores'))"
                                   true = "Failed to reference a physical Core"/>                       
<!--                        <a:tst expr="(node:fallback(.,1) &gt;= 0) and (node:fallback(.,1) &lt; num:i(count(node:fallback(node:current()/../../*, 1 ))))" false="Value out of range: must be in range 0 to N-1 (N is number of configured channels). Use the Calc button to calculate correct default value." />
                            <a:tst expr="text:uniq(node:fallback(../../*/OsPhysicalCoreId, text:split('1 2 3')), node:fallback(.,1) )" false="Duplicated value, OsPhysicalCoreId must be unique across Os. Use the Calc button to calculate correct default value." />
-->                    </a:da>                     
                    </v:var>
                    
                    <v:ref name="OsTpCounterRef" type="REFERENCE">
                         <a:a name="DESC" 
                              value="EN: Reference to a counter that use for Time Protection"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                           <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                           <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                         <a:a name="SCOPE" value="LOCAL"/>
                         <a:a name="UUID" 
                              value="8f6721c9-f794-4c7e-a36a-806e0a5864ce"/>
                         <a:da name="REF" 
                               value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCounter"/>
                         <a:da name="INVALID" type="XPath">
                           <a:tst expr="node:refexists(.)"
                                  false = "Node that referenced doesn't exists"/>
                           <a:tst expr="node:ref(.)/OsTimerHighResolution = 'true'"
                                  false = "Tp should using high resolution counter"/>
                           <a:tst expr="node:value(../../../OsOS/OsScalabilityClass) = 'SC2' or node:value(../../../OsOS/OsScalabilityClass) = 'SC4'"
                                  false = "Tp should not be using under SC1 or SC3"/>
                        </a:da>
                        <a:da name="OPTIONAL" value="true" />                            
                       </v:ref>
                    
                  <v:ctr name="OsCoreHookStackConfig" type="IDENTIFIABLE">
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="UUID" 
                         value="F91D29D5-17E4-4A05-AD26-D8F521B728D0"/>
                    <a:a name="ORIGIN" value="ChipowerTech"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="DESC" value="EN: This parameter provides the Core Hook Stack Configuration."/>

                    <v:var name="OsStartupHookSize" type="INTEGER">
                      <a:a name="DESC" value="EN: This parameter provides the Core StartupHook Stack Size Configuration.The uint is Bytes." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:da name="DEFAULT" value="1024"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>

                    <v:var name="OsErrorHookSize" type="INTEGER">
                      <a:a name="DESC" value="EN: This parameter provides the Core ErrorHook Stack Size Configuration.The uint is Bytes." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:da name="DEFAULT" value="1024"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>

                    <v:var name="OsShutdownHookSize" type="INTEGER">
                      <a:a name="DESC" value="EN: This parameter provides the Core ShutdownHook Stack Size Configuration.The uint is Bytes." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:da name="DEFAULT" value="1024"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>

                    <v:var name="OsProtectionHookSize" type="INTEGER">
                      <a:a name="DESC" value="EN: This parameter provides the Core ProtectionHook Stack Size Configuration.The uint is Bytes." />
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="ChipowerTech"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:da name="DEFAULT" value="1024"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>

                  </v:ctr>

                  <v:lst name="OsCoreMemoryProtection" type="MAP">
                    <a:da name="ENABLE" type="XPath" 
                          expr="(../../../OsOS/OsScalabilityClass = 'SC4') or (../../../OsOS/OsScalabilityClass = 'SC3')"
                          true="true" false="false"/>
                      <a:a name="UUID" 
                           value="6feba224-f010-4914-8cd6-19d9c82de9d7"/>
                           <v:ctr name="OsCoreMemoryProtection" type="IDENTIFIABLE">
                              <v:chc name="OsCoreMemoryProtectionChoice" type="IDENTIFIABLE">
                                   <a:a name="DESC" 
                                        value="EN: This container defines way to define Address region."/>
                                   <a:a name="UUID" 
                                        value="0398b4b3-eab7-4a09-b1c1-c913a9af0e84"/>
                                   <v:ctr name="RegionSelect" type="IDENTIFIABLE">
                                     <a:a name="DESC" 
                                          value="EN: This container specifies region."/>
                                     <a:a name="UUID" 
                                          value="4f491a06-34fb-4f8a-ae3a-6f57b3e4f543"/>
                                        <v:ref name="MemoryBlockRef" type="REFERENCE">
                                             <a:a name="DESC" 
                                                  value="EN: Reference to applications which have an access to this object."/>
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                             <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                             <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                             </a:a>
                                             <a:da name="INVALID" type="XPath">
                                             <a:tst expr="node:refexists(node:current())"
                                                       false = "Failed to reference a specific Memory Block"/>
                                             </a:da>
                                             <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                             <a:a name="UUID" 
                                                  value="9439a6a6-392d-4be3-bee2-9dcf715129a7"/>
                                             <a:da name="REF" 
                                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/MemoryBlock"/>
                                        </v:ref>
                                   </v:ctr>
                                   <v:ctr name="RegionWritten" type="IDENTIFIABLE">
                                     <a:a name="DESC" 
                                          value="EN: This container specifies the parameters to call a callback OS alarm action."/>
                                     <a:a name="UUID" 
                                          value="808f6a7c-53a6-49e0-8772-e821c424684b"/>
                                          <v:var name="OsCoreMemoryProtectionStartAddress" type="INTEGER">
                                             <a:a name="DESC" 
                                                  value="EN: This parameter contains the Start Address for memory protection"/>
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                               <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                             </a:a>
                                             <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                             <a:a name="SCOPE" value="ECU"/>
                                             <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                             <a:a name="UUID" 
                                                  value="6feba334-4c0e-4524-89d5-2ddce875abde"/>
                                             <a:da name="DEFAULT" value="0" />
                                             <a:da name="INVALID" type="Range">
                                               <a:tst expr="&lt;= ../OsCoreMemoryProtectionEndAddress"/>
                                               <a:tst expr="&gt;= 0"/>
                                             </a:da>
                                           </v:var>
                                           <v:var name="OsCoreMemoryProtectionEndAddress" type="INTEGER">
                                              <a:a name="DESC" 
                                                   value="EN: This parameter contains the End Address for memory protection"/>
                                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                   type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                              </a:a>
                                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                              <a:a name="SCOPE" value="ECU"/>
                                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                              <a:a name="UUID" 
                                                   value="6febaaa4-4c0e-4524-89d5-2ddce875abde"/>
                                              <a:da name="DEFAULT" value="0" />
                                              <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;= 4294967295"/>
                                                <a:tst expr="&gt;= 0"/>
                                              </a:da>
                                            </v:var>
                                   </v:ctr>
                                 </v:chc>
                           <a:a name="DESC" 
                                value="EN: This container contains the region for memory protection."/>
                           <a:a name="UUID" 
                                value="6feba224-f010-4914-8cd6-19d9c82de9d7"/>
                            <v:var name="CoreRegionReadWriteAccess" type="ENUMERATION">
                              <a:a name="DESC" value="EN: This parameter contains Read and Write Access for this region"/>
                              <a:a name="ORIGIN" value="ChipowerTech" />
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="SYMBOLICNAMEVALUE" value="false" />
                              <a:a name="UUID" value="0aaccac4-de79-4565-8120-830dc23e3679" />
                              <a:da name="DEFAULT" value="MPU_EL1_RW_EL0_NONE" />
                              <a:da name="RANGE">
                                   <a:v>MPU_EL1_RW_EL0_NONE</a:v>
                                   <a:v>MPU_EL1_RW_EL0_RW</a:v>
                                   <a:v>MPU_EL1_R_EL0_NONE</a:v>
                                   <a:v>MPU_EL1_R_EL0_R</a:v>
                              </a:da>
                            </v:var>
                            <v:var name="CoreExecutionAccess" type="ENUMERATION">
                              <a:a name="DESC" value="EN: This parameter contains Execution Access for this region"/>
                              <a:a name="ORIGIN" value="ChipowerTech" />
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="SYMBOLICNAMEVALUE" value="false" />
                              <a:a name="UUID" value="0aa5bbb4-de79-4565-8120-830dc23e3679" />
                              <a:da name="DEFAULT" value="MPU_EXECUTE_NEVER" />
                              <a:da name="RANGE">
                              <a:v>MPU_EXECUTE_NEVER</a:v>
                              <a:v>MPU_EXECUTE_ALLOWED</a:v>
                              </a:da>
                            </v:var>
                         </v:ctr>
                  </v:lst>
				  <v:lst name="OsCoreServiceCall" type="MAP">
					<a:da name="MAX" type="XPath" expr="ecu:get('OsResource.NumOfCores') - 1" />
					<a:da name="ENABLE" type="XPath" 
                          expr="count(../../*) &gt; 1"/>
					<a:da name="INVALID" type="XPath" 
                          expr="count(./*) = ecu:get('OsResource.NumOfCores') - 1"
						  false="Must configure cross core service call to all other cores"/>
               <v:ctr name="OsCoreServiceCall" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains configuration of cross core service call channel."/>
                      <a:a name="UUID" 
                           value="6feba224-f010-4914-8cd6-19d9c82de9d7"/>
					  <v:ref name="OsReceiverCore" type="REFERENCE">
						  <a:a name="DESC" 
							   value="EN: Reference to the receiver OsCore in the Ecuc Module."/>
						  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							   type="IMPLEMENTATIONCONFIGCLASS">
							<icc:v mclass="PreCompile">VariantPreCompile</icc:v>
							<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						  </a:a>
						  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						  <a:a name="SCOPE" value="LOCAL"/>
						  <a:a name="UUID" 
							   value="8f6721c9-f794-4c7e-a36a-806e0a5864ce"/>
						  <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCoreIdMappingConfig"/>
						  <a:da name="INVALID" type="XPath">
							<a:tst expr="node:name(node:ref(.)) != node:name(../../..)"
                               false = "Must reference to other cores."/>
							<a:tst expr="text:uniq(../*/OsReceiverCore, .)"
                               false = "Receiver core cannot be same."/>
						  </a:da>
					  </v:ref>
                      <v:var name="OsCoreServiceCallBufferLength" type="INTEGER">
                         <a:a name="DESC" 
                              value="EN: Buffer length of cross core channel"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                           <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                         <a:a name="SCOPE" value="ECU"/>
                         <a:a name="UUID" 
                              value="6febaaa4-4c0e-4524-89d5-2ddce875abde"/>
                         <a:da name="INVALID" type="Range">
                           <a:tst expr="&lt;= 4294967295"/>
                           <a:tst expr="&gt; 0"/>
                         </a:da>
						 <a:da name="DEFAULT" value="4" />
                       </v:var>
					</v:ctr>
				  </v:lst>
				  
                  </v:ctr>
               </v:lst>

               <v:lst name="OsAlarm" type="MAP">
                <v:ctr name="OsAlarm" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: An OsAlarm may be used to asynchronously inform or activate a specific task. It is possible to start alarms automatically at system start-up depending on the application mode."/>
                  <a:a name="UUID" value="2555829d-0f37-4c4c-86bf-c31ca457e6c0"/>                  
                  <v:lst name="OsAlarmAccessingApplication">
                    <v:ref name="OsAlarmAccessingApplication" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to applications which have an access to this object."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:refexists(node:current())"
                               false = "Failed to reference a specific application"/>
                     </a:da>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="UUID" 
                           value="9439a6a6-392d-4be3-bee2-9dcf715129a7"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                    </v:ref>
                  </v:lst>
                  <v:ref name="OsAlarmCounterRef" type="REFERENCE">
                    <a:a name="DESC" 
                         value="EN: Reference to the assigned counter for that alarm"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" 
                         value="9e1a9c39-72f6-4acb-856d-5078c5b79661"/>
                    <a:da name="REF" 
                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCounter"/>
                  </v:ref>
                  <v:var name="OsAlarmUseAutostart" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: The OsAlarmUseAutostart attributes defines whether Alarm need Autostart."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="7246678f-c579-4334-9d41-84cc17d217af"/>
                    <a:da name="DEFAULT" value="TRUE"/>
                  </v:var>
                  <v:lst name="OsAlarmAutostartAppModeRef">
                    <a:da name="MIN" value="1"/>
                    <a:da name="ENABLE" type="XPath" 
                         expr="node:value(../OsAlarmUseAutostart) = 'true'"
                         true="true" false="false"/>
                    <v:ref name="OsAlarmAutostartAppModeRef" type="CHOICE-REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to the application modes for which the AUTOSTART shall be performed."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="403fb2bf-e551-4211-a730-8f3332cd5bfc"/> 
                      <a:da name="REF">
                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsAppMode</a:v>
                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OSDEFAULTAPPMODE</a:v>
                        <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OSALLRUNNINGMODE</a:v>
                      </a:da>
                      <a:da name="INVALID" type="XPath">
                         <a:tst expr="(count(./../*) > 1) and (text:contains(node:name(node:ref(.)), 'OSALLRUNNINGMODE'))"
                                   true = "OSALLRUNNINGMODE is used no need to reference other mode"/>
                         <a:tst expr="text:uniq(node:order(../*), .)"
                                   false = "Multi reference same Autostart mode"/>
                         <a:tst expr="node:refexists(.)"
                                   false = "The referenced AppMode does not exists"/>
                    </a:da> 
                    </v:ref>
                  </v:lst>
                  <v:ctr name="OsAlarmAutostart" type="IDENTIFIABLE">
                    <a:da name="ENABLE" type="XPath" 
                         expr="node:value(../OsAlarmUseAutostart) = 'true'"
                         true="true" false="false"/>
                    <a:a name="DESC">
                      <a:v>EN: 
                          &lt;html&gt;
                            &lt;b&gt;OsAlarmAutostart&lt;/b&gt; is a boolean attribute whose value specifies whether the alarm shall be started
                            automatically when the kernel starts. If the value is &lt;b&gt;TRUE&lt;/b&gt;, the &lt;b&gt;OsAlarmAutostartAppModeRef&lt;/b&gt; sub-attribute
                            specifies in which application modes the task shall be automatically started, and the sub-attributes
                            &lt;b&gt;OsAlarmAlarmTime&lt;/b&gt; and &lt;b&gt;OsAlarmCycleTime&lt;/b&gt; specify the first and subsequent relative values of the
                            counter at which the alarm shall expire.
                          &lt;/html&gt;</a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="UUID" 
                         value="74738ace-8d8e-487b-8e4a-05524a0463cf"/>
                         
                    <v:var name="OsAlarmAlarmTime" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: The relative or absolute tick value when the alarm expires for the first time. Note that for an alarm                                  which is RELATIVE the value must be bigger than 0."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                         value="d90e8998-3af5-4f00-b809-09f7c1d979ae"/>
                      <a:da name="DEFAULT" value="0"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295"/>
                        <a:tst expr="&gt;=1"/>
                      </a:da>
                    </v:var>
                    <v:var name="OsAlarmCycleTime" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: Cycle time of a cyclic alarm in ticks. If the value is 0 than the alarm is not cyclic."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                         value="d90e8998-3af5-4f00-b809-09f7c1d979ae"/>
                      <a:da name="DEFAULT" value="0"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=4294967295"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>
                    <v:var name="OsAlarmAutostartType" type="ENUMERATION">
                      <a:a name="DESC" 
                           value="EN: This specifies the type of autostart for the alarm."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                         value="d90e8998-3af5-4f00-b809-09f7c1d979ae"/>
                      <a:da name="DEFAULT" value="RELATIVE"/>
                      <a:da name="RANGE">
                        <a:v>ABSOLUTE</a:v>
                        <a:v>RELATIVE</a:v>
                      </a:da>
                    </v:var>
                  </v:ctr>
                  <v:chc name="OsAlarmAction" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                         value="EN: This container defines which type of notification is used when the alarm expires."/>
                    <a:a name="UUID" 
                         value="0398b4b3-eab7-4a09-b1c1-c913a9af0e84"/>
                    <v:ctr name="OsAlarmActivateTask" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container specifies the parameters to activate a task."/>
                      <a:a name="UUID" 
                           value="4f491a06-34fb-4f8a-ae3a-6f57b3e4f543"/>
                      <v:ref name="OsAlarmActivateTaskRef" type="REFERENCE">
                        <a:a name="DESC" 
                             value="EN: Reference to the task that will be activated by that alarm action"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="UUID" 
                             value="183fe037-919e-4211-8c2e-1c93a5f08de9"/>
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsTask"/>
                        <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:refexists(node:current())"
                                false = "Failed to reference a specific Task"/>
                        </a:da>
                         </v:ref>
                    </v:ctr>
                    <v:ctr name="OsAlarmCallback" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container specifies the parameters to call a callback OS alarm action."/>
                      <a:a name="UUID" 
                           value="808f6a7c-53a6-49e0-8772-e821c424684b"/>
                      <v:var name="OsAlarmCallbackName" type="FUNCTION-NAME">
                        <a:a name="DESC" 
                             value="EN: Name of the function that is called when this alarm callback is triggered."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d756aa8a-86a3-4d51-99b9-47710a011449"/>
                        <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:empty(node:current())"
                                true = "Callback name cannot be empty"/>
                        <a:tst expr="node:value(../../../../OsOS/OsScalabilityClass) != 'SC1'"
                                true = "Callback only use in SC1 class"/>
                        </a:da>
                      </v:var>
                    </v:ctr>
                    <v:ctr name="OsAlarmIncrementCounter" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container specifies the parameters to increment a counter."/>
                      <a:a name="UUID" 
                           value="87cc70e1-d64f-4eca-9666-40f93a3a0b0c"/>
                      <v:ref name="OsAlarmIncrementCounterRef" type="REFERENCE">
                        <a:a name="DESC" 
                             value="EN: Reference to the counter that will be incremented by that alarm action"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" 
                             value="8055a9a4-e9ef-4a9e-acaf-f4fe668c4430"/>
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCounter"/>
                        <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:refexists(node:current())"
                                false = "Failed to reference a specific Counter"/>
                        </a:da>
                      </v:ref>
                    </v:ctr>
                    <v:ctr name="OsAlarmSetEvent" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container specifies the parameters to set an event"/>
                      <a:a name="UUID" 
                           value="58d17197-8d5c-41ab-a8b5-4c9cdfcb8dca"/>
                      <v:ref name="OsAlarmSetEventRef" type="REFERENCE">
                        <a:a name="DESC" 
                             value="EN: Reference to the event that will be set by that alarm action"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="node:refexists(node:current())"
                                   false = "Failed to reference a specific Event"/>
                         </a:da>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="UUID" 
                             value="3844808f-974a-4b68-a575-d1682a7990c5"/>
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsEvent"/>
                      </v:ref>
                      <v:ref name="OsAlarmSetEventTaskRef" type="REFERENCE">
                        <a:a name="DESC" 
                             value="EN: Reference to the task that will be activated by that event"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="UUID" 
                             value="60b360df-ad8e-4f5e-a8ad-e8586965878d"/>
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsTask"/>
                        <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:refexists(node:current()) and node:value(node:ref(.)/OsTaskType) = 'EXTENDED'"
                                false = "Failed to reference a specific Task or the Task is not EXTENDED"/>
                        </a:da>
                      </v:ref>
                    </v:ctr>
                  </v:chc>           
                </v:ctr>
              </v:lst>

              <v:ctr name="OSDEFAULTAPPMODE" type="IDENTIFIABLE" >
                   <a:a name="DESC" 
                        value="EN: OsAppMode is the object used to define ISO 17356-3 properties for an ISO 17356-3 application mode."/>
                   <a:a name="UUID" value="c038a45d-83ce-4a76-a287-0b0c7d0fab16"/>
                   <a:da name="EDITABLE" value="false" /> 
              </v:ctr>
              <v:ctr name="OSALLRUNNINGMODE" type="IDENTIFIABLE" >
                   <a:a name="DESC" 
                        value="EN: OsAppMode is the object used to define ISO 17356-3 properties for an ISO 17356-3 application mode."/>
                   <a:a name="UUID" value="c038a45d-83ce-4a76-a287-0b0c7d0fab16"/> 
                   <a:da name="EDITABLE" value="false" /> 
              </v:ctr>
              <v:lst name="OsAppMode" type="MAP">
               <a:da name="MIN" value="0" />
               <a:da name="MAX" value="31" />
                <v:ctr name="OsAppMode" type="IDENTIFIABLE" >
                  <a:a name="DESC" 
                       value="EN: OsAppMode is the object used to define ISO 17356-3 properties for an ISO 17356-3 application mode."/>
                  <a:a name="UUID" value="c038a45d-83ce-4a76-a287-0b0c7d0fab16"/>  
                </v:ctr>
              </v:lst>

              <v:lst name="OsApplication" type="MAP">
                <a:da name="MIN" value="0" />
                <a:da name="MAX" value="255" />
                <v:ctr name="OsApplication" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: An AUTOSAR OS must be capable of supporting a collection of OS objects (tasks, interrupts, alarms, hooks etc.) that form a cohesive functional unit. This collection of objects is termed an OS-Application."/>
                  <a:a name="UUID" value="21e55148-94fa-4257-a651-ed83f8859ce7"/>
                  <v:var name="OsTrusted" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Parameter to specify if an OS-Application is trusted or not."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="d90e8998-3af5-4f00-b809-09f7c1d979ae"/>
                    <a:da name="DEFAULT" value="true"/>
					<a:da name="EDITABLE" type="XPath">
					  <a:tst expr="(../../../OsOS/OsScalabilityClass = 'SC3') or (../../../OsOS/OsScalabilityClass = 'SC4')"/>
					</a:da>
                  </v:var>
                  <v:ref name="OsApplicationCoreRef" type="REFERENCE">
                    <a:a name="DESC" 
                         value="EN: Reference to the Core Definition in the Ecuc Module where the CoreId is defined. This reference is used to describe to which Core the OsApplication is bound."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" 
                         value="8f6720b9-f794-4c7e-a36a-806e0a5864ce"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCoreIdMappingConfig"/>

                    <a:da name="INVALID" type="XPath">
                      <a:tst expr="node:when(node:exists(../../*[num:i(node:fallback(node:current()/../@index,1))]) 
                                             ,(num:i(node:ref(node:ref(.)/OsCoreId)/EcucCoreId) &lt; num:i(node:ref(node:ref(../../*[node:when(node:exists(../../*[num:i(node:current()/../@index)]),num:i(node:current()/../@index),num:i(1))]/OsApplicationCoreRef)/OsCoreId)/EcucCoreId))
                                             ,true)"
                             true="The current Application is not sorted in ascending order according to Reference CoreID.Please check the OsApplicationCoreRef of EcuCoreId mapping value" />
                    </a:da>
                  </v:ref>

                  <v:var name="OsTrustedApplicationDelayTimingViolationCall" 
                         type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Parameter to specify if a timing violation which occurs within an trusted OS-Application is raised immediately of if it is delayed until the current task returns to the calling OS-Application (return of CallTrustedFunction)"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="ce937832-cba9-4357-afdd-937cd30fb14f"/>
                    <a:da name="DEFAULT" value="true"/>
                  </v:var>
                  <v:var name="OsTrustedApplicationWithProtection" 
                         type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Parameter to specify if a trusted OS-Application is executed with memory protection or not."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="20b361ee-18ed-40bf-a98b-de5bd3e6e6aa"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>

                  <v:lst name="OsAppMemoryProtection" type="MAP">
                    <a:da name="ENABLE" type="XPath" 
                          expr="(../../../OsOS/OsScalabilityClass = 'SC4') or (../../../OsOS/OsScalabilityClass = 'SC3')"
                          true="true" false="false"/>
                    <v:ctr name="OsAppMemoryProtection" type="IDENTIFIABLE">
                         <v:chc name="OsAppMemoryProtectionChoice" type="IDENTIFIABLE">
                              <a:a name="DESC" 
                                   value="EN: This container defines way to define Address region."/>
                              <a:a name="UUID" 
                                   value="0398b4b3-eab7-4a09-b1c1-c913a9af0e84"/>
                              <v:ctr name="RegionSelect" type="IDENTIFIABLE">
                                <a:a name="DESC" 
                                     value="EN: This container specifies region."/>
                                <a:a name="UUID" 
                                     value="4f491a06-34fb-4f8a-ae3a-6f57b3e4f543"/>
                                        <v:ref name="MemoryBlockRef" type="REFERENCE">
                                             <a:a name="DESC" 
                                                  value="EN: Reference to applications which have an access to this object."/>
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                             <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                             <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                             </a:a>
                                             <a:da name="INVALID" type="XPath">
                                             <a:tst expr="node:refexists(node:current())"
                                                       false = "Failed to reference a specific Memory Block"/>
                                             </a:da>
                                             <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                             <a:a name="UUID" 
                                                  value="9439a6a6-392d-4be3-bee2-9dcf715129a7"/>
                                             <a:da name="REF" 
                                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/MemoryBlock"/>
                                        </v:ref>
                              </v:ctr>
                              <v:ctr name="RegionWritten" type="IDENTIFIABLE">
                                <a:a name="DESC" 
                                     value="EN: This container specifies the parameters to call a callback OS alarm action."/>
                                <a:a name="UUID" 
                                     value="808f6a7c-53a6-49e0-8772-e821c424684b"/>
                                     <v:var name="OsAppMemoryProtectionStartAddress" type="INTEGER">
                                        <a:a name="DESC" 
                                             value="EN: This parameter contains the Start Address for memory protection"/>
                                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                             type="IMPLEMENTATIONCONFIGCLASS">
                                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                        </a:a>
                                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                        <a:a name="SCOPE" value="ECU"/>
                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                        <a:a name="UUID" 
                                             value="6feba334-4c0e-4524-89d5-2ddce875abde"/>
                                        <a:da name="DEFAULT" value="0" />
                                        <a:da name="INVALID" type="Range">
                                          <a:tst expr="&lt;= ../OsAppMemoryProtectionEndAddress"/>
                                          <a:tst expr="&gt;= 0"/>
                                        </a:da>
                                      </v:var>
                                      <v:var name="OsAppMemoryProtectionEndAddress" type="INTEGER">
                                         <a:a name="DESC" 
                                              value="EN: This parameter contains the End Address for memory protection"/>
                                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                              type="IMPLEMENTATIONCONFIGCLASS">
                                           <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                         </a:a>
                                         <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                         <a:a name="SCOPE" value="ECU"/>
                                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                         <a:a name="UUID" 
                                              value="6febaaa4-4c0e-4524-89d5-2ddce875abde"/>
                                         <a:da name="DEFAULT" value="0" />
                                         <a:da name="INVALID" type="Range">
                                           <a:tst expr="&lt;= 4294967295"/>
                                           <a:tst expr="&gt;= 0"/>
                                         </a:da>
                                       </v:var>
                              </v:ctr>
                            </v:chc>
                      <a:a name="DESC" 
                           value="EN: This container contains the region for memory protection."/>
                      <a:a name="UUID" 
                           value="6feba224-f010-4914-8cd6-19d9c82de9d7"/>
                       <v:var name="AppRegionReadWriteAccess" type="ENUMERATION">
                         <a:a name="DESC" value="EN: This parameter contains Read and Write Access for this region"/>
                         <a:a name="ORIGIN" value="ChipowerTech" />
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:a name="SYMBOLICNAMEVALUE" value="false" />
                         <a:a name="UUID" value="0aaccac4-de79-4565-8120-830dc23e3679" />
                         <a:da name="DEFAULT" value="MPU_EL1_RW_EL0_NONE" />
                         <a:da name="RANGE">
                              <a:v>MPU_EL1_RW_EL0_NONE</a:v>
                              <a:v>MPU_EL1_RW_EL0_RW</a:v>
                              <a:v>MPU_EL1_R_EL0_NONE</a:v>
                              <a:v>MPU_EL1_R_EL0_R</a:v>
                         </a:da>
                       </v:var>
                       <v:var name="AppExecutionAccess" type="ENUMERATION">
                         <a:a name="DESC" value="EN: This parameter contains Execution Access for this region"/>
                         <a:a name="ORIGIN" value="ChipowerTech" />
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:a name="SYMBOLICNAMEVALUE" value="false" />
                         <a:a name="UUID" value="0aa5bbb4-de79-4565-8120-830dc23e3679" />
                         <a:da name="DEFAULT" value="MPU_EXECUTE_NEVER" />
                         <a:da name="RANGE">
                         <a:v>MPU_EXECUTE_NEVER</a:v>
                         <a:v>MPU_EXECUTE_ALLOWED</a:v>
                         </a:da>
                       </v:var>
                    </v:ctr>
                  </v:lst>




                  <v:lst name="OsAppAlarmRef">
                    <v:ref name="OsAppAlarmRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Specifies the OsAlarms that belong to the OsApplication."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="403fb2bf-e551-4211-a730-8f3332cd5bfc"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsAlarm"/>
                      <a:da name="INVALID" type="XPath">
                         <a:tst expr="node:exists(node:ref(.))"
                                   false = "The refering Alarm does not exists"/>
                         <a:tst expr="text:uniq(node:order(../../../*/OsAppAlarmRef/*), .)"
                                   false = "Same Alarm should only be referenced once"/>
                      </a:da>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsAppCounterRef">
                    <v:ref name="OsAppCounterRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: References the OsCounters that belong to the OsApplication."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="a24c0ffa-1c41-4836-a43b-6ee658b7c228"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCounter"/>
                     <a:da name="INVALID" type="XPath">
                     <a:tst expr="node:exists(node:ref(.))"
                              false = "The refering Counter does not exists"/>
                     <a:tst expr="text:uniq(node:order(../../../*/OsAppCounterRef/*), .)"
                              false = "Same Counter should only be referenced once"/>
                     </a:da>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsAppEcucPartitionRef">
                    <a:da name="MAX" value="1"/>
                    <v:ref name="OsAppEcucPartitionRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Denotes which &quot;EcucPartition&quot; is implemented by this &quot;OSApplication&quot;."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="UUID" 
                           value="31229a87-348e-4b8c-91ce-8b4f118263d5"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/EcuC/EcucPartitionCollection/EcucPartition"/>
                     <a:da name="INVALID" type="XPath">
                     <a:tst expr="text:uniq(../../../*/OsAppEcucPartitionRef/*, .)"
                              false = "An EcucPartition must not be referenced by multiple OsAppEcucPartitionRefs."/>
                     </a:da>
                    </v:ref>
                  </v:lst>

                  <v:lst name="OsAppIsrRef">
                    <v:ref name="OsAppIsrRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: references which OsIsrs belong to the OsApplication"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="150211d4-b2db-4ed7-a13d-839d85a0d81a"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsIsr"/>
                      <a:da name="INVALID" type="XPath">
                      <a:tst expr="node:exists(node:ref(.)/OsIsrTimingProtection/*[1]) and not(node:refexists(node:ref(../../OsApplicationCoreRef)/OsTpCounterRef))"
                              true = "Core does not config Time Protection Counter but Isr uses Time Protection"/>  
                      <a:tst expr="node:exists(node:ref(.))"
                              false = "The refering ISR does not exists"/>
                      <a:tst expr="text:uniq(node:order(../../../*/OsAppIsrRef/*), .)"
                              false = "Same Isr should only be referenced once"/>
                      </a:da>
                    </v:ref>
                  </v:lst>

                  <v:lst name="OsAppScheduleTableRef">
                    <v:ref name="OsAppScheduleTableRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: References the OsScheduleTables that belong to the OsApplication."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="e5e12ac5-856c-4d90-8d89-bc82968b11f4"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsScheduleTable"/>
                      <a:da name="INVALID" type="XPath">
                      <a:tst expr="node:exists(node:ref(.))"
                              false = "The refering ScheduleTable does not exists"/>
                      <a:tst expr="text:uniq(node:order(../../../*/OsAppScheduleTableRef/*), .)"
                              false = "Same ScheduleTable should only be referenced once"/>
                      </a:da>
                    </v:ref>
                  </v:lst>

                  <v:lst name="OsAppTaskRef">
                    <v:ref name="OsAppTaskRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: references which OsTasks belong to the OsApplication"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="e5abd50e-9ebf-4974-8a91-90e0becce0b1"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsTask"/>
                      <a:da name="INVALID" type="XPath">
                      <a:tst expr="node:exists(node:ref(.))"
                              false = "The refering Task does not exists"/>
                      <a:tst expr="text:uniq(node:order(../../../*/OsAppTaskRef/*), .)"
                              false = "Same Task should only be referenced once"/>
                      <a:tst expr="node:exists(node:ref(.)/OsTaskTimingProtection/*[1]) and not(node:refexists(node:ref(../../OsApplicationCoreRef)/OsTpCounterRef))"
                              true = "Core does not config Time Protection Counter but Task uses Time Protection"/>     
                      </a:da>
                    </v:ref>
                  </v:lst>
     
                  <v:lst name="OsMemoryMappingCodeLocationRef">
                    <a:da name="MAX" value="1"/>
                    <v:ref name="OsMemoryMappingCodeLocationRef" 
                           type="FOREIGN-REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to the memory mapping containing details about the section where the code is placed."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="f820faf7-5428-4143-8f86-98ed3bf03c25"/>
                      <a:da name="REF" value="ASTyped:SwAddrMethod"/>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsRestartTask">
                    <a:da name="MAX" value="1"/>
                    <v:ref name="OsRestartTask" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Optionally one task of an OS-Application may be defined as Restart Task."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:da name="INVALID" type="XPath">
                         <a:tst expr="node:refexists(.)"
                         false = "The referenced Task does not exists"/>  
                       </a:da>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="77ab233a-16e4-4bb2-8127-c7c5e3ce74bd"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsTask"/>
                    </v:ref>
                  </v:lst>

                  <v:ctr name="OsApplicationHooks" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                         value="EN: Container to structure the OS-Application-specific hooks"/>
                    <a:a name="UUID" 
                         value="90dabd91-fed4-4910-a429-f222f1cae31f"/>
                    <v:var name="OsAppErrorHook" type="BOOLEAN">
                      <a:a name="DESC" 
                           value="EN: Select the OS-Application error hook."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:da name="ENABLE" type="XPath" 
                            expr="node:name(node:ref(node:ref(../../OsApplicationCoreRef)/OsKernelApplication)) = node:name(../../.) or node:value(../../../../OsOS/OsScalabilityClass) = 'SC1' or node:value(../../../../OsOS/OsScalabilityClass) = 'SC2'"
                            true="false" false="true"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="04be7480-2cd6-448c-9e0b-64a2c54301a5"/>
                      <a:da name="DEFAULT" value="false"/>  
                    </v:var>
                    <v:var name="OsAppShutdownHook" type="BOOLEAN">
                      <a:a name="DESC" 
                           value="EN: Select the OS-Application specific shutdown hook for the OS-Application."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:da name="ENABLE" type="XPath" 
                            expr="(node:name(node:ref(node:ref(../../OsApplicationCoreRef)/OsKernelApplication)) = node:name(../../.)) or node:value(../../../../OsOS/OsScalabilityClass) = 'SC1' or node:value(../../../../OsOS/OsScalabilityClass) = 'SC2'"
                            true="false" false="true"/>                      
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="701285e3-25de-44ce-b9ab-be76b6c2862a"/>
                      <a:da name="DEFAULT" value="false"/>        
                    </v:var>
                    <v:var name="OsAppStartupHook" type="BOOLEAN">
                      <a:a name="DESC" 
                           value="EN: Select the OS-Application specific startup hook for the OS-Application."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:da name="ENABLE" type="XPath" 
                            expr="node:name(node:ref(node:ref(../../OsApplicationCoreRef)/OsKernelApplication)) = node:name(../../.) or node:value(../../../../OsOS/OsScalabilityClass) = 'SC1' or node:value(../../../../OsOS/OsScalabilityClass) = 'SC2'"
                            true="false" false="true"/>                      
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="164f08df-4599-425b-a461-d7cf1901cd18"/>
                      <a:da name="DEFAULT" value="false"/>        
                    </v:var>
                    <v:lst name="OsMemoryMappingCodeLocationRef">
                      <a:da name="MAX" value="1"/>
                      <v:ref name="OsMemoryMappingCodeLocationRef" 
                             type="FOREIGN-REFERENCE">
                        <a:a name="DESC" 
                             value="EN: Reference to the memory mapping containing details about the section where the code is placed."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="UUID" 
                             value="00d779be-e4a5-4e36-ba25-0521baaf987a"/>
                        <a:da name="REF" value="ASTyped:SwAddrMethod"/>
                      </v:ref>
                    </v:lst>
                  </v:ctr>
                  <v:lst name="OsApplicationTrustedFunction" type="MAP">
                    <v:ctr name="OsApplicationTrustedFunction" 
                           type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: Container to structure the configuration parameters of trusted functions"/>
                      <a:a name="UUID" 
                           value="893b4b10-f4be-4f7f-9a1c-a6e41bbe8df9"/>
                      <v:var name="OsTrustedFunctionName" type="FUNCTION-NAME">
                        <a:a name="DESC" 
                             value="EN: Trusted function (as part of a trusted OS-Application) available to other OS-Applications. This also supersedes the ISO 17356-6 attribute TRUSTED in APPLICATION because the optionality of this parameter is describing that already."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="f37126a0-e0dc-4351-b338-8bf9785e2404"/>
						<a:da name="INVALID" type="XPath">
						  <a:tst expr="text:uniq(../../*/OsTrustedFunctionName, .)"
							     false="Duplicated function name"/>
						  <a:tst expr="text:uniq(../../../../*/OsApplicationTrustedFunction/*/OsTrustedFunctionName, .)"
							     false="Duplicated function name"/>
						  <a:tst expr="node:empty(.)"
							     true="Empty function name"/>
					    </a:da>
                      </v:var>
					  <v:lst name="OsTrustedFunctionParameter" type="MAP">
						<v:ctr name="OsTrustedFunctionParameter" 
							   type="IDENTIFIABLE">
						  <a:a name="DESC" 
                               value="EN: Container to structure the configuration parameters of trusted functions"/>
                          <a:a name="UUID" 
                               value="893b4b10-f4be-4f7f-9a1c-a6e41bbe8df9"/>
						  <v:var name="OsTrustedFunctionParameterDataType" type="STRING">
                            <a:a name="DESC" 
                                 value="EN: Data type of trusted function parameter. If paramterIN is complexe type, it must be transferred by reference."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="UUID" 
                                 value="4b1536f8-b286-4ad5-84b0-8a8d969dc6c6"/>
                          </v:var>
						  <v:var name="OsTrustedFunctionParameterType" type="ENUMERATION">
                            <a:a name="DESC" 
                                 value="EN: Type of trusted function parameter. Note: RETURNVAL is same as OUT"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="UUID" 
                                 value="4b1536f8-b286-4ad5-84b0-8a8d969dc6c6"/>
							<a:da name="RANGE">
							  <a:v>IN</a:v>
							  <a:v>OUT</a:v>
							  <a:v>INOUT</a:v>
							  <a:v>RETURNVAL</a:v>
							</a:da>
							<a:da name="INVALID" type="XPath">
							  <a:tst expr="(node:value(.) != 'RETURNVAL') or
										   (text:uniq(../../*/OsTrustedFunctionParameterType, .))"
									 false="Only can have one return val."/>
							</a:da>
                          </v:var>
						</v:ctr>
					  </v:lst>
                      <v:lst name="OsMemoryMappingCodeLocationRef">
                        <a:da name="MAX" value="1"/>
                        <v:ref name="OsMemoryMappingCodeLocationRef" 
                               type="FOREIGN-REFERENCE">
                          <a:a name="DESC" 
                               value="EN: Reference to the memory mapping containing details about the section where the code is placed."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="SCOPE" value="ECU"/>
                          <a:a name="UUID" 
                               value="d13806d5-ff1b-4511-90cf-4d643c2eefd0"/>
                          <a:da name="REF" value="ASTyped:SwAddrMethod"/>
                        </v:ref>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
                </v:ctr>
              </v:lst>
              <v:lst name="OsCounter" type="MAP">
                <v:ctr name="OsCounter" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: Configuration information for the counters that belong to the OsApplication."/>
                  <a:a name="UUID" value="90765d75-5b85-4501-a5a1-a7e5f01daa48"/>                  
                  <v:var name="OsCounterMaxAllowedValue" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: Maximum possible allowed value of the system counter in ticks."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="c5872b9f-6a72-4306-a20b-05e00185804e"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=18446744073709551615"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="node:value(node:current()) &lt; node:value(../OsCounterMinCycle )"
                                 true = "MaxAllowedValue cannot be less than MinCycle"/>
                    </a:da>
                  </v:var>
                  <v:var name="OsCounterMinCycle" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: The MINCYCLE attribute specifies the minimum allowed number of counter ticks for a cyclic alarm linked to the counter."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="5732cb26-f818-4b75-9396-f73829034fdd"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=18446744073709551615"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                  </v:var>
                  <v:var name="OsCounterTicksPerBase" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: The TICKSPERBASE attribute specifies the number of ticks required to reach a counterspecific unit. The interpretation is implementation-specific."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="4d5685f8-2048-468c-beea-44f366c2d998"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="((../OsCounterType = 'SOFTWARE') or (../OsTimerHighResolution = 'true')) and not (node:value(node:current()) = 1)"
                                 true = "If counter is SOFTWARE or High Resolution TickPerBase must equals 1"/>
                    </a:da>
                  </v:var>
                  <v:var name="OsCounterType" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: This parameter contains the natural type or unit of the counter."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="32884bbc-3c89-4cf0-889e-b8f1075989f8"/>
                    <a:da name="RANGE">
                      <a:v>HARDWARE</a:v>
                      <a:v>SOFTWARE</a:v>
                    </a:da>
                  </v:var>
                  <v:ref name="OsTimerTypeIsrRef" type="REFERENCE">
                    <a:a name="DESC" 
                         value="EN: Reference to Isr which excecute the Timer."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                         <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" 
                         value="32b331e8-53ce-4d8e-b349-270f5afa4232"/>
                    <a:da name="REF" 
                         value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsIsr"/>
                    <a:da name="EDITABLE" type="XPath" expr="../OsCounterType = 'HARDWARE'" />
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr=" node:value(../../../OsResourceSubderivative) = 'Os_SC300' or
                         node:value(../OsCounterType) = 'SOFTWARE' or 
                         node:value(node:ref(node:current())/OsIsrInterruptSource) = 27 or 
                         node:value(node:ref(node:current())/OsIsrInterruptSource) = 30 or 
                         node:value(node:ref(node:current())/OsIsrInterruptSource) = 246 or
                         node:value(node:ref(node:current())/OsIsrInterruptSource) = 247 or
                         node:value(node:ref(node:current())/OsIsrInterruptSource) = 248 or
                         node:value(node:ref(node:current())/OsIsrInterruptSource) = 249 or
                         node:value(node:ref(node:current())/OsIsrInterruptSource) = 250 or
                         node:value(node:ref(node:current())/OsIsrInterruptSource) = 251"
                                 false = "The Referenced ISR is not trigger by EL1 Timer or Base Timer"/>
                    </a:da>
                  </v:ref>
                  <v:var name="OsTimerHighResolution" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Select If the timer using High Resolution"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="701285e3-25de-44ce-b9ab-be76b6c2862a"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="node:value(node:current()) = 'false' or 
                         node:value(../OsCounterType) = 'SOFTWARE' or
                         node:value(node:ref(../OsTimerTypeIsrRef)/OsIsrInterruptSource) = 27 or 
                         node:value(node:ref(../OsTimerTypeIsrRef)/OsIsrInterruptSource) = 30"
                              false = "The Referenced ISR cannot use HRT">
                    </a:tst>
                    </a:da>
                    <a:da name="EDITABLE" type="XPath" expr="../OsCounterType = 'HARDWARE'" />
                  </v:var>
                  <v:var name="OsSecondsPerTick" type="FLOAT">
                    <a:a name="DESC" 
                         value="EN: The TICKSPERBASE attribute specifies the number of ticks required to reach a counterspecific unit. The interpretation is implementation-specific."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="4d5685f8-2048-468c-beea-44f366c2d998"/>
                    <a:da name="INVALID" type="XPath">
                      <a:tst expr="(node:value(../OsCounterType) = 'SOFTWARE') or (. &lt;=1.0 and . &gt;0.0) " 
                      false = "Failed to reference a specific application"/>
                    </a:da>
                    <a:da name="DEFAULT" value="0.001"/>
                    <a:da name="EDITABLE" type="XPath" expr="../OsCounterType = 'HARDWARE'" />
                  </v:var>
                  <v:lst name="OsCounterAccessingApplication">
                    <v:ref name="OsCounterAccessingApplication" 
                           type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to applications which have an access to this object."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="32b331e8-53ce-4d8e-b349-270f5afa4232"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                      <a:da name="INVALID" type="XPath">
                      <a:tst expr="node:refexists(node:current())"
                              false = "Failed to reference a specific application"/>
                      </a:da>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsTimeConstant" type="MAP">
                    <v:ctr name="OsTimeConstant" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: Allows the user to define constants which can be e.g. used to compare time values with timer tick values."/>
                      <a:a name="UUID" 
                           value="a8b468dc-0168-499a-9ea3-fb4ac6b892a2"/>
                      <v:var name="OsTimeValue" type="FLOAT">
                        <a:a name="DESC" 
                             value="EN: This parameter contains the value of the constant in seconds."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="255a4985-ed4d-4eca-9b88-786cb17c418e"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=Infinity"/>
                          <a:tst expr="&gt;=0.0"/>
                        </a:da>
                      </v:var>
                    </v:ctr>
                  </v:lst>                
                </v:ctr>
              </v:lst>
              <v:lst name="OsEvent" type="MAP">
                <v:ctr name="OsEvent" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: Representation of OS events in the configuration context. Adopted from the ISO 17356-6 specification."/>
                  <a:a name="UUID" value="a1812975-b47b-4517-a8db-026490ca13f3"/>
				<v:var name="OsEventMask" type="INTEGER">
				  <a:a name="DESC" 
					   value="EN: If event mask would be set to AUTO in OIL, this parameter should be omitted here."/>
				  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
					   type="IMPLEMENTATIONCONFIGCLASS">
					<icc:v mclass="PreCompile">VariantPreCompile</icc:v>
					<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
				  </a:a>
				  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
				  <a:a name="SCOPE" value="LOCAL"/>
				  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
				  <a:a name="UUID" 
					   value="d3fcce3e-7b9e-4dd5-9e25-e2c54a989d13"/>
				  <a:da name="INVALID" type="Range">
					<a:tst expr="&lt;=4294967295"/>
					<a:tst expr="&gt;=0"/>
				  </a:da>
				</v:var>
                </v:ctr>
              </v:lst>
              <v:lst name="OsIoc" type="MAP">
                <a:da name="MAX" value="1"/>
                <v:ctr name="OsIoc" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: Configuration of the IOC (Inter OS Application Communicator)."/>
                  <a:a name="UUID" value="0584af7c-580e-496d-aebe-44550f2aa9f3"/>
                  <v:lst name="OsIocIncludeHeader">
                    <a:a name="DESC" value="List of IOC header files"/>
                    <a:a name="LABEL" value="OsIocIncludeHeader"/>
                    <v:var name="OsIocIncludeHeader" type="STRING">
                      <a:a name="LABEL" value="File"/>
                    </v:var>
                  </v:lst>
                  <v:lst name="OsIocCommunication" type="MAP">
                    <v:ctr name="OsIocCommunication" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: Representation of a 1:1 or N:1 or N:M (unqueued only) communication between software parts located in different OS-Applications that are bound to the same or to different cores."/>
                      <a:a name="UUID" 
                           value="2b7f65c2-c6a5-4a9f-944f-b729437331ff"/>
                      <v:lst name="OsIocBufferLength">
                        <a:da name="MAX" value="1"/>
                        <v:var name="OsIocBufferLength" type="INTEGER">
                          <a:a name="DESC" 
                               value="EN: This attribute defines the size of the IOC internal queue to be allocated for a queued communication."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="8afce57a-36fd-423b-b109-ea6a6d3a6bc0"/>
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=4294967295"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                        </v:var>
                      </v:lst>
                      <v:lst name="OsIocDataProperties" type="MAP">
                        <a:da name="MIN" value="1"/>
						<a:da name="INVALID" type="XPath">
                          <a:tst expr="((count(./*) > 1) and (count(../OsIocSenderProperties/*) = 1)) or
									   (count(./*) = 1)"
								 false="N:1 or N:M communication  is only allowed for multiplicity of OsIocDataTypeRef = 1"/>
                        </a:da>
                        <v:ctr name="OsIocDataProperties" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: Data properties of the data to be transferred on the IOC communication channel."/>
                          <a:a name="UUID" 
                               value="89d78f4f-d104-45a9-8a19-7be8c1e8c546"/>
						  <v:var name="OsIocDataPropertyIndex" type="INTEGER">
						    <a:a name="DESC" 
							     value="EN: This parameter is used to define in which order the data is send, e.g. whether IocSendGroup(A,B) or IocSendGroup(B,A) shall be used."/>
						    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							     type="IMPLEMENTATIONCONFIGCLASS">
							  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
							  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						    </a:a>
						    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						    <a:a name="SCOPE" value="LOCAL"/>
						    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
						    <a:a name="UUID" 
							     value="a31d9866-ea2a-4457-95c1-ce3003117439"/>
						    <a:da name="INVALID" type="Range">
							  <a:tst expr="&lt;=255"/>
							  <a:tst expr="&gt;=0"/>
						    </a:da>
							<a:da name="DEFAULT" type="XPath">
							  <a:tst expr="../@index"/>
						    </a:da>
						  </v:var>
						  <v:var name="OsIocDataTypeRef" type="STRING">
                            <a:a name="DESC" 
                                 value="EN: This is the type of the data to be transferred on the IOC communication channel. This attribute is necessary to generate the parameter type of the Ioc functions. Additionally this information should be used to compute the data size for necessary data copy operations within the Ioc module."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="UUID" 
                                 value="4b1536f8-b286-4ad5-84b0-8a8d969dc6c6"/>
                          </v:var>
						  <v:var name="OsIocInitValue" type="STRING">
						    <a:a name="DESC" 
							     value="EN: Initial Value for the data to be transferred on the IOC communication channel."/>
						    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							     type="IMPLEMENTATIONCONFIGCLASS">
							  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
							  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						    </a:a>
						    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						    <a:a name="SCOPE" value="LOCAL"/>
						    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
						    <a:a name="UUID" 
							     value="3dfcc8a8-a53e-4ada-bb70-14de1b432bbf"/>
							<a:da name="EDITABLE" type="XPath">
							  <a:tst expr="count(../../../OsIocBufferLength/*) = 0"/>
						    </a:da>
						  </v:var>
						  <v:ref name="OsMemoryMappingCodeLocationRef" 
							     type="FOREIGN-REFERENCE">
						    <a:a name="DESC" 
							     value="EN: Reference to the memory mapping containing details about the section where the IOC buffer is placed."/>
						    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							     type="IMPLEMENTATIONCONFIGCLASS">
							  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
							  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						    </a:a>
						    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						    <a:a name="SCOPE" value="ECU"/>
						    <a:a name="UUID" 
							     value="0d0cef52-30ca-4c47-a249-180f154f724e"/>
						    <a:da name="REF" value="ASTyped:SwAddrMethod"/>
						  </v:ref>
                        </v:ctr>
                      </v:lst>
                      <v:lst name="OsIocReceiverProperties" type="MAP">
                        <a:da name="MIN" value="1"/>
						<a:da name="INVALID" type="XPath">
						  <a:tst expr="(count(../OsIocBufferLength/*) = 0) or
									   ((count(../OsIocBufferLength/*) > 0) and (count(./*) = 1))"
							     false="Number of receiver in queued mode must be 1"/>
						</a:da>
                        <v:ctr name="OsIocReceiverProperties" 
                               type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: Representation of receiver properties for one communication. For each OsIocCommunication one (1:1) or many receivers (N:M) have to be defined. This container should be instantiated within an OsIocCommunication."/>
                          <a:a name="UUID" 
                               value="2a7293f8-b389-47cd-8af0-dbb6547efb5a"/>
						  <v:var name="OsIocReceiverId" type="INTEGER">
						    <a:a name="DESC" 
							     value="EN: Representation of a receiver in a N:M communication to distinguish between receivers."/>
						    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							     type="IMPLEMENTATIONCONFIGCLASS">
							  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
							  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						    </a:a>
						    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						    <a:a name="SCOPE" value="ECU"/>
						    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
						    <a:a name="UUID" 
							     value="5c51d3f2-f7f9-425b-852b-d4d298843868"/>
						    <a:da name="INVALID" type="Range">
							  <a:tst expr="&lt;=255"/>
							  <a:tst expr="&gt;=0"/>
						    </a:da>
							<a:da name="DEFAULT" type="XPath">
							  <a:tst expr="../@index"/>
						    </a:da>
						  </v:var>
                          <v:ref name="OsIocReceivingOsApplicationRef" 
                                 type="REFERENCE">
                            <a:a name="DESC" 
                                 value="EN: This attribute is a reference to the receiving OsApplication instance defined in the configuration file of the OS."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="UUID" 
                                 value="4cf32f76-2d02-4a32-aeeb-0aee2089121e"/>
                            <a:da name="REF" 
                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                          </v:ref>
						  <v:var name="OsIocFunctionImplementationKind" 
							     type="ENUMERATION">
						    <a:a name="DESC" 
							     value="EN: This parameter is used to select whether this communication is implemented as a macro or as a function."/>
						    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							     type="IMPLEMENTATIONCONFIGCLASS">
							  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
							  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						    </a:a>
						    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						    <a:a name="SCOPE" value="LOCAL"/>
						    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
						    <a:a name="UUID" 
							     value="edb3932a-18af-44f5-9adc-ad8ef7033e92"/>
						    <a:da name="DEFAULT" value="DO_NOT_CARE"/>
						    <a:da name="RANGE">
							  <a:v>DO_NOT_CARE</a:v>
							  <a:v>FUNCTION</a:v>
							  <a:v>MACRO</a:v>
						    </a:da>
						  </v:var>
                          <v:var name="OsIocReceiveCallbackEnable" type="BOOLEAN">
                            <a:a name="DESC" 
                                 value="EN: Select stack monitoring of Tasks/Category 2 ISRs"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="7419aa90-df07-40e0-8215-d91ef1f806da"/>
							<a:a name="DEFAULT" value="'false'"/>
                          </v:var>
						  <v:var name="OsIocReceiverPullCB" 
							     type="FUNCTION-NAME">
						    <a:a name="DESC" 
							     value="EN: This attribute defines the name of a callback function that the IOC shall call on the receiving core for each data reception."/>
						    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							     type="IMPLEMENTATIONCONFIGCLASS">
							  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
							  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						    </a:a>
						    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						    <a:a name="SCOPE" value="LOCAL"/>
						    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
						    <a:a name="UUID" 
							     value="f365f63f-9cc5-452d-bb33-a8e6d297c7cc"/>
							<a:da name="EDITABLE" type="XPath" expr="../OsIocReceiveCallbackEnable = 'true'" />
							<a:da name="DEFAULT" type="XPath">
							  <a:tst expr="concat('Rte_IocReceiveCB_Ioc', ../../../@index, '_', node:name(..))"/>
						    </a:da>
						  </v:var>
                          <v:var name="IocStackSize" type="INTEGER">
                              <a:a name="DESC" 
                                   value="EN: Indicate the stack size for this IOC Receiver, default value is 1K. "/>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                   type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                              <a:a name="SCOPE" value="LOCAL"/>
                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                              <a:a name="UUID" 
                                   value="591742cd-da9a-4c56-9b56-06211c69f397"/>
                              <a:da name="INVALID" type="Range">
                                <a:tst expr="&lt;=4294967295"/>
                                <a:tst expr="&gt;=0"/>
                              </a:da>
                              <a:da name="DEFAULT" value="1024"/>
							  <a:da name="EDITABLE" type="XPath" expr="../OsIocReceiveCallbackEnable = 'true'" />
                            </v:var>
                        </v:ctr>
                      </v:lst>
                      <v:lst name="OsIocSenderProperties" type="MAP">
                        <a:da name="MIN" value="1"/>
                        <v:ctr name="OsIocSenderProperties" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: Representation of sender properties for one communication. For each OsIocCommunication one (1:1) or many senders (N:1 or N:M) have to be defined. Multiplicity &gt; 1 (N:1 or N:M communication) is only allowed for Multiplicity of OsIocDataTypeRef = 1."/>
                          <a:a name="UUID" 
                               value="df32afc2-f696-4ac4-9937-fb438c3a4c18"/>
						  <v:var name="OsIocSenderId" type="INTEGER">
						    <a:a name="DESC" 
							     value="EN: Representation of a sender in a N:1 or N:M communication to distinguish between senders."/>
						    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							     type="IMPLEMENTATIONCONFIGCLASS">
							  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
							  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						    </a:a>
						    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						    <a:a name="SCOPE" value="ECU"/>
						    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
						    <a:a name="UUID" 
							     value="4d5b4e93-dd29-4d3f-ab82-f9b9abb60977"/>
						    <a:da name="INVALID" type="Range">
							  <a:tst expr="&lt;=255"/>
							  <a:tst expr="&gt;=0"/>
						    </a:da>
							<a:da name="DEFAULT" type="XPath">
							  <a:tst expr="../@index"/>
						    </a:da>
						  </v:var>
                          <v:ref name="OsIocSendingOsApplicationRef" 
                                 type="REFERENCE">
                            <a:a name="DESC" 
                                 value="EN: This attribute is a reference to the sending OS-Application instance defined in the configuration file of the OS."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="UUID" 
                                 value="30537ee2-2415-4cac-954d-762a0bcaf941"/>
                            <a:da name="REF" 
                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                          </v:ref>
						  <v:var name="OsIocFunctionImplementationKind" 
							     type="ENUMERATION">
						    <a:a name="DESC" 
							     value="EN: This parameter is used to select whether this communication is implemented as a macro or as a function."/>
						    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							     type="IMPLEMENTATIONCONFIGCLASS">
							  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
							  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						    </a:a>
						    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						    <a:a name="SCOPE" value="LOCAL"/>
						    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
						    <a:a name="UUID" 
							     value="d6cb9b39-abe6-494a-905e-a880f438f398"/>
						    <a:da name="DEFAULT" value="DO_NOT_CARE"/>
						    <a:da name="RANGE">
							  <a:v>DO_NOT_CARE</a:v>
							  <a:v>FUNCTION</a:v>
							  <a:v>MACRO</a:v>
						    </a:da>
						  </v:var>
                        </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
                </v:ctr>
              </v:lst>
              <v:lst name="OsIsr" type="MAP">
                <v:ctr name="OsIsr" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: The OsIsr container represents an ISO 17356 interrupt service routine."/>
                  <a:a name="UUID" value="a184e0dd-de90-470a-9c83-08f414512402"/>
				  <a:da name="INVALID" type="XPath">
                    <a:tst expr="text:contains(concat(text:split(../../OsApplication/*/OsAppIsrRef/*, ' '), ' '), as:path(.))"
                    false = "This Isr does not reference by any Application"/>  
                  </a:da>
                  <v:var name="OsIsrCategory" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: This attribute specifies the category of this ISR."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="c64b35ef-52bb-4244-90cc-97f287fb82c6"/>
                    <a:da name="RANGE">
                      <a:v>CATEGORY_1</a:v>
                      <a:v>CATEGORY_2</a:v>
                    </a:da>
                  </v:var>
				  <v:var name="OsIsrInterruptSource" type="INTEGER">
                       <a:a name="DESC" value="EN: Interrupt source of this ISR. &lt;br/&gt;
											   Software Interrupt:0-15 &lt;br/&gt;
											   Peripheral Interrupt:16-991 &lt;br/&gt;
											   In multicore case, 0-(maxcore-2) must be used to cross core service call notification" />
                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                       </a:a>
                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                       <a:a name="SCOPE" value="ECU" />
                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                       <a:a name="UUID" value="badb922c-fc6c-4da1-bcd6-3c423d586ebe" />
                       <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=991" />
                            <a:tst expr="&gt;=0" />
                       </a:da>
                  </v:var>
				  <v:var name="OsIsrPriority" type="INTEGER">
                       <a:a name="DESC" value="EN: Priority of this ISR. From 0 to 31." />
                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                       </a:a>
                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                       <a:a name="SCOPE" value="ECU" />
                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                       <a:a name="UUID" value="badb922c-fc6c-4da1-bcd6-3c423d586ebe" />
                       <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=31" />
                            <a:tst expr="&gt;=0" />
                       </a:da>
                  </v:var>
				  <v:var name="OsIsrTriggerMethod" type="ENUMERATION">
                       <a:a name="DESC" value="EN:Select the interrupt source trigger method.&lt;br/&gt;
                                        LEVEL: level-sensitive&lt;br/&gt;
                                        EDGE: edge-triggered&lt;br/&gt;
                                        If this parameter is grayed out indicates that is non-configurable." />
                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                       </a:a>
                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                       <a:a name="SCOPE" value="ECU" />
                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                       <a:a name="UUID" value="badb922c-fc6c-4da1-bcd6-3c423d586ebe" />
					   <a:da name="DEFAULT" type="XPath">
                            <a:tst expr="node:when(ecu:list('Os.IsrTriggerMethodList')[num:i(node:current()/../OsIsrInterruptSource + 1)] = '1',
												   ecu:list('Os.GicIntTriggerMethod')[1], ecu:list('Os.GicIntTriggerMethod')[2])" />
                       </a:da>
					   <a:da name="RANGE" type="XPath" expr="ecu:list('Os.GicIntTriggerMethod')" />
                  </v:var>
				  <v:var name="OsIsrSrcAssignedTo" type="ENUMERATION">
                       <a:a name="DESC" value="EN:Select whether to assign the interrupt to FIQ(Fast Interrupt Request) or IRQ(Interrupt Request)." />
                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                       </a:a>
                       <a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                       <a:a name="SCOPE" value="ECU" />
                       <a:a name="SYMBOLICNAMEVALUE" value="false" />
                       <a:a name="UUID" value="badb922c-fc6c-4da1-bcd6-3c423d586ebe" />
					   <a:da name="DEFAULT" value="IRQ" />
					   <a:da name="RANGE">
							<a:v>FIQ</a:v>
							<a:v>IRQ</a:v>
                       </a:da>
                  </v:var>
				  <v:var name="OsIsrHandler" type="FUNCTION-NAME">
						<a:a name="DESC" 
                             value="EN: Name of the function that is called when this ISR is triggered."/>
						<a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
						<a:a name="ORIGIN" value="AUTOSAR_ECUC" />
                        <a:a name="SCOPE" value="ECU" />
						<a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="d756aa8a-86a3-4d51-99b9-47710a011449"/>
						<a:da name="EDITABLE" type="XPath">
						  <a:tst expr="../OsIsrInterruptSource > (ecu:get('OsResource.NumOfCores')-2)"/>
						</a:da>
				  </v:var>
				  <v:var name="OsIsrInitialEnableInterruptSource" type="BOOLEAN">
						<a:a name="DESC" 
							value="EN: If the interrupt source of this ISR shall be enabled at interrupt installation. &lt;br/&gt;
							true: Interrupt source will be enabled automatically. &lt;br/&gt;
							false: Interrupt source will not be enabled automatically."/>
						<a:a name="IMPLEMENTATIONCONFIGCLASS" 
							type="IMPLEMENTATIONCONFIGCLASS">
						<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						</a:a>
						<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						<a:a name="SCOPE" value="ECU"/>
						<a:a name="SYMBOLICNAMEVALUE" value="false"/>
						<a:a name="UUID" value="ffd7f2e2-d3c0-4982-8589-7933af3d61d1"/>
						<a:da name="DEFAULT" value="false" />
                  </v:var>
                  <v:var name="IsrStackSize" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: Indicate the stack size for this ISR, default value is 1K. "/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="591742cd-da9a-4c56-9b56-06211c69f397"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:da name="DEFAULT" value="1024"/>
                  </v:var>
				  <v:var name="IsCrossCoreServiceCallIsr" type="BOOLEAN">
					<a:a name="DESC" 
						value="EN: If this isr is used to cross core service call isr"/>
					<a:a name="IMPLEMENTATIONCONFIGCLASS" 
						type="IMPLEMENTATIONCONFIGCLASS">
					<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					</a:a>
					<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					<a:a name="SCOPE" value="ECU"/>
					<a:a name="SYMBOLICNAMEVALUE" value="false"/>
					<a:a name="UUID" value="ffd7f2e2-d3c0-4982-8589-7933af3d61d1"/>
					<a:da name="DEFAULT" value="false" />
					<a:da name="INVALID" type="XPath">
				      <a:tst expr="((node:value(.) = 'true') and (../OsIsrInterruptSource &lt;= (ecu:get('OsResource.NumOfCores')-2))) or
								   ((node:value(.) = 'false') and (../OsIsrInterruptSource &gt; (ecu:get('OsResource.NumOfCores')-2)))"
							 false="This Isr must be used to cross core service call"/>
				    </a:da>
                  </v:var>
				  <v:lst name="OsIsrAccessingApplication">
                    <v:ref name="OsIsrAccessingApplication" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to applications which have an access to this object."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="32dd0c1a-7153-4f78-a287-48f258b01f18"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsIsrPeriod">
                    <a:da name="MAX" value="1"/>
                    <v:var name="OsIsrPeriod" type="FLOAT">
                      <a:a name="DESC" 
                           value="EN: This parameter specifies the period in seconds of this ISR in case of a cyclically triggered interrupt."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="3214e7a1-73c5-4fa1-8bf5-d7d7c5b39e8b"/>
                    </v:var>
                  </v:lst>
                  <v:lst name="OsIsrResourceRef">
                    <v:ref name="OsIsrResourceRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: This reference defines the resources accessed by this ISR."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="41eae68f-8475-4298-bc1e-ab0b743a882d"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsResource"/>
					  <a:da name="INVALID" type="XPath">
						  <a:tst expr="text:uniq(../*, .)"
							     false="Duplicated reference"/>
					  </a:da>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsMemoryMappingCodeLocationRef">
                    <a:da name="MAX" value="1"/>
                    <v:ref name="OsMemoryMappingCodeLocationRef" 
                           type="FOREIGN-REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to the memory mapping containing details about the section where the code is placed."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="07274ebe-08a1-456e-aaca-341a8eaaa027"/>
                      <a:da name="REF" value="ASTyped:SwAddrMethod"/>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsIsrTimingProtection" type="MAP">
                    <a:da name="MAX" value="1"/>
                    <a:da name="ENABLE" type="XPath" 
                         expr="((../../../OsOS/OsScalabilityClass = 'SC4') or (../../../OsOS/OsScalabilityClass = 'SC2')) and (../OsIsrCategory = 'CATEGORY_2')"
                         true="true" false="false"/>
                    <v:ctr name="OsIsrTimingProtection" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains all parameters which are related to timing protection"/>
                      <a:a name="UUID" 
                           value="48ee3f9c-de00-4de8-a17b-5915d5330f70"/>
					  <a:da name="INVALID" type="XPath">
						<a:tst expr="../../OsIsrCategory = 'CATEGORY_1'"
							   true="Category1 isr cannot configure timing protection."/>
					  </a:da>
					  <v:var name="OsIsrAllInterruptLockBudget" type="FLOAT">
					    <a:a name="DESC" 
						     value="EN: This parameter contains the maximum time for which the ISR is allowed to lock all interrupts (via SuspendAllInterrupts() or DisableAllInterrupts()) (in seconds)."/>
					    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						     type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					    </a:a>
					    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					    <a:a name="SCOPE" value="ECU"/>
					    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					    <a:a name="UUID" 
						     value="1a9daae6-de01-41f1-bf1c-235d8ba9debb"/>
					    <a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=Infinity"/>
						  <a:tst expr="&gt;=0.0"/>
					    </a:da>
						<a:da name="OPTIONAL" value="true" />
					  </v:var>
					  <v:var name="OsIsrExecutionBudget" type="FLOAT">
					    <a:a name="DESC" 
						     value="EN: The parameter contains the maximum allowed execution time of the interrupt (in seconds)."/>
					    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						     type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					    </a:a>
					    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					    <a:a name="SCOPE" value="ECU"/>
					    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					    <a:a name="UUID" 
						     value="5dd6dafb-c35a-4b2b-a665-d48c3955b69c"/>
					    <a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=Infinity"/>
						  <a:tst expr="&gt;=0.0"/>
					    </a:da>
						<a:da name="OPTIONAL" value="true" />
					  </v:var>
					  <v:var name="OsIsrOsInterruptLockBudget" type="FLOAT">
					    <a:a name="DESC" 
						     value="EN: This parameter contains the maximum time for which the ISR is allowed to lock all Category 2 interrupts (via SuspendOSInterrupts()) (in seconds)."/>
					    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						     type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					    </a:a>
					    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					    <a:a name="SCOPE" value="ECU"/>
					    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					    <a:a name="UUID" 
						     value="18318034-e40e-4de5-80c4-54ee47caae5e"/>
					    <a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=Infinity"/>
						  <a:tst expr="&gt;=0.0"/>
					    </a:da>
						<a:da name="OPTIONAL" value="true" />
					  </v:var>
					  <v:var name="OsIsrTimeFrame" type="FLOAT">
					    <a:a name="DESC" 
						     value="EN: This parameter contains the minimum inter-arrival time between successive interrupts (in seconds)."/>
					    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						     type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					    </a:a>
					    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					    <a:a name="SCOPE" value="ECU"/>
					    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					    <a:a name="UUID" 
						     value="17f1483c-891d-4abd-a594-cf570f71103d"/>
					    <a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=Infinity"/>
						  <a:tst expr="&gt;=0.0"/>
					    </a:da>
						<a:da name="OPTIONAL" value="true" />
					  </v:var>
                      <v:lst name="OsIsrResourceLock" type="MAP">
                        <v:ctr name="OsIsrResourceLock" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: This container contains a list of times the interrupt uses resources."/>
                          <a:a name="UUID" 
                               value="57b8c957-4d5a-4d6d-98e6-2c06066036bc"/>
                          <v:var name="OsIsrResourceLockBudget" type="FLOAT">
                            <a:a name="DESC" 
                                 value="EN: This parameter contains the maximum time the interrupt is allowed to hold the given resource (in seconds)."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                 value="30867178-d1e1-435d-bc57-ed1b1276de38"/>
                            <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;=Infinity"/>
                              <a:tst expr="&gt;=0.0"/>
                            </a:da>
                          </v:var>
                          <v:ref name="OsIsrResourceLockResourceRef" 
                                 type="REFERENCE">
                            <a:a name="DESC" 
                                 value="EN: Reference to the resource the locking time is depending on"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="UUID" 
                                 value="71cc2753-a9ac-46be-8871-00885f8159fd"/>
                            <a:da name="REF" 
                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsResource"/>
						    <a:da name="INVALID" type="XPath">
							  <a:tst expr="text:uniq(../../*/OsIsrResourceLockResourceRef, .)"
									 false="Duplicated reference"/>
							</a:da>
                          </v:ref>
                        </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>

                  <v:lst name="OsIsrMemoryProtection" type="MAP">
                    <a:da name="ENABLE" type="XPath" 
                          expr="(../../../OsOS/OsScalabilityClass = 'SC4') or (../../../OsOS/OsScalabilityClass = 'SC3')"
                          true="true" false="false"/>
                          <v:ctr name="OsIsrMemoryProtection" type="IDENTIFIABLE">
                              <v:chc name="OsIsrMemoryProtectionChoice" type="IDENTIFIABLE">
                                   <a:a name="DESC" 
                                        value="EN: This container defines way to define Address region."/>
                                   <a:a name="UUID" 
                                        value="0398b4b3-eab7-4a09-b1c1-c913a9af0e84"/>
                                   <v:ctr name="RegionSelect" type="IDENTIFIABLE">
                                     <a:a name="DESC" 
                                          value="EN: This container specifies region."/>
                                     <a:a name="UUID" 
                                          value="4f491a06-34fb-4f8a-ae3a-6f57b3e4f543"/>
                                        <v:ref name="MemoryBlockRef" type="REFERENCE">
                                             <a:a name="DESC" 
                                                  value="EN: Reference to applications which have an access to this object."/>
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                             <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                             <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                             </a:a>
                                             <a:da name="INVALID" type="XPath">
                                             <a:tst expr="node:refexists(node:current())"
                                                       false = "Failed to reference a specific Memory Block"/>
                                             </a:da>
                                             <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                             <a:a name="UUID" 
                                                  value="9439a6a6-392d-4be3-bee2-9dcf715129a7"/>
                                             <a:da name="REF" 
                                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/MemoryBlock"/>
                                        </v:ref>
                                   </v:ctr>
                                   <v:ctr name="RegionWritten" type="IDENTIFIABLE">
                                     <a:a name="DESC" 
                                          value="EN: This container specifies the parameters to call a callback OS alarm action."/>
                                     <a:a name="UUID" 
                                          value="808f6a7c-53a6-49e0-8772-e821c424684b"/>
                                          <v:var name="OsIsrMemoryProtectionStartAddress" type="INTEGER">
                                             <a:a name="DESC" 
                                                  value="EN: This parameter contains the Start Address for memory protection"/>
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                               <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                             </a:a>
                                             <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                             <a:a name="SCOPE" value="ECU"/>
                                             <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                             <a:a name="UUID" 
                                                  value="6feba334-4c0e-4524-89d5-2ddce875abde"/>
                                             <a:da name="DEFAULT" value="0" />
                                             <a:da name="INVALID" type="Range">
                                               <a:tst expr="&lt;= ../OsIsrMemoryProtectionEndAddress"/>
                                               <a:tst expr="&gt;= 0"/>
                                             </a:da>
                                           </v:var>
                                           <v:var name="OsIsrMemoryProtectionEndAddress" type="INTEGER">
                                              <a:a name="DESC" 
                                                   value="EN: This parameter contains the End Address for memory protection"/>
                                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                   type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                              </a:a>
                                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                              <a:a name="SCOPE" value="ECU"/>
                                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                              <a:a name="UUID" 
                                                   value="6febaaa4-4c0e-4524-89d5-2ddce875abde"/>
                                              <a:da name="DEFAULT" value="0" />
                                              <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;= 4294967295"/>
                                                <a:tst expr="&gt;= 0"/>
                                              </a:da>
                                            </v:var>
                                   </v:ctr>
                                 </v:chc>    
                              
                              <v:var name="IsrRegionReadWriteAccess" type="ENUMERATION">
                                   <a:a name="DESC" value="EN: This parameter contains Read and Write Access for this region"/>
                                   <a:a name="ORIGIN" value="ChipowerTech" />
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                   <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                   <a:a name="UUID" value="0aaccac4-de79-4565-8120-830dc23e3679" />
                                   <a:da name="DEFAULT" value="MPU_EL1_RW_EL0_NONE" />
                                   <a:da name="RANGE">
                                        <a:v>MPU_EL1_RW_EL0_NONE</a:v>
                                        <a:v>MPU_EL1_RW_EL0_RW</a:v>
                                        <a:v>MPU_EL1_R_EL0_NONE</a:v>
                                        <a:v>MPU_EL1_R_EL0_R</a:v>
                                   </a:da>
                                 </v:var>
                                 <v:var name="IsrExecutionAccess" type="ENUMERATION">
                                   <a:a name="DESC" value="EN: This parameter contains Execution Access for this region"/>
                                   <a:a name="ORIGIN" value="ChipowerTech" />
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                   <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                   <a:a name="UUID" value="0aa5bbb4-de79-4565-8120-830dc23e3679" />
                                   <a:da name="DEFAULT" value="MPU_EXECUTE_NEVER" />
                                   <a:da name="RANGE">
                                   <a:v>MPU_EXECUTE_NEVER</a:v>
                                   <a:v>MPU_EXECUTE_ALLOWED</a:v>
                                   </a:da>
                              </v:var>
                         </v:ctr> 
                         </v:lst>

                  <v:lst name="OsIsrAccessCheck" type="MAP">
                    <a:da name="ENABLE" type="XPath" 
                         expr="(../../../OsOS/OsScalabilityClass = 'SC4') or (../../../OsOS/OsScalabilityClass = 'SC3')"
                         true="true" false="false"/>
                    <v:ctr name="OsIsrAccessCheck" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains the region for Access check."/>
                      <a:a name="UUID" 
                           value="13e51a89-f010-4914-8cd6-19d9c82de9d7"/>
                      <v:var name="OsIsrAccessCheckStartAddress" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: This parameter contains the Start Address for Access check"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="6feba724-4c0e-4524-89d5-2ddce875abde"/>
                         <a:da name="DEFAULT" value="0" />
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;= ../OsIsrAccessCheckEndAddress"/>
                          <a:tst expr="&gt;= 0"/>
                        </a:da>
                      </v:var>
                      <v:var name="OsIsrAccessCheckEndAddress" type="INTEGER">
                         <a:a name="DESC" 
                              value="EN: This parameter contains the End Address for Access check"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                           <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                         <a:a name="SCOPE" value="ECU"/>
                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                         <a:a name="UUID" 
                              value="6feba724-4c0e-4524-89d5-2ddce875abde"/>
                         <a:da name="DEFAULT" value="0" />
                         <a:da name="INVALID" type="Range">
                           <a:tst expr="&lt;= 4294967295"/>
                           <a:tst expr="&gt;= ../OsIsrAccessCheckStartAddress"/>
                         </a:da>
                       </v:var>
                       <v:var name="IsrAccessRight" type="ENUMERATION">
                         <a:a name="DESC" value="EN: This parameter contains Access Right"/>
                         <a:a name="ORIGIN" value="ChipowerTech" />
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:a name="SYMBOLICNAMEVALUE" value="false" />
                         <a:a name="UUID" value="0aa5bac4-de79-4565-8120-830dc23e3679" />
                         <a:da name="DEFAULT" value="OS_MEM_ACCESS_NON" />
                         <a:da name="RANGE">
                         <a:v>OS_MEM_ACCESS_NON</a:v>
                         <a:v>OS_MEM_ACCESS_READ</a:v>
                         <a:v>OS_MEM_ACCESS_WRITE</a:v>
                         <a:v>OS_MEM_ACCESS_RW</a:v>
                         <a:v>OS_MEM_ACCESS_EXECUTE</a:v>
                         <a:v>OS_MEM_ACCESS_REX</a:v>
                         <a:v>OS_MEM_ACCESS_WEX</a:v>
                         <a:v>OS_MEM_ACCESS_RWEX</a:v>
                         <a:v>OS_MEM_ACCESS_STACK</a:v>
                         <a:v>OS_MEM_ACCESS_SR</a:v>
                         <a:v>OS_MEM_ACCESS_SW</a:v>
                         <a:v>OS_MEM_ACCESS_SRW</a:v>
                         <a:v>OS_MEM_ACCESS_SEX</a:v>
                         <a:v>OS_MEM_ACCESS_SREX</a:v>
                         <a:v>OS_MEM_ACCESS_SWEX</a:v>
                         <a:v>OS_MEM_ACCESS_SRWEX</a:v>
                         </a:da>
                       </v:var>
                    </v:ctr>
                  </v:lst>
                </v:ctr>
              </v:lst>
              <v:ctr name="OsOS" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: OS is the object used to define ISO 17356-3 properties for an ISO 17356 application."/>
                <a:a name="UUID" value="4b44e35b-c8a8-4895-9444-dcbd293cec1b"/>
                <a:a name="TAB" value="OsOS"/>

                  <v:var name="OsNumberOfCores" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: Maximum number of cores that are controlled by the OS."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="77c6d453-b1ef-4c5f-bc23-237171db4362"/>
                    <a:da name="DEFAULT" type="XPath" expr="ecu:get('OsResource.NumOfCores')"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=65535"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                  </v:var>

                  <v:var name="OsScalabilityClass" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: A scalability class for each System Object &quot;OS&quot; has to be selected. In order to customize the operating system to the needs of the user and to take full advantage of the processor features the operating system can be scaled according to the scalability classes."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="d2795975-885d-4f90-9cd2-b5ba571069e6"/>
                    <a:da name="DEFAULT" value="SC1"/>     
                    <a:da name="RANGE">
                      <a:v>SC1</a:v>
                      <a:v>SC2</a:v>
                      <a:v>SC3</a:v>
                      <a:v>SC4</a:v>
                    </a:da>
                  </v:var>

                <v:var name="OsStackMonitoring" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Select stack monitoring of Tasks/Category 2 ISRs"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="ECU"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="7419aa90-df07-40e0-8215-d91ef1f806da"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>

                <v:var name="OsStatus" type="ENUMERATION">
                  <a:a name="DESC" 
                       value="EN: The Status attribute specifies whether a system with standard or extended status has to be used. Automatic assignment is not supported for this attribute."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="5663c48c-6337-427a-9f70-e89f0fcd90f6"/>
                  <a:da name="DEFAULT" value="STANDARD"/>
                  <a:da name="INVALID" type="XPath">
                    <a:tst expr="('SC3' = node:value(./../OsScalabilityClass) or 'SC4' = node:value(./../OsScalabilityClass)) and node:value(.) = 'STANDARD' "
                    true = "[SWS_Os_00328] If OsStatus is STANDARD and OsScalabilityClass is SC3 or SC4 the consistency check shall issue an error."/>  
                  </a:da>
                  <a:da name="RANGE">
                    <a:v>EXTENDED</a:v>
                    <a:v>STANDARD</a:v>
                  </a:da>
                </v:var>
                <v:var name="OsUseServiceProtection" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: The OsUseServiceProtection attribute defines whether the OS performs service protection check."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="eb551294-99f2-4871-8d93-ccb1eb252876"/>
                  <a:da name="DEFAULT" value="false"/>
				  <a:da name="INVALID" type="XPath">
					<a:tst expr="(node:value(.) = 'true') and (../OsStatus = 'STANDARD')"
                    true = "[SWS_Os_00050] If service protection is required and OsStatus is not equal to EXTENDED (all the associated error handling is provided), the consistency check shall issue an error."/>  
				  </a:da>
                </v:var>

                <v:var name="OsUseArti" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: The OsUseArti attribute defines whether the OS uses and calls ARTI hooks. This includes also the generation of related ARTI artifacts by the generator."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="eb551294-99f2-4871-8d93-ccb1eb252876"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="OsVendorArtiStateModel" type="ENUMERATION">
                  <a:a name="DESC" 
                       value="EN: Vendor specific. ARTI state model of Tasks and Cat2 ISRs: ENHANCED uses the classes AR_CP_OSARTI_TASK / AR_CP_OSARTI_CAT2ISR (SWS OS 7.17, preferred), STANDARD uses AR_CP_OS_TASK / AR_CP_OS_CAT2ISR. Also sets ArtiStatesTaskEnhanced in the ARTI description."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="5e3be4cf-a9e9-4a00-95b5-ef81b0ccc780"/>
                  <a:da name="DEFAULT" value="ENHANCED"/>
                  <a:da name="ENABLE" type="XPath" expr="../OsUseArti = 'true'"
                        true="true" false="false"/>
                  <a:da name="RANGE">
                    <a:v>ENHANCED</a:v>
                    <a:v>STANDARD</a:v>
                  </a:da>
                </v:var>
                <v:var name="OsVendorArtiTraceApplication" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Vendor specific. Emit the ARTI hook events of class AR_CP_OS_APPLICATION and describe them in the ARTI description. Only effective when OsUseArti is true."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="c032907c-8844-4178-863e-a20e5f1b195e"/>
                  <a:da name="DEFAULT" value="true"/>
                  <a:da name="ENABLE" type="XPath" expr="../OsUseArti = 'true'"
                        true="true" false="false"/>
                </v:var>
                <v:var name="OsVendorArtiTraceTask" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Vendor specific. Emit the ARTI hook events of class AR_CP_OS_TASK / AR_CP_OSARTI_TASK and describe them in the ARTI description. Only effective when OsUseArti is true."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="53fbbe59-f94a-43b0-8694-c9d8c2e5b229"/>
                  <a:da name="DEFAULT" value="true"/>
                  <a:da name="ENABLE" type="XPath" expr="../OsUseArti = 'true'"
                        true="true" false="false"/>
                </v:var>
                <v:var name="OsVendorArtiTraceCat2Isr" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Vendor specific. Emit the ARTI hook events of class AR_CP_OS_CAT2ISR / AR_CP_OSARTI_CAT2ISR and describe them in the ARTI description. Only effective when OsUseArti is true."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="751c6873-5dc3-4ec7-a11a-ecebd8456da8"/>
                  <a:da name="DEFAULT" value="true"/>
                  <a:da name="ENABLE" type="XPath" expr="../OsUseArti = 'true'"
                        true="true" false="false"/>
                </v:var>
                <v:var name="OsVendorArtiTraceServiceCalls" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Vendor specific. Emit the ARTI hook events of class AR_CP_OS_SERVICECALLS and describe them in the ARTI description. Entry and exit of every OS service: high run-time cost, off by default. Only effective when OsUseArti is true."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="76156581-baea-4748-9880-9473467c8c91"/>
                  <a:da name="DEFAULT" value="false"/>
                  <a:da name="ENABLE" type="XPath" expr="../OsUseArti = 'true'"
                        true="true" false="false"/>
                </v:var>
                <v:var name="OsVendorArtiTraceSpinlock" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Vendor specific. Emit the ARTI hook events of class AR_CP_OS_SPINLOCK and describe them in the ARTI description. Only effective when OsUseArti is true."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="9779219b-ac2d-4fd7-9d17-be507adb6fe5"/>
                  <a:da name="DEFAULT" value="true"/>
                  <a:da name="ENABLE" type="XPath" expr="../OsUseArti = 'true'"
                        true="true" false="false"/>
                </v:var>
                <v:var name="OsVendorArtiTraceHook" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Vendor specific. Emit the ARTI hook events of class AR_CP_OS_HOOK and describe them in the ARTI description. Only effective when OsUseArti is true."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="ChipowerTech"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="9edb7744-df3c-48c2-8703-a2c6ad5aa372"/>
                  <a:da name="DEFAULT" value="true"/>
                  <a:da name="ENABLE" type="XPath" expr="../OsUseArti = 'true'"
                        true="true" false="false"/>
                </v:var>
                <v:var name="OsUseGetServiceId" type="BOOLEAN">
                  <a:a name="DESC" value="EN: As defined by ISO 17356"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                       <a:da name="DEFAULT" value="true"/>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="07494c20-9286-43ca-bb6f-b31d46a78c67"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="OsUseParameterAccess" type="BOOLEAN">
                  <a:a name="DESC" value="EN: As defined by ISO 17356"/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                       <a:da name="DEFAULT" value="true"/>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="2f77eab0-dcea-490c-95d0-8bbf34b980cb"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="OsUseResScheduler" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: The OsUseResScheduler attribute defines whether the resource RES_SCHEDULER is used within the application."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="657f9769-51b9-469e-9db6-75dfa50797d2"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>

                <v:ctr name="OsHooks" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: Container to structure all hooks belonging to the OS"/>
                  <a:a name="UUID" value="366857d4-39ef-4494-8200-ee974af9cb33"/>
                  <v:var name="OsErrorHook" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Error hook as defined by ISO 17356"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="e2e08212-398d-40dd-9a07-7e78fe345998"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="OsPostTaskHook" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Post-task hook as defined by ISO 17356"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="3a3d137c-8ccf-4b5b-9e6b-993d1d6b17e6"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:var name="OsPreTaskHook" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Pre-task hook as defined by ISO 17356"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="ae5eb6e0-e80b-4abe-97bc-893bd08c7467"/>
                    <a:da name="DEFAULT" value="false"/>
                  </v:var>

                  <v:var name="OsProtectionHook" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Switch to enable/disable the call to the (user supplied) protection hook."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="9d8d17de-f43f-4d81-bfac-987f59e401e0"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:da name="ENABLE" value="true"/>

                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="node:value(.) = 'true' and node:value(../../OsScalabilityClass) = 'SC1'"
                         true = "ProtectionHook is not used in SC1"/>  
                    </a:da>
                  </v:var>

                  <v:var name="OsShutdownHook" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Shutdown hook as defined by ISO 17356"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="169253d5-6c64-4640-9090-009e62543a67"/>
                    <a:da name="DEFAULT" value="false"/>     
                  </v:var>
                  <v:var name="OsStartupHook" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Startup hook as defined by ISO 17356"/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="b64dd4c3-790a-46a4-9f45-516f1b936c8f"/>
                    <a:da name="DEFAULT" value="false"/>     
                  </v:var>
                  <v:lst name="OsMemoryMappingCodeLocationRef">
                    <a:da name="MAX" value="1"/>
                    <v:ref name="OsMemoryMappingCodeLocationRef" 
                           type="FOREIGN-REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to the memory mapping containing details about the section where the code is placed."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="a9d22f2b-c0aa-4c0a-b0c1-e01d412bcfac"/>
                      <a:da name="REF" value="ASTyped:SwAddrMethod"/>
                    </v:ref>
                  </v:lst>
                </v:ctr>


              </v:ctr>
              <v:lst name="OsPeripheralArea" type="MAP">
                <a:da name="MAX" value="65534"/>
                <v:ctr name="OsPeripheralArea" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: Container to structure the configuration parameters of one peripheral area. The container short name can be used to access this area."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="UUID" value="89b25c8e-a219-407e-9e8f-880cba79a051"/>
                  <v:var name="OsPeripheralAreaStartAddress" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: First valid address of a peripheral area."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="21ab36ae-1169-48e8-bb41-d786bfdba691"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=../OsPeripheralAreaEndAddress"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:da name="DEFAULT" value="0"/>
                  </v:var>
                  <v:var name="OsPeripheralAreaEndAddress" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: Last valid address of a peripheral area."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="efd8be5a-2e98-4b3f-ac2e-d1d30fb82d5d"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=18446744073709551615"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:da name="DEFAULT" value="0"/>
                  </v:var>
                  <v:lst name="OsPeripheralAreaAccessingApplication">
                    <v:ref name="OsPeripheralAreaAccessingApplication" 
                           type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to application which have access to this object."/>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="00adc922-a580-4015-82ed-89a06cc8f15a"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                      <a:da name="INVALID" type="XPath">
                         <a:tst expr="node:refexists(.)"
                         false = "This referenced Application do not exists"/>  
                      </a:da>
                    </v:ref>
                  </v:lst>
                </v:ctr>
              </v:lst>
              <v:lst name="OsResource" type="MAP">
                <v:ctr name="OsResource" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: An OsResource object is used to co-ordinate the concurrent access by tasks and ISRs to a shared resource, e.g. the scheduler, any program sequence, memory or any hardware area."/>
                  <a:a name="UUID" value="86c92fde-4838-4170-9a5c-4fd1c03503ed"/>
				  <a:da name="INVALID" type="XPath">
					  <a:tst expr="(@name = 'RES_SCHEDULER') and (node:value(../../OsOS/OsUseResScheduler) = 'true')"
							 true="Name of resource cannot be RES_SCHEDULER!!"/>
					  <a:tst expr="(OsResourceProperty = 'LINKED') or text:contains(concat(text:split(../../OsTask/*/OsTaskResourceRef/*, ' '), text:split(../../OsIsr/*/OsIsrResourceRef/*, ' ')), as:path(.))"
						     false = "This Resource does not reference by any Task or Isr"/> 
				  </a:da>
                  <v:var name="OsResourceProperty" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: This specifies the type of the resource."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="a764c3c3-e725-47a1-a3c7-cf70431aeb95"/>
                    <a:da name="RANGE">
                      <a:v>INTERNAL</a:v>
                      <a:v>LINKED</a:v>
                      <a:v>STANDARD</a:v>
                    </a:da>
                  </v:var>
				  <v:ref name="OsResourceCoreRef" type="REFERENCE">
				    <a:a name="DESC" 
					     value="EN: The core which resource belongs to."/>
				    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
			  		     type="IMPLEMENTATIONCONFIGCLASS">
					  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
				  	  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
				    </a:a>
				    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
				    <a:a name="SCOPE" value="LOCAL"/>
				    <a:a name="UUID" 
					     value="3094c4d1-1457-4025-8b01-dba4c97581f2"/>
				    <a:da name="REF" 
						  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCoreIdMappingConfig"/>
					<a:da name="ENABLE" type="XPath">
					  <a:tst expr="(../OsResourceProperty != 'LINKED') or (../OsResourceLinkedToResScheduler = 'true')"/>
				    </a:da>
                        <a:da name="INVALID" type="XPath">
                         <a:tst expr="node:refexists(.)"
                         false="the Referenced CoreId does not exists"/>
                       </a:da>
				  </v:ref>
				  <v:var name="OsResourceLinkedToResScheduler" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: If this resource is linked to RES_SCHEDULER."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="ffd7f2e2-d3c0-4982-8589-7933af3d61d1"/>
					<a:da name="DEFAULT" value="false"/>
					<a:da name="EDITABLE" type="XPath">
					  <a:tst expr="(../OsResourceProperty = 'LINKED') and (../../../OsOS//OsUseResScheduler = 'true')"/>
				    </a:da>
                  </v:var>
				  <v:ref name="OsResourceLinkedResourceRef" type="REFERENCE">
				    <a:a name="DESC" 
					     value="EN: The link to the resource. Must be valid if OsResourceProperty is LINKED."/>
				    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
			  		     type="IMPLEMENTATIONCONFIGCLASS">
					  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
				  	  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
				    </a:a>
				    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
				    <a:a name="SCOPE" value="LOCAL"/>
				    <a:a name="UUID" 
					     value="3094c4d1-1457-4025-8b01-dba4c97581f2"/>
				    <a:da name="REF" 
						  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsResource"/>
				    <a:da name="ENABLE" type="XPath">
					  <a:tst expr="(../OsResourceProperty = 'LINKED') and (../OsResourceLinkedToResScheduler = 'false')"/>
				    </a:da>					
				  </v:ref>
                  <v:lst name="OsResourceAccessingApplication">
                    <v:ref name="OsResourceAccessingApplication" 
                           type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to applications which have an access to this object."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="e43581dc-89bb-4465-b0c3-d8c38d12cb86"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                    </v:ref>
					<a:da name="ENABLE" type="XPath">
					  <a:tst expr="(../OsResourceProperty != 'LINKED') or (../OsResourceLinkedToResScheduler = 'true')"/>
				    </a:da>
                  </v:lst>
                </v:ctr>
              </v:lst>
              <v:lst name="OsScheduleTable" type="MAP">
                <v:ctr name="OsScheduleTable" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: An OsScheduleTable addresses the synchronization issue by providing an encapsulation of a statically defined set of alarms that cannot be modified at runtime."/>
                  <a:a name="UUID" value="74c906d1-a3aa-49ee-a292-7803a5a216c2"/>
				  <a:da name="INVALID" type="XPath">
                    <a:tst expr="text:contains(concat(text:split(../../OsApplication/*/OsAppScheduleTableRef/*, ' '), ' '), as:path(.))"
                    false = "This ScheduleTable does not reference by any Application"/>  
                  </a:da>
                  <v:var name="OsScheduleTableDuration" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: This parameter defines the modulus of the schedule table (in ticks)."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="e0992dca-c65b-40a6-97d5-1a1ce0824c5f"/>
                    <a:da name="INVALID" type="XPath">
                      <a:tst expr="(../OsScheduleTblSyncStrategy = 'NONE') or
								   ((../OsScheduleTblSyncStrategy = 'IMPLICIT') and (node:value(.) = (node:value(node:ref(../OsScheduleTableCounterRef)/OsCounterMaxAllowedValue) + 1))) or
								   ((../OsScheduleTblSyncStrategy = 'EXPLICIT') and (node:value(.) &lt;= (node:value(node:ref(../OsScheduleTableCounterRef)/OsCounterMaxAllowedValue) + 1)))"
							 false="For implicitly synchronized, duration must equal to OsCounterMaxAllowedValue +1 of its associated OSEK OS Counter.
									For explicitly synchronized, duration must no greater than modulus of the drive Counter."/>
                    </a:da>
                  </v:var>
                  <v:var name="OsScheduleTableRepeating" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: true: first expiry point on the schedule table shall be processed at final expiry point delay ticks after the final expiry point is processed."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="ffd7f2e2-d3c0-4982-8589-7933af3d61d1"/>
					<a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <v:ref name="OsScheduleTableCounterRef" type="REFERENCE">
                    <a:a name="DESC" 
                         value="EN: This parameter contains a reference to the counter which drives the schedule table."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="ECU"/>
                    <a:a name="UUID" 
                         value="e93ba0ce-53ba-4f3c-9cf0-e6cafd332841"/>
                    <a:da name="REF" 
                          value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCounter"/>
                  </v:ref>
				  <v:var name="OsScheduleTblSyncStrategy" type="ENUMERATION">
					<a:a name="DESC" 
						 value="EN: AUTOSAR OS provides support for synchronization in two ways: explicit and implicit."/>
					<a:a name="IMPLEMENTATIONCONFIGCLASS" 
						 type="IMPLEMENTATIONCONFIGCLASS">
					  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					</a:a>
					<a:a name="ORIGIN" value="AUTOSAR ECUC"/>
					<a:a name="SCOPE" value="ECU"/>
					<a:a name="SYMBOLICNAMEVALUE" value="false"/>
					<a:a name="UUID" 
						 value="9aea51b4-dff6-4fab-9229-2f61e3c8cd2b"/>
					<a:da name="DEFAULT" value="NONE"/>
					<a:da name="RANGE">
					  <a:v>EXPLICIT</a:v>
					  <a:v>IMPLICIT</a:v>
					  <a:v>NONE</a:v>
					</a:da>
				  </v:var>
				  <v:var name="OsScheduleTblExplicitPrecision" 
					     type="INTEGER">
				    <a:a name="DESC" 
					     value="EN: This configuration is only valid if the explicit synchronization is used."/>
				    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
				  	     type="IMPLEMENTATIONCONFIGCLASS">
					  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
					  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
				    </a:a>
				    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
				    <a:a name="SCOPE" value="ECU"/>
				    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
				    <a:a name="UUID" 
					     value="ffc408b7-a693-49e0-8f2c-4328f675a21a"/>
				    <a:da name="INVALID" type="Range">
					  <a:tst expr="&lt;=../OsScheduleTableDuration"/>
					  <a:tst expr="&gt;=0"/>
				    </a:da>
					<a:da name="EDITABLE" type="XPath">
					  <a:tst expr="../OsScheduleTblSyncStrategy = 'EXPLICIT'"/>
				    </a:da>
					<a:a name="DEFAULT" value="0"/>
				  </v:var>
                  <v:lst name="OsSchTblAccessingApplication">
                    <v:ref name="OsSchTblAccessingApplication" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to applications which have an access to this object."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="c6b3e65e-c23d-4b59-be1c-ef123b11ca49"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsScheduleTableAutostart" type="MAP">
                    <a:da name="MAX" value="1"/>
                    <v:ctr name="OsScheduleTableAutostart" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container specifies if and how the schedule table is started on startup of the Operating System. The options to start a schedule table correspond to the API calls to start schedule tables during runtime."/>
                      <a:a name="UUID" 
                           value="4f0729b7-eed1-4971-be76-2079acb9e3e9"/>
                      <v:var name="OsScheduleTableAutostartType" 
                             type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: This specifies the type of the autostart for the schedule table."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="a977ee74-f5a5-40b3-b805-2b0655ac4847"/>
                        <a:da name="RANGE">
                          <a:v>ABSOLUTE</a:v>
                          <a:v>RELATIVE</a:v>
                          <a:v>SYNCHRON</a:v>
                        </a:da>
                      </v:var>
					  <v:var name="OsScheduleTableStartValue" type="INTEGER">
					    <a:a name="DESC" 
						     value="EN: Absolute autostart tick value when the schedule table starts. Only used if the OsScheduleTableAutostartType is ABSOLUTE."/>
					    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						     type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					    </a:a>
					    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					    <a:a name="SCOPE" value="ECU"/>
					    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					    <a:a name="UUID" 
						     value="2299229b-f116-45c7-8cc5-67052ec6f7ac"/>
					    <a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=18446744073709551615"/>
						  <a:tst expr="&gt;=0"/>
					    </a:da>
					  </v:var>
                      <v:lst name="OsScheduleTableAppModeRef">
                        <a:da name="MIN" value="1"/>
                        <v:ref name="OsScheduleTableAppModeRef" 
                               type="REFERENCE">
                          <a:a name="DESC" 
                               value="EN: Reference in which application modes the schedule table should be started during startup"/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="SCOPE" value="ECU"/>
                          <a:a name="UUID" 
                               value="0510d259-648e-40f4-9855-1d5bce9b91aa"/>
                          <a:da name="REF">
                              <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsAppMode</a:v>
                              <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OSDEFAULTAPPMODE</a:v>
                              <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OSALLRUNNINGMODE</a:v>
                          </a:da>
                        </v:ref>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
                  <v:lst name="OsScheduleTableExpiryPoint" type="MAP">
                    <a:da name="MIN" value="1"/>
                    <v:ctr name="OsScheduleTableExpiryPoint" 
                           type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: The point on a Schedule Table at which the OS activates tasks and/or sets events"/>
                      <a:a name="UUID" 
                           value="9784e0bd-1169-4bf8-9199-387ef591816a"/>
                      <v:var name="OsScheduleTblExpPointOffset" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: The offset from zero (in ticks) at which the expiry point is to be processed."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="522b6451-2355-453b-928c-0d4960853f80"/>
                        <a:da name="INVALID" type="XPath">
                          <a:tst expr="(node:value(.) = 0) or
									   ((node:value(.)&gt;=node:value(node:ref(../../../OsScheduleTableCounterRef)/OsCounterMinCycle)) and
									   (node:value(.)&lt;=node:value(node:ref(../../../OsScheduleTableCounterRef)/OsCounterMaxAllowedValue)))"
								 false="The Initial Offset shall be zero OR in the range OsCounterMin-Cycle..OsCounterMaxAllowedValue of the underlying Counter."/>
						  <a:tst expr="text:uniq(../../*/OsScheduleTblExpPointOffset, .)"
								 false="Expiry point offset must be unique in a schedule table."/>
                        </a:da>
                      </v:var>
					  <v:var name="OsScheduleTableMaxLengthen" 
							 type="INTEGER">
						<a:a name="DESC" 
							 value="EN: The maximum positive adjustment that can be made to the expiry point offset (in ticks)."/>
						<a:a name="IMPLEMENTATIONCONFIGCLASS" 
							 type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						</a:a>
						<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						<a:a name="SCOPE" value="LOCAL"/>
						<a:a name="SYMBOLICNAMEVALUE" value="false"/>
						<a:a name="UUID" 
							 value="8b60791b-5cb3-4bde-8206-eace4a7151c0"/>
						<a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=../../../OsScheduleTableDuration"/>
						  <a:tst expr="&gt;=0"/>
						</a:da>
						<a:da name="EDITABLE" type="XPath">
						  <a:tst expr="../../../OsScheduleTblSyncStrategy = 'EXPLICIT'"/>
						</a:da>
						<a:a name="DEFAULT" value="0"/>
					  </v:var>
					  <v:var name="OsScheduleTableMaxShorten" 
							 type="INTEGER">
						<a:a name="DESC" 
							 value="EN: The maximum negative adjustment that can be made to the expiry point offset (in ticks)."/>
						<a:a name="IMPLEMENTATIONCONFIGCLASS" 
							 type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						</a:a>
						<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						<a:a name="SCOPE" value="LOCAL"/>
						<a:a name="SYMBOLICNAMEVALUE" value="false"/>
						<a:a name="UUID" 
							 value="3ea5351b-1d08-4e6f-b78e-8287a067ad22"/>
						<a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=18446744073709551615"/>
						  <a:tst expr="&gt;=0"/>
						</a:da>
						<a:da name="EDITABLE" type="XPath">
						  <a:tst expr="../../../OsScheduleTblSyncStrategy = 'EXPLICIT'"/>
						</a:da>
						<a:a name="DEFAULT" value="0"/>
					  </v:var>
                      <v:lst name="OsScheduleTableEventSetting" type="MAP">
                        <v:ctr name="OsScheduleTableEventSetting" 
                               type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: Event that is triggered by that schedule table."/>
                          <a:a name="UUID" 
                               value="b1df6e69-3b02-462b-8376-ed966e9b2fb0"/>
                          <v:ref name="OsScheduleTableSetEventRef" 
                                 type="REFERENCE">
                            <a:a name="DESC" 
                                 value="EN: Reference to event that will be set by action"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="UUID" 
                                 value="bd95714e-9497-47b2-a2e8-4f6fda8ed951"/>
                            <a:da name="REF" 
                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsEvent"/>
                          </v:ref>
                          <v:ref name="OsScheduleTableSetEventTaskRef" 
                                 type="REFERENCE">
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="LOCAL"/>
                            <a:a name="UUID" 
                                 value="29efa048-a873-4d8c-9e08-ab11a3e6222d"/>
                            <a:da name="REF" 
                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsTask"/>
                          </v:ref>
                        </v:ctr>
                      </v:lst>
                      <v:lst name="OsScheduleTableTaskActivation" type="MAP">
                        <v:ctr name="OsScheduleTableTaskActivation" 
                               type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: Task that is triggered by that schedule table."/>
                          <a:a name="UUID" 
                               value="70feadbb-9fe2-40a6-b60b-905c67e12878"/>
                          <v:ref name="OsScheduleTableActivateTaskRef" 
                                 type="REFERENCE">
                            <a:a name="DESC" 
                                 value="EN: Reference to task that will be activated by action"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="UUID" 
                                 value="d2e0c84e-906b-420f-84be-718a6a4dd8a8"/>
                            <a:da name="REF" 
                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsTask"/>
                          </v:ref>
                        </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
				</v:ctr>
              </v:lst>
              <v:lst name="OsSpinlock" type="MAP">
                <v:ctr name="OsSpinlock" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: An OsSpinlock object is used to co-ordinate concurrent access by TASKs/ISR2s on different cores to a shared resource."/>
                  <a:a name="UUID" value="fc22fa0f-29d3-4d47-b793-34bbbc83ac1f"/>
                  <v:var name="OsSpinlockLockMethod" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: Lock method which is used when a spinlock is taken. Note that it is possible that a user (e.g. a Task) might hold more than one spinlock. In this case the last lock taken is forced to use at least a lock methode which locks as strong as the current one."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                    <a:da name="DEFAULT" value="LOCK_NOTHING"/>
                    <a:da name="RANGE">
                      <a:v>LOCK_ALL_INTERRUPTS</a:v>
                      <a:v>LOCK_CAT2_INTERRUPTS</a:v>
                      <a:v>LOCK_NOTHING</a:v>
                      <a:v>LOCK_WITH_RES_SCHEDULER</a:v>
                    </a:da>
                  </v:var>
				<v:ref name="OsSpinlockSuccessor" type="REFERENCE">
				  <a:a name="DESC" 
					   value="EN: Reference to OsApplications that have an access to this object."/>
				  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
					   type="IMPLEMENTATIONCONFIGCLASS">
					<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
				  </a:a>
				  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
				  <a:a name="SCOPE" value="LOCAL"/>
				  <a:a name="UUID" 
					   value="2406ec43-ba4f-435a-b8ca-2fdca5bdd9cf"/>
				  <a:da name="REF" 
						value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsSpinlock"/>
				  <a:a name="OPTIONAL" value="true"/>
				</v:ref>
                  <v:lst name="OsSpinlockAccessingApplication">
                    <a:da name="MIN" value="1"/>
                    <v:ref name="OsSpinlockAccessingApplication" 
                           type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to OsApplications that have an access to this object."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="e7ebc16a-f005-4310-999c-d0f1bc51d1d6"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                    </v:ref>
                  </v:lst>
                </v:ctr>
              </v:lst>
              <v:lst name="OsTask" type="MAP">
                <v:ctr name="OsTask" type="IDENTIFIABLE">
                  <a:a name="DESC" 
                       value="EN: This container represents an ISO 17356 task."/>
                  <a:a name="UUID" value="ebae4f88-ec11-4be8-8956-585c94f4e86f"/>
                  <a:da name="INVALID" type="XPath">
                    <a:tst expr="text:contains(concat(text:split(../../OsApplication/*/OsAppTaskRef/*, ' '), ' '), as:path(.))"
                    false = "This Task does not reference by any Application"/>  
                  </a:da>
                  <v:var name="OsTaskActivation" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: This attribute defines the maximum number of queued activation requests for the task. A value equal to &quot;1&quot; means that at any time only a single activation is permitted for this task. Note that the value must be a natural number starting at 1."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="d1ef020e-0255-4425-87c9-c60be6bc7f84"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=255"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="text:contains(node:name(..), 'Idle_Task_') and not(node:value(.) = 1)"
                                 true = "The OsTaskActivation for Idle Task should be 1"/> 
                    </a:da>
                  </v:var>
                  <v:lst name="OsTaskPeriod">
                    <a:da name="MAX" value="1"/>
                    <v:var name="OsTaskPeriod" type="FLOAT">
                      <a:a name="DESC" 
                           value="EN: This parameter specifies the period in seconds of this task in case of a cyclically activated task."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="5b1fe236-a319-4a5b-b6f9-8f98d9a2a887"/>
                    </v:var>
                  </v:lst>
                  <v:var name="OsTaskPriority" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: The priority of a task is defined by the value of this attribute. This value has to be understood as a relative value, i.e. the values show only the relative ordering of the tasks."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="591742cd-da9a-4c56-9b56-06211c69f397"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="text:contains(node:name(..), 'Idle_Task_') and not(node:value(.) = 0)"
                                 true = "The Task Priority for Idle Task should be 0"/>
                         <a:tst expr="not(text:contains(node:name(..), 'Idle_Task_')) and (node:value(.) = 0)"
                                 true = "The Task Priority for Task except Idle_Task should not be 0"/>  
                    </a:da>
                  </v:var>
                  <v:var name="OsTaskSchedule" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: The OsTaskSchedule attribute defines the preemptability of the task."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="7246678f-c579-4334-9d41-84cc17d217af"/>
                    <a:da name="RANGE">
                      <a:v>FULL</a:v>
                      <a:v>NON</a:v>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="text:contains(node:name(..), 'Idle_Task_') and not(node:value(.) = 'FULL')"
                                 true = "The OsTaskSchedule for Idle Task should be FULL"/>  
                    </a:da>
                  </v:var>
                  <v:var name="OsTaskType" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: The OsTaskType attributes defines the Basic Task or Extended Task."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="7246678f-c579-4334-9d41-84cc17d217af"/>
                    <a:da name="RANGE">
                      <a:v>BASIC</a:v>
                      <a:v>EXTENDED</a:v>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="text:contains(node:name(..), 'Idle_Task_') and not(node:value(.) = 'BASIC')"
                                 true = "The OsTaskType for Idle Task should be BASIC"/>  
                    </a:da>
                    <a:da name="DEFAULT" value="BASIC"/>
                  </v:var>
                  <v:var name="OsTaskUseAutostart" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: The OsTaskUseAutostart attributes defines whether Task need Autostart."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="7246678f-c579-4334-9d41-84cc17d217af"/>
                    <a:da name="DEFAULT" value="TRUE"/>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="text:contains(node:name(..), 'Idle_Task_') and not(node:value(.) = 'true')"
                                 true = "The OsTaskUseAutostart for Idle Task should be true"/>  
                    </a:da>
                  </v:var>
                  <v:var name="TaskStackSize" type="INTEGER">
                    <a:a name="DESC" 
                         value="EN: Indicate the stack size for this task, default value is 1K. "/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="591742cd-da9a-4c56-9b56-06211c69f397"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295"/>
                      <a:tst expr="&gt;=0"/>
                    </a:da>
                    <a:da name="DEFAULT" value="1024"/>
                  </v:var>
                  <v:lst name="OsMemoryMappingCodeLocationRef">
                    <a:da name="MAX" value="1"/>
                    <v:ref name="OsMemoryMappingCodeLocationRef" 
                           type="FOREIGN-REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to the memory mapping containing details about the section where the code is placed."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="UUID" 
                           value="0ea5bc81-3c2b-40a5-afb5-b383aa1573c8"/>
                      <a:da name="REF" value="ASTyped:SwAddrMethod"/>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsTaskAccessingApplication">
                    <v:ref name="OsTaskAccessingApplication" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: Reference to applications which have an access to this object."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="32dd0c1a-7153-4f78-a287-48f258b01f18"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsApplication"/>
                      <a:da name="INVALID" type="XPath">
                         <a:tst expr="node:refexists(node:current())"
                                false = "Failed to reference a specific application"/>
                      </a:da>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsTaskEventRef">
                    <v:ref name="OsTaskEventRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: This reference defines the list of events the extended task may react on."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="5c39f555-cefd-426b-860f-8aa4bd80078a"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsEvent"/>
                      <a:da name="INVALID" type="XPath">
                         <a:tst expr="node:refexists(node:current())"
                                false = "Failed to reference a specific application"/>
                      </a:da>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="not (node:value(../../OsTaskType) = 'BASIC')"
                               false = "Basic Task cannot have Event"/>
                         <a:tst expr="text:uniq(node:order(../*), .)"
                              false = "Same Event should only be referenced once"/>
                     </a:da>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsTaskResourceRef">
                    <v:ref name="OsTaskResourceRef" type="REFERENCE">
                      <a:a name="DESC" 
                           value="EN: This reference defines a list of resources accessed by this task."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="UUID" 
                           value="0c305811-d8e2-46a0-b566-bc112a5de25b"/>
                      <a:da name="REF" 
                            value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsResource"/>
                      <a:da name="INVALID" type="XPath">
                        <a:tst expr="node:refexists(.)"
                              false = "Invalid Resource Referenced"/>
                        <a:tst expr="text:uniq(node:order(../*), .)"
                              false = "Same Resource should only be referenced once"/>
                      </a:da>
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsTaskAutostartAppModeRef">
                    <a:da name="MIN" value="1"/>
                    <a:da name="ENABLE" type="XPath" 
                         expr="node:value(../OsTaskUseAutostart) = 'true'"
                         true="true" false="false"/>
                    <v:ref name="OsTaskAutostartAppModeRef" type="REFERENCE">
                         <a:a name="DESC" 
                              value="EN: Reference to application modes in which that task is activated on startup of the OS"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                         <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                         <a:a name="UUID" 
                              value="e8303d4b-2da4-42b4-a23e-c082abec5a21"/>
                         <a:da name="REF">
                         <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsAppMode</a:v>
                         <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OSDEFAULTAPPMODE</a:v>
                         <a:v>ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OSALLRUNNINGMODE</a:v>
                         </a:da>
                         <a:da name="INVALID" type="XPath">
                              <a:tst expr="(count(./../*) > 1) and (text:contains(node:name(node:ref(.)), 'OSALLRUNNINGMODE'))"
                                        true = "OSALLRUNNINGMODE is used no need to reference other mode"/>
                              <a:tst expr="text:uniq(node:order(../*), .)"
                                        false = "Multi reference same Autostart mode"/>
                              <a:tst expr="node:refexists(.)"
                                        false = "The referenced AppMode does not exists"/>

                              <a:tst expr="text:contains(node:name(../..), 'Idle_Task_') and not(node:name(node:ref(.)) = 'OSALLRUNNINGMODE')"
                                        true = "Idle_Task OsTaskAutostartAppModeRef must be all running mode"/>  
          
                         </a:da> 
                    </v:ref>
                  </v:lst>
                  <v:lst name="OsTaskTimingProtection" type="MAP">
                    <a:da name="MAX" value="1"/>
                    <a:da name="ENABLE" type="XPath" 
                         expr="(../../../OsOS/OsScalabilityClass = 'SC4') or (../../../OsOS/OsScalabilityClass = 'SC2')"
                         true="true" false="false"/>
                    <v:ctr name="OsTaskTimingProtection" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains all parameters regarding timing protection of the task."/>
                      <a:a name="UUID" 
                           value="b522b7bc-49f0-4179-a374-72055f0bd67c"/>
					  <v:var name="OsTaskAllInterruptLockBudget" type="FLOAT">
					    <a:a name="DESC" 
						     value="EN: This parameter contains the maximum time for which the task is allowed to lock all interrupts (via SuspendAllInterrupts() or DisableAllInterrupts()) (in seconds)."/>
					    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						     type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					    </a:a>
					    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					    <a:a name="SCOPE" value="ECU"/>
					    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					    <a:a name="UUID" 
						     value="43d60446-c56a-456e-904a-b26671ad5942"/>
					    <a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=Infinity"/>
						  <a:tst expr="&gt;=0.0"/>
					    </a:da>
						<a:da name="OPTIONAL" value="true" />
					  </v:var>
					  <v:var name="OsTaskExecutionBudget" type="FLOAT">
					    <a:a name="DESC" 
						     value="EN: This parameter contains the maximum allowed execution time of the task (in seconds)."/>
					    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						     type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					    </a:a>
					    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					    <a:a name="SCOPE" value="ECU"/>
					    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					    <a:a name="UUID" 
						     value="fecb7965-1951-438c-89a6-e23aeca36aab"/>
					    <a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=Infinity"/>
						  <a:tst expr="&gt;=0.0"/>
					    </a:da>
						<a:da name="OPTIONAL" value="true" />
					  </v:var>
					  <v:var name="OsTaskOsInterruptLockBudget" type="FLOAT">
					    <a:a name="DESC" 
						     value="EN: This parameter contains the maximum time for which the task is allowed to lock all Category 2 interrupts (via SuspendOSInterrupts()) (in seconds)."/>
					    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						     type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					    </a:a>
					    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					    <a:a name="SCOPE" value="ECU"/>
					    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					    <a:a name="UUID" 
						     value="bec7d9f3-93b0-43af-8c38-03c256a817f4"/>
					    <a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=Infinity"/>
						  <a:tst expr="&gt;=0.0"/>
					    </a:da>
						<a:da name="OPTIONAL" value="true" />
					  </v:var>
					  <v:var name="OsTaskTimeFrame" type="FLOAT">
					    <a:a name="DESC" 
						     value="EN: The minimum inter-arrival time between activations and/or releases of a task (in seconds)."/>
					    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						     type="IMPLEMENTATIONCONFIGCLASS">
						  <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
						  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					    </a:a>
					    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					    <a:a name="SCOPE" value="ECU"/>
					    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					    <a:a name="UUID" 
						     value="0badd4b5-c62c-499a-9db8-504141f24019"/>
					    <a:da name="INVALID" type="Range">
						  <a:tst expr="&lt;=Infinity"/>
						  <a:tst expr="&gt;=0.0"/>
					    </a:da>
						<a:da name="OPTIONAL" value="true" />
					  </v:var>
                      <v:lst name="OsTaskResourceLock" type="MAP">
                        <v:ctr name="OsTaskResourceLock" type="IDENTIFIABLE">
                          <a:a name="DESC" 
                               value="EN: This container contains the worst case time between getting and releasing a given resource (in seconds)."/>
                          <a:a name="UUID" 
                               value="13e51a89-f010-4914-8cd6-19d9c82de9d7"/>
                          <v:var name="OsTaskResourceLockBudget" type="FLOAT">
                            <a:a name="DESC" 
                                 value="EN: This parameter contains the maximum time the task is allowed to lock the resource (in seconds)"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" 
                                 value="6feba724-4c0e-4524-89d5-2ddce875abde"/>
                            <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;=Infinity"/>
                              <a:tst expr="&gt;=0.0"/>
                            </a:da>
                          </v:var>
                          <v:ref name="OsTaskResourceLockResourceRef" 
                                 type="REFERENCE">
                            <a:a name="DESC" 
                                 value="EN: Reference to the resource used by the task"/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SCOPE" value="ECU"/>
                            <a:a name="UUID" 
                                 value="46aec50d-7eb6-406c-9ead-4b7d95c4a39f"/>
                            <a:da name="REF" 
                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsResource"/>
                              <a:da name="INVALID" type="XPath">
                              <a:tst expr="node:refexists(.)"
                                        false = "Invalid Resource is referenced"/>
                              <a:tst expr="text:uniq(node:order(../../*/OsTaskResourceLockResourceRef), .)"
                                        false = "Same Resource should only be referenced once"/>
                              </a:da> 
                          </v:ref>
                        </v:ctr>
                      </v:lst>
                    </v:ctr>
                  </v:lst>
                  <v:lst name="OsTaskMemoryProtection" type="MAP">
                    <a:da name="ENABLE" type="XPath" 
                         expr="(../../../OsOS/OsScalabilityClass = 'SC4') or (../../../OsOS/OsScalabilityClass = 'SC3')"
                         true="true" false="false"/>
                         <v:ctr name="OsTaskMemoryProtection" type="IDENTIFIABLE">
                              <v:chc name="OsTaskMemoryProtectionChoice" type="IDENTIFIABLE">
                                   <a:a name="DESC" 
                                        value="EN: This container defines way to define Address region."/>
                                   <a:a name="UUID" 
                                        value="0398b4b3-eab7-4a09-b1c1-c913a9af0e84"/>
                                   <v:ctr name="RegionSelect" type="IDENTIFIABLE">
                                     <a:a name="DESC" 
                                          value="EN: This container specifies region."/>
                                     <a:a name="UUID" 
                                          value="4f491a06-34fb-4f8a-ae3a-6f57b3e4f543"/>
                                        <v:ref name="MemoryBlockRef" type="REFERENCE">
                                             <a:a name="DESC" 
                                                  value="EN: Reference to applications which have an access to this object."/>
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                             <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                                             <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                             </a:a>
                                             <a:da name="INVALID" type="XPath">
                                             <a:tst expr="node:refexists(node:current())"
                                                       false = "Failed to reference a specific Memory Block"/>
                                             </a:da>
                                             <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                             <a:a name="UUID" 
                                                  value="9439a6a6-392d-4be3-bee2-9dcf715129a7"/>
                                             <a:da name="REF" 
                                                  value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/MemoryBlock"/>
                                        </v:ref>
                                   </v:ctr>
                                   <v:ctr name="RegionWritten" type="IDENTIFIABLE">
                                     <a:a name="DESC" 
                                          value="EN: This container specifies the parameters to call a callback OS alarm action."/>
                                     <a:a name="UUID" 
                                          value="808f6a7c-53a6-49e0-8772-e821c424684b"/>
                                          <v:var name="OsTaskMemoryProtectionStartAddress" type="INTEGER">
                                             <a:a name="DESC" 
                                                  value="EN: This parameter contains the Start Address for memory protection"/>
                                             <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                  type="IMPLEMENTATIONCONFIGCLASS">
                                               <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                             </a:a>
                                             <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                             <a:a name="SCOPE" value="ECU"/>
                                             <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                             <a:a name="UUID" 
                                                  value="6feba334-4c0e-4524-89d5-2ddce875abde"/>
                                             <a:da name="DEFAULT" value="0" />
                                             <a:da name="INVALID" type="Range">
                                               <a:tst expr="&lt;= ../OsTaskMemoryProtectionEndAddress"/>
                                               <a:tst expr="&gt;= 0"/>
                                             </a:da>
                                           </v:var>
                                           <v:var name="OsTaskMemoryProtectionEndAddress" type="INTEGER">
                                              <a:a name="DESC" 
                                                   value="EN: This parameter contains the End Address for memory protection"/>
                                              <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                                   type="IMPLEMENTATIONCONFIGCLASS">
                                                <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                              </a:a>
                                              <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                                              <a:a name="SCOPE" value="ECU"/>
                                              <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                              <a:a name="UUID" 
                                                   value="6febaaa4-4c0e-4524-89d5-2ddce875abde"/>
                                              <a:da name="DEFAULT" value="0" />
                                              <a:da name="INVALID" type="Range">
                                                <a:tst expr="&lt;= 4294967295"/>
                                                <a:tst expr="&gt;= 0"/>
                                              </a:da>
                                            </v:var>
                                   </v:ctr>
                                 </v:chc>
                              
                              <v:var name="TaskRegionReadWriteAccess" type="ENUMERATION">
                                   <a:a name="DESC" value="EN: This parameter contains Read and Write Access for this region"/>
                                   <a:a name="ORIGIN" value="ChipowerTech" />
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                   <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                   <a:a name="UUID" value="0aaccac4-de79-4565-8120-830dc23e3679" />
                                   <a:da name="DEFAULT" value="MPU_EL1_RW_EL0_NONE" />
                                   <a:da name="RANGE">
                                        <a:v>MPU_EL1_RW_EL0_NONE</a:v>
                                        <a:v>MPU_EL1_RW_EL0_RW</a:v>
                                        <a:v>MPU_EL1_R_EL0_NONE</a:v>
                                        <a:v>MPU_EL1_R_EL0_R</a:v>
                                   </a:da>
                                 </v:var>
                                 <v:var name="TaskExecutionAccess" type="ENUMERATION">
                                   <a:a name="DESC" value="EN: This parameter contains Execution Access for this region"/>
                                   <a:a name="ORIGIN" value="ChipowerTech" />
                                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                   <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                   </a:a>
                                   <a:a name="SYMBOLICNAMEVALUE" value="false" />
                                   <a:a name="UUID" value="0aa5bbb4-de79-4565-8120-830dc23e3679" />
                                   <a:da name="DEFAULT" value="MPU_EXECUTE_NEVER" />
                                   <a:da name="RANGE">
                                   <a:v>MPU_EXECUTE_NEVER</a:v>
                                   <a:v>MPU_EXECUTE_ALLOWED</a:v>
                                   </a:da>
                              </v:var>
                         </v:ctr>
                  </v:lst>
                  <v:lst name="OsTaskAccessCheck" type="MAP">
                    <a:da name="ENABLE" type="XPath" 
                         expr="(../../../OsOS/OsScalabilityClass = 'SC4') or (../../../OsOS/OsScalabilityClass = 'SC3')"
                         true="true" false="false"/>
                    <v:ctr name="OsTaskAccessCheck" type="IDENTIFIABLE">
                      <a:a name="DESC" 
                           value="EN: This container contains the region for Access check."/>
                      <a:a name="UUID" 
                           value="13e51a89-f010-4914-8cd6-19d9c82de9d7"/>
                      <v:var name="OsTaskAccessCheckStartAddress" type="INTEGER">
                        <a:a name="DESC" 
                             value="EN: This parameter contains the Start Address for Access check"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="6feba724-4c0e-4524-89d5-2ddce875abde"/>
                         <a:da name="DEFAULT" value="0" />
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;= ../OsTaskAccessCheckEndAddress"/>
                          <a:tst expr="&gt;= 0"/>
                        </a:da>
                      </v:var>
                      <v:var name="OsTaskAccessCheckEndAddress" type="INTEGER">
                         <a:a name="DESC" 
                              value="EN: This parameter contains the End Address for Access check"/>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                              type="IMPLEMENTATIONCONFIGCLASS">
                           <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                         <a:a name="SCOPE" value="ECU"/>
                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                         <a:a name="UUID" 
                              value="6feba724-4c0e-4524-89d5-2ddce875abde"/>
                         <a:da name="DEFAULT" value="0" />
                         <a:da name="INVALID" type="Range">
                           <a:tst expr="&lt;= 4294967295"/>
                           <a:tst expr="&gt;= ../OsTaskAccessCheckStartAddress"/>
                         </a:da>
                       </v:var>
                       <v:var name="TaskAccessRight" type="ENUMERATION">
                         <a:a name="DESC" value="EN: This parameter contains Access Right"/>
                         <a:a name="ORIGIN" value="ChipowerTech" />
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                         </a:a>
                         <a:a name="SYMBOLICNAMEVALUE" value="false" />
                         <a:a name="UUID" value="0aa5bac4-de79-4565-8120-830dc23e3679" />
                         <a:da name="DEFAULT" value="OS_MEM_ACCESS_NON" />
                         <a:da name="RANGE">
                         <a:v>OS_MEM_ACCESS_NON</a:v>
                         <a:v>OS_MEM_ACCESS_READ</a:v>
                         <a:v>OS_MEM_ACCESS_WRITE</a:v>
                         <a:v>OS_MEM_ACCESS_RW</a:v>
                         <a:v>OS_MEM_ACCESS_EXECUTE</a:v>
                         <a:v>OS_MEM_ACCESS_REX</a:v>
                         <a:v>OS_MEM_ACCESS_WEX</a:v>
                         <a:v>OS_MEM_ACCESS_RWEX</a:v>
                         <a:v>OS_MEM_ACCESS_STACK</a:v>
                         <a:v>OS_MEM_ACCESS_SR</a:v>
                         <a:v>OS_MEM_ACCESS_SW</a:v>
                         <a:v>OS_MEM_ACCESS_SRW</a:v>
                         <a:v>OS_MEM_ACCESS_SEX</a:v>
                         <a:v>OS_MEM_ACCESS_SREX</a:v>
                         <a:v>OS_MEM_ACCESS_SWEX</a:v>
                         <a:v>OS_MEM_ACCESS_SRWEX</a:v>
                         </a:da>
                       </v:var>
                    </v:ctr>
                  </v:lst>
                </v:ctr>
              </v:lst>
              <v:lst name="MemoryRegion" type="MAP">
               <a:da name="ENABLE" type="XPath" 
               expr="node:value(./../OsResourceSubderivative) = 'Os_THA6206'"
               true="true" false="false"/>
               <v:ctr name="MemoryRegion" type="IDENTIFIABLE">
                 <a:a name="DESC" 
                      value="EN: Memory Mapping illustrate the overall memory in the core."/>
                 <a:a name="UUID" value="fc22fa0f-29d3-4d47-b793-34bbbc83ac1f"/>
                 <v:var name="MemoryRegionStartAddress" type="INTEGER">
                   <a:a name="DESC" 
                        value="EN: Start address for the region."/>
                   <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                        type="IMPLEMENTATIONCONFIGCLASS">
                     <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                   </a:a>
                   <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                   <a:a name="SCOPE" value="LOCAL"/>
                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                   <a:a name="UUID" 
                        value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                       <a:a name="DEFAULT" value="0"/>
                   <a:da name="INVALID" type="Range">
                     <a:tst expr="&lt;=4294967295"/>
                     <a:tst expr="&gt;=0"/>
                   </a:da>
                 </v:var>
                 <v:var name="MemoryRegionEndAddress" type="INTEGER">
                   <a:a name="DESC" 
                        value="EN: End address for the region."/>
                   <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                        type="IMPLEMENTATIONCONFIGCLASS">
                     <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                   </a:a>
                   <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                   <a:a name="SCOPE" value="LOCAL"/>
                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                   <a:a name="UUID" 
                        value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                       <a:a name="DEFAULT" value="0"/>
                   <a:da name="INVALID" type="Range">
                     <a:tst expr="&lt;=4294967295"/>
                     <a:tst expr="&gt;=../MemoryRegionStartAddress"/>
                   </a:da>
                 </v:var>
                 <v:var name="MemoryRegionAttribute" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: Indicate the region is flash or ram."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                        <a:a name="DEFAULT" value="RAM"/>
                        <a:da name="RANGE">
                         <a:v>RAM</a:v>
                         <a:v>FLASH</a:v>
                       </a:da>
                 </v:var>
                 <v:var name="MemoryRegionCopy" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: Whether block need to be copy and copy by which core."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                        <a:a name="DEFAULT" value="NON"/>
                        <a:da name="RANGE">
                          <a:v>ALL</a:v>
                          <a:v>NON</a:v>
                          <a:v>CORE0</a:v>
                          <a:v>CORE1</a:v>
                        </a:da>
                 </v:var>
                 <v:var name="AllMemoryStored" type="BOOLEAN">
                    <a:a name="DESC" 
                         value="EN: Whether the all the memory store at this section."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="7246678f-c579-4334-9d41-84cc17d217af"/>
                    <a:da name="INVALID" type="XPath">
                         <a:tst expr="text:uniq(../../*/AllMemoryStored, .) or 'false' = node:value(.) "
                         false = "Receiver core cannot be same."/>
                    </a:da> 
                    <a:da name="DEFAULT" value="FALSE"/>
               </v:var>
               </v:ctr>
             </v:lst>
            <v:lst name="MemoryBlock" type="MAP">
               <a:a name="UUID" 
               value="6feba224-f010-4914-8cd6-19d9c82de9d7"/>
               <a:da name="ENABLE" type="XPath" 
               expr="node:value(./../OsResourceSubderivative) = 'Os_THA6206'"
               true="true" false="false"/>
              <v:ctr name="MemoryBlock" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: Memory Block indicate the data block in the memory Region."/>
                <a:a name="UUID" value="fc22fa0f-29d3-4d47-b793-34bbbc83ac1f"/>
                <v:var name="MemoryBlockSize" type="INTEGER">
                  <a:a name="DESC" 
                       value="EN: The Memory Block Size."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" 
                       value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                      <a:a name="DEFAULT" value="0"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=4294967295"/>
                    <a:tst expr="&gt;=0"/>
                  </a:da>
                </v:var>
                <v:var name="MemoryBlockAlign" type="ENUMERATION">
                  <a:a name="DESC" 
                       value="EN: The align of Memory block."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" 
                       value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                      <a:a name="DEFAULT" value="NON"/>
                      <a:da name="RANGE">
                        <a:v>NON</a:v>
                        <a:v>128</a:v>
                        <a:v>64</a:v>
                        <a:v>32</a:v>
                        <a:v>16</a:v>
                        <a:v>8</a:v>
                      </a:da>
                </v:var>
               <v:var name="MemoryRegionType" type="ENUMERATION">
                    <a:a name="DESC" 
                         value="EN: The Section Type."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                        <a:a name="DEFAULT" value="BSS"/>
                        <a:da name="RANGE">
                          <a:v>BSS</a:v>
                          <a:v>NON_INIT</a:v>
                          <a:v>VARIABLE</a:v>
                          <a:v>RO_DATA</a:v>
                          <a:v>RO_CODE</a:v>
                        </a:da>
               </v:var>
               <v:ref name="MemoryRegionRef" type="REFERENCE">
                    <a:a name="DESC" 
                         value="EN: Memory Block that reference to a specific ."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="UUID" 
                         value="8f6720b9-f794-4c7e-a36a-806e0a5864ce"/>
                         <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/MemoryRegion"/>
               </v:ref>
               <v:var name="MemoryCopyStage" type="ENUMERATION">
                    
                    <a:a name="DESC" 
                         value="EN: The Memory Copy Stage."/>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SCOPE" value="LOCAL"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" 
                         value="6ea56657-36c1-4a27-a0b9-0d22558fbaab"/>
                        <a:a name="DEFAULT" value="NON"/>
                        <a:da name="RANGE">
                          <a:v>NON</a:v>
                          <a:v>STAGEONE</a:v>
                          <a:v>STAGETWO</a:v>
                          <a:v>STAGETHREE</a:v>
                          <a:v>STAGEUNCLEAR</a:v>
