                    [!VAR "PreviousMemoryBlock" = "'ImageLimit(CORE1_ABORT_STACK)'"!][!//
                [!ENDIF!][!//
            [!ENDIF!][!//
            [!IF "node:exists(./UndefinedStack/Core1MemoryRegionRef)"!][!//
                [!IF "node:name(node:ref(./UndefinedStack/Core1MemoryRegionRef)) = $MemoryRegionName"!][!//
                    CORE1_UNDEFINED_STACK [!"$PreviousMemoryBlock"!] [!IF "node:value(./UndefinedStack/Core1StackAlign) != 'NON'"!]ALIGN [!"node:value(./UndefinedStack/Core1StackAlign)"!][!ENDIF!] EMPTY [!"num:inttohex(./UndefinedStack/Core1StackSize)"!] {}
                    [!VAR "PreviousMemoryBlock" = "'ImageLimit(CORE1_UNDEFINED_STACK)'"!][!//
                [!ENDIF!][!//
            [!ENDIF!][!//
            [!IF "node:exists(./IrqStack/Core1MemoryRegionRef)"!][!//
                [!IF "node:name(node:ref(./IrqStack/Core1MemoryRegionRef)) = $MemoryRegionName"!][!//
