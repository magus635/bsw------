                    [!VAR "PreviousMemoryBlock" = "'ImageLimit(CORE1_IRQ_STACK)'"!][!//
                [!ENDIF!][!//
            [!ENDIF!][!//
            [!IF "node:exists(./FiqStack/Core1MemoryRegionRef)"!][!//
                [!IF "node:name(node:ref(./FiqStack/Core1MemoryRegionRef)) = $MemoryRegionName"!][!//
                    CORE1_FIQ_STACK [!"$PreviousMemoryBlock"!] [!IF "node:value(./FiqStack/Core1StackAlign) != 'NON'"!]ALIGN [!"node:value(./FiqStack/Core1StackAlign)"!][!ENDIF!] EMPTY [!"num:inttohex(./FiqStack/Core1StackSize)"!] {}
                    [!VAR "PreviousMemoryBlock" = "'ImageLimit(CORE1_FIQ_STACK)'"!][!//
                [!ENDIF!][!//
            [!ENDIF!][!//
        [!ENDIF!][!//

    [!ENDSELECT!][!//
[!ENDSELECT!][!//
[!ENDLOOP!][!//
    ;Following execution section is used to detect related execution range.
    [!LOOP "node:order(/AUTOSAR/TOP-LEVEL-PACKAGES/Os/ELEMENTS/Os/MemoryBlock/*, '@index')"!][!//
        [!IF "node:ref(./MemoryRegionRef)/MemoryRegionAttribute != 'FLASH'"!][!//
            [!IF "node:value(./MemoryBlockAlign) = 'NON'"!][!//
                [!"node:name(.)"!]_LIMIT ImageLimit([!"node:name(.)"!]) EMPTY 0x0{}
            [!ELSE!][!//
                [!"node:name(.)"!]_LIMIT AlignExpr(ImageLimit([!"node:name(.)"!]), [!"node:value(./MemoryBlockAlign)"!]) EMPTY 0x0{}
            [!ENDIF!][!//
        [!ENDIF!][!//
    [!ENDLOOP!][!//
[!ENDINDENT!][!//
}
[!ENDIF!][!//
[!ENDINDENT!][!//