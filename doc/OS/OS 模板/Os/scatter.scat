[!INDENT "0"!][!//
[!IF "node:value(/AUTOSAR/TOP-LEVEL-PACKAGES/Os/ELEMENTS/Os/OsResourceSubderivative) = 'Os_THA6206'"!][!//
#! armclang --target=arm-arm-none-eabi -march=armv8-a -E -x c
[!SELECT "/AUTOSAR/TOP-LEVEL-PACKAGES/Os/ELEMENTS/Os"!][!//
    [!LOOP "node:order(./MemoryRegion/*, '@index')"!][!//
        #define [!"node:name(.)"!]                    [!"num:inttohex(node:value(./MemoryRegionStartAddress))"!]
    [!ENDLOOP!][!//
[!ENDSELECT!][!//
;/**************************************************************************************************
; * Copyright (c) Tongxin Microelectronics Co., Ltd. All Rights Reserved.
