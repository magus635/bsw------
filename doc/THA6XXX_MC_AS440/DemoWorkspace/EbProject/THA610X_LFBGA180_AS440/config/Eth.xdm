<?xml version='1.0'?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="Eth" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="Eth" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <d:ctr type="MODULE-CONFIGURATION">
              <a:a name="DEF" value="ASPath:/THA6_AS440_FuSa/Eth"/>
              <d:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" 
                     value="VariantPostBuild">
                <a:a name="IMPORTER_INFO" value="@DEF"/>
              </d:var>
              <d:ctr name="EthConfigSet" type="IDENTIFIABLE">
                <d:lst name="EthCtrlConfig" type="MAP">
                  <d:ctr name="EthCtrlConfig_0" type="IDENTIFIABLE">
                    <d:var name="EthCtrlEnableMii" type="BOOLEAN" value="true">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="EthCtrlEnableLoopback" type="BOOLEAN" 
                           value="false">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="EthCtrlEnableRxInterrupt" type="BOOLEAN" 
                           value="false">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="EthCtrlEnableTxInterrupt" type="BOOLEAN" 
                           value="false">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="EthOpMode" type="ENUMERATION" 
                           value="FULLDUPLEX">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="EthSkewTxClockDelay" type="INTEGER" value="0"/>
                    <d:var name="EthSkewRxClockDelay" type="INTEGER" value="0">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="EthCtrlIdx" type="INTEGER" value="0">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="EthCtrlMacLayerSpeed" type="ENUMERATION" 
                           value="ETH_MAC_LAYER_SPEED_10M">
                      <a:a name="ENABLE" value="true"/>
                    </d:var>
                    <d:var name="EthCtrlMacLayerSubType" type="ENUMERATION" 
                           value="STANDARD">
                      <a:a name="ENABLE" value="true"/>
                    </d:var>
                    <d:var name="EthCtrlMacLayerType" type="ENUMERATION" 
                           value="ETH_MAC_LAYER_TYPE_XMII">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="EthCtrlPhyAddress" type="STRING" 
                           value="00:DE:AD:00:00:02">
                      <a:a name="ENABLE" value="true"/>
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:ref name="EthCtrlEcucPartitionRef" type="REFERENCE" >
                      <a:a name="ENABLE" value="false"/>
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:ref>
                    <d:ctr name="EthCtrlConfigEgress" type="IDENTIFIABLE">
                      <d:ref name="EthCtrlConfigEgressLastSchedulerRef" 
                             type="REFERENCE" >
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:ref>
                      <d:lst name="EthCtrlConfigEgressFifo" type="MAP">
                        <d:ctr name="EthCtrlConfigEgressFifo_0" 
                               type="IDENTIFIABLE">
                          <d:var name="EthCtrlConfigEgressFifoBufLenByte" 
                                 type="INTEGER" value="256"/>
                          <d:var name="EthCtrlConfigEgressFifoBufTotal" 
                                 type="INTEGER" value="4"/>
                          <d:var name="EthCtrlConfigEgressFifoIdx" 
                                 type="INTEGER" value="0">
                            <a:a name="IMPORTER_INFO">
                              <a:v>@DEF</a:v>
                              <a:v>@CALC</a:v>
                            </a:a>
                          </d:var>
                          <d:lst 
                                 name="EthCtrlConfigEgressFifoPriorityAssignment">
                            <d:var type="INTEGER" value="0">
                              <a:a name="IMPORTER_INFO">
                                <a:v>@DEF</a:v>
                                <a:v>@CALC</a:v>
                              </a:a>
                            </d:var>
                            <d:var type="INTEGER" value="1"/>
                            <d:var type="INTEGER" value="2"/>
                            <d:var type="INTEGER" value="3"/>
                            <d:var type="INTEGER" value="4"/>
                            <d:var type="INTEGER" value="5"/>
                            <d:var type="INTEGER" value="6"/>
                          </d:lst>
                        </d:ctr>
                        <d:ctr name="EthCtrlConfigEgressFifo_1" 
                               type="IDENTIFIABLE">
                          <d:var name="EthCtrlConfigEgressFifoBufLenByte" 
                                 type="INTEGER" value="256"/>
                          <d:var name="EthCtrlConfigEgressFifoBufTotal" 
                                 type="INTEGER" value="5"/>
                          <d:var name="EthCtrlConfigEgressFifoIdx" 
                                 type="INTEGER" value="1">
                            <a:a name="IMPORTER_INFO">
                              <a:v>@DEF</a:v>
                              <a:v>@CALC</a:v>
                            </a:a>
                          </d:var>
                          <d:lst 
                                 name="EthCtrlConfigEgressFifoPriorityAssignment">
                            <d:var type="INTEGER" value="7"/>
                          </d:lst>
                        </d:ctr>
                      </d:lst>
                      <d:lst name="EthCtrlConfigScheduler" type="MAP">
                        <d:ctr name="EthCtrlConfigScheduler_0" 
                               type="IDENTIFIABLE">
                          <d:var name="EthCtrlConfigSchedulerAlgorithm" 
                                 type="ENUMERATION" 
                                 value="ETH_SCHEDULER_STRICT_PRIORITY">
                            <a:a name="IMPORTER_INFO" value="@DEF"/>
                          </d:var>
                          <d:lst name="EthCtrlConfigSchedulerPredecessor" 
                                 type="MAP">
                            <d:ctr name="EthCtrlConfigSchedulerPredecessor_0" 
                                   type="IDENTIFIABLE">
                              <d:var 
                                     name="EthCtrlConfigSchedulerPredecessorOrder" 
                                     type="INTEGER" value="0">
                                <a:a name="IMPORTER_INFO">
                                  <a:v>@DEF</a:v>
                                  <a:v>@CALC</a:v>
                                </a:a>
                              </d:var>
                              <d:ref 
                                     name="EthCtrlConfigSchedulerPredecessorRef" 
                                     type="REFERENCE" 
                                     value="ASPath:/Eth/Eth/EthConfigSet/EthCtrlConfig_0/EthCtrlConfigEgress/EthCtrlConfigEgressFifo_0"/>
                            </d:ctr>
                            <d:ctr name="EthCtrlConfigSchedulerPredecessor_1" 
                                   type="IDENTIFIABLE">
                              <d:var 
                                     name="EthCtrlConfigSchedulerPredecessorOrder" 
                                     type="INTEGER" value="1"/>
                              <d:ref 
                                     name="EthCtrlConfigSchedulerPredecessorRef" 
                                     type="REFERENCE" 
                                     value="ASPath:/Eth/Eth/EthConfigSet/EthCtrlConfig_0/EthCtrlConfigEgress/EthCtrlConfigEgressFifo_1"/>
                            </d:ctr>
                          </d:lst>
                        </d:ctr>
                      </d:lst>
                      <d:lst name="EthCtrlConfigShaper" type="MAP"/>
                      <d:lst name="EthCtrlConfigDMAArbitration" type="MAP">
                        <d:ctr name="EthCtrlConfigDMAArbitration_0" 
                               type="IDENTIFIABLE">
                          <d:var name="EthCtrlConfigDMAArbitrationAlgorithm" 
                                 type="ENUMERATION" 
                                 value="ETH_DMA_ARBITRATION_FIXED_PRIORITY"/>
                          <d:lst name="EthCtrlConfigDMAWeightAssignment" 
                                 type="MAP"/>
                        </d:ctr>
                      </d:lst>
                    </d:ctr>
                    <d:ctr name="EthCtrlConfigIngress" type="IDENTIFIABLE">
                      <d:lst name="EthCtrlConfigIngressFifo" type="MAP">
                        <d:ctr name="EthCtrlConfigIngressFifo_0" 
                               type="IDENTIFIABLE">
                          <d:var name="EthCtrlConfigIngressFifoBufLenByte" 
                                 type="INTEGER" value="256"/>
                          <d:var name="EthCtrlConfigIngressFifoBufTotal" 
                                 type="INTEGER" value="4"/>
                          <d:var name="EthCtrlConfigIngressFifoIdx" 
                                 type="INTEGER" value="0">
                            <a:a name="IMPORTER_INFO">
                              <a:v>@DEF</a:v>
                              <a:v>@CALC</a:v>
                            </a:a>
                          </d:var>
                          <d:lst 
                                 name="EthCtrlConfigIngressFifoPriorityAssignment"/>
                        </d:ctr>
                      </d:lst>
                      <d:ref name="EthCtrlConfigIngressUntaggedPktsFifoRef" 
                             type="REFERENCE" 
                             value="ASPath:/Eth/Eth/EthConfigSet/EthCtrlConfig_0/EthCtrlConfigIngress/EthCtrlConfigIngressFifo_0"/>
                    </d:ctr>
                    <d:lst name="EthDemEventParameterRefs" type="MAP"/>
                  </d:ctr>
                </d:lst>
              </d:ctr>
              <d:ctr name="EthGeneral" type="IDENTIFIABLE">
                <d:var name="EthDevErrorDetect" type="BOOLEAN" value="true"/>
                <d:var name="EthSafetyErrorDetect" type="BOOLEAN" value="true"/>
                <d:var name="EthGetDropCountApi" type="BOOLEAN" value="true"/>
                <d:var name="EthGetEtherStatsApi" type="BOOLEAN" value="true"/>
                <d:var name="EthGetTxErrorCounterValuesApi" type="BOOLEAN" 
                       value="false">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="EthGetTxStatsApi" type="BOOLEAN" value="false">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="EthGlobalTimeSupport" type="BOOLEAN" value="true"/>
                <d:var name="EthIndex" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="EthMainFunctionPeriod" type="FLOAT" value="0.005">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="EthMaxCtrlsSupported" type="INTEGER" value="1">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="EthVersionInfoApi" type="BOOLEAN" value="true"/>
                <d:lst name="EthEcucPartitionRef"/>
                <d:ctr name="EthCtrlOffloading" type="IDENTIFIABLE">
                  <d:var name="EthCtrlEnableOffloadChecksumICMP" type="BOOLEAN" 
                         value="true"/>
                  <d:var name="EthCtrlEnableOffloadChecksumIPv4" type="BOOLEAN" 
                         value="true"/>
                  <d:var name="EthCtrlEnableOffloadChecksumTCP" type="BOOLEAN" 
                         value="true"/>
                  <d:var name="EthCtrlEnableOffloadChecksumUDP" type="BOOLEAN" 
                         value="true"/>
                </d:ctr>
              </d:ctr>
              <d:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                <d:var name="ArReleaseMajorVersion" type="INTEGER" value="4">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ArReleaseMinorVersion" type="INTEGER" value="4">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ArReleaseRevisionVersion" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ModuleId" type="INTEGER" value="88">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SwMajorVersion" type="INTEGER" value="1">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SwMinorVersion" type="INTEGER" value="2">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SwPatchVersion" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="VendorId" type="INTEGER" value="175">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
              </d:ctr>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
