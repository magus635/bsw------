<?xml version='1.0'?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="Sent" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="Sent" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <d:ctr type="MODULE-CONFIGURATION">
              <a:a name="DEF" value="ASPath:/THA6_AS440_FuSa/Sent"/>
              <d:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" 
                     value="VariantPostBuild">
                <a:a name="IMPORTER_INFO" value="@DEF"/>
              </d:var>
              <d:lst name="SentConfigSet" type="MAP">
                <d:ctr name="SentConfigSet_0" type="IDENTIFIABLE">
                  <d:lst name="SentChannelConfigSet" type="MAP">
                    <d:ctr name="SentChannelConfigSet_0" type="IDENTIFIABLE">
                      <d:var name="SentChLogiIndex" type="INTEGER" value="0">
                        <a:a name="IMPORTER_INFO">
                          <a:v>@DEF</a:v>
                          <a:v>@CALC</a:v>
                        </a:a>
                      </d:var>
                      <d:var name="SentChPhyIndex" type="ENUMERATION" 
                             value="SENT2"/>
                      <d:var name="SentChanCRCType" type="ENUMERATION" 
                             value="SENT_CRC_TYPE_2010"/>
                      <d:var name="SentChanStatusNibbleCRCInc" type="BOOLEAN" 
                             value="true"/>
                      <d:var name="SentChanFrameCrcDisable" type="BOOLEAN" 
                             value="false">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="SentChanFrameDataLen" type="INTEGER" 
                             value="6">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="SentChanIgnoreEndPulse" type="BOOLEAN" 
                             value="false">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="SentChanInPulse" type="ENUMERATION" 
                             value="SENT_POLARITY_FALLING"/>
                      <d:var name="SentClocksPerTick" type="INTEGER" value="300"/>
                      <d:var name="SentChanCalloutFn" type="FUNCTION-NAME" 
                             value="Sent_CalloutChan0"/>
                      <d:var name="SentChanErrCalloutFn" type="FUNCTION-NAME" 
                             value="Sent_ErrCalloutChan0"/>
                      <d:ctr name="SPCConfig" type="IDENTIFIABLE">
                        <d:var name="SentChanUsedSpc" type="BOOLEAN" 
                               value="true"/>
                        <d:var name="SentTriggerMode" type="ENUMERATION" 
                               value="SENT_TRIGGER_MODE_SPC"/>
                        <d:var name="SentSpcPlusWidth" type="INTEGER" value="3">
                          <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:var>
                        <d:ref name="SentGtmChannel" type="REFERENCE" 
                               value="ASPath:/Mcu/Mcu/GtmConfiguration_0/GtmToPeripheral_0/SaradcSent_0"/>
                      </d:ctr>
                    </d:ctr>
                    <d:ctr name="SentChannelConfigSet_1" type="IDENTIFIABLE">
                      <d:var name="SentChLogiIndex" type="INTEGER" value="1"/>
                      <d:var name="SentChPhyIndex" type="ENUMERATION" 
                             value="SENT4"/>
                      <d:var name="SentChanCRCType" type="ENUMERATION" 
                             value="SENT_CRC_TYPE_2010">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="SentChanStatusNibbleCRCInc" type="BOOLEAN" 
                             value="false"/>
                      <d:var name="SentChanFrameCrcDisable" type="BOOLEAN" 
                             value="false">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="SentChanFrameDataLen" type="INTEGER" 
                             value="6">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="SentChanIgnoreEndPulse" type="BOOLEAN" 
                             value="true"/>
                      <d:var name="SentChanInPulse" type="ENUMERATION" 
                             value="SENT_POLARITY_FALLING"/>
                      <d:var name="SentClocksPerTick" type="INTEGER" value="300"/>
                      <d:var name="SentChanCalloutFn" type="FUNCTION-NAME" 
                             value="Sent_CalloutChan1"/>
                      <d:var name="SentChanErrCalloutFn" type="FUNCTION-NAME" 
                             value="Sent_ErrCalloutChan1"/>
                      <d:ctr name="SPCConfig" type="IDENTIFIABLE">
                        <d:var name="SentChanUsedSpc" type="BOOLEAN" 
                               value="false"/>
                        <d:var name="SentTriggerMode" type="ENUMERATION" 
                               value="SENT_TRIGGER_MODE_SPC"/>
                        <d:var name="SentSpcPlusWidth" type="INTEGER" value="3"/>
                        <d:ref name="SentGtmChannel" type="REFERENCE" 
                               value="ASPath:/Mcu/Mcu/GtmConfiguration_0/GtmToPeripheral_0/SaradcSent_0"/>
                      </d:ctr>
                    </d:ctr>
                    <d:ctr name="SentChannelConfigSet_2" type="IDENTIFIABLE">
                      <d:var name="SentChLogiIndex" type="INTEGER" value="2"/>
                      <d:var name="SentChPhyIndex" type="ENUMERATION" 
                             value="SENT5"/>
                      <d:var name="SentChanCRCType" type="ENUMERATION" 
                             value="SENT_CRC_TYPE_2010">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="SentChanStatusNibbleCRCInc" type="BOOLEAN" 
                             value="true"/>
                      <d:var name="SentChanFrameCrcDisable" type="BOOLEAN" 
                             value="false">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="SentChanFrameDataLen" type="INTEGER" 
                             value="6">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="SentChanIgnoreEndPulse" type="BOOLEAN" 
                             value="true"/>
                      <d:var name="SentChanInPulse" type="ENUMERATION" 
                             value="SENT_POLARITY_FALLING"/>
                      <d:var name="SentClocksPerTick" type="INTEGER" value="300"/>
                      <d:var name="SentChanCalloutFn" type="FUNCTION-NAME" 
                             value="Sent_CalloutChan2"/>
                      <d:var name="SentChanErrCalloutFn" type="FUNCTION-NAME" 
                             value="Sent_ErrCalloutChan2"/>
                      <d:ctr name="SPCConfig" type="IDENTIFIABLE">
                        <d:var name="SentChanUsedSpc" type="BOOLEAN" 
                               value="true"/>
                        <d:var name="SentTriggerMode" type="ENUMERATION" 
                               value="SENT_TRIGGER_MODE_GTM"/>
                        <d:var name="SentSpcPlusWidth" type="INTEGER" value="3">
                          <a:a name="IMPORTER_INFO" value="@DEF"/>
                        </d:var>
                        <d:ref name="SentGtmChannel" type="REFERENCE" 
                               value="ASPath:/Mcu/Mcu/GtmConfiguration_0/GtmToPeripheral_0/SaradcSent_12"/>
                      </d:ctr>
                    </d:ctr>
                  </d:lst>
                </d:ctr>
              </d:lst>
              <d:ctr name="SentGeneral" type="IDENTIFIABLE">
                <d:var name="SentDeInitApi" type="BOOLEAN" value="true"/>
                <d:var name="SentDevErrorDetect" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SentSafetyErrorDetect" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SentSpcFeatureSupport" type="BOOLEAN" value="true"/>
                <d:var name="SentVersionInfoApi" type="BOOLEAN" value="true"/>
                <d:var name="SentIndex" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
              </d:ctr>
              <d:ctr name="SentPublishedInformation" type="IDENTIFIABLE"/>
              <d:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                <d:var name="ArReleaseMajorVersion" type="INTEGER" value="4">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ArReleaseMinorVersion" type="INTEGER" value="4">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ArReleasePatchVersion" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SwMajorVersion" type="INTEGER" value="1">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SwMinorVersion" type="INTEGER" value="2">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="SwPatchVersion" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="ModuleId" type="INTEGER" value="255">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="VendorId" type="INTEGER" value="175">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
              </d:ctr>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
