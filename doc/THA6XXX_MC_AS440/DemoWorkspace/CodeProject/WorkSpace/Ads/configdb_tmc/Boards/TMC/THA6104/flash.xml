<flash_config
    xmlns:xi="http://www.w3.org/2001/XInclude"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.arm.com/flash_config"
    xsi:schemaLocation="http://www.arm.com/flash_config ../../../Schemas/flash_config.xsd">
    <devices>
        <device name="MainFlash">
            <programming_type type="FILE">
                <!-- Use the standard method for running Keil algorithms -->
                <method language="JYTHON" script="FDB://keil_flash.py" class="KeilFlash" method_config="Main"/>
            </programming_type>
        </device>
        <device name="HSMFlash">
            <programming_type type="FILE">
                <!-- Use the standard method for running Keil algorithms -->
                <method language="JYTHON" script="FDB://keil_flash.py" class="KeilFlash" method_config="HSM"/>
            </programming_type>
        </device>
        <device name="SFlash">
            <programming_type type="FILE">
                <!-- Use the standard method for running Keil algorithms -->
                <method language="JYTHON" script="FDB://keil_flash.py" class="KeilFlash" method_config="SFLASH"/>
            </programming_type>
        </device>
        <device name="UCBFlash">
            <programming_type type="FILE">
                <!-- Use the standard method for running Keil algorithms -->
                <method language="JYTHON" script="FDB://keil_flash.py" class="KeilFlash" method_config="UCB"/>
            </programming_type>
        </device>
    </devices>
    <method_configs>
        <method_config id="HSM">
            <params>
                <!-- Programming algorithm binary to load to target -->
                <param name="algorithm" type="string" value="FDB://algorithms/HSM.FLM"/>
                <!-- The core in the target to run the algorithm -->
                <param name="coreName" type="string" value="SC300"/>
                <!-- RAM location & size for algorithm code and write buffers -->
                <param name="ramAddress" type="integer" value="0x20000000"/>
                <param name="ramSize" type="integer" value="0x4000"/>
                <!-- Allow timeouts to be disabled -->
                <param name="disableTimeouts" type="string" value="false"/>
                <!-- Set to false to skip the verification stage -->
                <param name="verify" type="string" value="true"/>
            </params>
        </method_config>
        <method_config id="SFLASH">
            <params>
                <!-- Programming algorithm binary to load to target -->
                <param name="algorithm" type="string" value="FDB://algorithms/SFLASH.FLM"/>
                <!-- The core in the target to run the algorithm -->
                <param name="coreName" type="string" value="Cortex-R52+_0"/>
                <!-- RAM location & size for algorithm code and write buffers -->
                <param name="ramAddress" type="integer" value="0x00200000"/>
                <param name="ramSize" type="integer" value="0x8000"/>
                <!-- Allow timeouts to be disabled -->
                <param name="disableTimeouts" type="string" value="false"/>
                <!-- Set to false to skip the verification stage -->
                <param name="verify" type="string" value="false"/>
            </params>
        </method_config>
        <method_config id="Main">
            <params>
                <!-- Programming algorithm binary to load to target -->
                <param name="algorithm" type="string" value="FDB://algorithms/MAIN.FLM"/>
                <!-- The core in the target to run the algorithm -->
                <param name="coreName" type="string" value="Cortex-R52+_0"/>
                <!-- RAM location & size for algorithm code and write buffers -->
                <param name="ramAddress" type="integer" value="0x00200000"/>
                <param name="ramSize" type="integer" value="0x8000"/>
                <!-- Allow timeouts to be disabled -->
                <param name="disableTimeouts" type="string" value="false"/>
                <!-- Set to false to skip the verification stage -->
                <param name="verify" type="string" value="true"/>
            </params>
        </method_config>
        <method_config id="UCB">
            <params>
                <!-- Programming algorithm binary to load to target -->
                <param name="algorithm" type="string" value="FDB://algorithms/UCB.FLM"/>
                <!-- The core in the target to run the algorithm -->
                <param name="coreName" type="string" value="Cortex-R52+_0"/>
                <!-- RAM location & size for algorithm code and write buffers -->
                <param name="ramAddress" type="integer" value="0x00200000"/>
                <param name="ramSize" type="integer" value="0x8000"/>
                <!-- Allow timeouts to be disabled -->
                <param name="disableTimeouts" type="string" value="false"/>
                <!-- Set to false to skip the verification stage -->
                <param name="verify" type="string" value="true"/>
            </params>
        </method_config>
    </method_configs>
</flash_config>
