#! armclang --target=arm-arm-none-eabi -march=armv8-a -E -x c

;/**************************************************************************************************
; * Copyright (c) Tongxin Microelectronics Co., Ltd. All Rights Reserved.
; * FileName: LinkerAdsPf.scat
; * Author:    30011
; * Version:   v0.1
; * Date:     2023/05/31
; * Description: This file startup the system.
; * Others:
; * History:
; *  Date          Author    Modified
; *  2023/05/31    30011     create
; ************************************************************************************************/
;
;/******* Memory ************** Start Address ****************************    End Address *******************************
;        CPUXATCM                0x00000000                0x00000000 - 0x00010000 (64K)          local access CPUXATCM address
;        CPUXCTCM                0x00200000                0x00200000 - 0x00210000 (64K)          local access CPUXCTCM address set  it as internel address for CPU0 and cpu1 in startup code.
;
;        CPUXPFLASH0             0x08000000                0x08000000 - 0x08300000 (3MB)          local access PF0 address
;        CPUXPFLASH1             0x08300000                0x08300000 - 0x08600000 (3MB)          local access PF1 address
;
;        CPU0ATCM                0x30000000                0x30000000 - 0x30010000 (64K)          AXI access CPU0ATCM address
;        CPU0BTCM                0x30100000                0x30100000 - 0x30130000 (192K)         AXI access CPU0BTCM address   set  it as internel address for CPU0 in startup code.
;        CPU0CTCM                0x30200000                0x30200000 - 0x30210000 (64K)          AXI access CPU0CTCM address
;
;        CPU1ATCM                0x30400000                0x30400000 - 0x30410000 (64K)          AXI access CPU1ATCM address
;        CPU1BTCM                0x30500000                0x30500000 - 0x30530000 (192K)         AXI access CPU1BTCM address  set it as  internel address for CPU1 in startup code.
;        CPU1CTCM                0x30600000                0x30600000 - 0x30610000 (64K)          AXI access CPU1CTCM address
;        GMU_NORMAL              0x10000000                0x10000000 - 0x10040000 (256K)         AXI access global memory address(Cacheable)
;        LMU1_NORMAL             0x10054000                0x10054000 - 0x10058000 (16k)          AXI Cacheable
;        LMU2_NORMAL             0x10058000                0x10058000 - 0x1005C000 (16k)          AXI Cacheable
;        LMU3_NORMAL             0x1005C000                0x1005C000 - 0x10060000 (16k)          AXI Cacheable
;        PFLASH0_NORMAL          0x40400000                0x40400000 - 0x40700000 (3MB)          AXI access PF0 address(Cacheable)
;        PFLASH1_NORMAL          0x40700000                0x40700000 - 0x40A00000 (3MB)          AXI access PF1 address(Cacheable)
;        DFLASH_NORMAL           0x44000000                0x44000000 - 0x44080000 (512KB)        AXI access DF address(Cacheable)
;        GMU_DEVICE              0x82000000                0x82000000 - 0x82040000 (256K)         AXI access global memory address(Non-Cacheable)
;        PFLASH0_DEVICE          0x90400000                0x90400000 - 0x90700000 (3MB)          AXI access PF0 address(Non-Cacheable)
;        PFLASH1_DEVICE          0x90700000                0x90700000 - 0x90A00000 (3MB)          AXI access PF1 address(Non-Cacheable)
;        DFLASH_DEVICE           0x94000000                0x94000000 - 0x94080000 (512KB)        AXI access DF address(Non-Cacheable)
;        LMU1_DEVICE             0xB0020000                0xB0020000 - 0xB0024000 (16KB)         AXI access LMU address(Non-Cacheable)
;        LMU2_DEVICE             0xC00D0000                0xC00D0000 - 0xC00D4000 (16KB)         AXI access LMU address(Non-Cacheable)
;        LMU3_DEVICE             0xD0040000                0xD0040000 - 0xD0044000 (16KB)         AXI access LMU address(Non-Cacheable)
;
;**********************************************************************************************************************/

#define STARTUP_ADDRESS                0x00000000
#define CPUXATCM_ADDRESS               0x00000000
#define CPUXCTCM_ADDRESS               0x00200000
#define CPUXPFLASH0_ADDRESS            0x08000000


#define GMU_NORMAL_UNDEFINE_ADDRESS    0x10020000

#define CPU0BTCM_ADDRESS               0x30100000
#define CPU0_STACK_ADDRESS             0x30129000
#define CPU1BTCM_ADDRESS               0x30500000
#define CPU1_STACK_ADDRESS             0x30529000
#define PFLASH0_NORMAL_ADDRESS         0x40400000
#define PFLASH1_NORMAL_ADDRESS         0x40700000
#define GMU_DEVICE_ADDRESS             0x82000000
#define DFLASH_MEMORY_ADDRESS          0x44000000

#define LMU1_DEVICE_ADDRESS            0xB0020000
#define LMU2_DEVICE_ADDRESS            0xC00D0000
#define LMU3_DEVICE_ADDRESS            0xD0040000
#define LMU1_NORMAL_ADDRESS            0x10054000
#define LMU2_NORMAL_ADDRESS            0x10058000
#define LMU3_NORMAL_ADDRESS            0x1005C000






ROM_CODE CPUXPFLASH0_ADDRESS 0X300000                                  ;3M
{
;PFLASH0_NORMAL
    INT_VECTOR_TABLE STARTUP_ADDRESS ALIGN 64 0x2080
    {
        *(.init_default_vector, +First)                              ;Set EL2/EL1 Default vector at 0x0 length is 0x2080 Bytes
        exception.o(.IRQ_init_vector)                                ;IRQ
    }

    EX_CODE  CPUXPFLASH0_ADDRESS+AlignExpr(ImageLimit(INT_VECTOR_TABLE),64) ALIGN 64  0X300000
    {
        *(.user_code,+First)                                         ; Code section to user code
        *(+RO-CODE)                                                  ;Code section to store instruction
        *(+CODE, .exceptionHandler) 
        *(+CODE, .mcal_text_asil_d) 
        *(+CODE, .mcal_text_callout_asil_d)
        *(+CODE, .sdk_text_asil_d) 
        *(+CODE, .sdk_text_callout_asil_d)
        *(+CODE, .sdk_text_asil_d_core1)
        *(+CODE, .sdk_text_callout_asil_d_core1)    
    }
    EX_CONST_DATA AlignExpr(ImageLimit(EX_CODE), 64) ALIGN 64 0X300000
    {
        *  (+RO-DATA)
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_bool  ) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_8  ) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_16  ) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_32  ) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_unspecified  )
        *  ( +RO-DATA , .mcal_const_asil_d_bool  ) 
        *  ( +RO-DATA , .mcal_const_asil_d_8  ) 
        *  ( +RO-DATA , .mcal_const_asil_d_16  ) 
        *  ( +RO-DATA , .mcal_const_asil_d_32  ) 
        *  ( +RO-DATA , .mcal_const_asil_d_unspecified  )
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_bool_core0) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_8_core0) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_16_core0) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_32_core0) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_unspecified_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_bool_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_8_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_16_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_32_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_unspecified_core0)
        *  (+RO-DATA, .sdk_const_*)                     
 
    }

    EX_CODE_CORE1  AlignExpr(ImageLimit(EX_CONST_DATA), 64) ALIGN 64 0X300000
    {
        *(.mcal_text_asil_d_core1)
        *(.mcal_text_callout_asil_d_core1)
    }
    EX_CONST_DATA_CORE1 AlignExpr(ImageLimit(EX_CODE_CORE1), 64) ALIGN 64 0X300000
    {
        *(.mcal_const_cfg_asil_d_bool_core1) 
        *(.mcal_const_cfg_asil_d_8_core1) 
        *(.mcal_const_cfg_asil_d_16_core1) 
        *(.mcal_const_cfg_asil_d_32_core1) 
        *(.mcal_const_cfg_asil_d_unspecified_core1) 
        *(.mcal_const_asil_d_bool_core1) 
        *(.mcal_const_asil_d_8_core1) 
        *(.mcal_const_asil_d_16_core1) 
        *(.mcal_const_asil_d_32_core1) 
        *(.mcal_const_asil_d_unspecified_core1) 
    }


;CPUXATCM

    CODE_CLONE STARTUP_ADDRESS+AlignExpr(ImageLimit(INT_VECTOR_TABLE), 64) ALIGN 64 0x7000
    {
        *(.private_clone_code)                                       
    }

;CPUXCTCM
    DATA_CLONE CPUXCTCM_ADDRESS ALIGN 64 0x8000
    {
        exception.o(.exceptionRegInfo)                               ;exception register information
        *(.private_clone_data)
    }
    BSS_CLONE AlignExpr(ImageLimit(DATA_CLONE), 64) ALIGN 64 0x8000
    {
        *(.private_clone_bss)   
    }

;GMU_NORMAL
    UNDEFINE_RAM_DATA GMU_NORMAL_UNDEFINE_ADDRESS ALIGN 64 0x20000
    {
        *(+RW-DATA)        
        *(.global_data)
        *(.mcal_data)
        *(.mcal_data_asil_d_bool)
        *(.mcal_data_asil_d_8)
        *(.mcal_data_asil_d_16)
        *(.mcal_data_asil_d_32)
        *(.mcal_data_asil_d_unspecified)
        *(.sdk_data)
        *(.sdk_data_asil_d_bool)
        *(.sdk_data_asil_d_8)
        *(.sdk_data_asil_d_16)
        *(.sdk_data_asil_d_32)
        *(.sdk_data_asil_d_unspecified)
    }

    UNDEFINE_RAM_BSS AlignExpr(ImageLimit(UNDEFINE_RAM_DATA), 64) ALIGN 64 0x20000
    {
        *(+ZI)        
        *(.global_bss)                                               ;
        *(.mcal_bss_asil_d_bool)
        *(.mcal_bss_asil_d_8)
        *(.mcal_bss_asil_d_16)
        *(.mcal_bss_asil_d_32)
        *(.mcal_bss_asil_d_unspecified)
        *(.mcal_cleared)
        *(.mcal_bss)
        *(.sdk_bss_asil_d_bool)
        *(.sdk_bss_asil_d_8)
        *(.sdk_bss_asil_d_16)
        *(.sdk_bss_asil_d_32)
        *(.sdk_bss_asil_d_unspecified)
        *(.sdk_cleared)
        *(.sdk_bss)
    }
    UNCLEAR_RAM_BSS AlignExpr(ImageLimit(UNDEFINE_RAM_BSS), 64) ALIGN 64 0x20000
    {
    
        *(.unclear_bss)                                              ; To store the variable that will not be reset in warm reset.
        *(.mcal_no_init_asil_d_bool)
        *(.mcal_no_init_asil_d_8)
        *(.mcal_no_init_asil_d_16)
        *(.mcal_no_init_asil_d_32)
        *(.mcal_no_init_asil_d_unspecified)
        *(.sdk_no_init_asil_d_bool)
        *(.sdk_no_init_asil_d_8)
        *(.sdk_no_init_asil_d_16)
        *(.sdk_no_init_asil_d_32)
        *(.sdk_no_init_asil_d_unspecified)
    }

;LMU_NORMAL
    LMU1_CACHED_DATA LMU1_NORMAL_ADDRESS ALIGN 64 0x4000
    {
        *(.mcal_data_asil_d_bool_lmu1)
        *(.mcal_data_asil_d_8_lmu1)
        *(.mcal_data_asil_d_16_lmu1)
        *(.mcal_data_asil_d_32_lmu1)
        *(.mcal_data_asil_d_unspecified_lmu1)
    }
    LMU1_CACHED_BSS AlignExpr(ImageLimit(LMU1_CACHED_DATA), 64)  ALIGN 64 0x4000
    {
        *(.mcal_bss_asil_d_bool_lmu1)
        *(.mcal_bss_asil_d_8_lmu1)
        *(.mcal_bss_asil_d_16_lmu1)
        *(.mcal_bss_asil_d_32_lmu1)
        *(.mcal_bss_asil_d_unspecified_lmu1)
    }
    LMU2_CACHED_DATA LMU2_NORMAL_ADDRESS ALIGN 64 0x4000
    {
        *(.mcal_data_asil_d_bool_lmu2)
        *(.mcal_data_asil_d_8_lmu2)
        *(.mcal_data_asil_d_16_lmu2)
        *(.mcal_data_asil_d_32_lmu2)
        *(.mcal_data_asil_d_unspecified_lmu2)
    }
    LMU2_CACHED_BSS AlignExpr(ImageLimit(LMU2_CACHED_DATA), 64)  ALIGN 64 0x4000
    {
        *(.mcal_bss_asil_d_bool_lmu2)
        *(.mcal_bss_asil_d_8_lmu2)
        *(.mcal_bss_asil_d_16_lmu2)
        *(.mcal_bss_asil_d_32_lmu2)
        *(.mcal_bss_asil_d_unspecified_lmu2)
    }

    LMU3_CACHED_DATA LMU3_NORMAL_ADDRESS ALIGN 64 0x4000
    {
        *(.mcal_data_asil_d_bool_lmu3)
        *(.mcal_data_asil_d_8_lmu3)
        *(.mcal_data_asil_d_16_lmu3)
        *(.mcal_data_asil_d_32_lmu3)
        *(.mcal_data_asil_d_unspecified_lmu3)
    }
    LMU3_CACHED_BSS AlignExpr(ImageLimit(LMU3_CACHED_DATA), 64)  ALIGN 64 0x4000
    {
        *(.mcal_bss_asil_d_bool_lmu3)
        *(.mcal_bss_asil_d_8_lmu3)
        *(.mcal_bss_asil_d_16_lmu3)
        *(.mcal_bss_asil_d_32_lmu3)
        *(.mcal_bss_asil_d_unspecified_lmu3)
    }


;CPU0BTCM

    PRIVATE_CODE_CORE0 CPU0BTCM_ADDRESS ALIGN 64 0x18000
    {
        *(.private_Core0_code)
        *(.mcal_ramcode_asil_d_core0)
        *(.mcal_text_asil_d_core0)
        *(.mcal_text_fast_asil_d_core0)
        *(.mcal_text_callout_asil_d_core0)
        *(.sdk_ramcode_asil_d_core0)
        *(.sdk_text_asil_d_core0)
        *(.sdk_text_fast_asil_d_core0)
        *(.sdk_text_callout_asil_d_core0)       
    }

    PRIVATE_DATA_CORE0 AlignExpr(ImageLimit(PRIVATE_CODE_CORE0), 64) ALIGN 64 0x8000
    {
        *(.private_Core0_data)                                       ;
        *(.mcal_data_asil_d_bool_core0)
        *(.mcal_data_asil_d_8_core0)
        *(.mcal_data_asil_d_16_core0)
        *(.mcal_data_asil_d_32_core0)
        *(.mcal_data_asil_d_unspecified_core0)
        *(.sdk_data_asil_d_bool_core0)
        *(.sdk_data_asil_d_8_core0)
        *(.sdk_data_asil_d_16_core0)
        *(.sdk_data_asil_d_32_core0)
        *(.sdk_data_asil_d_unspecified_core0)
    }

    PRIVATE_BSS_CORE0 AlignExpr(ImageLimit(PRIVATE_DATA_CORE0), 64) ALIGN 64 0x9000
    {
        *(.private_Core0_bss)                                        
        *(.private_bss_Core0)
        *(.mcal_bss_asil_d_bool_core0)
        *(.mcal_bss_asil_d_8_core0)
        *(.mcal_bss_asil_d_16_core0)
        *(.mcal_bss_asil_d_32_core0)
        *(.mcal_bss_asil_d_unspecified_core0)
        *(.sdk_bss_asil_d_bool_core0)
        *(.sdk_bss_asil_d_8_core0)
        *(.sdk_bss_asil_d_16_core0)
        *(.sdk_bss_asil_d_32_core0)
        *(.sdk_bss_asil_d_unspecified_core0)
    }

    PRIVATE_NO_INIT_CORE0 AlignExpr(ImageLimit(PRIVATE_BSS_CORE0), 64) ALIGN 64 0x9000
    {
        *(.mcal_no_init_asil_d_bool_core0)
        *(.mcal_no_init_asil_d_8_core0)
        *(.mcal_no_init_asil_d_16_core0)
        *(.mcal_no_init_asil_d_32_core0)
        *(.mcal_no_init_asil_d_unspecified_core0)
        *(.mcal_no_init_asil_d_bool_uncached_core0)
        *(.mcal_no_init_asil_d_8_uncached_core0)
        *(.mcal_no_init_asil_d_16_uncached_core0)
        *(.mcal_no_init_asil_d_32_uncached_core0)
        *(.mcal_no_init_asil_d_unspecified_uncached_core0)
    }
    

    CORE0_USER_STACK CPU0_STACK_ADDRESS ALIGN 8 EMPTY 0x1000{}                 ;
    CORE0_HYP_STACK ImageLimit(CORE0_USER_STACK) ALIGN 8 EMPTY 0x1000{}        ;
    CORE0_KERNEL_STACK ImageLimit(CORE0_HYP_STACK) ALIGN 8 EMPTY 0x1000{}      ;
    CORE0_ABORT_STACK ImageLimit(CORE0_KERNEL_STACK) ALIGN 8 EMPTY 0x1000{}    ;
    CORE0_UNDEFINED_STACK ImageLimit(CORE0_ABORT_STACK) ALIGN 8 EMPTY 0x1000{} ;
    CORE0_IRQ_STACK ImageLimit(CORE0_UNDEFINED_STACK) ALIGN 8 EMPTY 0x1000{}   ;
    CORE0_FIQ_STACK ImageLimit(CORE0_IRQ_STACK) ALIGN 8 EMPTY 0x1000{}         ;

;CPU1BTCM

    PRIVATE_CODE_CORE1 CPU1BTCM_ADDRESS ALIGN 64 0x18000
    {
        *(.private_Core1_code)                                       ;Set Core0 private code section at BTCM 0x30500000~0x30517FFF
        *(.private_code_Core1)
        *(.mcal_ramcode_asil_d_core1)
        *(.mcal_text_fast_asil_d_core1)
        *(.sdk_ramcode_asil_d_core1)
        *(.sdk_text_fast_asil_d_core1)
    }

    PRIVATE_DATA_CORE1 AlignExpr(ImageLimit(PRIVATE_CODE_CORE1), 64) ALIGN 64 0x8000
    {
        
        *(.private_Core1_data)                                       ;Set Core1 private data section at BTCM. 0x30518000~0x3051FFFF length is 32KB
        *(.mcal_data_asil_d_bool_core1)
        *(.mcal_data_asil_d_8_core1)
        *(.mcal_data_asil_d_16_core1)
        *(.mcal_data_asil_d_32_core1)
        *(.mcal_data_asil_d_unspecified_core1)
        *(.sdk_data_asil_d_bool_core1)
        *(.sdk_data_asil_d_8_core1)
        *(.sdk_data_asil_d_16_core1)
        *(.sdk_data_asil_d_32_core1)
        *(.sdk_data_asil_d_unspecified_core1)
    }

    PRIVATE_BSS_CORE1 AlignExpr(ImageLimit(PRIVATE_DATA_CORE1), 64) ALIGN 64 0x9000
    {
        *(.private_Core1_bss)                                        ;Set core1 private bss section at BTCM 0x30520000~0x30528FFF length is 36KB
        *(.mcal_bss_asil_d_bool_core1)
        *(.mcal_bss_asil_d_8_core1)
        *(.mcal_bss_asil_d_16_core1)
        *(.mcal_bss_asil_d_32_core1)
        *(.mcal_bss_asil_d_unspecified_core1)
        *(.sdk_bss_asil_d_bool_core1)
        *(.sdk_bss_asil_d_8_core1)
        *(.sdk_bss_asil_d_16_core1)
        *(.sdk_bss_asil_d_32_core1)
        *(.sdk_bss_asil_d_unspecified_core1)
    }
    PRIVATE_NO_INIT_CORE1 AlignExpr(ImageLimit(PRIVATE_BSS_CORE1), 64) ALIGN 64 0x9000
    {
        *(.mcal_no_init_asil_d_bool_core1)
        *(.mcal_no_init_asil_d_8_core1)
        *(.mcal_no_init_asil_d_16_core1)
        *(.mcal_no_init_asil_d_32_core1)
        *(.mcal_no_init_asil_d_unspecified_core1)
        *(.mcal_no_init_asil_d_bool_uncached_core1)
        *(.mcal_no_init_asil_d_8_uncached_core1)
        *(.mcal_no_init_asil_d_16_uncached_core1)
        *(.mcal_no_init_asil_d_32_uncached_core1)
        *(.mcal_no_init_asil_d_unspecified_uncached_core1)
    }
    CORE1_USER_STACK CPU1_STACK_ADDRESS ALIGN 8 EMPTY 0x1000{}                 ;
    CORE1_HYP_STACK ImageLimit(CORE1_USER_STACK) ALIGN 8 EMPTY 0x1000{}        ;
    CORE1_KERNEL_STACK ImageLimit(CORE1_HYP_STACK) ALIGN 8 EMPTY 0x1000{}      ;
    CORE1_ABORT_STACK ImageLimit(CORE1_KERNEL_STACK) ALIGN 8 EMPTY 0x1000{}    ;
    CORE1_UNDEFINED_STACK ImageLimit(CORE1_ABORT_STACK) ALIGN 8 EMPTY 0x1000{} ;
    CORE1_IRQ_STACK ImageLimit(CORE1_UNDEFINED_STACK) ALIGN 8 EMPTY 0x1000{}   ;
    CORE1_FIQ_STACK ImageLimit(CORE1_IRQ_STACK) ALIGN 8 EMPTY 0x1000{}         ;


;GMU_DEVICE

    RAM_CODE GMU_DEVICE_ADDRESS ALIGN 64 0X20000
    {
      *(.mcal_text_fast_asil_d)
      *(.mcal_ramcode_asil_d)
    }

    ;data placed at GMU area must be uint32 alignment. 
    GLOBAL_UNCACHED_DATA AlignExpr(ImageLimit(RAM_CODE), 64) ALIGN 64 0X20000
    {
        *(.uncached_data)
        *(.mcal_data_asil_d_bool_uncached)
        *(.mcal_data_asil_d_8_uncached)
        *(.mcal_data_asil_d_16_uncached)
        *(.mcal_data_asil_d_32_uncached)    
        *(.mcal_data_asil_d_unspecified_uncached)
        *(.sdk_data_asil_d_bool_uncached)
        *(.sdk_data_asil_d_8_uncached)
        *(.sdk_data_asil_d_16_uncached)
        *(.sdk_data_asil_d_32_uncached)    
        *(.sdk_data_asil_d_unspecified_uncached)                                    
    }

    GLOBAL_UNCACHED_BSS AlignExpr(ImageLimit(GLOBAL_UNCACHED_DATA), 64) ALIGN 64 0X20000
    {
        *(.uncached_bss)                                             ;
        *(.mcal_bss_asil_d_bool_uncached)
        *(.mcal_bss_asil_d_8_uncached)
        *(.mcal_bss_asil_d_16_uncached)
        *(.mcal_bss_asil_d_32_uncached)
        *(.mcal_bss_asil_d_unspecified_uncached)
        *(.sdk_bss_asil_d_bool_uncached)
        *(.sdk_bss_asil_d_8_uncached)
        *(.sdk_bss_asil_d_16_uncached)
        *(.sdk_bss_asil_d_32_uncached)
        *(.sdk_bss_asil_d_unspecified_uncached)
    }
    GLOBAL_UNCACHED_NOINIT AlignExpr(ImageLimit(GLOBAL_UNCACHED_BSS), 64) ALIGN 64 0X20000
    {

        *(.mcal_no_init_asil_d_bool_uncached)
        *(.mcal_no_init_asil_d_8_uncached)
        *(.mcal_no_init_asil_d_16_uncached)
        *(.mcal_no_init_asil_d_32_uncached)
        *(.mcal_no_init_asil_d_unspecified_uncached)
    }

;LMU DEVICE
    LMU1_UNCACHED_DATA LMU1_DEVICE_ADDRESS ALIGN 64 0x4000
    {
        *(.mcal_data_asil_d_bool_lmu1_uncached)
        *(.mcal_data_asil_d_8_lmu1_uncached)
        *(.mcal_data_asil_d_16_lmu1_uncached)
        *(.mcal_data_asil_d_32_lmu1_uncached)
        *(.mcal_data_asil_d_unspecified_lmu1_uncached)
        *(.lmu1_uncached_data)                                             ; To store the globle uncached variables that used in RAM store in Flash.
        *(.lmu1_uncached_data.*)                                           ; The address is 0xB0020000~0xB0023FFF,length is 16KB.
        *(.sdk_data_asil_d_bool_lmu1_uncached)
        *(.sdk_data_asil_d_8_lmu1_uncached)
