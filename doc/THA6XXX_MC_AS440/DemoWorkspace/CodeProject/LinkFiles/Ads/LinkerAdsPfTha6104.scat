#! armclang --target=arm-arm-none-eabi -march=armv8-a -E -x c

;/**************************************************************************************************
; * Copyright (c) Tongxin Microelectronics Co., Ltd. All Rights Reserved.
; * FileName: LinkerAdsPftha6104.scat
; * Author:    30011
; * Version:   v0.1
; * Date:     2025/05/26
; * Description: link file for tha6104.
; * Others:
; * History:
; *  Date          Author    Modified
; ************************************************************************************************/
;
;/******* Memory ************** Start Address ****************************    End Address *******************************
;        CPUXATCM                0x00000000                0x00000000 - 0x00008000 (64K to 32KB)  local access CPUXATCM address
;        CPUXCTCM                0x00200000                0x00200000 - 0x00220000 (64K TO 128KB) local access CPUXCTCM address set  it as internel address for CPU0 and cpu1 in startup code.
;        C1CPUXATCM              0x00000000                0x00000000 - 0x00010000 (64K)          local access Cluster1 CPUXATCM address 
;        C1CPUXBTCM              0x00100000                0x00100000 - 0x00118000 (96K)          local access Cluster1 CPUXBTCM address invalid
;        C1CPUXCTCM              0x00200000                0x00200000 - 0x00220000 (64K to 128k)          local access Cluster1 CPUXCTCM address set  it as internel address for CPU0 and cpu1 in startup code.
;        CPUXPFLASH0             0x08000000                0x08000000 - 0x08200000 (3MB TO 2MB)          local access PF0 address
;        CPUXPFLASH1             0x08200000  (83 TO 82)    0x08200000 - 0x08400000 (3MB TO 2MB)          local access PF1 address
;        GMU0_NORMAL             0x10000000                0x10000000 - 0x1000A000 (256K TO 40K) AXI access global memory address(Cacheable)
;        GMU1_NORMAL             0x10000000                0x1000A000 - 0x10014000 (128K TO 40K)         AXI access global memory address(Cacheable)
;        LMU2_NORMAL             0x10058000                0x10058000 - 0x1005C000 (16k)          AXI Cacheable
;        CPU0ATCM                0x30000000                0x30000000 - 0x30008000 (64K TO 32K)          AXI access CPU0ATCM address
;        CPU0BTCM                0x30100000                0x30100000 - 0x30140000 (192K TO 256K) AXI access CPU0BTCM address   set  it as internel address for CPU0 in startup code.
;        CPU0CTCM                0x30200000                0x30200000 - 0x30220000 (64K to 128k)          AXI access CPU0CTCM address
;        PFLASH0_NORMAL          0x40400000                0x40400000 - 0x40600000 (3MB TO 2MB)          AXI access PF0 address(Cacheable)
;        PFLASH1_NORMAL          0x40600000 (407 TO 406) 0x40600000 - 0x40800000 (3MB TO 2MB)          AXI access PF1 address(Cacheable)
;        DFLASH_NORMAL           0x44000000                0x44000000 - 0x44040000 (512KB TO 256K)        AXI access DF address(Cacheable)
;        GMU0_DEVICE             0x82000000                0x82000000 - 0x8200A000 (256K TO 40k) AXI access global memory address(Non-Cacheable)
;        GMU1_DEVICE             0x82020000                0x8200A000 - 0x82014000 (128K TO 40K)         AXI access global memory address(Non-Cacheable)
;        PFLASH0_DEVICE          0x90400000                0x90400000 - 0x90600000 (3MB TO 2MB)          AXI access PF0 address(Non-Cacheable)
;        PFLASH1_DEVICE          0x90600000 (907 TO 906)   0x90600000 - 0x90800000 (3MB TO 2MB)          AXI access PF1 address(Non-Cacheable)
;        DFLASH_DEVICE           0x94000000                0x94000000 - 0x94040000 (512KB TO 256K)        AXI access DF address(Non-Cacheable)
;        LMU2_DEVICE             0xC00D0000                0xC00D0000 - 0xC00D4000 (16KB)         AXI access LMU address(Non-Cacheable)
;
;**********************************************************************************************************************/

#define STARTUP_ADDRESS                0x00000000
#define CPUXATCM_ADDRESS               0x00000000
#define CPUXCTCM_ADDRESS               0x00200000
#define CPUXPFLASH0_ADDRESS            0x08000000
#define CPUXPFLASH1_ADDRESS            0x08200000


#define GMU_NORMAL_UNDEFINE_ADDRESS    0x1000C000
#define LMU2_NORMAL_ADDRESS            0x10058000
#define CPU0BTCM_ADDRESS               0x30100000
#define CPU0_STACK_ADDRESS             (0x30140000 - 0x7000)

#define PFLASH0_NORMAL_ADDRESS         0x40400000
#define PFLASH1_NORMAL_ADDRESS         0x40600000

#define GMU_DEVICE_ADDRESS             0x82000000
#define DFLASH_MEMORY_ADDRESS          0x44000000

#define LMU2_DEVICE_ADDRESS            0xC00D0000


ROM_CODE CPUXPFLASH0_ADDRESS 0X200000                                  ;3M
{
;PFLASH0_NORMAL
    INT_VECTOR_TABLE STARTUP_ADDRESS ALIGN 64 0x2080
    {
        *(.init_default_vector, +First)                              ;Set EL2/EL1 Default vector at 0x0 length is 0x2080 Bytes
        exception.o(.IRQ_init_vector)                                ;IRQ
    }

    EX_CODE  CPUXPFLASH0_ADDRESS+AlignExpr(ImageLimit(INT_VECTOR_TABLE),64) ALIGN 64  0X200000
    {
        *(.user_code,+First)                                         ; Code section to user code
        *(+RO-CODE)                                                  ;Code section to store instruction
        *(+CODE, .exceptionHandler) 
        *(+CODE, .mcal_text_asil_d) 
        *(+CODE, .mcal_text_callout_asil_d)
        *(+CODE, .sdk_text_asil_d) 
        *(+CODE, .sdk_text_callout_asil_d)
    }
    EX_CONST_DATA AlignExpr(ImageLimit(EX_CODE), 64) ALIGN 64 0X200000
    {
        *  (+RO-DATA)
        *  ( +RO-DATA , .mcal_const_*  ) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_bool  ) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_8  ) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_16  ) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_32  ) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_unspecified  )
        *  ( +RO-DATA , .mcal_const_asil_d_bool  ) 
        *  ( +RO-DATA , .mcal_const_asil_d_8  ) 
        *  ( +RO-DATA , .mcal_const_asil_d_16  ) 
        *  ( +RO-DATA , .mcal_const_asil_d_32  ) 
        *  ( +RO-DATA , .mcal_const_asil_d_unspecified  )
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_bool_core0) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_8_core0) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_16_core0) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_32_core0) 
        *  ( +RO-DATA , .mcal_const_cfg_asil_d_unspecified_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_bool_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_8_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_16_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_32_core0) 
        *  ( +RO-DATA , .mcal_const_asil_d_unspecified_core0) 
        *(+RO-DATA, .sdk_const_cfg_asil_d_bool) 
        *(+RO-DATA, .sdk_const_cfg_asil_d_8) 
        *(+RO-DATA, .sdk_const_cfg_asil_d_16) 
        *(+RO-DATA, .sdk_const_cfg_asil_d_32) 
        *(+RO-DATA, .sdk_const_cfg_asil_d_unspecified)
        *(+RO-DATA, .sdk_const_asil_d_bool) 
        *(+RO-DATA, .sdk_const_asil_d_8) 
        *(+RO-DATA, .sdk_const_asil_d_16) 
        *(+RO-DATA, .sdk_const_asil_d_32) 
        *(+RO-DATA, .sdk_const_asil_d_unspecified  )
        *(+RO-DATA, .sdk_const_cfg_asil_d_bool_core0) 
        *(+RO-DATA, .sdk_const_cfg_asil_d_8_core0) 
        *(+RO-DATA, .sdk_const_cfg_asil_d_16_core0) 
        *(+RO-DATA, .sdk_const_cfg_asil_d_32_core0) 
        *(+RO-DATA, .sdk_const_cfg_asil_d_unspecified_core0) 
        *(+RO-DATA, .sdk_const_asil_d_bool_core0) 
        *(+RO-DATA, .sdk_const_asil_d_8_core0) 
        *(+RO-DATA, .sdk_const_asil_d_16_core0) 
        *(+RO-DATA, .sdk_const_asil_d_32_core0) 
        *(+RO-DATA, .sdk_const_asil_d_unspecified_core0) 
    }



;CPUXATCM

    CODE_CLONE STARTUP_ADDRESS+AlignExpr(ImageLimit(INT_VECTOR_TABLE), 64) ALIGN 64 0x7000
    {
        *(.private_clone_code)                                       
    }

;CPUXCTCM
    DATA_CLONE CPUXCTCM_ADDRESS ALIGN 64 0x8000
    {
        exception.o(.exceptionRegInfo)                               ;exception register information
        *(.private_clone_data)
    }
    BSS_CLONE AlignExpr(ImageLimit(DATA_CLONE), 64) ALIGN 64 0x8000
    {
        *(.private_clone_bss)   
    }

;GMU_NORMAL
    UNDEFINE_RAM_DATA GMU_NORMAL_UNDEFINE_ADDRESS ALIGN 64 0X8000
    {
        *(+RW-DATA)        
        *(.global_data)
        *(.mcal_data)
        *(.mcal_data_asil_d_bool)
        *(.mcal_data_asil_d_8)
        *(.mcal_data_asil_d_16)
        *(.mcal_data_asil_d_32)
        *(.mcal_data_asil_d_unspecified)
        *(.sdk_data)
        *(.sdk_data_asil_d_bool)
        *(.sdk_data_asil_d_8)
        *(.sdk_data_asil_d_16)
        *(.sdk_data_asil_d_32)
        *(.sdk_data_asil_d_unspecified)
    }

    UNDEFINE_RAM_BSS AlignExpr(ImageLimit(UNDEFINE_RAM_DATA), 64) ALIGN 64 0X8000
    {
        *(+ZI)        
        *(.global_bss)                                               ;
        *(.mcal_bss_asil_d_bool)
        *(.mcal_bss_asil_d_8)
        *(.mcal_bss_asil_d_16)
        *(.mcal_bss_asil_d_32)
        *(.mcal_bss_asil_d_unspecified)
        *(.mcal_cleared)
        *(.mcal_bss)
        *(.sdk_bss_asil_d_bool)
        *(.sdk_bss_asil_d_8)
        *(.sdk_bss_asil_d_16)
        *(.sdk_bss_asil_d_32)
        *(.sdk_bss_asil_d_unspecified)
        *(.sdk_cleared)
        *(.sdk_bss)
    }
    UNCLEAR_RAM_BSS AlignExpr(ImageLimit(UNDEFINE_RAM_BSS), 64) ALIGN 64 0X8000
    {
    
        *(.unclear_bss)                                              ; To store the variable that will not be reset in warm reset.
        *(.mcal_no_init_asil_d_bool)
        *(.mcal_no_init_asil_d_8)
        *(.mcal_no_init_asil_d_16)
        *(.mcal_no_init_asil_d_32)
        *(.mcal_no_init_asil_d_unspecified)
        *(.sdk_no_init_asil_d_bool)
        *(.sdk_no_init_asil_d_8)
        *(.sdk_no_init_asil_d_16)
        *(.sdk_no_init_asil_d_32)
        *(.sdk_no_init_asil_d_unspecified)
    }

;LMU_NORMAL
    LMU2_CACHED_DATA LMU2_NORMAL_ADDRESS ALIGN 64 0x4000
    {
        *(.mcal_data_asil_d_bool_lmu2)
        *(.mcal_data_asil_d_8_lmu2)
        *(.mcal_data_asil_d_16_lmu2)
        *(.mcal_data_asil_d_32_lmu2)
        *(.mcal_data_asil_d_unspecified_lmu2)
    }
    LMU2_CACHED_BSS AlignExpr(ImageLimit(LMU2_CACHED_DATA), 64)  ALIGN 64 0x4000
    {
        *(.mcal_bss_asil_d_bool_lmu2)
        *(.mcal_bss_asil_d_8_lmu2)
        *(.mcal_bss_asil_d_16_lmu2)
        *(.mcal_bss_asil_d_32_lmu2)
        *(.mcal_bss_asil_d_unspecified_lmu2)
    }


;CPU0BTCM

    PRIVATE_CODE_CORE0 CPU0BTCM_ADDRESS ALIGN 64 0x35000
    {
        *(.private_Core0_code)
        *(.mcal_ramcode_asil_d_core0)
        *(.mcal_text_asil_d_core0)
        *(.mcal_text_fast_asil_d_core0)
        *(.mcal_text_callout_asil_d_core0)
        *(.sdk_ramcode_asil_d_core0)
        *(.sdk_text_asil_d_core0)
        *(.sdk_text_fast_asil_d_core0)
        *(.sdk_text_callout_asil_d_core0)

    }

    PRIVATE_DATA_CORE0 AlignExpr(ImageLimit(PRIVATE_CODE_CORE0), 64) ALIGN 64 0x35000
    {
        *(.private_Core0_data)                                       ;
        *(.mcal_data_asil_d_bool_core0)
        *(.mcal_data_asil_d_8_core0)
        *(.mcal_data_asil_d_16_core0)
        *(.mcal_data_asil_d_32_core0)
        *(.mcal_data_asil_d_unspecified_core0)
        *(.sdk_data_asil_d_bool_core0)
        *(.sdk_data_asil_d_8_core0)
        *(.sdk_data_asil_d_16_core0)
        *(.sdk_data_asil_d_32_core0)
        *(.sdk_data_asil_d_unspecified_core0)
    }

    PRIVATE_BSS_CORE0 AlignExpr(ImageLimit(PRIVATE_DATA_CORE0), 64) ALIGN 64 0x35000
    {
        *(.private_Core0_bss)                                        
        *(.private_bss_Core0)
        *(.mcal_bss_asil_d_bool_core0)
        *(.mcal_bss_asil_d_8_core0)
        *(.mcal_bss_asil_d_16_core0)
        *(.mcal_bss_asil_d_32_core0)
        *(.mcal_bss_asil_d_unspecified_core0)
        *(.sdk_bss_asil_d_bool_core0)
        *(.sdk_bss_asil_d_8_core0)
        *(.sdk_bss_asil_d_16_core0)
        *(.sdk_bss_asil_d_32_core0)
        *(.sdk_bss_asil_d_unspecified_core0)
    }

    PRIVATE_NO_INIT_CORE0 AlignExpr(ImageLimit(PRIVATE_BSS_CORE0), 64) ALIGN 64 0x35000
    {
        *(.mcal_no_init_asil_d_bool_core0)
        *(.mcal_no_init_asil_d_8_core0)
        *(.mcal_no_init_asil_d_16_core0)
        *(.mcal_no_init_asil_d_32_core0)
        *(.mcal_no_init_asil_d_unspecified_core0)
        *(.mcal_no_init_asil_d_bool_uncached_core0)
        *(.mcal_no_init_asil_d_8_uncached_core0)
        *(.mcal_no_init_asil_d_16_uncached_core0)
        *(.mcal_no_init_asil_d_32_uncached_core0)
        *(.mcal_no_init_asil_d_unspecified_uncached_core0)
    }
    

    CORE0_USER_STACK CPU0_STACK_ADDRESS ALIGN 8 EMPTY 0x1000{}                 ;
    CORE0_HYP_STACK ImageLimit(CORE0_USER_STACK) ALIGN 8 EMPTY 0x1000{}        ;
    CORE0_KERNEL_STACK ImageLimit(CORE0_HYP_STACK) ALIGN 8 EMPTY 0x1000{}      ;
    CORE0_ABORT_STACK ImageLimit(CORE0_KERNEL_STACK) ALIGN 8 EMPTY 0x1000{}    ;
    CORE0_UNDEFINED_STACK ImageLimit(CORE0_ABORT_STACK) ALIGN 8 EMPTY 0x1000{} ;
    CORE0_IRQ_STACK ImageLimit(CORE0_UNDEFINED_STACK) ALIGN 8 EMPTY 0x1000{}   ;
    CORE0_FIQ_STACK ImageLimit(CORE0_IRQ_STACK) ALIGN 8 EMPTY 0x1000{}         ;



;GMU_DEVICE

    RAM_CODE GMU_DEVICE_ADDRESS ALIGN 64 0XC000
    {
      *(.mcal_text_fast_asil_d)
      *(.mcal_ramcode_asil_d)
    }

    ;data placed at GMU area must be uint32 alignment. 
    GLOBAL_UNCACHED_DATA AlignExpr(ImageLimit(RAM_CODE), 64) ALIGN 64 0XC000
    {
        *(.uncached_data)
        *(.mcal_data_asil_d_bool_uncached)
        *(.mcal_data_asil_d_8_uncached)
        *(.mcal_data_asil_d_16_uncached)
        *(.mcal_data_asil_d_32_uncached)    
        *(.mcal_data_asil_d_unspecified_uncached)
        *(.sdk_data_asil_d_bool_uncached)
        *(.sdk_data_asil_d_8_uncached)
        *(.sdk_data_asil_d_16_uncached)
        *(.sdk_data_asil_d_32_uncached)    
        *(.sdk_data_asil_d_unspecified_uncached)                                            
    }

    GLOBAL_UNCACHED_BSS AlignExpr(ImageLimit(GLOBAL_UNCACHED_DATA), 64) ALIGN 64 0XC000
    {
        *(.uncached_bss)                                             ;
        *(.mcal_bss_asil_d_bool_uncached)
        *(.mcal_bss_asil_d_8_uncached)
        *(.mcal_bss_asil_d_16_uncached)
        *(.mcal_bss_asil_d_32_uncached)
        *(.mcal_bss_asil_d_unspecified_uncached)
        *(.sdk_bss_asil_d_bool_uncached)
        *(.sdk_bss_asil_d_8_uncached)
        *(.sdk_bss_asil_d_16_uncached)
        *(.sdk_bss_asil_d_32_uncached)
        *(.sdk_bss_asil_d_unspecified_uncached)
 
    }
    GLOBAL_UNCACHED_NOINIT AlignExpr(ImageLimit(GLOBAL_UNCACHED_BSS), 64) ALIGN 64 0XC000
    {

        *(.mcal_no_init_asil_d_bool_uncached)
        *(.mcal_no_init_asil_d_8_uncached)
        *(.mcal_no_init_asil_d_16_uncached)
        *(.mcal_no_init_asil_d_32_uncached)
        *(.mcal_no_init_asil_d_unspecified_uncached)
    }

;LMU DEVICE
   
    LMU2_UNCACHED_DATA LMU2_DEVICE_ADDRESS ALIGN 64 0x4000
    {
        *(.mcal_data_asil_d_bool_lmu2_uncached)
        *(.mcal_data_asil_d_8_lmu2_uncached)
        *(.mcal_data_asil_d_16_lmu2_uncached)
        *(.mcal_data_asil_d_32_lmu2_uncached)
        *(.mcal_data_asil_d_unspecified_lmu2_uncached)
        *(.lmu2_uncached_data)                                             ; To store the globle uncached variables that used in RAM store in Flash.
        *(.lmu2_uncached_data.*)                                           ; The address is 0xC00D0000~0xC00D3FFF,length is 16KB.
        *(.sdk_data_asil_d_bool_lmu2_uncached)
        *(.sdk_data_asil_d_8_lmu2_uncached)
        *(.sdk_data_asil_d_16_lmu2_uncached)
        *(.sdk_data_asil_d_32_lmu2_uncached)
        *(.sdk_data_asil_d_unspecified_lmu2_uncached)
    }
    LMU2_UNCACHED_BSS AlignExpr(ImageLimit(LMU2_UNCACHED_DATA), 64)  ALIGN 64 0x4000
    {
        *(.mcal_bss_asil_d_bool_lmu2_uncached)
        *(.mcal_bss_asil_d_8_lmu2_uncached)
        *(.mcal_bss_asil_d_16_lmu2_uncached)
        *(.mcal_bss_asil_d_32_lmu2_uncached)
        *(.mcal_bss_asil_d_unspecified_lmu2_uncached)
    }




;Following execution section is used to detect related execution range.
    INT_VECTOR_TABLE_LIMIT AlignExpr(ImageLimit(INT_VECTOR_TABLE), 64) EMPTY 0x0{}
    CODE_CLONE_LIMIT AlignExpr(ImageLimit(CODE_CLONE), 64) EMPTY 0x0{}
    DATA_CLONE_LIMIT AlignExpr(ImageLimit(DATA_CLONE), 64) EMPTY 0x0{}
    PRIVATE_CODE_CORE0_LIMIT AlignExpr(ImageLimit(PRIVATE_CODE_CORE0), 64) EMPTY 0x0{}
    PRIVATE_DATA_CORE0_LIMIT AlignExpr(ImageLimit(PRIVATE_DATA_CORE0), 64) EMPTY 0x0{}



    UNDEFINE_RAM_DATA_LIMIT AlignExpr(ImageLimit(UNDEFINE_RAM_DATA), 64) EMPTY 0x0{}
    GLOBAL_UNCACHED_DATA_LIMIT AlignExpr(ImageLimit(GLOBAL_UNCACHED_DATA), 64) EMPTY 0x0{}
    LMU2_CACHED_DATA_LIMIT AlignExpr(ImageLimit(LMU2_CACHED_DATA), 64) EMPTY 0x0{}
    LMU2_UNCACHED_DATA_LIMIT AlignExpr(ImageLimit(LMU2_UNCACHED_DATA), 64) EMPTY 0x0{}




    BSS_CLONE_LIMIT AlignExpr(ImageLimit(BSS_CLONE), 64) EMPTY 0x0{}
    CORE0_FIQ_STACK_LIMIT AlignExpr(ImageLimit(CORE0_FIQ_STACK), 64) EMPTY 0x0{}

    PRIVATE_BSS_CORE0_LIMIT AlignExpr(ImageLimit(PRIVATE_BSS_CORE0), 64) EMPTY 0x0{}

    UNDEFINE_RAM_BSS_LIMIT AlignExpr(ImageLimit(UNDEFINE_RAM_BSS), 64) EMPTY 0x0{}
    UNCLEAR_RAM_BSS_LIMIT AlignExpr(ImageLimit(UNCLEAR_RAM_BSS), 64) EMPTY 0x0{}
    GLOBAL_UNCACHED_BSS_LIMIT AlignExpr(ImageLimit(GLOBAL_UNCACHED_BSS), 64) EMPTY 0x0{}
    LMU2_CACHED_BSS_LIMIT AlignExpr(ImageLimit(LMU2_CACHED_BSS), 64) EMPTY 0x0{}
    LMU2_UNCACHED_BSS_LIMIT AlignExpr(ImageLimit(LMU2_UNCACHED_BSS), 64) EMPTY 0x0{}

}
DFLASH_CODE DFLASH_MEMORY_ADDRESS 0x10000
{
	DFLASH_DATA DFLASH_MEMORY_ADDRESS ALIGN 64 0x10000
    {
        *(.dflash_data)                                              ; To store the variables that stored in DFlash.
                                                                     ; The address is 0x44000000 - 0x44010000,length is 64KB.
    }
}